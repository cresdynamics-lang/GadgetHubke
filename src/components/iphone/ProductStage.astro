---
/**
 * Product photo stage - #F5F5F7 with multiply blend (white photo bg disappears).
 * Blend sits on the element directly on the stage (not inside a transform wrapper).
 */
interface Props {
  src: string;
  srcWebp?: string;
  alt: string;
  class?: string;
  wide?: boolean;
  eager?: boolean;
  highPriority?: boolean;
  width?: number;
  height?: number;
}

const {
  src,
  srcWebp,
  alt,
  class: className = "",
  wide = false,
  eager = false,
  highPriority = false,
  width = 760,
  height = 760,
} = Astro.props;
---

<div class:list={["pstage", className]}>
  <picture>
    {srcWebp ? <source srcset={srcWebp} type="image/webp" /> : null}
    <img
      class:list={["pstage__img", { "pstage__img--wide": wide }]}
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={highPriority ? "high" : "auto"}
    />
  </picture>
</div>

<style>
  .pstage {
    background: #f5f5f7;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 1.5rem;
    aspect-ratio: 1;
  }

  .pstage picture {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .pstage__img {
    width: 88%;
    height: auto;
    max-height: 92%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .pstage__img--wide {
    width: 94%;
  }
</style>
