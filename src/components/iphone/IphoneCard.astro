---
/**
 * Shop card for iPhone 11 - 16 catalog. New and Ex-UK are separate cards.
 */
import ProductStage from "./ProductStage.astro";
import ConditionBadge from "../ConditionBadge.astro";
import {
  type IphoneModel,
  getImage,
  availableViews,
  defaultColourForModel,
  availableColours,
  isOverviewOnly,
  isLatestTag,
  isValueTag,
  modelSubline,
  storagePrices,
  colourHex,
  isLightColour,
  colourLabel,
} from "../../lib/iphone";
import { cardImageSrc } from "../../lib/card-images";
import { filterColours, type ListingChannel } from "../../lib/listing-offers";
import { whatsappUrl } from "../../lib/site";

interface Props {
  model: IphoneModel;
  compare?: boolean;
  /** Above-the-fold cards should paint immediately. */
  eager?: boolean;
  channel?: ListingChannel;
  priceKes?: number;
  coloursInStock?: string[];
  href?: string;
}

const { model, compare = true, eager = false, channel = "new", priceKes, coloursInStock, href: hrefProp } = Astro.props;
const colours = filterColours(availableColours(model.id), coloursInStock);
const colour = colours.includes(model.defaultColour ?? "")
  ? model.defaultColour!
  : defaultColourForModel(model.id, colours[0]) || colours[0] || null;
const resolved = getImage(model.id, colour, 1, model.name);
const cardSrc = cardImageSrc(model.id, resolved.src);
const img = { ...resolved, src: cardSrc, srcWebp: cardSrc.endsWith(".webp") ? cardSrc : resolved.srcWebp };
const overviewOnly = isOverviewOnly(model.id);
const price = storagePrices(model.basePriceKes, model.storage, model.name)[0];
const displayKes = priceKes ?? price.kes;
const href = hrefProp || `/iphone/${model.id}`;
const wa = whatsappUrl(`Hello Gadget Hub, I'm interested in the ${model.name}${channel === "ex-uk" ? " (Ex-UK)" : ""}.`);
const tag = isLatestTag(model) ? "Latest" : isValueTag(model) ? "Value" : null;

const colourPayload = colours.map((key) => {
  const resolved = getImage(model.id, key, 1, model.name);
  const views = availableViews(model.id, key);
  const altView = views.includes(2)
    ? getImage(model.id, key, 2, model.name)
    : null;
  const hover =
    altView && !altView.fallback && altView.src !== resolved.src
      ? altView
      : null;
  return {
    key,
    hex: colourHex(key),
    label: colourLabel(key),
    src: resolved.src,
    srcWebp: resolved.srcWebp ?? "",
    alt: resolved.alt,
    light: isLightColour(key),
    hoverSrc: hover?.src ?? "",
    hoverWebp: hover?.srcWebp ?? "",
  };
});

const hoverSrc =
  colourPayload[0]?.hoverSrc ||
  (colourPayload[1] && colourPayload[1].src !== img.src ? colourPayload[1].src : "");
---

<article
  class="icard"
  data-icard
  data-model={model.id}
  data-family={model.family}
  data-tier={model.tier}
  data-price={displayKes}
  data-price-new={displayKes}
  data-channel={channel}
  data-battery={model.batteryVideoHours}
  data-size={model.displayInches}
>
  {
    compare ? (
      <label class="icard__compare">
        <input type="checkbox" data-compare={model.id} aria-label={`Compare ${model.name}`} />
      </label>
    ) : null
  }
  <ConditionBadge channel={channel} />
  {
    tag ? <span class="icard__tag">{tag}</span> : null
  }
  <a class:list={["icard__media", { "icard__media--swap": Boolean(hoverSrc) }]} href={href}>
    <ProductStage
      src={img.src}
      srcWebp={img.srcWebp}
      alt={img.alt}
      width={img.width}
      height={img.width}
      eager={eager}
      highPriority={eager}
    />
    {
      hoverSrc ? (
        <img
          class="icard__img-alt"
          data-icard-alt
          src={hoverSrc}
          alt=""
          width={img.width}
          height={img.width}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      ) : null
    }
  </a>
  <div class="icard__body">
    <h3 class="icard__name"><a href={href}>{model.name}</a></h3>
    <p class="icard__channel">{channel === "ex-uk" ? "Ex-UK" : "New"}</p>
    <p class="icard__sub">{modelSubline(model)}</p>
    {
      overviewOnly ? (
        <p class="icard__note">Full angle set coming soon</p>
      ) : (
        <div class="icard__swatches" role="group" aria-label={`${model.name} colours`}>
          {colourPayload.map((c) => (
            <button
              type="button"
              class:list={["icard__dot", { "is-active": c.key === colour, "icard__dot--light": c.light }]}
              style={`--swatch: ${c.hex}`}
              aria-label={c.label}
              data-icard-swatch
              data-src={c.src}
              data-webp={c.srcWebp}
              data-alt={c.alt}
              data-hover={c.hoverSrc || ""}
              data-hover-webp={c.hoverWebp || ""}
            />
          ))}
        </div>
      )
    }
    <div class="icard__row icard__row--price">
      <p class="icard__price">
        <span class="icard__from" data-icard-price data-live-price={model.id} data-live-field={channel === "ex-uk" ? "exUkKes" : "priceKes"} data-live-prefix="">{`KSh ${Math.round(displayKes).toLocaleString("en-KE")}`}</span>
      </p>
      <button
        type="button"
        class="btn btn--secondary btn--xs"
        data-add-bag={model.id}
        data-name={model.name}
        data-colour={colour ?? ""}
        data-storage={model.storage[0]}
        data-kes={displayKes}
        data-image={img.src}
      >
        Add to Cart
      </button>
    </div>
    <div class="icard__row icard__row--links">
      <a class="btn btn--primary btn--xs" href={href}>Details</a>
      <a class="btn btn--whatsapp btn--xs" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll("[data-icard]").forEach((card) => {
    if (card.getAttribute("data-icard-bound") === "1") return;
    card.setAttribute("data-icard-bound", "1");
    const img = card.querySelector(".pstage__img");
    const webpSource = card.querySelector(".pstage source");
    const bag = card.querySelector("[data-add-bag]");
    const altImg = card.querySelector("[data-icard-alt]") as HTMLImageElement | null;
    const media = card.querySelector(".icard__media");

    card.querySelectorAll("[data-icard-swatch]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const src = btn.getAttribute("data-src");
        const webp = btn.getAttribute("data-webp");
        const alt = btn.getAttribute("data-alt");
        const hover = btn.getAttribute("data-hover") || "";
        if (img && src) {
          img.style.opacity = "0";
          window.setTimeout(() => {
            img.src = src;
            if (webpSource) {
              if (webp) webpSource.srcset = webp;
              else webpSource.removeAttribute("srcset");
            }
            if (alt) img.alt = alt;
            img.style.opacity = "1";
          }, 120);
        }
        if (altImg && hover && hover !== src) {
          altImg.src = hover;
          media?.classList.add("icard__media--swap");
        } else if (altImg && !hover) {
          media?.classList.remove("icard__media--swap");
        }
        card.querySelectorAll("[data-icard-swatch]").forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        if (bag) {
          bag.setAttribute("data-colour", btn.getAttribute("aria-label") || "");
          bag.setAttribute("data-image", src || "");
        }
      });
    });

    bag?.addEventListener("click", (e) => {
      e.preventDefault();
      if (!(bag instanceof HTMLElement)) return;
      const ch = card.getAttribute("data-channel") || "new";
      window.dispatchEvent(
        new CustomEvent("gh:bag-add", {
          detail: {
            id: `${bag.getAttribute("data-add-bag")}-${ch}`,
            name: bag.getAttribute("data-name"),
            colour: bag.getAttribute("data-colour"),
            storage: bag.getAttribute("data-storage"),
            kes: Number(bag.getAttribute("data-kes") || 0),
            image: bag.getAttribute("data-image"),
          },
        }),
      );
    });
  });
</script>

<style>
  .icard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    overflow: hidden;
    transition:
      transform var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .icard:hover {
    transform: translateY(-4px);
    border-color: var(--color-fg);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.08);
  }

  .icard :global(.pstage) {
    border-radius: 0;
  }

  .icard :global(.pstage__img) {
    transition: opacity 0.35s ease;
  }

  .icard__media {
    position: relative;
    display: block;
    text-decoration: none;
  }

  .icard__img-alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .icard__media--swap:hover :global(.pstage__img) {
    opacity: 0;
  }

  .icard__media--swap:hover .icard__img-alt {
    opacity: 1;
  }

  .icard__compare {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    background: rgb(255 255 255 / 0.9);
    border-radius: 0.25rem;
    padding: 0.2rem;
  }

  .icard__tag {
    position: absolute;
    top: 2.35rem;
    left: 0.75rem;
    z-index: 2;
    font-size: 0.65rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--color-black);
    color: var(--color-white);
  }

  .icard__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.15rem;
    flex: 1;
  }

  .icard__name {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .icard__name a {
    color: inherit;
    text-decoration: none;
  }

  .icard__channel {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .icard__sub {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .icard__note {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    color: var(--color-fg-muted);
  }

  .icard__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .icard__dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / 0.12);
    background: var(--swatch);
    padding: 0;
    cursor: pointer;
  }

  .icard__dot--light {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .icard__dot.is-active {
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }

  .icard__row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.55rem;
  }

  .icard__row--links {
    margin-top: 0.4rem;
    padding-top: 0;
  }

  .icard__price {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
  }

  .icard__from {
    font-weight: var(--font-weight-display);
    letter-spacing: -0.02em;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .icard__row .btn {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    white-space: nowrap;
  }

  .icard__row--price .btn {
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .icard,
    .icard:hover,
    .icard :global(.pstage__img) {
      transition: none;
      transform: none;
    }
  }

  /* Price and Add to cart never touch: smaller type on narrow cards, and the
     button drops under the price when the card is too narrow for both. */
  .icard__row--price {
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 0.5rem;
    row-gap: 0.4rem;
  }
  .icard__row--price .icard__price,
  .icard__row--price .icard__price * {
    font-size: clamp(0.74rem, 2.9vw, 0.85rem);
  }
  .icard__row--price :global(.btn) {
    flex: 0 0 auto;
    font-size: clamp(0.66rem, 2.6vw, 0.75rem);
    padding: 0.28rem 0.55rem;
    min-height: 1.75rem;
  }
</style>
