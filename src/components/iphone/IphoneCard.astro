---
/**
 * Shop card for iPhone 11 - 16 catalog. New | EX-UK toggles sample from-price.
 */
import ProductStage from "./ProductStage.astro";
import StockChannelToggle from "../StockChannelToggle.astro";
import {
  type IphoneModel,
  getImage,
  availableViews,
  defaultColourForModel,
  availableColours,
  isOverviewOnly,
  isLatestTag,
  isValueTag,
  modelSubline,
  storagePrices,
  formatKes,
  lipaMonthly,
  colourHex,
  isLightColour,
  colourLabel,
} from "../../lib/iphone";
import { iphoneConfig } from "../../lib/iphone/config";
import { exUkFromNew } from "../../lib/stock-channel";

interface Props {
  model: IphoneModel;
  compare?: boolean;
}

const { model, compare = true } = Astro.props;
const colour = defaultColourForModel(model.id, model.defaultColour ?? undefined);
const img = getImage(model.id, colour, 1, model.name);
const colours = availableColours(model.id);
const overviewOnly = isOverviewOnly(model.id);
const price = storagePrices(model.basePriceKes, model.storage)[0];
const priceExUk = exUkFromNew(price.kes);
const lipa = lipaMonthly(price.kes);
const href = `/iphone/${model.id}`;
const tag = isLatestTag(model) ? "Latest" : isValueTag(model) ? "Value" : null;

const colourPayload = colours.map((key) => {
  const resolved = getImage(model.id, key, 1, model.name);
  const views = availableViews(model.id, key);
  const altView = views.includes(2)
    ? getImage(model.id, key, 2, model.name)
    : null;
  const hover =
    altView && !altView.fallback && altView.src !== resolved.src
      ? altView
      : null;
  return {
    key,
    hex: colourHex(key),
    label: colourLabel(key),
    src: resolved.src,
    srcWebp: resolved.srcWebp ?? "",
    alt: resolved.alt,
    light: isLightColour(key),
    hoverSrc: hover?.src ?? "",
    hoverWebp: hover?.srcWebp ?? "",
  };
});

const hoverSrc =
  colourPayload[0]?.hoverSrc ||
  (colourPayload[1] && colourPayload[1].src !== img.src ? colourPayload[1].src : "");
---

<article
  class="icard"
  data-icard
  data-model={model.id}
  data-family={model.family}
  data-tier={model.tier}
  data-price={price.kes}
  data-price-new={price.kes}
  data-price-ex-uk={priceExUk}
  data-channel="new"
  data-battery={model.batteryVideoHours}
  data-size={model.displayInches}
>
  {
    compare ? (
      <label class="icard__compare">
        <input type="checkbox" data-compare={model.id} aria-label={`Compare ${model.name}`} />
      </label>
    ) : null
  }
  {
    tag ? <span class="icard__tag">{tag}</span> : null
  }
  <a class:list={["icard__media", { "icard__media--swap": Boolean(hoverSrc) }]} href={href}>
    <ProductStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={img.width} height={img.width} />
    {
      hoverSrc ? (
        <img
          class="icard__img-alt"
          data-icard-alt
          src={hoverSrc}
          alt=""
          width={img.width}
          height={img.width}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      ) : null
    }
  </a>
  <div class="icard__body">
    <h3 class="icard__name"><a href={href}>{model.name}</a></h3>
    <StockChannelToggle class="icard__channel" />
    <p class="icard__sub">{modelSubline(model)}</p>
    {
      overviewOnly ? (
        <p class="icard__note">Full angle set coming soon</p>
      ) : (
        <div class="icard__swatches" role="group" aria-label={`${model.name} colours`}>
          {colourPayload.map((c, i) => (
            <button
              type="button"
              class:list={["icard__dot", { "is-active": i === 0, "icard__dot--light": c.light }]}
              style={`--swatch: ${c.hex}`}
              aria-label={c.label}
              data-icard-swatch
              data-src={c.src}
              data-webp={c.srcWebp}
              data-alt={c.alt}
              data-hover={c.hoverSrc || ""}
              data-hover-webp={c.hoverWebp || ""}
            />
          ))}
        </div>
      )
    }
    <p class="icard__price">
      <span class="icard__from" data-icard-price data-live-price={model.id} data-live-prefix="From ">From {formatKes(price.kes)}</span>
      <span class="icard__sample" data-live-stock={model.id}>1-year warranty</span>
    </p>
    <p class="icard__lipa" data-icard-lipa>
      or {formatKes(lipa.monthlyKes)} a month for {lipa.months} months after a {iphoneConfig.lipa.depositDefaultPct}% deposit
    </p>
    <div class="icard__actions">
      <a class="btn btn--primary btn--xs" href={href}>View</a>
      <button
        type="button"
        class="btn btn--secondary btn--xs"
        data-add-bag={model.id}
        data-name={model.name}
        data-colour={colour ?? ""}
        data-storage={model.storage[0]}
        data-kes={price.kes}
        data-image={img.src}
      >
        Add to Cart
      </button>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll("[data-icard]").forEach((card) => {
    const img = card.querySelector(".pstage__img") as HTMLImageElement | null;
    const webpSource = card.querySelector(".pstage source") as HTMLSourceElement | null;
    const priceEl = card.querySelector("[data-icard-price]");
    const lipaEl = card.querySelector("[data-icard-lipa]");
    const bag = card.querySelector("[data-add-bag]");
    const depositPct = 40;
    const months = 6;

    function channelKes() {
      const ch = card.getAttribute("data-channel") || "new";
      const newKes = Number(card.getAttribute("data-price-new") || card.getAttribute("data-price") || 0);
      const exUkKes = Number(card.getAttribute("data-price-ex-uk") || newKes);
      return ch === "ex-uk" ? exUkKes : newKes;
    }

    function syncChannelPrice() {
      const kes = channelKes();
      const ch = card.getAttribute("data-channel") || "new";
      if (priceEl) priceEl.textContent = `From KES ${kes.toLocaleString("en-KE")}`;
      if (lipaEl) {
        const deposit = Math.round((kes * depositPct) / 100);
        const monthly = Math.round((kes - deposit) / months);
        lipaEl.textContent = `or KES ${monthly.toLocaleString("en-KE")} a month for ${months} months after a ${depositPct}% deposit`;
      }
      if (bag) bag.setAttribute("data-kes", String(kes));
      card.setAttribute("data-price", String(kes));
      card.querySelectorAll("[data-stock-channel] [data-channel]").forEach((b) => {
        const on = b.getAttribute("data-channel") === ch;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
    }

    card.querySelectorAll("[data-stock-channel] [data-channel]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        card.setAttribute("data-channel", btn.getAttribute("data-channel") || "new");
        syncChannelPrice();
      });
    });

    const altImg = card.querySelector("[data-icard-alt]") as HTMLImageElement | null;
    const media = card.querySelector(".icard__media");

    card.querySelectorAll("[data-icard-swatch]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const src = btn.getAttribute("data-src");
        const webp = btn.getAttribute("data-webp");
        const alt = btn.getAttribute("data-alt");
        const hover = btn.getAttribute("data-hover") || "";
        if (img && src) {
          img.style.opacity = "0";
          window.setTimeout(() => {
            img.src = src;
            if (webpSource) {
              if (webp) webpSource.srcset = webp;
              else webpSource.removeAttribute("srcset");
            }
            if (alt) img.alt = alt;
            img.style.opacity = "1";
          }, 120);
        }
        if (altImg && hover && hover !== src) {
          altImg.src = hover;
          media?.classList.add("icard__media--swap");
        } else if (altImg && !hover) {
          media?.classList.remove("icard__media--swap");
        }
        card.querySelectorAll("[data-icard-swatch]").forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        if (bag) {
          bag.setAttribute("data-colour", btn.getAttribute("aria-label") || "");
          bag.setAttribute("data-image", src || "");
        }
      });
    });

    bag?.addEventListener("click", (e) => {
      e.preventDefault();
      if (!(bag instanceof HTMLElement)) return;
      const ch = card.getAttribute("data-channel") || "new";
      const channelLabel = ch === "ex-uk" ? "EX-UK" : "New";
      window.dispatchEvent(
        new CustomEvent("gh:bag-add", {
          detail: {
            id: `${bag.getAttribute("data-add-bag")}-${ch}`,
            name: bag.getAttribute("data-name"),
            colour: bag.getAttribute("data-colour"),
            storage: `${bag.getAttribute("data-storage")} · ${channelLabel}`,
            kes: Number(bag.getAttribute("data-kes") || 0),
            image: bag.getAttribute("data-image"),
            channel: channelLabel,
          },
        }),
      );
    });
  });
</script>

<style>
  .icard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    overflow: hidden;
    transition:
      transform var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .icard:hover {
    transform: translateY(-4px);
    border-color: var(--color-fg);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.08);
  }

  .icard :global(.pstage) {
    border-radius: 0;
  }

  .icard :global(.pstage__img) {
    transition: opacity 0.35s ease;
  }

  .icard__media {
    position: relative;
    display: block;
    text-decoration: none;
  }

  .icard__img-alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .icard__media--swap:hover :global(.pstage__img) {
    opacity: 0;
  }

  .icard__media--swap:hover .icard__img-alt {
    opacity: 1;
  }

  .icard__compare {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    background: rgb(255 255 255 / 0.9);
    border-radius: 0.25rem;
    padding: 0.2rem;
  }

  .icard__tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    font-size: 0.65rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--color-black);
    color: var(--color-white);
  }

  .icard__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.15rem;
    flex: 1;
  }

  .icard__name {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .icard__name a {
    color: inherit;
    text-decoration: none;
  }

  .icard__channel {
    margin: 0.15rem 0 0.1rem;
  }

  .icard__channel :global(.stock-channel__hint) {
    display: none;
  }

  .icard__sub {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .icard__note {
    margin: 0.25rem 0 0;
    font-size: 0.75rem;
    color: var(--color-fg-muted);
  }

  .icard__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .icard__dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / 0.12);
    background: var(--swatch);
    padding: 0;
    cursor: pointer;
  }

  .icard__dot--light {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .icard__dot.is-active {
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }

  .icard__price {
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .icard__from {
    font-weight: var(--font-weight-display);
    letter-spacing: -0.02em;
  }

  .icard__sample {
    font-size: 0.7rem;
    color: var(--color-fg-muted);
  }

  .icard__lipa {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    line-height: 1.35;
  }

  .icard__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .icard,
    .icard:hover,
    .icard :global(.pstage__img) {
      transition: none;
      transform: none;
    }
  }
</style>
