---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackButton from "../BackButton.astro";
import {
  formatKesSeo,
  buildSeriesHubJsonLd,
  type IphoneSeriesHub,
} from "../../lib/iphone/seo";
import { site } from "../../lib/site";
import { livePricedCatalog, iphoneLiveId } from "../../lib/pricing/live";
import { withLiveSeoPrices } from "../../lib/iphone/seo/live";

interface Props {
  hub: IphoneSeriesHub;
}

const { hub: hubDefault } = Astro.props;
// Live admin prices for every model in the series.
const liveById = new Map((await livePricedCatalog()).map((p) => [p.id, p]));
const liveModels = hubDefault.models
  .map((m) => withLiveSeoPrices(m, liveById.get(iphoneLiveId(m.id))))
  .sort((a, b) => a.fromKes - b.fromKes || a.name.localeCompare(b.name));
const liveFrom = Math.min(...liveModels.map((m) => m.fromKes));
const hub = {
  ...hubDefault,
  models: liveModels,
  metaDescription: `Compare every ${hubDefault.name} model at Gadget Hub Nairobi. KES ${liveFrom.toLocaleString("en-KE")}. Pay in full or Lipa Mdogo Mdogo.`,
};
const pageUrl = new URL(`/iphone/${hub.slug}`, site.url).href;
const jsonLd = buildSeriesHubJsonLd({
  name: hub.name,
  pageUrl,
  description: hub.metaDescription,
});
---

<BaseLayout title={hub.title} description={hub.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="series-hub container">
    <BackButton fallbackHref="/iphone" />
    <nav class="series-hub__crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/iphone">iPhone</a></li>
        <li aria-current="page">{hub.name}</li>
      </ol>
    </nav>
    <h1>{hub.name}</h1>
    <p class="series-hub__intro">{hub.intro}</p>
    <table>
      <thead>
        <tr>
          <th scope="col">Model</th>
          <th scope="col">Price</th>
          <th scope="col">Storage options</th>
        </tr>
      </thead>
      <tbody>
        {
          hub.models.map((m) => (
            <tr>
              <td>
                <a href={`/iphone/${m.id}`}>{m.name}</a>
              </td>
              <td>{formatKesSeo(m.fromKes)}</td>
              <td>{m.variants.map((v) => v.storage).join(", ")}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p><a href="/iphone">← All iPhone series</a></p>
  </article>
</BaseLayout>

<style>
  .series-hub {
    max-width: 52rem;
    margin: 2rem auto 4rem;
    padding: 0 1.25rem;
  }
  .series-hub__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: #6e6e73;
  }
  .series-hub__crumbs li:not(:last-child)::after {
    content: "/";
    margin-left: 0.35rem;
  }
  .series-hub h1 {
    margin: 0 0 0.75rem;
  }
  .series-hub__intro {
    line-height: 1.55;
    color: #424245;
  }
  .series-hub table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .series-hub th,
  .series-hub td {
    text-align: left;
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid #e8e8ed;
  }
</style>
