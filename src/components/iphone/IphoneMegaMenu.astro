---
/**
 * Compact iPhone nav flyout - iPhone 18 lineup + shop all.
 */
import { formatKes } from "../../lib/iphone";
import { latestByFamily, formatFromKes } from "../../lib/iphone/lineup";

const eighteen = latestByFamily(18);

const picks = eighteen.map((i) => ({
  id: i.id,
  name: i.name,
  href: i.href,
  priceLabel: formatKes(i.priceKes),
  badge: i.badge || "New",
  src: i.image.src,
  alt: i.image.alt,
  priceKes: i.priceKes,
}));

const previews = Object.fromEntries(picks.map((p) => [p.id, p]));
const defaultPreview =
  picks.find((p) => p.id === "iphone-pro") ||
  picks[0] || {
    id: "iphone-18",
    name: "iPhone 18",
    href: "/iphone?family=18",
    priceLabel: "",
    badge: "New",
    src: "",
    alt: "",
    priceKes: 0,
  };
---

<div class="imega" data-imega>
  <div class="imega__cols">
    <div class="imega__col">
      <p class="imega__heading">iPhone 18</p>
      <ul>
        {
          picks.map((m) => (
            <li>
              <a class="imega__link" href={m.href} data-mega-preview={m.id}>
                <span>
                  {m.name}
                  <span class="imega__tag">{m.badge}</span>
                </span>
                <span class="imega__from">{formatFromKes(m.priceKes)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="imega__all" href="/iphone?family=18">Shop all iPhone 18</a>
      <a class="imega__all" href="/shop/iphone">Shop all iPhone</a>
    </div>

    <div class="imega__col">
      <p class="imega__heading">Explore</p>
      <ul>
        <li><a class="imega__link" href="/iphone">iPhone overview</a></li>
        <li><a class="imega__link" href="/iphone?family=17">iPhone 17</a></li>
        <li><a class="imega__link" href="/iphone">All generations</a></li>
        <li><a class="imega__link" href="/trade-in">Trade in</a></li>
        <li><a class="imega__link" href="/lipa-mdogo-mdogo">Lipa Mdogo Mdogo</a></li>
      </ul>
    </div>

    <aside class="imega__preview" data-mega-card>
      <div class="imega__stage">
        <img
          data-mega-img
          src={defaultPreview.src}
          alt={defaultPreview.alt}
          width="240"
          height="240"
          decoding="async"
        />
      </div>
      <p class="imega__pname" data-mega-name>{defaultPreview.name}</p>
      <p class="imega__pprice" data-mega-price>
        {defaultPreview.priceLabel ? `From ${defaultPreview.priceLabel}` : ""}
      </p>
      <a class="btn btn--primary btn--sm" data-mega-cta href={defaultPreview.href}>
        View
      </a>
    </aside>
  </div>
</div>

<script define:vars={{ previews, defaultPreview }}>
  const root = document.querySelector("[data-imega]");
  if (root) {
    const img = root.querySelector("[data-mega-img]");
    const name = root.querySelector("[data-mega-name]");
    const price = root.querySelector("[data-mega-price]");
    const cta = root.querySelector("[data-mega-cta]");

    function show(id) {
      const p = previews[id] || defaultPreview;
      if (img instanceof HTMLImageElement) {
        img.src = p.src;
        img.alt = p.alt;
      }
      if (name) name.textContent = p.name;
      if (price) price.textContent = p.priceLabel ? `From ${p.priceLabel}` : "";
      if (cta instanceof HTMLAnchorElement) cta.href = p.href;
    }

    root.querySelectorAll("[data-mega-preview]").forEach((a) => {
      a.addEventListener("mouseenter", () => show(a.getAttribute("data-mega-preview")));
      a.addEventListener("focus", () => show(a.getAttribute("data-mega-preview")));
    });
  }
</script>

<style>
  .imega {
    padding: 0.25rem 0 0.5rem;
  }
  .imega__cols {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.25fr 0.9fr 0.85fr;
    align-items: start;
  }
  .imega__heading {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    font-weight: 600;
  }
  .imega ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .imega__link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    text-decoration: none;
    color: var(--color-fg);
    font-size: 0.875rem;
  }
  .imega__link:hover,
  .imega__link:focus-visible {
    text-decoration: underline;
  }
  .imega__from {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    white-space: nowrap;
  }
  .imega__tag {
    margin-left: 0.35rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--color-black);
    color: var(--color-white);
    border-radius: 999px;
    padding: 0.1rem 0.35rem;
  }
  .imega__all {
    display: inline-block;
    margin-top: 0.65rem;
    margin-right: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
  }
  .imega__preview {
    background: var(--color-stage);
    border-radius: var(--radius-lg);
    padding: 0.85rem;
  }
  .imega__stage {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin-bottom: 0.5rem;
  }
  .imega__stage img {
    width: 72%;
    height: auto;
    object-fit: contain;
  }
  .imega__pname {
    margin: 0;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
  }
  .imega__pprice {
    margin: 0.25rem 0 0.65rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  @media (max-width: 63.749rem) {
    .imega {
      display: none;
    }
  }
</style>
