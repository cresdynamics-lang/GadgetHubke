---
---

<section class="tradein fade-up" data-fade-up aria-labelledby="tradein-heading">
  <img
    class="tradein__bg"
    src="/images/home/trade-in-pro.jpg"
    alt=""
    width="1024"
    height="235"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />

  <div class="tradein__content">
    <p class="tradein__brand">Gadget Hub</p>
    <h2 id="tradein-heading">You don’t have to worry.</h2>
    <p class="tradein__lede">
      Offers you trade-in options. Bring your current phone and get out with an
      Apple smile. The phone you want is a click away.
    </p>
    <a class="btn btn--inverse tradein__cta" href="/trade-in">Start trade in</a>
  </div>
</section>

<style>
  .tradein {
    position: relative;
    isolation: isolate;
    background: #000;
    color: var(--color-white);
    min-height: clamp(18rem, 42vw, 28rem);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
  }

  .tradein__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the phone (center band) clear of copy */
    object-position: center 58%;
  }

  .tradein__content {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 40rem);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4) 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Soft veil only behind text so the phone below stays visible */
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.72) 0%,
      rgb(0 0 0 / 0.35) 70%,
      transparent 100%
    );
    padding-bottom: var(--space-8);
  }

  .tradein__brand {
    font-family: var(--font-hero);
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: var(--space-2);
  }

  .tradein__content h2 {
    font-family: var(--font-hero);
    font-size: clamp(1.15rem, 2.6vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }

  .tradein__lede {
    color: rgb(255 255 255 / 0.78);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-5);
    max-width: 30rem;
  }

  .tradein__cta {
    background: var(--color-white);
    color: var(--color-black);
  }

  .tradein__cta:hover {
    background: var(--color-grey-200);
    color: var(--color-black);
  }

  @media (min-width: 48rem) {
    .tradein {
      min-height: clamp(22rem, 36vw, 32rem);
    }

    .tradein__content {
      padding-top: var(--space-10);
    }

    .tradein__lede {
      font-size: var(--text-base);
    }
  }
</style>
