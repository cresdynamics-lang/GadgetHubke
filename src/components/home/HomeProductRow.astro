---
/**
 * Horizontal scrollable product row for the homepage.
 */
import Price from "../Price.astro";
import type { DealItem } from "../../lib/home";

interface Props {
  title: string;
  lede?: string;
  href: string;
  linkLabel?: string;
  items: DealItem[];
  ariaLabel?: string;
}

const {
  title,
  lede,
  href,
  linkLabel = "Shop all ›",
  items,
  ariaLabel = title,
} = Astro.props;
---

<section class="home-row fade-up" data-fade-up>
  <div class="container">
    <header class="home-section__head home-section__head--row">
      <div>
        <h2>{title}</h2>
        {lede ? <p>{lede}</p> : null}
      </div>
      <a class="home-section__link" href={href}>{linkLabel}</a>
    </header>
  </div>

  <div class="home-row__scroller" tabindex="0" aria-label={ariaLabel}>
    <ul class="home-row__track">
      {
        items.map((item) => (
          <li>
            <a class="home-row__card" href={item.href}>
              <span class="home-row__media product-stage">
                {item.badge ? <span class="badge home-row__badge">{item.badge}</span> : null}
                {item.image ? (
                  <img
                    src={item.image.src}
                    alt={item.image.alt}
                    width="280"
                    height="240"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="home-row__placeholder" aria-hidden="true" />
                )}
              </span>
              <span class="home-row__name">{item.name}</span>
              <Price kes={item.priceKes} prefix="From" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .home-row {
    padding-block: var(--space-8);
  }

  .home-row__scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-2);
  }

  .home-row__scroller:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: -2px;
  }

  .home-row__track {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-4);
    display: flex;
    gap: var(--space-4);
    width: max-content;
  }

  @media (min-width: 40rem) {
    .home-row__track {
      padding-inline: max(var(--space-4), calc((100vw - var(--container)) / 2));
    }
  }

  .home-row__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 12.5rem;
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .home-row__card {
      width: 14rem;
    }
  }

  .home-row__card:hover .home-row__name {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .home-row__media {
    position: relative;
    aspect-ratio: 1.05 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .home-row__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-4);
    transition: transform 0.45s var(--ease-out);
  }

  .home-row__card:hover .home-row__media img {
    transform: scale(1.04);
  }

  .home-row__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, var(--color-grey-200), var(--color-grey-100));
  }

  .home-row__badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1;
  }

  .home-row__name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .home-row__card :global(.price) {
    font-size: var(--text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-row__media img {
      transition: none;
    }
  }
</style>
