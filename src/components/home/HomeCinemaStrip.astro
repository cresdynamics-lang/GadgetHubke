---
/**
 * Dual cinematic panels - Apple-style black hero frames for home.
 */
import { homeOpt } from "../../lib/home-images";

interface Shot {
  href: string;
  src: string;
  alt: string;
  eyebrow: string;
  title: string;
  cta: string;
}

interface Props {
  shots: [Shot, Shot];
}

const { shots } = Astro.props;
---

<section class="home-cinema" aria-label="Featured products">
  <div class="home-cinema__grid">
    {
      shots.map((shot) => (
        <a class="home-cinema__panel" href={shot.href}>
          <img
            class="home-cinema__img"
            src={homeOpt(shot.src)}
            alt={shot.alt}
            width="1024"
            height="235"
            loading="lazy"
            decoding="async"
            sizes="50vw"
          />
          <span class="home-cinema__shade" aria-hidden="true" />
          <span class="home-cinema__copy">
            <span class="home-cinema__eyebrow">{shot.eyebrow}</span>
            <span class="home-cinema__title">{shot.title}</span>
            <span class="home-cinema__cta">{shot.cta}</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .home-cinema {
    padding-block: 0 var(--space-4);
  }

  .home-cinema__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
    padding-inline: max(0.65rem, calc((100% - var(--container, 72rem)) / 2 + var(--space-4)));
  }

  @media (min-width: 48rem) {
    .home-cinema__grid {
      gap: 0.65rem;
    }
  }

  .home-cinema__panel {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: #000;
    text-decoration: none;
    color: #f5f5f7;
    /* Wide rectangle so product imagery reads clearly */
    aspect-ratio: 16 / 9;
    width: 100%;
    isolation: isolate;
  }

  @media (min-width: 48rem) {
    .home-cinema__panel {
      border-radius: var(--radius-lg);
      aspect-ratio: 16 / 8.5;
    }
  }

  .home-cinema__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s var(--ease-out);
  }

  .home-cinema__panel:hover .home-cinema__img {
    transform: scale(1.04);
  }

  .home-cinema__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.08) 0%,
      rgba(0, 0, 0, 0.02) 45%,
      rgba(0, 0, 0, 0.58) 100%
    );
    z-index: 1;
  }

  .home-cinema__copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 0.55rem 0.55rem;
  }

  @media (min-width: 48rem) {
    .home-cinema__copy {
      gap: 0.15rem;
      padding: 0.75rem 0.9rem 0.85rem;
    }
  }

  .home-cinema__eyebrow {
    font-size: 0.5rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(245, 245, 247, 0.72);
  }

  .home-cinema__title {
    font-family: var(--font-display);
    font-weight: var(--font-weight-display);
    font-size: clamp(0.78rem, 2.6vw, 1.2rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .home-cinema__cta {
    margin-top: 0.05rem;
    font-size: clamp(0.55rem, 1.8vw, 0.78rem);
    font-weight: var(--font-weight-medium);
    color: #2997ff;
  }

  @media (min-width: 48rem) {
    .home-cinema__eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.07em;
    }

    .home-cinema__title {
      font-size: clamp(1rem, 1.8vw, 1.35rem);
    }

    .home-cinema__cta {
      font-size: 0.8rem;
    }
  }

  .home-cinema__panel:hover .home-cinema__cta {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
