---
/**
 * Full-bleed category feature band - Mac / iPad style alternating tiles.
 */
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  href: string;
  ctaLabel?: string;
  imageSrc: string;
  imageSrcWebp?: string;
  imageAlt: string;
  /** Flip media to the left on desktop */
  reverse?: boolean;
  tone?: "light" | "dark";
}

const {
  eyebrow,
  title,
  body,
  href,
  ctaLabel = "Shop",
  imageSrc,
  imageSrcWebp,
  imageAlt,
  reverse = false,
  tone = "light",
} = Astro.props;
---

<section
  class:list={[
    "feature-band",
    `feature-band--${tone}`,
    { "feature-band--reverse": reverse },
    "fade-up",
  ]}
  data-fade-up
>
  <div class="feature-band__inner container">
    <div class="feature-band__copy">
      {eyebrow ? <p class="feature-band__eyebrow">{eyebrow}</p> : null}
      <h2>{title}</h2>
      <p class="feature-band__body">{body}</p>
      <a class:list={["btn", tone === "dark" ? "btn--inverse" : "btn--primary"]} href={href}>
        {ctaLabel}
      </a>
    </div>
    <div class="feature-band__media product-stage">
      <picture>
        {imageSrcWebp ? <source srcset={imageSrcWebp} type="image/webp" /> : null}
        <img src={imageSrc} alt={imageAlt} width="720" height="560" loading="lazy" decoding="async" />
      </picture>
    </div>
  </div>
</section>

<style>
  .feature-band {
    padding-block: var(--space-10);
  }

  .feature-band--light {
    background: var(--color-stage);
  }

  .feature-band--dark {
    background: var(--color-black);
    color: var(--color-white);
  }

  .feature-band__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .feature-band__inner {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-12);
    }

    .feature-band--reverse .feature-band__copy {
      order: 2;
    }

    .feature-band--reverse .feature-band__media {
      order: 1;
    }
  }

  .feature-band__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-grey);
  }

  .feature-band--dark .feature-band__eyebrow {
    color: var(--color-grey-400);
  }

  .feature-band__copy h2 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0 0 var(--space-3);
  }

  .feature-band__body {
    margin: 0 0 var(--space-6);
    max-width: 28rem;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  .feature-band--dark .feature-band__body {
    color: var(--color-grey-400);
  }

  .feature-band__media {
    border-radius: 0;
    overflow: hidden;
    aspect-ratio: 5 / 4;
  }

  .feature-band__media picture {
    display: contents;
  }

  .feature-band__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
