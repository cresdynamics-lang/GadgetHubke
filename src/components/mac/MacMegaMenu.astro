---
/**
 * Compact Mac nav flyout - featured Air/Pro picks + shop all.
 */
import {
  macModels,
  getMacImage,
  defaultMacColour,
  formatKes,
  type MacModel,
} from "../../lib/mac";

function previewFor(m: MacModel) {
  const colour = defaultMacColour(m);
  const img = getMacImage(m.id, colour, "product", m.name);
  return {
    id: m.id,
    name: m.name,
    href: `/mac/${m.id}`,
    priceKes: m.basePriceKes,
    priceLabel: formatKes(m.basePriceKes),
    src: img.src,
    alt: img.alt,
    isNew: Boolean(m.isNew),
  };
}

const featuredIds = [
  "macbook-air-13-m4",
  "macbook-air-15-m4",
  "macbook-pro-14-m4",
  "macbook-pro-16-m4-pro",
] as const;

const picks = featuredIds
  .map((id) => macModels.find((m) => m.id === id))
  .filter(Boolean)
  .map((m) => previewFor(m as MacModel));

const defaultPreview =
  picks[0] ||
  previewFor(macModels.find((m) => m.id === "macbook-air-13-m4") || macModels[0]);
const previews = Object.fromEntries(picks.map((p) => [p.id, p]));
---

<div class="mmega" data-mmega>
  <div class="mmega__cols">
    <div class="mmega__col">
      <p class="mmega__heading">Featured Mac</p>
      <ul>
        {
          picks.map((m) => (
            <li>
              <a class="mmega__link" href={m.href} data-mega-preview={m.id}>
                <span>
                  {m.name}
                  {m.isNew ? <span class="mmega__tag">New</span> : null}
                </span>
                <span class="mmega__from">from {formatKes(m.priceKes)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="mmega__all" href="/mac/shop">Shop all Mac</a>
    </div>

    <div class="mmega__col">
      <p class="mmega__heading">Explore</p>
      <ul>
        <li><a class="mmega__link" href="/mac">Mac overview</a></li>
        <li><a class="mmega__link" href="/mac/shop?family=Air">MacBook Air</a></li>
        <li><a class="mmega__link" href="/mac/shop?family=Pro">MacBook Pro</a></li>
        <li><a class="mmega__link" href="/mac/compare">Compare</a></li>
        <li><a class="mmega__link" href="/trade-in">Trade in</a></li>
        <li><a class="mmega__link" href="/lipa-mdogo-mdogo">Lipa Mdogo Mdogo</a></li>
      </ul>
    </div>

    <div class="mmega__preview" data-mega-card>
      <div class="mmega__stage">
        <img
          data-mega-img
          src={defaultPreview.src}
          alt={defaultPreview.alt}
          width="320"
          height="200"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="mmega__pname" data-mega-name>{defaultPreview.name}</p>
      <p class="mmega__pprice" data-mega-price>From {formatKes(defaultPreview.priceKes)}</p>
      <a class="btn btn--primary btn--sm" data-mega-view href={defaultPreview.href}>View</a>
    </div>
  </div>
</div>

<script define:vars={{ previews, defaultPreview }}>
  const root = document.querySelector("[data-mmega]");
  if (root) {
    const img = root.querySelector("[data-mega-img]");
    const name = root.querySelector("[data-mega-name]");
    const price = root.querySelector("[data-mega-price]");
    const view = root.querySelector("[data-mega-view]");

    function show(id) {
      const p = previews[id] || defaultPreview;
      if (img instanceof HTMLImageElement) {
        img.src = p.src;
        img.alt = p.alt;
      }
      if (name) name.textContent = p.name;
      if (price) price.textContent = `From ${p.priceLabel}`;
      if (view instanceof HTMLAnchorElement) view.href = p.href;
    }

    root.querySelectorAll("[data-mega-preview]").forEach((a) => {
      a.addEventListener("mouseenter", () => show(a.getAttribute("data-mega-preview")));
      a.addEventListener("focus", () => show(a.getAttribute("data-mega-preview")));
    });
  }
</script>

<style>
  .mmega {
    padding: 0.25rem 0 0.5rem;
  }
  .mmega__cols {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.25fr 0.9fr 0.85fr;
    align-items: start;
  }
  .mmega__heading {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6e6e73;
    font-weight: 600;
  }
  .mmega ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mmega__link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    text-decoration: none;
    color: #1d1d1f;
    font-size: 0.875rem;
  }
  .mmega__link:hover,
  .mmega__link:focus-visible {
    text-decoration: underline;
  }
  .mmega__from {
    color: #6e6e73;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .mmega__tag {
    margin-left: 0.35rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: #000;
    color: #fff;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
  }
  .mmega__all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1d1d1f;
  }
  .mmega__preview {
    background: #f5f5f7;
    border-radius: 1rem;
    padding: 0.85rem;
    color: #1d1d1f;
  }
  .mmega__stage {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    margin-bottom: 0.5rem;
  }
  .mmega__stage img {
    width: 92%;
    height: auto;
    object-fit: contain;
  }
  .mmega__pname {
    margin: 0;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
  }
  .mmega__pprice {
    margin: 0.25rem 0 0.65rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  @media (max-width: 63.749rem) {
    .mmega {
      display: none;
    }
  }
</style>
