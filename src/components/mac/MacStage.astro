---
/**
 * Wide 16:10 Mac product stage — #F5F5F7 + multiply on the image element.
 */
interface Props {
  src: string;
  srcWebp?: string;
  alt: string;
  class?: string;
  eager?: boolean;
  highPriority?: boolean;
  width?: number;
  height?: number;
}

const {
  src,
  srcWebp,
  alt,
  class: className = "",
  eager = false,
  highPriority = false,
  width = 1400,
  height = 875,
} = Astro.props;
---

<div class:list={["mstage", className]}>
  <picture>
    {srcWebp ? <source srcset={srcWebp} type="image/webp" /> : null}
    <img
      class="mstage__img"
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={highPriority ? "high" : "auto"}
    />
  </picture>
</div>

<style>
  .mstage {
    background: #f5f5f7;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 1.5rem;
    aspect-ratio: 16 / 10;
    color: #1d1d1f;
  }

  .mstage picture {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .mstage__img {
    width: 92%;
    height: auto;
    max-height: 94%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
</style>
