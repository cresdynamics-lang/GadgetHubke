---
/**
 * Customer reviews: list + fullscreen write sheet on tap → Post.
 * Persists via /api/reviews (admin Tools → Reviews).
 */
interface Props {
  productId: string;
  productName: string;
}

const { productId, productName } = Astro.props;
---

<section
  class="reviews"
  data-reviews
  data-product-id={productId}
  data-product-name={productName}
  aria-labelledby={`reviews-heading-${productId}`}
>
  <div class="reviews__head">
    <div>
      <h2 id={`reviews-heading-${productId}`}>Customer reviews</h2>
      <p class="reviews__lede" data-reviews-lede>What buyers say about {productName}.</p>
    </div>
    <div class="reviews__summary" data-reviews-summary hidden>
      <p class="reviews__avg" data-reviews-avg>0.0</p>
      <p class="reviews__stars" data-reviews-stars aria-hidden="true">★★★★★</p>
      <p class="reviews__count" data-reviews-count>0 reviews</p>
    </div>
  </div>

  <div class="reviews__toolbar">
    <button type="button" class="btn btn--primary" data-reviews-open>
      Write a review
    </button>
  </div>

  <div class="reviews__list-wrap">
    <p class="reviews__status" data-reviews-status>Loading reviews…</p>
    <ul class="reviews__list" data-reviews-list role="list"></ul>
  </div>

  <div
    class="reviews-sheet"
    data-reviews-sheet
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby={`reviews-sheet-title-${productId}`}
  >
    <div class="reviews-sheet__panel">
      <header class="reviews-sheet__head">
        <div>
          <p class="reviews-sheet__eyebrow">Review</p>
          <h3 id={`reviews-sheet-title-${productId}`}>Write a review</h3>
          <p class="reviews-sheet__product">{productName}</p>
        </div>
        <button type="button" class="reviews-sheet__close" data-reviews-close aria-label="Close review form">
          ×
        </button>
      </header>

      <form class="reviews-sheet__form" data-reviews-form novalidate>
        <label>
          <span>Your name</span>
          <input
            type="text"
            name="author"
            maxlength="40"
            required
            autocomplete="nickname"
            placeholder="e.g. Amina K."
          />
        </label>

        <label>
          <span>City (optional)</span>
          <input
            type="text"
            name="city"
            maxlength="40"
            autocomplete="address-level2"
            placeholder="Nairobi"
          />
        </label>

        <fieldset class="reviews__rating">
          <legend>Rating</legend>
          <div class="reviews__rating-row">
            {[5, 4, 3, 2, 1].map((n) => (
              <label>
                <input type="radio" name="rating" value={String(n)} required={n === 5} />
                <span>{n}★</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label>
          <span>Title (optional)</span>
          <input type="text" name="title" maxlength="80" placeholder="Short headline" />
        </label>

        <label>
          <span>Your review</span>
          <textarea
            name="body"
            rows="5"
            maxlength="800"
            required
            placeholder="How was the device, packaging, and pickup or delivery?"
          ></textarea>
        </label>

        <p class="reviews__form-error" data-reviews-error hidden></p>
        <p class="reviews__form-ok" data-reviews-ok hidden>Thanks - your review is live.</p>

        <div class="reviews-sheet__actions">
          <button type="button" class="btn btn--secondary" data-reviews-close>Cancel</button>
          <button type="submit" class="btn btn--primary" data-reviews-submit>Post review</button>
        </div>
        <p class="reviews__persist" data-reviews-persist hidden></p>
      </form>
    </div>
  </div>
</section>

<script>
  function stars(n) {
    const full = Math.round(n);
    return "★★★★★".slice(0, full) + "☆☆☆☆☆".slice(full);
  }

  function formatDate(iso) {
    try {
      return new Intl.DateTimeFormat("en-KE", {
        day: "numeric",
        month: "short",
        year: "numeric",
      }).format(new Date(iso));
    } catch {
      return "";
    }
  }

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  document.querySelectorAll("[data-reviews]").forEach((root) => {
    if (root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const productId = root.dataset.productId || "";
    const listEl = root.querySelector("[data-reviews-list]");
    const statusEl = root.querySelector("[data-reviews-status]");
    const summaryEl = root.querySelector("[data-reviews-summary]");
    const avgEl = root.querySelector("[data-reviews-avg]");
    const starsEl = root.querySelector("[data-reviews-stars]");
    const countEl = root.querySelector("[data-reviews-count]");
    const sheet = root.querySelector("[data-reviews-sheet]");
    const form = root.querySelector("[data-reviews-form]");
    const errorEl = root.querySelector("[data-reviews-error]");
    const okEl = root.querySelector("[data-reviews-ok]");
    const persistEl = root.querySelector("[data-reviews-persist]");
    const submitBtn = root.querySelector("[data-reviews-submit]");
    const openBtn = root.querySelector("[data-reviews-open]");

    function openSheet() {
      if (!sheet) return;
      sheet.hidden = false;
      document.documentElement.classList.add("reviews-sheet-open");
      document.body.style.overflow = "hidden";
      const first = form?.querySelector("input, textarea, button");
      if (first instanceof HTMLElement) first.focus();
    }

    function closeSheet() {
      if (!sheet) return;
      sheet.hidden = true;
      document.documentElement.classList.remove("reviews-sheet-open");
      document.body.style.overflow = "";
      errorEl?.setAttribute("hidden", "");
      okEl?.setAttribute("hidden", "");
    }

    openBtn?.addEventListener("click", openSheet);
    root.querySelectorAll("[data-reviews-close]").forEach((btn) => {
      btn.addEventListener("click", closeSheet);
    });
    sheet?.addEventListener("click", (e) => {
      if (e.target === sheet) closeSheet();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && sheet && !sheet.hidden) closeSheet();
    });

    function render(payload) {
      const { summary, reviews } = payload;
      if (summaryEl && avgEl && starsEl && countEl) {
        if (summary.count > 0) {
          summaryEl.removeAttribute("hidden");
          avgEl.textContent = summary.average.toFixed(1);
          starsEl.textContent = stars(summary.average);
          countEl.textContent = `${summary.count} review${summary.count === 1 ? "" : "s"}`;
        } else {
          summaryEl.setAttribute("hidden", "");
        }
      }

      if (listEl) {
        listEl.replaceChildren();
        if (reviews.length === 0) {
          if (statusEl) statusEl.textContent = "No reviews yet. Be the first to share yours.";
        } else if (statusEl) {
          statusEl.textContent = "";
        }
        for (const r of reviews) {
          const li = document.createElement("li");
          li.className = "reviews__item";
          li.innerHTML = `
            <div class="reviews__item-top">
              <strong>${escapeHtml(r.author)}</strong>
              <span class="reviews__item-stars" aria-label="${r.rating} out of 5">${stars(r.rating)}</span>
            </div>
            <p class="reviews__item-title">${escapeHtml(r.title)}</p>
            <p class="reviews__item-body">${escapeHtml(r.body)}</p>
            <p class="reviews__item-meta">${escapeHtml([r.city, formatDate(r.createdAt)].filter(Boolean).join(" · "))}</p>
          `;
          listEl.appendChild(li);
        }
      }

      if (persistEl && payload.persistence === "seed-only") {
        persistEl.hidden = false;
        persistEl.textContent =
          "Live posting needs store storage (Upstash). Ask the shop to connect reviews for production.";
      } else if (persistEl) {
        persistEl.hidden = true;
      }
    }

    async function load() {
      if (statusEl) statusEl.textContent = "Loading reviews…";
      try {
        const res = await fetch(`/api/reviews?productId=${encodeURIComponent(productId)}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Failed to load");
        render(data);
      } catch {
        if (statusEl) statusEl.textContent = "Could not load reviews right now.";
      }
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form) return;
      errorEl?.setAttribute("hidden", "");
      okEl?.setAttribute("hidden", "");
      const fd = new FormData(form);
      const payload = {
        productId,
        author: String(fd.get("author") || ""),
        city: String(fd.get("city") || ""),
        rating: Number(fd.get("rating")),
        title: String(fd.get("title") || ""),
        body: String(fd.get("body") || ""),
      };
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Posting…";
      }
      try {
        const res = await fetch("/api/reviews", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Could not post review");
        render(data);
        form.reset();
        okEl?.removeAttribute("hidden");
        window.setTimeout(() => closeSheet(), 900);
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : "Could not post review.";
          errorEl.removeAttribute("hidden");
        }
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Post review";
        }
      }
    });

    void load();
  });
</script>

<style>
  .reviews {
    margin: 3rem 0 1rem;
    padding: 2rem 0 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .reviews__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1rem;
  }
  .reviews__head h2 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    letter-spacing: -0.02em;
  }
  .reviews__lede {
    margin: 0;
    color: #6e6e73;
    font-size: 0.95rem;
  }
  .reviews__summary {
    text-align: right;
  }
  .reviews__avg {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .reviews__stars {
    margin: 0.2rem 0 0;
    color: #1d1d1f;
    letter-spacing: 0.08em;
  }
  .reviews__count {
    margin: 0.15rem 0 0;
    color: #6e6e73;
    font-size: 0.85rem;
  }
  .reviews__toolbar {
    margin-bottom: 1.25rem;
  }
  .reviews__status {
    margin: 0 0 0.75rem;
    color: #6e6e73;
    font-size: 0.9rem;
  }
  .reviews__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .reviews__item {
    background: #f5f5f7;
    border-radius: 1rem;
    padding: 1rem 1.1rem;
  }
  .reviews__item-top {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }
  .reviews__item-stars {
    letter-spacing: 0.06em;
    font-size: 0.9rem;
  }
  .reviews__item-title {
    margin: 0.4rem 0 0.25rem;
    font-weight: 600;
  }
  .reviews__item-body {
    margin: 0;
    color: #1d1d1f;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .reviews__item-meta {
    margin: 0.55rem 0 0;
    color: #6e6e73;
    font-size: 0.8rem;
  }

  .reviews-sheet {
    position: fixed;
    inset: 0;
    z-index: 120;
    background: rgb(0 0 0 / 0.45);
    display: grid;
    place-items: stretch;
    padding: 0;
  }
  .reviews-sheet[hidden] {
    display: none;
  }
  .reviews-sheet__panel {
    background: #fff;
    width: 100%;
    height: 100%;
    max-height: 100dvh;
    overflow: auto;
    display: flex;
    flex-direction: column;
    padding: max(1rem, env(safe-area-inset-top)) 1.15rem
      calc(1.25rem + env(safe-area-inset-bottom));
  }
  @media (min-width: 40rem) {
    .reviews-sheet {
      place-items: center;
      padding: 1.5rem;
    }
    .reviews-sheet__panel {
      width: min(34rem, 100%);
      height: auto;
      max-height: min(92dvh, 44rem);
      border-radius: 1.25rem;
      box-shadow: 0 24px 64px rgb(0 0 0 / 0.28);
    }
  }
  .reviews-sheet__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .reviews-sheet__eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6e6e73;
    font-weight: 600;
  }
  .reviews-sheet__head h3 {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .reviews-sheet__product {
    margin: 0.25rem 0 0;
    color: #6e6e73;
    font-size: 0.9rem;
  }
  .reviews-sheet__close {
    border: 0;
    background: #f5f5f7;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    color: #1d1d1f;
  }
  .reviews-sheet__form {
    display: grid;
    gap: 0.85rem;
    flex: 1;
  }
  .reviews-sheet__form label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: #1d1d1f;
  }
  .reviews-sheet__form input,
  .reviews-sheet__form textarea {
    font: inherit;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 0.65rem;
    padding: 0.65rem 0.75rem;
    background: #fff;
  }
  .reviews-sheet__form textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .reviews__rating {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .reviews__rating legend {
    font-size: 0.85rem;
    margin-bottom: 0.35rem;
  }
  .reviews__rating-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .reviews__rating-row label {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    cursor: pointer;
  }
  .reviews__rating-row input {
    margin: 0;
  }
  .reviews-sheet__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.35rem;
  }
  .reviews-sheet__actions :global(.btn) {
    flex: 1 1 auto;
    min-width: 7rem;
  }
  .reviews__form-error {
    margin: 0;
    color: #b42318;
    font-size: 0.85rem;
  }
  .reviews__form-ok {
    margin: 0;
    color: #0e9f6e;
    font-size: 0.85rem;
  }
  .reviews__persist {
    margin: 0;
    color: #6e6e73;
    font-size: 0.78rem;
  }
</style>
