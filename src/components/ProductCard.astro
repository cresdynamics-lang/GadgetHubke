---
/**
 * Blueprint product card: stage image, price + cart row, Details + WhatsApp row.
 * New and Ex-UK are separate cards with a top-left condition badge — no toggle.
 */
import Price from "./Price.astro";
import ConditionBadge from "./ConditionBadge.astro";
import { whatsappUrl } from "../lib/site";
import type { ListingChannel } from "../lib/listing-offers";

interface Props {
  id?: string;
  name: string;
  href: string;
  priceKes: number;
  image: { src: string; alt: string };
  blurb?: string;
  badge?: "New" | "Pre-order" | "Coming soon";
  channel?: ListingChannel;
  colors?: { id: string; label: string; hex: string; imageSrc?: string }[];
  /** Load image immediately (above-the-fold / first-screen cards). */
  eager?: boolean;
  /** Highest fetch priority — use for the first 1–2 LCP candidates only. */
  priority?: boolean;
}

const {
  id: productId,
  name,
  href,
  priceKes,
  image,
  blurb,
  badge,
  channel = "new",
  colors: allColors = [],
  eager = false,
  priority = false,
} = Astro.props;
const colors = allColors;
const displayImage = colors[0]?.imageSrc ? { src: colors[0].imageSrc, alt: `${name} in ${colors[0].label}` } : image;
const loadEager = eager || priority;
const liveId = productId || href.split("/").filter(Boolean).pop() || "";
const waBase = whatsappUrl();
const wa = whatsappUrl(`Hello Gadget Hub, I'm interested in the ${name}${channel === "ex-uk" ? " (Ex-UK)" : ""}.`);
const hoverSrc =
  colors.find((c) => c.imageSrc && c.imageSrc !== displayImage.src)?.imageSrc || "";
---

<article
  class="pcard"
  data-pcard
  data-channel={channel}
  data-price-new={priceKes}
  data-wa-base={waBase}
>
  <ConditionBadge channel={channel} class="pcard__badge" />
  {
    badge && badge !== "New" ? (
      <span class:list={["badge", "pcard__badge", "pcard__badge--extra", { "pcard__badge--soft": true }]}>
        {badge}
      </span>
    ) : null
  }
  <a class:list={["pcard__media", "product-stage", { "pcard__media--swap": Boolean(hoverSrc) }]} href={href}>
    <img
      data-pcard-img
      src={displayImage.src}
      alt={displayImage.alt}
      width="440"
      height="400"
      sizes="(max-width: 40rem) 46vw, 220px"
      loading={loadEager ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
    />
    {
      hoverSrc ? (
        <img
          class="pcard__img-alt"
          data-pcard-alt
          src={hoverSrc}
          alt=""
          width="440"
          height="400"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      ) : null
    }
  </a>
  <div class="pcard__body">
    <h3 class="pcard__name">
      <a href={href}>{name}</a>
    </h3>
    {blurb ? <p class="pcard__blurb">{blurb}</p> : null}
    {
      colors.length > 0 ? (
        <div class="pcard__colors" role="group" aria-label={`${name} finishes`}>
          {colors.map((c, i) => (
            <button
              type="button"
              class:list={["pcard__swatch", { "is-active": i === 0 }]}
              style={`--swatch: ${c.hex}`}
              aria-label={c.label}
              data-pcard-swatch
              data-src={c.imageSrc || image.src}
              data-alt={`${name} in ${c.label}`}
            />
          ))}
        </div>
      ) : null
    }
    <div class="pcard__row pcard__row--price">
      <p class="pcard__price" data-pcard-price data-live-price={liveId} data-live-field={channel === "ex-uk" ? "exUkKes" : "priceKes"} data-live-prefix="">
        <Price kes={priceKes} />
      </p>
      <a class="btn btn--secondary btn--xs" href={href}>Add to Cart</a>
    </div>
    <div class="pcard__row pcard__row--links">
      <a class="btn btn--primary btn--xs" href={href}>Details</a>
      <a class="btn btn--whatsapp btn--xs" href={wa} target="_blank" rel="noopener noreferrer" data-pcard-wa>
        WhatsApp
      </a>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll("[data-pcard]").forEach((card) => {
    if (card.getAttribute("data-pcard-bound") === "1") return;
    card.setAttribute("data-pcard-bound", "1");
    const img = card.querySelector("[data-pcard-img]");
    const altImg = card.querySelector("[data-pcard-alt]");
    const media = card.querySelector(".pcard__media");

    card.querySelectorAll("[data-pcard-swatch]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-src");
        const alt = btn.getAttribute("data-alt");
        if (img && src) {
          img.src = src;
          if (alt) img.alt = alt;
        }
        const other = Array.from(card.querySelectorAll("[data-pcard-swatch]")).find(
          (b) => b !== btn && b.getAttribute("data-src") && b.getAttribute("data-src") !== src,
        );
        const otherSrc = other?.getAttribute("data-src") || "";
        if (altImg && otherSrc) {
          altImg.src = otherSrc;
          media?.classList.add("pcard__media--swap");
        } else if (!otherSrc) {
          media?.classList.remove("pcard__media--swap");
        }
        card.querySelectorAll("[data-pcard-swatch]").forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
      });
    });
  });
</script>

<style>
  .pcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pcard__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
  }

  .pcard__badge--soft {
    background: var(--color-ink);
  }

  .pcard__badge--extra {
    left: auto;
    right: var(--space-3);
  }

  .pcard__media {
    position: relative;
    aspect-ratio: 1.1 / 1;
    margin-bottom: var(--space-4);
    text-decoration: none;
    display: block;
  }

  .pcard__media img {
    padding: var(--space-5);
    transition: opacity 0.35s ease;
  }

  .pcard__img-alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
  }

  .pcard__media--swap:hover [data-pcard-img] {
    opacity: 0;
  }

  .pcard__media--swap:hover .pcard__img-alt {
    opacity: 1;
  }

  .pcard__name {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-display);
    margin-bottom: var(--space-1);
  }

  .pcard__name a {
    text-decoration: none;
  }

  .pcard__blurb {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin-bottom: var(--space-3);
  }

  .pcard__colors {
    display: flex;
    gap: 0.4rem;
    margin-bottom: var(--space-3);
  }

  .pcard__swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: var(--swatch, #ccc);
    cursor: pointer;
    padding: 0;
  }

  .pcard__swatch.is-active {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  .pcard__row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
  }

  .pcard__row--links {
    margin-top: 0.4rem;
  }

  .pcard__price {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-size: 0.85rem;
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pcard__row .btn {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    white-space: nowrap;
  }

  .pcard__row--price .btn {
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard__media img {
      transition: none;
    }
    .pcard__media--swap:hover [data-pcard-img] {
      opacity: 1;
    }
    .pcard__media--swap:hover .pcard__img-alt {
      opacity: 0;
    }
  }

  /* Price and Add to cart never touch: smaller type on narrow cards, and the
     button drops under the price when the card is too narrow for both. */
  .pcard__row--price {
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 0.5rem;
    row-gap: 0.4rem;
  }
  .pcard__row--price .pcard__price,
  .pcard__row--price .pcard__price * {
    font-size: clamp(0.74rem, 2.9vw, 0.85rem);
  }
  .pcard__row--price :global(.btn) {
    flex: 0 0 auto;
    font-size: clamp(0.66rem, 2.6vw, 0.75rem);
    padding: 0.28rem 0.55rem;
    min-height: 1.75rem;
  }
</style>
