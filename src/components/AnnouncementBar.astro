---
/**
 * Rotating announcement bar - dismissible; sticky nav sits below.
 */
import { iphoneConfig } from "../lib/iphone/config";

const lines = [
  { text: iphoneConfig.announce, href: "/iphone" },
  { text: "Lipa Mdogo Mdogo available.", href: "/lipa-mdogo-mdogo" },
  { text: "Trade in your old phone.", href: "/trade-in" },
] as const;
---

<div class="announce" data-announce role="region" aria-label="Announcements">
  <div class="announce__inner container">
    <p class="announce__line" data-announce-line>
      <a href={lines[0].href}>{lines[0].text}</a>
    </p>
    <button type="button" class="announce__close" data-announce-close aria-label="Dismiss announcements">
      <span aria-hidden="true">×</span>
    </button>
  </div>
</div>

<script define:vars={{ lines }}>
  const root = document.querySelector("[data-announce]");
  if (root) {
    const KEY = "gh-announce-dismissed";
    if (sessionStorage.getItem(KEY) === "1") {
      root.hidden = true;
      document.documentElement.classList.add("announce-dismissed");
    } else {
      const lineEl = root.querySelector("[data-announce-line]");
      let i = 0;
      if (lineEl && lines.length > 1) {
        window.setInterval(() => {
          i = (i + 1) % lines.length;
          const item = lines[i];
          lineEl.innerHTML = `<a href="${item.href}">${item.text}</a>`;
        }, 4500);
      }
      root.querySelector("[data-announce-close]")?.addEventListener("click", () => {
        root.hidden = true;
        sessionStorage.setItem(KEY, "1");
        document.documentElement.classList.add("announce-dismissed");
      });
    }
  }
</script>

<style>
  .announce {
    background: var(--color-black);
    color: var(--color-white);
    min-height: var(--announce-height);
    display: flex;
    align-items: center;
    font-size: var(--text-xs);
    letter-spacing: 0.01em;
  }

  .announce[hidden] {
    display: none;
  }

  .announce__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: min(100% - 1.5rem, var(--container-wide));
    margin-inline: auto;
    position: relative;
    padding-block: 0.45rem;
  }

  .announce__line {
    margin: 0;
    text-align: center;
    flex: 1;
  }

  .announce__line a {
    color: inherit;
    text-decoration: none;
  }

  .announce__line a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .announce__close {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 1.15rem;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    opacity: 0.7;
  }

  .announce__close:hover {
    opacity: 1;
  }
</style>
