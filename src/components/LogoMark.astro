---
/**
 * Interlocking GH monogram - matches logo: solid G overlapping outlined H.
 * Strict black/white; use `inverse` on dark surfaces.
 */
interface Props {
  class?: string;
  inverse?: boolean;
  size?: number;
}

const { class: className = "", inverse = false, size = 36 } = Astro.props;
const fill = inverse ? "#FFFFFF" : "#0A0A0A";
---

<svg
  class:list={["logo-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <!-- Outlined H (behind / right) -->
  <path
    d="M34 14h6.5v14H52v6.5H40.5V50H34V14Zm18 0h6.5v36H52V14Z"
    stroke={fill}
    stroke-width="3.25"
    stroke-linejoin="round"
    fill="none"
  />
  <!-- Solid G (front / left), overlaps H -->
  <path
    fill={fill}
    d="M28.5 10C17.2 10 9 18.4 9 30.5S17.2 51 28.5 51c7.4 0 13.2-3.4 16.2-8.8l-5.4-3.2c-1.9 3.2-5.5 5.2-10.8 5.2-7.6 0-12.8-5.4-12.8-13.7S20.9 16.8 28.5 16.8c5.6 0 9.4 2.4 11.2 6.2h-9.6V29h17.4c.2-1 .3-2.1.3-3.3C47.8 15.6 39.4 10 28.5 10Z"
  />
</svg>
