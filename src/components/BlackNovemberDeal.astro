---
/**
 * Framed Black November deal: 4 devices, then welcome — auto-closes.
 * Pops after 5s on first landing per session; dismiss with X anytime.
 */
const slides = [
  {
    id: "iphone",
    title: "iPhone 17",
    sub: "ProMotion · A19 · from KSh 120,000",
    href: "/iphone/iphone-17",
    src: "/Gadget_Hub_iPhone_Apple_Store_Images/iphone-17/iphone-17_lavender_view1.webp",
    alt: "iPhone 17 in Lavender",
  },
  {
    id: "ipad",
    title: "iPad (A16)",
    sub: "Everyday iPad · from KSh 64,000",
    href: "/ipad/ipad-a16",
    src: "/Gadget_Hub_Store_Angles/ipad-a16/pink-1.webp",
    alt: "iPad A16 in Pink",
  },
  {
    id: "pro-max",
    title: "iPhone 18 Pro Max",
    sub: "Biggest Pro · A20 Pro · from KSh 218,000",
    href: "/iphone/iphone-18-pro-max",
    src: "/Gadget_Hub_iPhone_Apple_Store_Images/iphone-18-pro-max/iphone-18-pro-max_black_view1.webp",
    alt: "iPhone 18 Pro Max",
  },
  {
    id: "mac",
    title: "MacBook Air 13″ M4",
    sub: "Thin. Fast. All day. · from KSh 148,000",
    href: "/mac/macbook-air-13-m4",
    src: "/Gadget_Hub_Store_Angles/macbook-air-13-m4/sky-blue-1.webp",
    alt: "MacBook Air 13 M4 in Sky Blue",
  },
] as const;
---

<dialog class="bn-deal" data-bn-deal aria-label="Black November deals at Gadget Hub">
  <div class="bn-deal__frame">
    <button type="button" class="bn-deal__close" data-bn-close aria-label="Close deal">
      <span aria-hidden="true">×</span>
    </button>

    <p class="bn-deal__eyebrow">Black November at Gadget Hub</p>

    <div class="bn-deal__slides" data-bn-slides>
      {
        slides.map((s, i) => (
          <article
            class:list={["bn-deal__slide", { "is-active": i === 0 }]}
            data-bn-slide
            data-href={s.href}
            hidden={i !== 0}
          >
            <div class="bn-deal__media">
              <img src={s.src} alt={s.alt} width="900" height="900" decoding="async" />
            </div>
            <h2 class="bn-deal__title">{s.title}</h2>
            <p class="bn-deal__sub">{s.sub}</p>
            <a class="bn-deal__cta" href={s.href} data-bn-cta>
              View deal
            </a>
          </article>
        ))
      }

      <article class="bn-deal__slide bn-deal__slide--welcome" data-bn-slide data-bn-welcome hidden>
        <p class="bn-deal__welcome-kicker">You’re in</p>
        <h2 class="bn-deal__title">Welcome to Gadget Hub</h2>
        <p class="bn-deal__sub">
          Sealed Apple devices in Nairobi — New or Ex-UK. Pay by M-Pesa or Lipa Mdogo Mdogo.
        </p>
        <a class="bn-deal__cta" href="/iphone" data-bn-cta>Shop now</a>
      </article>
    </div>

    <div class="bn-deal__dots" data-bn-dots aria-hidden="true">
      {slides.map((_, i) => <span class:list={["bn-deal__dot", { "is-active": i === 0 }]} data-bn-dot />)}
      <span class="bn-deal__dot" data-bn-dot data-bn-dot-welcome></span>
    </div>
  </div>
</dialog>

<script>
  const KEY = "gh-bn-deals-2025-v2";
  const DELAY_MS = 5000;
  const SLIDE_MS = 1800;
  const WELCOME_MS = 2200;
  const path = window.location.pathname || "";
  const skip =
    path.startsWith("/admin") ||
    path.startsWith("/management") ||
    path.startsWith("/checkout");

  const dialog = document.querySelector("[data-bn-deal]");
  if (!(dialog instanceof HTMLDialogElement) || skip) {
    dialog?.remove();
  } else if (typeof sessionStorage !== "undefined" && sessionStorage.getItem(KEY) === "1") {
    dialog.remove();
  } else {
    const closeBtn = dialog.querySelector("[data-bn-close]");
    const slides = [...dialog.querySelectorAll("[data-bn-slide]")];
    const dots = [...dialog.querySelectorAll("[data-bn-dot]")];
    let opened = false;
    /** @type {number[]} */
    let timers = [];
    let index = 0;

    function markSeen() {
      try {
        sessionStorage.setItem(KEY, "1");
      } catch {
        /* private mode */
      }
    }

    function clearTimers() {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
    }

    function showSlide(i: number) {
      index = i;
      slides.forEach((slide, n) => {
        if (!(slide instanceof HTMLElement)) return;
        const on = n === i;
        slide.hidden = !on;
        slide.classList.toggle("is-active", on);
      });
      dots.forEach((dot, n) => {
        dot.classList.toggle("is-active", n === i);
      });
    }

    function closeDeal() {
      clearTimers();
      dialog.close();
      markSeen();
    }

    function scheduleRun() {
      clearTimers();
      // 4 device slides, then welcome, then auto-close.
      const deviceCount = slides.length - 1;
      for (let i = 1; i < deviceCount; i++) {
        timers.push(window.setTimeout(() => showSlide(i), SLIDE_MS * i));
      }
      timers.push(
        window.setTimeout(() => showSlide(deviceCount), SLIDE_MS * deviceCount),
      );
      timers.push(
        window.setTimeout(closeDeal, SLIDE_MS * deviceCount + WELCOME_MS),
      );
    }

    function openDeal() {
      if (opened) return;
      opened = true;
      showSlide(0);
      dialog.showModal();
      document.documentElement.classList.add("bn-deal-open");
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        // Show welcome quickly, then close.
        timers.push(window.setTimeout(() => showSlide(slides.length - 1), 800));
        timers.push(window.setTimeout(closeDeal, 800 + WELCOME_MS));
        return;
      }
      scheduleRun();
    }

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("bn-deal-open");
      clearTimers();
      markSeen();
    });

    closeBtn?.addEventListener("click", closeDeal);
    dialog.querySelectorAll("[data-bn-cta]").forEach((cta) => {
      cta.addEventListener("click", () => markSeen());
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeDeal();
    });
    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeDeal();
    });

    window.setTimeout(openDeal, DELAY_MS);
  }
</script>

<style>
  .bn-deal {
    border: none;
    padding: 0;
    margin: auto;
    width: min(calc(100vw - 1.5rem), 26rem);
    max-width: calc(100vw - 1.5rem);
    max-height: min(92dvh, 40rem);
    background: transparent;
    color: #f5f5f7;
    overflow: visible;
  }

  .bn-deal::backdrop {
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(4px);
  }

  .bn-deal__frame {
    position: relative;
    display: grid;
    gap: 0.65rem;
    padding: 1.1rem 1rem 1rem;
    border-radius: 1.25rem;
    background: linear-gradient(165deg, #1c1c1e 0%, #0c0c0d 55%, #14110c 100%);
    border: 1px solid rgba(245, 166, 35, 0.35);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04) inset,
      0 22px 60px rgba(0, 0, 0, 0.45);
  }

  .bn-deal__close {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    z-index: 3;
    width: 2.15rem;
    height: 2.15rem;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .bn-deal__close:hover {
    background: rgba(255, 255, 255, 0.24);
  }

  .bn-deal__eyebrow {
    margin: 0.15rem 2.2rem 0 0;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5a623;
  }

  .bn-deal__slides {
    position: relative;
    min-height: 22rem;
  }

  .bn-deal__slide {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.35rem;
    animation: bn-in 0.35s ease both;
  }

  .bn-deal__slide[hidden] {
    display: none;
  }

  .bn-deal__media {
    width: min(100%, 16.5rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    background: #f5f5f7;
    overflow: hidden;
  }

  .bn-deal__media img {
    width: 86%;
    height: auto;
    max-height: 90%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .bn-deal__title {
    margin: 0.35rem 0 0;
    font-size: clamp(1.2rem, 4.5vw, 1.55rem);
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .bn-deal__sub {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: rgba(245, 245, 247, 0.72);
    max-width: 22rem;
  }

  .bn-deal__cta {
    margin-top: 0.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.45rem;
    padding: 0.55rem 1.2rem;
    border-radius: 999px;
    background: #f5a623;
    color: #111;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
  }

  .bn-deal__cta:hover {
    filter: brightness(1.06);
  }

  .bn-deal__slide--welcome {
    place-content: center;
    min-height: 22rem;
    padding: 1rem 0.5rem;
  }

  .bn-deal__welcome-kicker {
    margin: 0;
    font-size: 0.78rem;
    color: rgba(245, 245, 247, 0.55);
  }

  .bn-deal__dots {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    padding-top: 0.15rem;
  }

  .bn-deal__dot {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
  }

  .bn-deal__dot.is-active {
    background: #f5a623;
    width: 0.9rem;
  }

  @keyframes bn-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bn-deal__slide {
      animation: none;
    }
  }

  @media (min-width: 40rem) {
    .bn-deal {
      width: min(92vw, 28rem);
    }

    .bn-deal__frame {
      padding: 1.25rem 1.2rem 1.1rem;
    }

    .bn-deal__media {
      width: 17.5rem;
    }
  }
</style>
