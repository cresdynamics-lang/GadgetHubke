---
/**
 * Compact iPad nav flyout - featured picks + shop all.
 */
import {
  ipadModels,
  getIpadImage,
  defaultIpadColour,
  formatKes,
  type IpadModel,
} from "../../lib/ipad";

function previewFor(m: IpadModel) {
  const colour = defaultIpadColour(m);
  const img = getIpadImage(m.id, colour, "product", m.name);
  return {
    id: m.id,
    name: m.name,
    href: `/ipad/${m.id}`,
    priceKes: m.basePriceKes,
    priceLabel: formatKes(m.basePriceKes),
    src: img.src,
    alt: img.alt,
    isNew: Boolean(m.isNew),
  };
}

const featuredIds = [
  "ipad-pro-11-m4",
  "ipad-air-11-m2",
  "ipad-mini-a17-pro",
  "ipad-a16",
] as const;

const featured = featuredIds
  .map((id) => ipadModels.find((m) => m.id === id))
  .filter(Boolean)
  .map((m) => previewFor(m as IpadModel));

const fallback = previewFor(
  ipadModels.find((m) => m.id === "ipad-air-11-m2") || ipadModels[0],
);
const picks = featured.length ? featured : [fallback];
const defaultPreview = picks[0];
const previews = Object.fromEntries(picks.map((p) => [p.id, p]));
---

<div class="imega" data-imega>
  <div class="imega__cols">
    <div class="imega__col">
      <p class="imega__heading">Featured iPad</p>
      <ul>
        {
          picks.map((m) => (
            <li>
              <a class="imega__link" href={m.href} data-mega-preview={m.id}>
                <span>
                  {m.name}
                  {m.isNew ? <span class="imega__tag">New</span> : null}
                </span>
                <span class="imega__from">from {formatKes(m.priceKes)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="imega__all" href="/ipad/shop">Shop all iPad</a>
    </div>

    <div class="imega__col">
      <p class="imega__heading">Explore</p>
      <ul>
        <li><a class="imega__link" href="/ipad">iPad overview</a></li>
        <li><a class="imega__link" href="/ipad/compare">Compare</a></li>
        <li><a class="imega__link" href="/accessories/apple-pencil">Apple Pencil</a></li>
        <li><a class="imega__link" href="/trade-in">Trade in</a></li>
        <li><a class="imega__link" href="/lipa-mdogo-mdogo">Lipa Mdogo Mdogo</a></li>
      </ul>
    </div>

    <div class="imega__preview" data-mega-card>
      <div class="imega__stage">
        <img
          data-mega-img
          src={defaultPreview.src}
          alt={defaultPreview.alt}
          width="280"
          height="280"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="imega__pname" data-mega-name>{defaultPreview.name}</p>
      <p class="imega__pprice" data-mega-price>From {formatKes(defaultPreview.priceKes)}</p>
      <a class="btn btn--primary btn--sm" data-mega-view href={defaultPreview.href}>View</a>
    </div>
  </div>
</div>

<script define:vars={{ previews, defaultPreview }}>
  const root = document.querySelector("[data-imega]");
  if (root) {
    const img = root.querySelector("[data-mega-img]");
    const name = root.querySelector("[data-mega-name]");
    const price = root.querySelector("[data-mega-price]");
    const view = root.querySelector("[data-mega-view]");

    function show(id) {
      const p = previews[id] || defaultPreview;
      if (img instanceof HTMLImageElement) {
        img.src = p.src;
        img.alt = p.alt;
      }
      if (name) name.textContent = p.name;
      if (price) price.textContent = `From ${p.priceLabel}`;
      if (view instanceof HTMLAnchorElement) view.href = p.href;
    }

    root.querySelectorAll("[data-mega-preview]").forEach((a) => {
      a.addEventListener("mouseenter", () => show(a.getAttribute("data-mega-preview")));
      a.addEventListener("focus", () => show(a.getAttribute("data-mega-preview")));
    });
  }
</script>

<style>
  .imega {
    padding: 0.25rem 0 0.5rem;
  }
  .imega__cols {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.2fr 0.9fr 0.85fr;
    align-items: start;
  }
  .imega__heading {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    font-weight: 600;
  }
  .imega ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .imega__link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    text-decoration: none;
    color: var(--color-fg);
    font-size: var(--text-sm);
  }
  .imega__link:hover,
  .imega__link:focus-visible {
    text-decoration: underline;
  }
  .imega__from {
    color: var(--color-fg-muted);
    white-space: nowrap;
  }
  .imega__tag {
    margin-left: 0.35rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--color-black);
    color: var(--color-white);
    border-radius: 999px;
    padding: 0.1rem 0.35rem;
  }
  .imega__all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg);
  }
  .imega__preview {
    background: var(--color-stage);
    border-radius: var(--radius-lg);
    padding: 0.85rem;
  }
  .imega__stage {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }
  .imega__stage img {
    width: 78%;
    height: auto;
    object-fit: contain;
  }
  .imega__pname {
    margin: 0;
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: -0.02em;
  }
  .imega__pprice {
    margin: 0.25rem 0 0.65rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  @media (max-width: 63.749rem) {
    .imega {
      display: none;
    }
  }
</style>
