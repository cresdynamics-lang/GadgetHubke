---
/**
 * Trade-In estimator with iPad + iPhone + Mac lists.
 */
import { ipadModels, formatKes, tradeInEstimate, ipadConfig } from "../../lib/ipad";
import { macModels } from "../../lib/mac";
import { models as iphoneModels } from "../../lib/iphone";

interface Props {
  modelId?: string;
}

const { modelId } = Astro.props;
const ipadOpts = ipadModels.map((m) => ({ id: m.id, name: m.name, base: m.basePriceKes }));
const macOpts = macModels.map((m) => ({ id: m.id, name: m.name, base: m.basePriceKes }));
const phoneOpts = iphoneModels.map((m) => ({ id: m.id, name: m.name, base: m.basePriceKes }));
const initial = ipadOpts.find((o) => o.id === modelId) || ipadOpts[0];
const start = tradeInEstimate(initial.base, "good");
const waPhone = ipadConfig.whatsapp;
const pct = ipadConfig.tradeIn.conditionPct;
---

<section class="ipad-trade" data-ipad-trade>
  <header>
    <h3>Trade-In estimator</h3>
    <p>{ipadConfig.tradeIn.note}</p>
  </header>
  <label>
    Your current device
    <select data-trade-model>
      <optgroup label="iPad">
        {ipadOpts.map((o) => (
          <option value={o.id} data-base={o.base} selected={o.id === initial.id}>
            {o.name}
          </option>
        ))}
      </optgroup>
      <optgroup label="iPhone">
        {phoneOpts.map((o) => (
          <option value={o.id} data-base={o.base}>
            {o.name}
          </option>
        ))}
      </optgroup>
      <optgroup label="MacBook">
        {macOpts.map((o) => (
          <option value={o.id} data-base={o.base}>
            {o.name}
          </option>
        ))}
      </optgroup>
    </select>
  </label>
  <div class="ipad-trade__cond" role="group" aria-label="Condition">
    <button type="button" data-cond="likeNew" data-pct={pct.likeNew}>Like new</button>
    <button type="button" class="is-active" data-cond="good" data-pct={pct.good}>Good</button>
    <button type="button" data-cond="worn" data-pct={pct.worn}>Worn</button>
  </div>
  <p class="ipad-trade__estimate">
    About <strong data-trade-value>{formatKes(start)}</strong>
  </p>
  <a
    class="btn btn--secondary btn--sm"
    data-trade-wa
    href={`https://wa.me/${waPhone}?text=${encodeURIComponent(`Hi Gadget Hub - trade-in estimate for ${initial.name}: about ${formatKes(start)} (indicative).`)}`}
    target="_blank"
    rel="noopener noreferrer"
  >
    Send estimate on WhatsApp
  </a>
</section>

<script define:vars={{ waPhone }}>
  document.querySelectorAll("[data-ipad-trade]").forEach((root) => {
    const model = root.querySelector("[data-trade-model]");
    const valueEl = root.querySelector("[data-trade-value]");
    const wa = root.querySelector("[data-trade-wa]");
    let pctVal = 33;

    function round500(n) {
      return Math.round(n / 500) * 500;
    }

    function run() {
      if (!(model instanceof HTMLSelectElement)) return;
      const opt = model.selectedOptions[0];
      const base = Number(opt?.getAttribute("data-base") || 0);
      const value = round500((base * pctVal) / 100);
      if (valueEl) valueEl.textContent = `KES ${value.toLocaleString("en-KE")}`;
      if (wa instanceof HTMLAnchorElement) {
        wa.href = `https://wa.me/${waPhone}?text=${encodeURIComponent(
          `Hi Gadget Hub - trade-in estimate for ${opt?.textContent?.trim()}: about KES ${value.toLocaleString("en-KE")} (indicative).`,
        )}`;
      }
    }

    model?.addEventListener("change", run);
    root.querySelectorAll("[data-cond]").forEach((btn) => {
      btn.addEventListener("click", () => {
        root.querySelectorAll("[data-cond]").forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        pctVal = Number(btn.getAttribute("data-pct") || 33);
        run();
      });
    });
  });
</script>

<style>
  .ipad-trade {
    border: 1px solid var(--color-border);
    border-radius: var(--ipad-radius);
    padding: 1rem;
  }
  .ipad-trade header h3 { margin: 0 0 0.25rem; }
  .ipad-trade header p { margin: 0 0 1rem; font-size: var(--text-sm); color: var(--color-fg-muted); }
  .ipad-trade label { display: grid; gap: 0.35rem; margin-bottom: 0.85rem; font-size: var(--text-sm); font-weight: 600; }
  .ipad-trade select { width: 100%; font: inherit; padding: 0.5rem; border-radius: 0.5rem; border: 1px solid var(--color-border); }
  .ipad-trade__cond { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.85rem; }
  .ipad-trade__cond button {
    border: 1px solid var(--color-border); background: var(--color-bg); border-radius: 999px;
    padding: 0.35rem 0.7rem; font: inherit; font-size: var(--text-sm); cursor: pointer;
  }
  .ipad-trade__cond button.is-active { background: #000; color: #fff; }
  .ipad-trade__estimate { margin: 0 0 0.85rem; }
</style>
