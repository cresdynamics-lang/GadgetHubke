---
/**
 * TV & Home stage on #F5F5F7. Multiply on the <img> only.
 * square: speakers; wide 4:3 for Apple TV.
 */
interface Props {
  src: string;
  srcWebp?: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  class?: string;
  square?: boolean;
}

const {
  src,
  srcWebp,
  alt,
  width = 1400,
  height = 1400,
  priority = false,
  class: className,
  square = true,
} = Astro.props;
---

<div class:list={["thstage", className, { "thstage--wide": !square }]}>
  <picture>
    {srcWebp ? <source srcset={srcWebp} type="image/webp" /> : null}
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </picture>
</div>

<style>
  .thstage {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #f5f5f7;
    border-radius: var(--tv-home-radius, 1.5rem);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .thstage--wide {
    aspect-ratio: 4 / 3;
  }
  .thstage img {
    width: 88%;
    height: auto;
    max-height: 92%;
    object-fit: contain;
    mix-blend-mode: multiply;
    display: block;
  }
</style>
