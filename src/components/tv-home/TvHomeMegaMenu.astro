---
/**
 * Compact TV & Home nav flyout - featured picks + shop all.
 */
import {
  tvHomeModels,
  getTvHomeModel,
  getTvHomeImage,
  formatKes,
  type TvHomeModel,
} from "../../lib/tv-home";

function previewFor(m: TvHomeModel) {
  const img = getTvHomeImage(m.id, "hero", m.name);
  return {
    id: m.id,
    name: m.name,
    href: `/tv-home/${m.id}`,
    priceKes: m.basePriceKes,
    priceLabel: formatKes(m.basePriceKes),
    src: img.src,
    alt: img.alt,
    isNew: Boolean(m.isNew),
  };
}

const featuredIds = ["apple-tv-4k-3", "homepod-2", "homepod-mini"] as const;
const picks = featuredIds
  .map((id) => getTvHomeModel(id))
  .filter(Boolean)
  .map((m) => previewFor(m as TvHomeModel));

const defaultPreview =
  picks[0] || previewFor(getTvHomeModel("apple-tv-4k-3") || tvHomeModels[0]);
const previews = Object.fromEntries(picks.map((p) => [p.id, p]));
---

<div class="thmega" data-thmega>
  <div class="thmega__cols">
    <div class="thmega__col">
      <p class="thmega__heading">Featured</p>
      <ul>
        {
          picks.map((m) => (
            <li>
              <a class="thmega__link" href={m.href} data-mega-preview={m.id}>
                <span>
                  {m.name}
                  {m.isNew ? <span class="thmega__tag">New</span> : null}
                </span>
                <em>from {m.priceLabel}</em>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="thmega__all" href="/tv-home/shop">Shop all TV &amp; Home</a>
    </div>

    <div class="thmega__col">
      <p class="thmega__heading">Explore</p>
      <ul>
        <li><a class="thmega__link" href="/tv-home">TV &amp; Home overview</a></li>
        <li><a class="thmega__link" href="/tv-home/compare">Compare</a></li>
        <li><a class="thmega__link" href="/trade-in">Trade in</a></li>
        <li><a class="thmega__link" href="/lipa-mdogo-mdogo">Lipa Mdogo Mdogo</a></li>
      </ul>
    </div>

    <div class="thmega__preview" data-mega-card>
      <div class="thmega__stage">
        <img
          data-mega-img
          src={defaultPreview.src}
          alt={defaultPreview.alt}
          width="240"
          height="240"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p data-mega-name class="thmega__pname">{defaultPreview.name}</p>
      <p data-mega-price class="thmega__pprice">
        <strong>From {defaultPreview.priceLabel}</strong>
      </p>
      <a class="btn btn--primary btn--sm" data-mega-view href={defaultPreview.href}>View</a>
    </div>
  </div>
</div>

<script define:vars={{ previews, defaultPreview }}>
  const root = document.querySelector("[data-thmega]");
  if (root) {
    const img = root.querySelector("[data-mega-img]");
    const name = root.querySelector("[data-mega-name]");
    const price = root.querySelector("[data-mega-price]");
    const view = root.querySelector("[data-mega-view]");

    function show(id) {
      const p = previews[id] || defaultPreview;
      if (img instanceof HTMLImageElement) {
        img.src = p.src;
        img.alt = p.alt;
      }
      if (name) name.textContent = p.name;
      if (price) price.innerHTML = `<strong>From ${p.priceLabel}</strong>`;
      if (view instanceof HTMLAnchorElement) view.href = p.href;
    }

    root.querySelectorAll("[data-mega-preview]").forEach((a) => {
      a.addEventListener("mouseenter", () => show(a.getAttribute("data-mega-preview")));
      a.addEventListener("focus", () => show(a.getAttribute("data-mega-preview")));
    });
  }
</script>

<style>
  .thmega {
    padding: 0.25rem 0 0.5rem;
  }
  .thmega__cols {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.2fr 0.9fr 0.85fr;
    align-items: start;
  }
  .thmega__heading {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6e6e73;
    font-weight: 600;
  }
  .thmega ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .thmega__link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    text-decoration: none;
    color: var(--color-fg);
    font-size: var(--text-sm);
  }
  .thmega__link:hover,
  .thmega__link:focus-visible {
    text-decoration: underline;
  }
  .thmega__link em {
    font-style: normal;
    color: #6e6e73;
    white-space: nowrap;
  }
  .thmega__tag {
    margin-left: 0.35rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    background: #000;
    color: #fff;
    border-radius: 999px;
    padding: 0.1rem 0.35rem;
  }
  .thmega__all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg);
  }
  .thmega__preview {
    background: #f5f5f7;
    border-radius: 1rem;
    padding: 0.85rem;
  }
  .thmega__stage {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin-bottom: 0.5rem;
  }
  .thmega__stage img {
    width: 72%;
    height: auto;
    object-fit: contain;
  }
  .thmega__pname {
    margin: 0;
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .thmega__pprice {
    margin: 0.25rem 0 0.65rem;
    font-size: var(--text-sm);
  }
  @media (max-width: 63.749rem) {
    .thmega {
      display: none;
    }
  }
</style>
