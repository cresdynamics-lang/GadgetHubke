---
import { tvHomeModels, formatKes, lipaMonthly, tvHomeConfig } from "../../lib/tv-home";

interface Props { modelId?: string; }
const { modelId } = Astro.props;
const options = tvHomeModels.map((m) => ({ id: m.id, name: m.name, base: m.basePriceKes }));
const initial = options.find((o) => o.id === modelId) || options[0];
const cfg = tvHomeConfig.lipa;
const start = lipaMonthly(initial.base, cfg.depositDefaultPct, cfg.monthsDefault);
---

<section class="tvhome-lipa" data-tvhome-lipa>
  <header>
    <h3>Lipa Mdogo Mdogo</h3>
    <p>{cfg.note}</p>
  </header>
  <label>
    Model
    <select data-tvhome-lipa-model>
      {options.map((o) => (
        <option value={o.id} data-base={o.base} selected={o.id === initial.id}>{o.name}</option>
      ))}
    </select>
  </label>
  <label>
    Deposit <span data-tvhome-lipa-dep-label>{cfg.depositDefaultPct}%</span>
    <input type="range" min={cfg.depositMinPct} max={cfg.depositMaxPct} step={cfg.depositStepPct} value={cfg.depositDefaultPct} data-tvhome-lipa-deposit />
    <span class="tvhome-lipa__hint">Minimum deposit is {cfg.depositMinPct}%.</span>
  </label>
  <div class="tvhome-lipa__months" role="group" aria-label="Months">
    {cfg.monthOptions.map((m) => (
      <button type="button" class:list={{ "is-active": m === cfg.monthsDefault }} data-tvhome-lipa-months={m}>{m} mo</button>
    ))}
  </div>
  <div class="tvhome-lipa__result">
    <p><span data-tvhome-lipa-monthly>{formatKes(start.monthlyKes)}</span> <small>/ month</small></p>
    <p data-tvhome-lipa-line>{formatKes(start.depositKes)} deposit · {start.months} payments · sample total {formatKes(initial.base)}</p>
  </div>
</section>

<script>
  document.querySelectorAll("[data-tvhome-lipa]").forEach((root) => {
    const model = root.querySelector("[data-tvhome-lipa-model]");
    const deposit = root.querySelector("[data-tvhome-lipa-deposit]");
    const depLabel = root.querySelector("[data-tvhome-lipa-dep-label]");
    const monthly = root.querySelector("[data-tvhome-lipa-monthly]");
    const line = root.querySelector("[data-tvhome-lipa-line]");
    let months = Number(root.querySelector("[data-tvhome-lipa-months].is-active")?.getAttribute("data-tvhome-lipa-months") || 6);
    function run() {
      if (!(model instanceof HTMLSelectElement) || !(deposit instanceof HTMLInputElement)) return;
      const opt = model.selectedOptions[0];
      const base = Number(opt?.getAttribute("data-base") || 0);
      const depPct = Number(deposit.value);
      const dep = Math.round((base * depPct) / 100);
      const mo = Math.round((base - dep) / months);
      if (depLabel) depLabel.textContent = `${depPct}%`;
      if (monthly) monthly.textContent = `KES ${mo.toLocaleString("en-KE")}`;
      if (line) line.textContent = `KES ${dep.toLocaleString("en-KE")} deposit · ${months} payments · sample total KES ${base.toLocaleString("en-KE")}`;
    }
    model?.addEventListener("change", run);
    deposit?.addEventListener("input", run);
    root.querySelectorAll("[data-tvhome-lipa-months]").forEach((btn) => {
      btn.addEventListener("click", () => {
        root.querySelectorAll("[data-tvhome-lipa-months]").forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        months = Number(btn.getAttribute("data-tvhome-lipa-months") || 6);
        run();
      });
    });
    run();
  });
</script>

<style>
  .tvhome-lipa { display: grid; gap: 0.75rem; padding: 1.25rem; background: #f5f5f7; border-radius: 1rem; }
  .tvhome-lipa header h3 { margin: 0 0 0.25rem; font-size: 1.1rem; }
  .tvhome-lipa header p { margin: 0; font-size: var(--text-sm); color: #6e6e73; }
  .tvhome-lipa label { display: grid; gap: 0.35rem; font-size: var(--text-sm); font-weight: 600; }
  .tvhome-lipa select, .tvhome-lipa input[type="range"] { width: 100%; }
  .tvhome-lipa__months { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tvhome-lipa__months button {
    border: 1px solid #d2d2d7; background: #fff; padding: 0.35rem 0.65rem; border-radius: 999px; cursor: pointer; font-size: var(--text-sm);
  }
  .tvhome-lipa__months button.is-active { background: #000; color: #fff; border-color: #000; }
  .tvhome-lipa__result p { margin: 0.15rem 0; }
  .tvhome-lipa__result span { font-size: 1.35rem; font-weight: 700; }
  .tvhome-lipa__hint {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: #6e6e73;
  }
</style>
