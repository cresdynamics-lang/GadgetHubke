---
/**
 * Product price in KES (shop base currency).
 */
interface Props {
  /** Amount in Kenyan Shillings */
  kes: number;
  class?: string;
  /** Optional prefix, e.g. "From" */
  prefix?: string;
}

const { kes, class: className = "", prefix } = Astro.props;
const display = `KSh ${Math.round(kes).toLocaleString("en-KE")}`;
---

<span class:list={["price", className]}>
  {prefix ? <span class="price__prefix">{prefix}</span> : null}
  <span class="price__amount">{display}</span>
</span>

<style>
  .price {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.45rem;
  }

  .price__prefix {
    font-weight: var(--font-weight-medium);
    color: var(--color-fg-muted);
    font-size: 0.92em;
  }

  .price__amount {
    font-weight: inherit;
  }
</style>
