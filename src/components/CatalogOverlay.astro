---
/**
 * Live prices on storefront cards.
 * Targets: [data-live-price="product-id"], [data-live-stock="product-id"].
 */
---

<script>
  type Entry = { priceKes?: number; exUkKes?: number; inStock?: boolean };
  let overlay: Record<string, Entry> = {};

  const formatKes = (n: number) => `KSh ${Math.round(n).toLocaleString("en-KE")}`;
  // The short-lived "Ex-UK only" menu mode is gone; clear it for anyone who turned it on.
  try {
    localStorage.removeItem("gh-channel");
  } catch {}

  function render() {
    for (const [id, entry] of Object.entries(overlay)) {
      document.querySelectorAll(`[data-live-price="${id}"]`).forEach((el) => {
        const prefix = el.getAttribute("data-live-prefix") || "";
        if (typeof entry.priceKes === "number") el.textContent = `${prefix}${formatKes(entry.priceKes)}`;
      });
      if (typeof entry.inStock === "boolean") {
        document.querySelectorAll(`[data-live-stock="${id}"]`).forEach((el) => {
          el.textContent = entry.inStock ? "In stock" : "Out of stock";
          el.classList.toggle("is-oos", !entry.inStock);
        });
      }
    }
  }

  async function load() {
    try {
      const res = await fetch("/api/catalog-overlay");
      if (!res.ok) return;
      overlay = ((await res.json()) as { overlay: Record<string, Entry> }).overlay || {};
      render();
    } catch {
      /* ignore */
    }
  }

  void load();
</script>
