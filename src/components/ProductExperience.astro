---
/**
 * Interactive “how it feels” panels - Design / Capture / Everyday / Mac.
 * Keeps exploration on-site and routes attention back to buy.
 */
import type { ProductExperience as Experience } from "../lib/products";

interface Props {
  productName: string;
  experiences: Experience[];
  buyHref?: string;
}

const { productName, experiences, buyHref = "#buy" } = Astro.props;
---

{
  experiences.length > 0 ? (
    <section class="feel container" id="experience" data-feel aria-labelledby="feel-heading">
      <header class="feel__intro">
        <p class="feel__eyebrow">How it feels</p>
        <h2 id="feel-heading">Living with {productName}</h2>
        <p class="feel__lede">
          Tap through the moments that make an iPhone feel immediate - in the hand,
          at the shutter, across your day, and on your Mac.
        </p>
      </header>

      <div class="feel__shell">
        <div class="feel__stage" data-feel-stage>
          {experiences.map((exp, i) =>
            exp.image ? (
              <img
                class:list={["feel__img", { "is-active": i === 0 }]}
                data-feel-img
                data-feel-for={exp.id}
                src={exp.image.src}
                alt={exp.image.alt}
                width="720"
                height="660"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            ) : null
          )}
          {!experiences.some((e) => e.image) ? (
            <div class="feel__img feel__img--empty is-active" aria-hidden="true" />
          ) : null}
        </div>

        <div class="feel__panel">
          <div class="feel__tabs" role="tablist" aria-label={`${productName} experience`}>
            {experiences.map((exp, i) => (
              <button
                type="button"
                class:list={["feel__tab", { "is-active": i === 0 }]}
                role="tab"
                id={`feel-tab-${exp.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`feel-panel-${exp.id}`}
                data-feel-tab
                data-feel-target={exp.id}
                tabindex={i === 0 ? 0 : -1}
              >
                {exp.label}
              </button>
            ))}
          </div>

          {experiences.map((exp, i) => (
            <div
              class:list={["feel__copy", { "is-active": i === 0 }]}
              role="tabpanel"
              id={`feel-panel-${exp.id}`}
              aria-labelledby={`feel-tab-${exp.id}`}
              data-feel-panel
              data-feel-id={exp.id}
              hidden={i !== 0}
            >
              <h3>{exp.title}</h3>
              {exp.cue ? <p class="feel__cue">{exp.cue}</p> : null}
              <p class="feel__body">{exp.body}</p>
            </div>
          ))}

          <p class="feel__cta">
            <a class="btn btn--primary" href={buyHref}>
              Configure &amp; buy
            </a>
          </p>
        </div>
      </div>
    </section>
  ) : null
}

<script>
  const root = document.querySelector("[data-feel]");
  if (root) {
    const tabs = [...root.querySelectorAll("[data-feel-tab]")];
    const panels = [...root.querySelectorAll("[data-feel-panel]")];
    const images = [...root.querySelectorAll("[data-feel-img]")];

    function activate(id: string, focusTab = false) {
      tabs.forEach((tab) => {
        const on = tab.getAttribute("data-feel-target") === id;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) (tab as HTMLButtonElement).focus();
      });
      panels.forEach((panel) => {
        const on = panel.getAttribute("data-feel-id") === id;
        panel.classList.toggle("is-active", on);
        if (on) panel.removeAttribute("hidden");
        else panel.setAttribute("hidden", "");
      });
      images.forEach((img) => {
        img.classList.toggle("is-active", img.getAttribute("data-feel-for") === id);
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-feel-target");
        if (id) activate(id);
      });
      tab.addEventListener("keydown", (e) => {
        const key = (e as KeyboardEvent).key;
        if (key !== "ArrowRight" && key !== "ArrowLeft" && key !== "Home" && key !== "End")
          return;
        e.preventDefault();
        const i = tabs.indexOf(tab);
        let next = i;
        if (key === "ArrowRight") next = (i + 1) % tabs.length;
        if (key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        if (key === "Home") next = 0;
        if (key === "End") next = tabs.length - 1;
        const id = tabs[next]?.getAttribute("data-feel-target");
        if (id) activate(id, true);
      });
    });

    // Reveal on scroll - subtle presence, not noise
    const shell = root.querySelector(".feel__shell");
    if (shell && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-inview");
              io.disconnect();
            }
          }
        },
        { threshold: 0.2 }
      );
      io.observe(shell);
    } else {
      shell?.classList.add("is-inview");
    }
  }
</script>

<style>
  .feel {
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .feel__intro {
    margin-bottom: var(--space-8);
    max-width: 36rem;
  }

  .feel__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .feel__intro h2 {
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    margin-bottom: var(--space-3);
  }

  .feel__lede {
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
  }

  .feel__shell {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }

  .feel__shell.is-inview {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 56rem) {
    .feel__shell {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-10);
    }
  }

  .feel__stage {
    position: relative;
    aspect-ratio: 11 / 10;
    background: linear-gradient(
      165deg,
      #f3f3f5 0%,
      #ffffff 42%,
      #ececef 100%
    );
    overflow: hidden;
  }

  .feel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-6);
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.45s ease,
      transform 0.55s ease;
    pointer-events: none;
  }

  .feel__img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .feel__img--empty {
    background: repeating-linear-gradient(
      -12deg,
      transparent,
      transparent 12px,
      rgba(0, 0, 0, 0.03) 12px,
      rgba(0, 0, 0, 0.03) 13px
    );
  }

  .feel__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .feel__tab {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0.75rem 0.9rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-fg-muted);
    cursor: pointer;
    position: relative;
  }

  .feel__tab::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0;
    height: 2px;
    background: var(--color-fg);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .feel__tab:hover {
    color: var(--color-fg);
  }

  .feel__tab.is-active {
    color: var(--color-fg);
  }

  .feel__tab.is-active::after {
    transform: scaleX(1);
  }

  .feel__tab:focus-visible {
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }

  .feel__copy {
    animation: feelIn 0.4s ease;
  }

  .feel__copy[hidden] {
    display: none;
  }

  @keyframes feelIn {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .feel__copy h3 {
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    margin-bottom: var(--space-2);
  }

  .feel__cue {
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
    letter-spacing: 0.01em;
    margin-bottom: var(--space-3);
  }

  .feel__body {
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
    max-width: 34rem;
  }

  .feel__cta {
    margin-top: var(--space-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .feel__shell,
    .feel__img,
    .feel__tab::after,
    .feel__copy {
      transition: none;
      animation: none;
    }

    .feel__shell {
      opacity: 1;
      transform: none;
    }
  }
</style>
