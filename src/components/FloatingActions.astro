---
import { site, whatsappUrl } from "../lib/site";

const waHref = whatsappUrl("Hi GadgetHub — I'd like to shop.");
const socials = [
  {
    label: "Facebook",
    href: site.social.facebook,
    icon: "fa-brands fa-facebook-f",
    className: "float-socials__btn--facebook",
  },
  {
    label: "Instagram",
    href: site.social.instagram,
    icon: "fa-brands fa-instagram",
    className: "float-socials__btn--instagram",
  },
  {
    label: "TikTok",
    href: site.social.tiktok,
    icon: "fa-brands fa-tiktok",
    className: "float-socials__btn--tiktok",
  },
] as const;
---

<aside class="float-socials" aria-label="Social media">
  {
    socials.map((item) => (
      <a
        class:list={["float-socials__btn", item.className]}
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={item.label}
        title={item.label}
      >
        <i class={item.icon} aria-hidden="true"></i>
      </a>
    ))
  }
</aside>

<a
  class="float-whatsapp"
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`WhatsApp ${site.phoneDisplay}`}
  title={`WhatsApp ${site.phoneDisplay}`}
>
  <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
</a>

<style>
  .float-socials {
    position: fixed;
    left: max(0.65rem, env(safe-area-inset-left));
    bottom: max(0.85rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .float-socials__btn,
  .float-whatsapp {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 6px 18px rgb(10 10 10 / 0.18);
    transition:
      transform var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease);
  }

  .float-socials__btn:hover,
  .float-whatsapp:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgb(10 10 10 / 0.22);
  }

  .float-socials__btn i,
  .float-whatsapp i {
    font-size: 1.05rem;
    line-height: 1;
    width: auto;
  }

  .float-socials__btn--facebook {
    background: #1877f2;
  }

  .float-socials__btn--instagram {
    background: linear-gradient(
      45deg,
      #f58529,
      #dd2a7b 50%,
      #8134af 75%,
      #515bd4
    );
  }

  .float-socials__btn--tiktok {
    background: #0a0a0a;
  }

  .float-whatsapp {
    position: fixed;
    right: max(0.65rem, env(safe-area-inset-right));
    bottom: max(0.85rem, env(safe-area-inset-bottom));
    z-index: 90;
    width: 3rem;
    height: 3rem;
    background: #25d366;
  }

  .float-whatsapp i {
    font-size: 1.45rem;
  }

  @media (min-width: 40rem) {
    .float-socials {
      left: max(1.1rem, env(safe-area-inset-left));
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      gap: 0.65rem;
    }

    .float-socials__btn {
      width: 2.85rem;
      height: 2.85rem;
    }

    .float-socials__btn i {
      font-size: 1.2rem;
    }

    .float-whatsapp {
      right: max(1.1rem, env(safe-area-inset-right));
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      width: 3.5rem;
      height: 3.5rem;
    }

    .float-whatsapp i {
      font-size: 1.65rem;
    }
  }
</style>
