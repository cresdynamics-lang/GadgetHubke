---
import { site, whatsappUrl, telUrl } from "../lib/site";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  hideWhatsApp?: boolean;
}

const { hideWhatsApp = false } = Astro.props;
const waHref = whatsappUrl("Hi Gadget Hub - I'd like to shop.");

const socials = [
  {
    label: "Facebook",
    href: site.social.facebook,
    icon: "facebook" as const,
    className: "float-socials__btn--facebook",
    external: true,
  },
  {
    label: "Instagram",
    href: site.social.instagram,
    icon: "instagram" as const,
    className: "float-socials__btn--instagram",
    external: true,
  },
  {
    label: "TikTok",
    href: site.social.tiktok,
    icon: "tiktok" as const,
    className: "float-socials__btn--tiktok",
    external: true,
  },
  {
    label: `Call ${site.phoneDisplay}`,
    href: telUrl(),
    icon: "phone" as const,
    className: "float-socials__btn--call",
    external: false,
  },
] as const;
---

<aside class="float-socials" aria-label="Social and call">
  {
    socials.map((item) => (
      <a
        class:list={["float-socials__btn", item.className]}
        href={item.href}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener noreferrer" : undefined}
        aria-label={item.label}
        title={item.label}
      >
        <SocialIcon name={item.icon} class="float-socials__icon" />
      </a>
    ))
  }
</aside>

{
  !hideWhatsApp ? (
    <a
      class="float-wa-pill"
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Online on WhatsApp - ${site.phoneDisplay}`}
      title={`WhatsApp ${site.phoneDisplay}`}
    >
      <span class="float-wa-pill__mark">
        <img
          class="float-wa-pill__logo"
          src="/images/logo-mark.png"
          alt=""
          width="40"
          height="40"
          decoding="async"
        />
      </span>
      <span class="float-wa-pill__text">
        <span class="float-wa-pill__online">Online on WhatsApp</span>
        <span class="float-wa-pill__line">Talk to us, we are here.</span>
      </span>
    </a>
  ) : null
}

<style>
  .float-socials {
    position: fixed;
    left: max(0.55rem, env(safe-area-inset-left));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .float-socials__btn {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 4px 12px rgb(10 10 10 / 0.16);
    transition:
      transform var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease);
  }

  .float-socials__btn:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgb(10 10 10 / 0.2);
  }

  .float-socials__btn :global(.float-socials__icon) {
    width: 0.78rem;
    height: 0.78rem;
  }

  .float-socials__btn--facebook {
    background: #1877f2;
  }

  .float-socials__btn--instagram {
    background: linear-gradient(
      45deg,
      #f58529,
      #dd2a7b 50%,
      #8134af 75%,
      #515bd4
    );
  }

  .float-socials__btn--tiktok {
    background: #0a0a0a;
  }

  .float-socials__btn--call {
    background: #1d1d1f;
  }

  .float-wa-pill {
    position: fixed;
    right: max(0.65rem, env(safe-area-inset-right));
    bottom: max(0.85rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: min(250px, calc(100vw - 1.5rem));
    min-height: 56px;
    padding: 0.55rem 0.85rem 0.55rem 0.55rem;
    border-radius: 999px;
    text-decoration: none;
    color: #fff !important;
    background: linear-gradient(135deg, #2ee46f, #0e9f6e 55%, #075e54);
    box-shadow: 0 10px 28px rgb(14 159 110 / 0.38);
    transition:
      transform var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease);
  }

  .float-wa-pill:hover {
    color: #fff !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgb(14 159 110 / 0.48);
  }

  .float-wa-pill__mark {
    flex: 0 0 auto;
    width: 2.45rem;
    height: 2.45rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .float-wa-pill__logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .float-wa-pill__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .float-wa-pill__online {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.9;
    line-height: 1.1;
  }

  .float-wa-pill__line {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 40rem) {
    .float-socials {
      left: max(0.85rem, env(safe-area-inset-left));
      bottom: max(1rem, env(safe-area-inset-bottom));
      gap: 0.4rem;
    }

    .float-socials__btn {
      width: 2rem;
      height: 2rem;
    }

    .float-socials__btn :global(.float-socials__icon) {
      width: 0.85rem;
      height: 0.85rem;
    }

    .float-wa-pill {
      right: max(1.1rem, env(safe-area-inset-right));
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      width: 280px;
      min-height: 60px;
    }
  }
</style>
