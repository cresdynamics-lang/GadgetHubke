---
import { site, whatsappUrl, telUrl } from "../lib/site";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  hideWhatsApp?: boolean;
}

const { hideWhatsApp = false } = Astro.props;
const waHref = whatsappUrl("Hi Gadget Hub - I'd like to shop.");

const socials = [
  {
    label: "Facebook",
    href: site.social.facebook,
    icon: "facebook" as const,
    className: "float-socials__btn--facebook",
    external: true,
  },
  {
    label: "Instagram",
    href: site.social.instagram,
    icon: "instagram" as const,
    className: "float-socials__btn--instagram",
    external: true,
  },
  {
    label: "TikTok",
    href: site.social.tiktok,
    icon: "tiktok" as const,
    className: "float-socials__btn--tiktok",
    external: true,
  },
  {
    label: `Call ${site.phoneDisplay}`,
    href: telUrl(),
    icon: "phone" as const,
    className: "float-socials__btn--call",
    external: false,
  },
] as const;
---

<aside class="float-socials" aria-label="Social and call">
  {
    socials.map((item) => (
      <a
        class:list={["float-socials__btn", item.className]}
        href={item.href}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener noreferrer" : undefined}
        aria-label={item.label}
        title={item.label}
      >
        <SocialIcon name={item.icon} class="float-socials__icon" />
      </a>
    ))
  }
</aside>

{
  !hideWhatsApp ? (
    <a
      class="float-wa-pill is-collapsed"
      data-float-wa
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Online on WhatsApp - ${site.phoneDisplay}`}
      title={`WhatsApp ${site.phoneDisplay}`}
    >
      <span class="float-wa-pill__brand" aria-hidden="true">
        <img
          class="float-wa-pill__logo"
          src="/images/logo-mark.png"
          alt=""
          width="40"
          height="40"
          decoding="async"
        />
      </span>
      <span class="float-wa-pill__wa" aria-hidden="true">
        <SocialIcon name="whatsapp" class="float-wa-pill__wa-icon" />
      </span>
      <span class="float-wa-pill__text">
        <span class="float-wa-pill__online">Online on WhatsApp</span>
        <span class="float-wa-pill__line">Talk to us, we are here.</span>
      </span>
    </a>
  ) : null
}

<script>
  const pill = document.querySelector("[data-float-wa]");
  if (pill instanceof HTMLElement) {
    const FIRST_OPEN_AT = 5_000;
    const FIRST_OPEN_FOR = 3_500;
    const SECOND_OPEN_AT = 60_000;
    const PEEK_FOR = 2_000;
    const HIDE_FOR = 3 * 60_000;

    const expand = () => {
      pill.classList.remove("is-collapsed");
      pill.classList.add("is-expanded");
    };
    const collapse = () => {
      pill.classList.add("is-collapsed");
      pill.classList.remove("is-expanded");
    };

    collapse();

    window.setTimeout(() => {
      expand();
      window.setTimeout(collapse, FIRST_OPEN_FOR);
    }, FIRST_OPEN_AT);

    const schedulePeekCycle = (delay: number) => {
      window.setTimeout(() => {
        expand();
        window.setTimeout(() => {
          collapse();
          schedulePeekCycle(HIDE_FOR);
        }, PEEK_FOR);
      }, delay);
    };

    schedulePeekCycle(SECOND_OPEN_AT);
  }
</script>

<style>
  .float-socials {
    position: fixed;
    left: max(0.55rem, env(safe-area-inset-left));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .float-socials__btn {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 999px;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 4px 12px rgb(10 10 10 / 0.16);
    transition:
      transform var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease);
  }

  .float-socials__btn:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgb(10 10 10 / 0.2);
  }

  .float-socials__btn :global(.float-socials__icon) {
    width: 0.78rem;
    height: 0.78rem;
  }

  .float-socials__btn--facebook {
    background: #1877f2;
  }

  .float-socials__btn--instagram {
    background: linear-gradient(
      45deg,
      #f58529,
      #dd2a7b 50%,
      #8134af 75%,
      #515bd4
    );
  }

  .float-socials__btn--tiktok {
    background: #0a0a0a;
  }

  .float-socials__btn--call {
    background: #1d1d1f;
  }

  .float-wa-pill {
    --wa-green: #25d366;
    --wa-green-deep: #128c7e;
    position: fixed;
    right: max(0.65rem, env(safe-area-inset-right));
    bottom: max(0.85rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    box-sizing: border-box;
    max-width: min(260px, calc(100vw - 1.5rem));
    min-height: 3rem;
    padding: 0.35rem 0.75rem 0.35rem 0.35rem;
    border-radius: 999px;
    text-decoration: none;
    color: #fff !important;
    background: linear-gradient(135deg, #2ee46f, var(--wa-green) 45%, var(--wa-green-deep));
    box-shadow: 0 10px 28px rgb(14 159 110 / 0.38);
    overflow: hidden;
    transition:
      max-width 0.4s var(--ease),
      min-height 0.4s var(--ease),
      padding 0.4s var(--ease),
      gap 0.4s var(--ease),
      background 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      transform var(--duration-fast) var(--ease);
  }

  /* Collapsed = classic green WhatsApp circle */
  .float-wa-pill.is-collapsed {
    width: 2.85rem;
    max-width: 2.85rem;
    min-width: 2.85rem;
    min-height: 2.85rem;
    height: 2.85rem;
    padding: 0;
    gap: 0;
    justify-content: center;
    background: var(--wa-green);
    box-shadow: 0 8px 22px rgb(37 211 102 / 0.45);
  }

  .float-wa-pill.is-expanded {
    width: auto;
    max-width: min(260px, calc(100vw - 1.5rem));
  }

  .float-wa-pill:hover {
    color: #fff !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgb(14 159 110 / 0.48);
  }

  .float-wa-pill__brand {
    flex: 0 0 auto;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .float-wa-pill__logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .float-wa-pill__wa {
    display: none;
    place-items: center;
    width: 100%;
    height: 100%;
    color: #fff;
  }

  .float-wa-pill__wa :global(.float-wa-pill__wa-icon) {
    width: 1.45rem;
    height: 1.45rem;
  }

  .float-wa-pill.is-collapsed .float-wa-pill__brand,
  .float-wa-pill.is-collapsed .float-wa-pill__text {
    display: none;
  }

  .float-wa-pill.is-collapsed .float-wa-pill__wa {
    display: grid;
  }

  .float-wa-pill.is-expanded .float-wa-pill__wa {
    display: none;
  }

  .float-wa-pill__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .float-wa-pill.is-collapsed .float-wa-pill__text {
    display: none;
  }

  .float-wa-pill__online {
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.9;
    line-height: 1.1;
  }

  .float-wa-pill__line {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 40rem) {
    .float-socials {
      display: flex;
      left: max(0.85rem, env(safe-area-inset-left));
      bottom: max(1rem, env(safe-area-inset-bottom));
      gap: 0.4rem;
    }

    .float-socials__btn {
      width: 2rem;
      height: 2rem;
    }

    .float-socials__btn :global(.float-socials__icon) {
      width: 0.85rem;
      height: 0.85rem;
    }

    .float-wa-pill {
      right: max(1.1rem, env(safe-area-inset-right));
      bottom: max(1.25rem, env(safe-area-inset-bottom));
    }

    .float-wa-pill.is-collapsed {
      width: 3.05rem;
      max-width: 3.05rem;
      min-width: 3.05rem;
      min-height: 3.05rem;
      height: 3.05rem;
    }

    .float-wa-pill.is-collapsed .float-wa-pill__wa :global(.float-wa-pill__wa-icon) {
      width: 1.55rem;
      height: 1.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-wa-pill {
      transition: none;
    }
  }
</style>
