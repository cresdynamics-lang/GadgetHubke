---
/**
 * Choose a device from the live list: model, storage or configuration, colour,
 * and New or Ex-UK. Pages start it with initDevicePickers() from scripts/devicePicker.
 */
import type { DeviceOption } from "../lib/device-options";

interface Props {
  options: DeviceOption[];
  /** Field name prefix, so a form can hold more than one picker. */
  name: string;
  label?: string;
  /** Let sold-out options be chosen and tell the customer, instead of blocking them. */
  notifyUnavailable?: boolean;
}

const { options, name, label = "Model", notifyUnavailable = false } = Astro.props;
const soldOut = (o: DeviceOption) => notifyUnavailable && o.variants.every((v) => !v.newKes && !v.exUkKes);
const groups = [...new Set(options.map((o) => o.group))];
const json = JSON.stringify(options).replace(/</g, "\\u003c");
---

<div class="picker" data-device-picker data-picker-notify={notifyUnavailable ? "1" : undefined}>
  <script type="application/json" data-device-options set:html={json} />
  <label class="picker__field">
    <span>{label}</span>
    <select name={`${name}Product`} required data-picker-product>
      <option value="" selected disabled>Select a model</option>
      {
        groups.map((group) => (
          <optgroup label={group}>
            {options.filter((o) => o.group === group).map((o) => <option value={o.id}>{o.name}{soldOut(o) ? " (not available)" : ""}</option>)}
          </optgroup>
        ))
      }
    </select>
  </label>
  <label class="picker__field" data-picker-variant-field>
    <span>Storage or version</span>
    <select name={`${name}Variant`} required disabled data-picker-variant>
      <option value="" selected disabled>Choose a model first</option>
    </select>
  </label>
  <label class="picker__field" data-picker-colour-field>
    <span>Colour</span>
    <select name={`${name}Colour`} required disabled data-picker-colour>
      <option value="" selected disabled>Choose a model first</option>
    </select>
  </label>
  <div class="picker__channel" role="radiogroup" aria-label="New or Ex-UK">
    <label><input type="radio" name={`${name}Channel`} value="new" checked data-picker-channel /> <span data-picker-channel-label>New</span></label>
    <label><input type="radio" name={`${name}Channel`} value="ex-uk" data-picker-channel /> <span data-picker-channel-label>Ex-UK</span></label>
  </div>
  <p class="picker__price" data-picker-price hidden></p>
  {notifyUnavailable && <p class="picker__notice" data-picker-notice role="status" hidden></p>}
</div>

<style>
  .picker {
    display: grid;
    gap: var(--space-4);
  }

  .picker__field {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .picker__field[hidden] {
    display: none;
  }

  .picker__field select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-white);
    font-weight: var(--font-weight-regular);
  }

  .picker__channel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .picker__channel label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
  }

  .picker__channel label:has(input:checked) {
    border-color: var(--color-black);
    box-shadow: inset 0 0 0 1px var(--color-black);
  }

  .picker__channel label:has(input:disabled) {
    opacity: 0.45;
    cursor: default;
  }

  .picker__price {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }

  .picker__price[hidden],
  .picker__notice[hidden] {
    display: none;
  }

  .picker__notice {
    margin: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid #e0a100;
    border-radius: var(--radius-md);
    background: #fff8e1;
    color: #5c4300;
    font-size: var(--text-sm);
  }
</style>
