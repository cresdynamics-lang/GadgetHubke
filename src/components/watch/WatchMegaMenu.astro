---
/**
 * Watch mega menu — Shop / Bands / Need / live preview.
 */
import {
  watchModels,
  watchModelsByFamily,
  getWatchImage,
  formatKes,
  type WatchModel,
} from "../../lib/watch";

function newestFirst(list: WatchModel[]) {
  return [...list].sort((a, b) => b.year - a.year || b.basePriceKes - a.basePriceKes);
}

function previewFor(m: WatchModel) {
  const img = getWatchImage(m.id, "main", m.name);
  return {
    id: m.id,
    name: m.name,
    tagline: m.tagline,
    size: `${m.defaultCaseMm} mm`,
    href: `/watch/${m.id}`,
    priceKes: m.basePriceKes,
    src: img.src,
    alt: img.alt,
    isNew: Boolean(m.isNew),
  };
}

const previews = Object.fromEntries(watchModels.map((m) => [m.id, previewFor(m)]));
const defaultPreview = previewFor(
  watchModels.find((m) => m.id === "watch-s12-46") || watchModels[0],
);

const shopNow = [
  watchModels.find((m) => m.id === "watch-s12-46"),
  watchModels.find((m) => m.id === "watch-ultra-4"),
  watchModels.find((m) => m.id === "watch-se3-44"),
].filter(Boolean) as WatchModel[];

const earlier = newestFirst(
  watchModels.filter(
    (m) =>
      !["watch-s12-42", "watch-s12-46", "watch-ultra-4", "watch-se3-40", "watch-se3-44"].includes(m.id) &&
      m.family !== "Hermès" &&
      m.family !== "Nike",
  ),
).slice(0, 10);

const bands = [
  { label: "Sport Band", href: "/watch/shop?band=sport-band" },
  { label: "Sport Loop", href: "/watch/shop?band=sport-loop" },
  { label: "Milanese", href: "/watch/shop?band=milanese" },
  { label: "Leather", href: "/watch/shop?band=leather-link" },
  { label: "Nike", href: "/watch/shop?band=nike-sport-band" },
  { label: "Hermès", href: "/watch/shop?band=hermes-band" },
  { label: "Chargers", href: "/shop/accessories/power" },
  { label: "Screen protectors", href: "/shop/accessories/cases" },
];

const needs = [
  { label: "For fitness and running", href: "/watch/shop?need=fitness" },
  { label: "For health tracking", href: "/watch/shop?need=health" },
  { label: "For adventure and diving", href: "/watch/shop?need=adventure" },
  { label: "For kids and family", href: "/watch/shop?need=kids" },
  { label: "Lowest price", href: "/watch/shop?need=price" },
  { label: "Biggest and brightest", href: "/watch/shop?need=bright" },
];
---

<div class="wmega" data-wmega>
  <div class="wmega__cols">
    <div class="wmega__col">
      <p class="wmega__heading">Shop Watch</p>
      <ul>
        {
          shopNow.map((m) => (
            <li>
              <a class="wmega__link" href={`/watch/${m.id}`} data-mega-preview={m.id}>
                <span>
                  {m.name.replace("Apple Watch ", "")}
                  {m.isNew ? <span class="wmega__tag">New</span> : null}
                </span>
                <em>from {formatKes(m.basePriceKes)}</em>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="wmega__gen">Earlier models</p>
      <ul>
        {
          earlier.map((m) => (
            <li>
              <a class="wmega__link" href={`/watch/${m.id}`} data-mega-preview={m.id}>
                <span>{m.name.replace("Apple Watch ", "")}</span>
                <em>from {formatKes(m.basePriceKes)}</em>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="wmega__all" href="/watch/shop">Shop all Watch</a>
    </div>

    <div class="wmega__col">
      <p class="wmega__heading">Bands and accessories</p>
      <ul>
        {bands.map((b) => (
          <li><a class="wmega__link" href={b.href}>{b.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="wmega__col">
      <p class="wmega__heading">Shop by need</p>
      <ul>
        {needs.map((n) => (
          <li><a class="wmega__link" href={n.href}>{n.label}</a></li>
        ))}
      </ul>
      <ul class="wmega__tools">
        <li><a href="/watch/compare">Compare Watches</a></li>
        <li><a href="/trade-in">Trade in your old Watch</a></li>
        <li><a href="/lipa-mdogo-mdogo">Lipa Mdogo Mdogo</a></li>
      </ul>
    </div>

    <div class="wmega__preview" data-mega-card>
      <div class="wmega__stage">
        <img data-mega-img src={defaultPreview.src} alt={defaultPreview.alt} width="420" height="315" />
      </div>
      <p data-mega-name>{defaultPreview.name}</p>
      <p data-mega-tagline class="wmega__muted">{defaultPreview.tagline}</p>
      <p data-mega-size class="wmega__muted">{defaultPreview.size}</p>
      <p data-mega-price><strong>From {formatKes(defaultPreview.priceKes)}</strong></p>
      <a class="btn btn--primary btn--sm" data-mega-view href={defaultPreview.href}>View</a>
    </div>
  </div>
</div>

<script define:vars={{ previews, defaultPreview }}>
  const root = document.querySelector("[data-wmega]");
  if (root) {
    const img = root.querySelector("[data-mega-img]");
    const name = root.querySelector("[data-mega-name]");
    const tagline = root.querySelector("[data-mega-tagline]");
    const size = root.querySelector("[data-mega-size]");
    const price = root.querySelector("[data-mega-price]");
    const view = root.querySelector("[data-mega-view]");

    function show(id) {
      const p = previews[id] || defaultPreview;
      if (img instanceof HTMLImageElement) {
        img.style.opacity = "0";
        img.style.transform = "scale(0.97)";
        window.setTimeout(() => {
          img.src = p.src;
          img.alt = p.alt;
          img.style.opacity = "1";
          img.style.transform = "scale(1)";
        }, 170);
      }
      if (name) name.textContent = p.name;
      if (tagline) tagline.textContent = p.tagline;
      if (size) size.textContent = p.size;
      if (price) price.innerHTML = `<strong>From KES ${p.priceKes.toLocaleString("en-KE")}</strong>`;
      if (view instanceof HTMLAnchorElement) view.href = p.href;
    }

    root.querySelectorAll("[data-mega-preview]").forEach((a) => {
      a.addEventListener("mouseenter", () => show(a.getAttribute("data-mega-preview")));
      a.addEventListener("focus", () => show(a.getAttribute("data-mega-preview")));
    });
  }
</script>

<style>
  .wmega { padding: 1.25rem 1.5rem 1.5rem; }
  .wmega__cols {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 64rem) {
    .wmega__cols { grid-template-columns: 1.1fr 0.9fr 0.9fr 1.1fr; }
  }
  .wmega__heading {
    margin: 0 0 0.65rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6e6e73;
  }
  .wmega__gen {
    margin: 0.85rem 0 0.4rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .wmega ul { list-style: none; margin: 0; padding: 0; }
  .wmega__link {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0;
    text-decoration: none;
    color: inherit;
    font-size: var(--text-sm);
    transition: transform 160ms ease;
  }
  .wmega__link:hover, .wmega__link:focus-visible { transform: translateX(5px); }
  .wmega__link em { font-style: normal; color: #6e6e73; white-space: nowrap; }
  .wmega__tag {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.65rem;
    background: #000;
    color: #fff;
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    vertical-align: middle;
  }
  .wmega__all {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .wmega__tools { margin-top: 0.85rem; }
  .wmega__tools a { font-size: var(--text-sm); color: inherit; }
  .wmega__preview {
    background: #f5f5f7;
    border-radius: 1.25rem;
    padding: 1rem;
  }
  .wmega__stage {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    margin-bottom: 0.75rem;
  }
  .wmega__stage img {
    width: 90%;
    height: auto;
    mix-blend-mode: multiply;
    transition: opacity 170ms ease, transform 170ms ease;
  }
  .wmega__preview p { margin: 0.15rem 0; }
  .wmega__muted { font-size: var(--text-sm); color: #6e6e73; }
  .wmega__preview .btn { margin-top: 0.65rem; }
  @media (prefers-reduced-motion: reduce) {
    .wmega__link { transition: none; }
    .wmega__link:hover { transform: none; }
  }
</style>
