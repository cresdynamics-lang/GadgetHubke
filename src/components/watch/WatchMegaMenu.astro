---
/**
 * Compact Watch nav flyout - featured picks + shop all.
 */
import {
  watchModels,
  getWatchImage,
  formatKes,
  type WatchModel,
} from "../../lib/watch";

function previewFor(m: WatchModel) {
  const img = getWatchImage(m.id, "main", m.name);
  return {
    id: m.id,
    name: m.name,
    href: `/watch/${m.id}`,
    priceKes: m.basePriceKes,
    priceLabel: formatKes(m.basePriceKes),
    src: img.src,
    alt: img.alt,
    isNew: Boolean(m.isNew),
  };
}

const featuredIds = [
  "watch-s12-46",
  "watch-s12-42",
  "watch-ultra-4",
  "watch-se3-44",
] as const;

const picks = featuredIds
  .map((id) => watchModels.find((m) => m.id === id))
  .filter(Boolean)
  .map((m) => previewFor(m as WatchModel));

const defaultPreview =
  picks[0] ||
  previewFor(watchModels.find((m) => m.id === "watch-s12-46") || watchModels[0]);
const previews = Object.fromEntries(picks.map((p) => [p.id, p]));
---

<div class="wmega" data-wmega>
  <div class="wmega__cols">
    <div class="wmega__col">
      <p class="wmega__heading">Featured Watch</p>
      <ul>
        {
          picks.map((m) => (
            <li>
              <a class="wmega__link" href={m.href} data-mega-preview={m.id}>
                <span>
                  {m.name.replace("Apple Watch ", "")}
                  {m.isNew ? <span class="wmega__tag">New</span> : null}
                </span>
                <em>from {formatKes(m.priceKes)}</em>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="wmega__all" href="/watch/shop">Shop all Watch</a>
    </div>

    <div class="wmega__col">
      <p class="wmega__heading">Explore</p>
      <ul>
        <li><a class="wmega__link" href="/watch">Watch overview</a></li>
        <li><a class="wmega__link" href="/watch/compare">Compare</a></li>
        <li><a class="wmega__link" href="/watch/shop?band=sport-band">Bands</a></li>
        <li><a class="wmega__link" href="/trade-in">Trade in</a></li>
        <li><a class="wmega__link" href="/lipa-mdogo-mdogo">Lipa Mdogo Mdogo</a></li>
      </ul>
    </div>

    <div class="wmega__preview" data-mega-card>
      <div class="wmega__stage">
        <img
          data-mega-img
          src={defaultPreview.src}
          alt={defaultPreview.alt}
          width="280"
          height="210"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p data-mega-name class="wmega__pname">{defaultPreview.name}</p>
      <p data-mega-price class="wmega__pprice">
        <strong>From {formatKes(defaultPreview.priceKes)}</strong>
      </p>
      <a class="btn btn--primary btn--sm" data-mega-view href={defaultPreview.href}>View</a>
    </div>
  </div>
</div>

<script define:vars={{ previews, defaultPreview }}>
  const root = document.querySelector("[data-wmega]");
  if (root) {
    const img = root.querySelector("[data-mega-img]");
    const name = root.querySelector("[data-mega-name]");
    const price = root.querySelector("[data-mega-price]");
    const view = root.querySelector("[data-mega-view]");

    function show(id) {
      const p = previews[id] || defaultPreview;
      if (img instanceof HTMLImageElement) {
        img.src = p.src;
        img.alt = p.alt;
      }
      if (name) name.textContent = p.name;
      if (price) price.innerHTML = `<strong>From ${p.priceLabel}</strong>`;
      if (view instanceof HTMLAnchorElement) view.href = p.href;
    }

    root.querySelectorAll("[data-mega-preview]").forEach((a) => {
      a.addEventListener("mouseenter", () => show(a.getAttribute("data-mega-preview")));
      a.addEventListener("focus", () => show(a.getAttribute("data-mega-preview")));
    });
  }
</script>

<style>
  .wmega {
    padding: 0.25rem 0 0.5rem;
  }
  .wmega__cols {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.2fr 0.9fr 0.85fr;
    align-items: start;
  }
  .wmega__heading {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6e6e73;
    font-weight: 600;
  }
  .wmega ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wmega__link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    text-decoration: none;
    color: var(--color-fg);
    font-size: var(--text-sm);
  }
  .wmega__link:hover,
  .wmega__link:focus-visible {
    text-decoration: underline;
  }
  .wmega__link em {
    font-style: normal;
    color: #6e6e73;
    white-space: nowrap;
  }
  .wmega__tag {
    margin-left: 0.35rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: #000;
    color: #fff;
    border-radius: 999px;
    padding: 0.1rem 0.35rem;
  }
  .wmega__all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-fg);
  }
  .wmega__preview {
    background: #f5f5f7;
    border-radius: 1rem;
    padding: 0.85rem;
  }
  .wmega__stage {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    margin-bottom: 0.5rem;
  }
  .wmega__stage img {
    width: 70%;
    height: auto;
    object-fit: contain;
  }
  .wmega__pname {
    margin: 0;
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .wmega__pprice {
    margin: 0.25rem 0 0.65rem;
    font-size: var(--text-sm);
  }
  @media (max-width: 63.749rem) {
    .wmega {
      display: none;
    }
  }
</style>
