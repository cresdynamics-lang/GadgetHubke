---
/**
 * Watch product card - wide stage, colour dots, price, bag + compare.
 */
import WatchStage from "./WatchStage.astro";
import {
  type WatchModel,
  getWatchImage,
  defaultWatchColour,
  colourHex,
  colourLabel,
  watchSubline,
} from "../../lib/watch";
import { whatsappUrl } from "../../lib/site";
import ConditionBadge from "../ConditionBadge.astro";
import { filterColours, type ListingChannel } from "../../lib/listing-offers";

interface Props {
  model: WatchModel;
  compare?: boolean;
  channel?: ListingChannel;
  priceKes?: number;
  coloursInStock?: string[];
  href?: string;
}

const { model, compare = true, channel = "new", priceKes, coloursInStock, href: hrefProp } = Astro.props;
const colours = filterColours(model.colours, coloursInStock);
const colour = colours.includes(defaultWatchColour(model)) ? defaultWatchColour(model) : colours[0] || defaultWatchColour(model);
const href = hrefProp || `/watch/${model.id}`;
const displayKes = priceKes ?? model.basePriceKes;
const img = getWatchImage(model.id, "main", model.name);
const hoverCandidate = getWatchImage(model.id, "design", model.name);
const hoverSrc =
  !hoverCandidate.fallback && hoverCandidate.src !== img.src ? hoverCandidate.src : "";
const wa = whatsappUrl(`Hello Gadget Hub, I'm interested in the ${model.name}${channel === "ex-uk" ? " (Ex-UK)" : ""}.`);
---

<article class="wcard" data-watch-card data-id={model.id} data-channel={channel}>
  <a class:list={["wcard__media", { "wcard__media--swap": Boolean(hoverSrc) }]} href={href}>
    <WatchStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={img.width} height={Math.round(img.width * 0.75)} />
    {
      hoverSrc ? (
        <img
          class="wcard__img-alt"
          src={hoverSrc}
          alt=""
          width={img.width}
          height={Math.round(img.width * 0.75)}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      ) : null
    }
    <ConditionBadge channel={channel} />
    {
      model.specialBandIncluded ? <span class="wcard__tag wcard__tag--band">Special band included</span> : null
    }
  </a>
  <div class="wcard__body">
    <h3><a href={href}>{model.name}</a></h3>
    <p class="wcard__sub">{watchSubline(model)}</p>
    {
      model.batteryHours != null ? (
        <p class="wcard__meta">Up to {model.batteryHours} h · Apple claim</p>
      ) : (
        <p class="wcard__meta">Battery details on request</p>
      )
    }
    <div class="wcard__colours" role="list" aria-label="Colours">
      {
        colours.slice(0, 8).map((c) => (
          <button
            type="button"
            role="listitem"
            class:list={{ "is-active": c === colour }}
            style={`--dot:${colourHex(c)}`}
            title={colourLabel(c)}
            aria-label={colourLabel(c)}
            data-wcard-colour={c}
          />
        ))
      }
    </div>
    <div class="wcard__row wcard__row--price">
      <p class="wcard__price">
        <span data-live-price={model.id} data-live-field={channel === "ex-uk" ? "exUkKes" : "priceKes"} data-live-prefix="">{`KSh ${Math.round(displayKes).toLocaleString("en-KE")}`}</span>
      </p>
    </div>
    <div class="wcard__row wcard__row--links">
      <a class="btn btn--primary btn--xs" href={href}>Details</a>
      <a class="btn btn--whatsapp btn--xs" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
    {
      compare ? (
        <label class="wcard__compare">
          <input type="checkbox" data-watch-compare value={model.id} />
          Compare
        </label>
      ) : null
    }
  </div>
</article>

<script>
  document.querySelectorAll("[data-watch-bag]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(btn instanceof HTMLElement)) return;
      window.dispatchEvent(
        new CustomEvent("gh:bag-add", {
          detail: {
            id: btn.getAttribute("data-id"),
            name: btn.getAttribute("data-name"),
            size: btn.getAttribute("data-size"),
            material: btn.getAttribute("data-material"),
            colour: btn.getAttribute("data-colour"),
            kes: Number(btn.getAttribute("data-kes") || 0),
            image: btn.getAttribute("data-image"),
          },
        }),
      );
    });
  });
</script>

<style>
  .wcard {
    display: grid;
    gap: 0.75rem;
  }
  .wcard__media {
    position: relative;
    display: block;
    text-decoration: none;
  }
  .wcard__media :global(img) {
    transition: opacity 0.35s ease;
  }
  .wcard__img-alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    mix-blend-mode: multiply;
  }
  .wcard__media--swap:hover :global(.wstage__img),
  .wcard__media--swap:hover :global(img:not(.wcard__img-alt)) {
    opacity: 0;
  }
  .wcard__media--swap:hover .wcard__img-alt {
    opacity: 1;
  }
  .wcard__tag {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    background: #000;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
  }
  .wcard__tag--band { left: auto; right: 0.65rem; background: #1d1d1f; }
  .wcard__body h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .wcard__body h3 a { color: inherit; text-decoration: none; }
  .wcard__sub, .wcard__meta, .wcard__fine {
    margin: 0.2rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted, #6e6e73);
  }
  .wcard__colours { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.55rem; }
  .wcard__colours button {
    width: 0.85rem; height: 0.85rem; border-radius: 50%;
    border: 1px solid #d2d2d7; background: var(--dot); padding: 0; cursor: pointer;
  }
  .wcard__colours button.is-active { outline: 2px solid #000; outline-offset: 2px; }
  .wcard__row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.65rem;
  }
  .wcard__row--links {
    margin-top: 0.4rem;
  }
  .wcard__price {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .wcard__row .btn {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    white-space: nowrap;
  }
  .wcard__row--price .btn {
    flex: 0 0 auto;
  }
  .wcard__compare {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.45rem;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  /* Price and Add to cart never touch: smaller type on narrow cards, and the
     button drops under the price when the card is too narrow for both. */
  .wcard__row--price {
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 0.5rem;
    row-gap: 0.4rem;
  }
  .wcard__row--price .wcard__price,
  .wcard__row--price .wcard__price * {
    font-size: clamp(0.74rem, 2.9vw, 0.85rem);
  }
  .wcard__row--price :global(.btn) {
    flex: 0 0 auto;
    font-size: clamp(0.66rem, 2.6vw, 0.75rem);
    padding: 0.28rem 0.55rem;
    min-height: 1.75rem;
  }
</style>
