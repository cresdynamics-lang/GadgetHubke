---
/**
 * Wide 4:3 Watch stage on #F5F5F7. Multiply on the <img> only.
 */
interface Props {
  src: string;
  srcWebp?: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  class?: string;
}

const { src, srcWebp, alt, width = 1400, height = 1050, priority = false, class: className } = Astro.props;
---

<div class:list={["wstage", className]}>
  <picture>
    {srcWebp ? <source srcset={srcWebp} type="image/webp" /> : null}
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
    />
  </picture>
</div>

<style>
  .wstage {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #f5f5f7;
    border-radius: var(--watch-radius, 1.5rem);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .wstage img {
    width: 88%;
    height: auto;
    max-height: 92%;
    object-fit: contain;
    mix-blend-mode: multiply;
    display: block;
  }
</style>
