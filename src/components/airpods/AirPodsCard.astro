---
import AirPodsStage from "./AirPodsStage.astro";
import {
  type AirpodsModel,
  getAirpodsImage,
  defaultAirpodsColour,
  colourHex,
  colourLabel,
} from "../../lib/airpods";
import { whatsappUrl } from "../../lib/site";
import ConditionBadge from "../ConditionBadge.astro";
import { filterColours, type ListingChannel } from "../../lib/listing-offers";

interface Props {
  model: AirpodsModel;
  compare?: boolean;
  channel?: ListingChannel;
  priceKes?: number;
  coloursInStock?: string[];
  href?: string;
}

const { model, compare = true, channel = "new", priceKes, coloursInStock, href: hrefProp } = Astro.props;
const colours = filterColours(model.colours, coloursInStock);
const colour = colours.includes(defaultAirpodsColour(model)) ? defaultAirpodsColour(model) : colours[0] || defaultAirpodsColour(model);
const img = getAirpodsImage(model.id, "earbuds", model.name);
const hoverImg = getAirpodsImage(model.id, "case", model.name);
const hoverSrc =
  !hoverImg.fallback && hoverImg.src !== img.src
    ? hoverImg.src
    : (() => {
        const hero = getAirpodsImage(model.id, "hero", model.name);
        return !hero.fallback && hero.src !== img.src ? hero.src : "";
      })();
const href = hrefProp || `/airpods/${model.id}`;
const displayKes = priceKes ?? model.basePriceKes;
const wa = whatsappUrl(`Hello Gadget Hub, I'm interested in the ${model.name}${channel === "ex-uk" ? " (Ex-UK)" : ""}.`);
---

<article class="acard" data-airpods-card data-id={model.id} data-channel={channel}>
  <a class:list={["acard__media", { "acard__media--swap": Boolean(hoverSrc) }]} href={href}>
    <AirPodsStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={img.width} height={img.width} />
    {
      hoverSrc ? (
        <img
          class="acard__img-alt"
          src={hoverSrc}
          alt=""
          width={img.width}
          height={img.width}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      ) : null
    }
    <ConditionBadge channel={channel} />
    {model.standInImage ? <span class="acard__tag acard__tag--stand">Stand-in image</span> : null}
  </a>
  <div class="acard__body">
    <h3><a href={href}>{model.name}</a></h3>
    <p class="acard__sub">{model.tagline}</p>
    {
      model.batterySingleHours != null ? (
        <p class="acard__meta">Up to {model.batterySingleHours} h · Apple claim</p>
      ) : null
    }
    <div class="acard__colours" role="list" aria-label="Colours">
      {
        colours.slice(0, 8).map((c) => (
          <button
            type="button"
            role="listitem"
            class:list={{ "is-active": c === colour }}
            style={`--dot:${colourHex(c)}`}
            title={colourLabel(c)}
            aria-label={colourLabel(c)}
            data-acard-colour={c}
          />
        ))
      }
    </div>
    <div class="acard__row acard__row--price">
      <p class="acard__price">
        <span data-live-price={model.id} data-live-field={channel === "ex-uk" ? "exUkKes" : "priceKes"} data-live-prefix="">{`KSh ${Math.round(displayKes).toLocaleString("en-KE")}`}</span>
      </p>
    </div>
    <div class="acard__row acard__row--links">
      <a class="btn btn--primary btn--xs" href={href}>Details</a>
      <a class="btn btn--whatsapp btn--xs" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
    {
      compare ? (
        <label class="acard__compare">
          <input type="checkbox" data-airpods-compare value={model.id} />
          Compare
        </label>
      ) : null
    }
  </div>
</article>

<script>
  document.querySelectorAll("[data-airpods-bag]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(btn instanceof HTMLElement)) return;
      window.dispatchEvent(
        new CustomEvent("gh:bag-add", {
          detail: {
            id: btn.getAttribute("data-id"),
            name: btn.getAttribute("data-name"),
            colour: btn.getAttribute("data-colour"),
            caseOption: btn.getAttribute("data-case-option"),
            extras: btn.getAttribute("data-extras") || "",
            kes: Number(btn.getAttribute("data-kes") || 0),
            image: btn.getAttribute("data-image"),
          },
        }),
      );
    });
  });
</script>

<style>
  .acard { display: grid; gap: 0.75rem; min-width: 0; }
  .acard__media {
    position: relative;
    display: block;
    text-decoration: none;
  }
  .acard__media :global(img) {
    transition: opacity 0.35s ease;
  }
  .acard__img-alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    mix-blend-mode: multiply;
  }
  .acard__media--swap:hover :global(.astage__img),
  .acard__media--swap:hover :global(img:not(.acard__img-alt)) {
    opacity: 0;
  }
  .acard__media--swap:hover .acard__img-alt {
    opacity: 1;
  }
  .acard__tag {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    background: #000;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
  }
  .acard__tag--stand { left: auto; right: 0.65rem; background: #1d1d1f; max-width: 45%; text-align: right; }
  .acard__body h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .acard__body h3 a { color: inherit; text-decoration: none; }
  .acard__sub, .acard__meta, .acard__fine {
    margin: 0.2rem 0 0;
    font-size: var(--text-sm);
    color: #6e6e73;
  }
  .acard__colours { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.55rem; }
  .acard__colours button {
    width: 0.85rem; height: 0.85rem; border-radius: 50%;
    border: 1px solid #d2d2d7; background: var(--dot); padding: 0; cursor: pointer;
  }
  .acard__colours button.is-active { outline: 2px solid #000; outline-offset: 2px; }
  .acard__row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.65rem;
  }
  .acard__row--links {
    margin-top: 0.4rem;
  }
  .acard__price {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .acard__row .btn {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    white-space: nowrap;
  }
  .acard__row--price .btn {
    flex: 0 0 auto;
  }
  .acard__compare {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.45rem;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  /* Price and Add to cart never touch: smaller type on narrow cards, and the
     button drops under the price when the card is too narrow for both. */
  .acard__row--price {
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 0.5rem;
    row-gap: 0.4rem;
  }
  .acard__row--price .acard__price,
  .acard__row--price .acard__price * {
    font-size: clamp(0.74rem, 2.9vw, 0.85rem);
  }
  .acard__row--price :global(.btn) {
    flex: 0 0 auto;
    font-size: clamp(0.66rem, 2.6vw, 0.75rem);
    padding: 0.28rem 0.55rem;
    min-height: 1.75rem;
  }
</style>
