---
/**
 * Floating oval buy card - product thumb + name + blurb + CTAs.
 * Appears after scroll; proxies page cart / buy-now checkout controls.
 */
interface Props {
  productName: string;
  imageSrc: string;
  imageAlt?: string;
  description?: string;
}

const {
  productName,
  imageSrc,
  imageAlt = productName,
  description = "Sealed stock · ready in Nairobi",
} = Astro.props;
---

<div class="float-buy" data-sticky-buy hidden>
  <div class="float-buy__media">
    <img src={imageSrc} alt={imageAlt} width="72" height="72" loading="lazy" decoding="async" />
  </div>
  <div class="float-buy__copy">
    <p class="float-buy__name">{productName}</p>
    <p class="float-buy__desc" data-float-desc>{description}</p>
  </div>
  <div class="float-buy__actions">
    <a class="btn btn--secondary btn--xs" href="/trade-in">Trade In</a>
    <a class="btn btn--whatsapp btn--xs" data-sticky-wa href="#">Order on WhatsApp</a>
  </div>
</div>

<script>
  const bar = document.querySelector("[data-sticky-buy]");
  if (bar) {
    document.documentElement.classList.add("has-sticky-buy");

    function sync() {
      const show = window.scrollY > 120;
      bar.toggleAttribute("hidden", !show);
      document.documentElement.classList.toggle("sticky-buy-visible", show);
    }

    window.addEventListener("scroll", sync, { passive: true });
    sync();

    const stickyWa = bar.querySelector("[data-sticky-wa]");
    if (stickyWa instanceof HTMLAnchorElement) {
      const pageWa = document.querySelector("[data-pdp-wa], [data-wa-link], [data-wa]");
      if (pageWa instanceof HTMLAnchorElement && pageWa.href) {
        stickyWa.href = pageWa.href;
        stickyWa.target = "_blank";
        stickyWa.rel = "noopener noreferrer";
      } else {
        stickyWa.hidden = true;
      }
    }
  }
</script>

<style>
  .float-buy {
    position: fixed;
    z-index: 88;
    left: 50%;
    bottom: max(0.85rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    width: min(calc(100vw - 1.25rem), 42rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    padding: 0.55rem 0.6rem;
    border-radius: 1.35rem;
    background: rgb(255 255 255 / 0.95);
    border: 1px solid rgb(0 0 0 / 0.08);
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.14);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .float-buy[hidden] {
    display: none;
  }

  .float-buy__media {
    width: 2.55rem;
    height: 2.55rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--color-stage, #f5f5f7);
    flex-shrink: 0;
  }

  .float-buy__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 0.15rem;
  }

  .float-buy__copy {
    min-width: 0;
    flex: 1 1 calc(100% - 3.4rem);
  }

  .float-buy__name {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .float-buy__desc {
    margin: 0.08rem 0 0;
    font-size: 0.65rem;
    color: var(--color-fg-muted);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .float-buy__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    width: 100%;
    flex: 1 1 100%;
  }

  .float-buy__actions :global(.btn) {
    width: 100%;
    min-width: 0;
    min-height: 1.85rem;
    border-radius: 999px;
    font-size: clamp(0.5rem, 1.8vw, 0.62rem);
    padding: 0.3rem 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    justify-content: center;
  }

  @media (min-width: 40rem) {
    .float-buy__media {
      width: 3rem;
      height: 3rem;
    }

    .float-buy__name {
      font-size: 0.88rem;
    }

    .float-buy__desc {
      font-size: 0.7rem;
    }
  }

  :global(html.sticky-buy-visible .float-wa-pill) {
    bottom: calc(5.75rem + env(safe-area-inset-bottom, 0px));
  }

  :global(html.sticky-buy-visible .float-socials) {
    bottom: calc(5.75rem + env(safe-area-inset-bottom, 0px));
  }

  :global(html.has-sticky-buy body) {
    padding-bottom: 5.5rem;
  }
</style>
