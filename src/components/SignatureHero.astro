---
/**
 * Signature home hero - four equal rectangular tiles fill the viewport
 * as one solid rectangle, hold ~2s, then split to the corners while
 * centred copy opens. 30s after the page has loaded, a silent product reel takes over
 * the hero, then it returns to the copy. Respects prefers-reduced-motion.
 */
import { whatsappUrl } from "../lib/site";
import type { HeroPhone, HeroReelGroup, HeroShopLink } from "../lib/home";

interface Props {
  eyebrow?: string;
  title?: string;
  titleLine?: string;
  lede?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  /** Third CTA (replaces hero WhatsApp when set) */
  tertiaryHref?: string;
  tertiaryLabel?: string;
  phones: [HeroPhone, HeroPhone, HeroPhone, HeroPhone];
  reel?: HeroReelGroup[];
  shopLinks?: HeroShopLink[];
}

const {
  eyebrow = "Gadget Hub · Norwich Union House Nairobi · Verified Apple Reseller",
  title = "Some People Buy Phones,",
  titleLine = "Some Come At Gadget Hub",
  lede = "Your New iPhone is here, Come, Have the Feeling.",
  primaryHref = "/shop",
  primaryLabel = "Shop Apple",
  secondaryHref = "/trade-in",
  secondaryLabel = "Trade-in",
  tertiaryHref = "/lipa-mdogo-mdogo",
  tertiaryLabel = "Lipa Mdogo Mdogo",
  phones,
  reel = [],
  shopLinks = [],
} = Astro.props;

const wa = whatsappUrl("Hello Gadget Hub, I'd like to shop Apple products.");
const brandIdx = titleLine.indexOf("Gadget Hub");
const punchBefore = brandIdx >= 0 ? titleLine.slice(0, brandIdx) : titleLine;
const punchAfter = brandIdx >= 0 ? titleLine.slice(brandIdx + "Gadget Hub".length) : "";
const punchHasBrand = brandIdx >= 0;
const useTertiary = Boolean(tertiaryHref && tertiaryLabel);
---

<section class="sig-hero" data-sig-hero aria-labelledby="sig-hero-title">
  <div class="sig-hero__stage" data-sig-stage aria-hidden="true">
    {
      phones.map((phone, i) => (
        <a
          class={`sig-hero__tile sig-hero__tile--${i + 1}`}
          href={phone.href}
          tabindex="-1"
          data-sig-phone
        >
          <img
            src={phone.src}
            srcset={`${phone.src.replace("-1600.", "-800.")} 800w, ${phone.src} 1600w`}
            sizes="50vw"
            alt=""
            width="1600"
            height="1152"
            loading="eager"
            decoding="sync"
            fetchpriority={i === 0 ? "high" : "auto"}
          />
        </a>
      ))
    }
  </div>

  <div class="sig-hero__copy container">
    <p class="sig-hero__eyebrow">{eyebrow}</p>
    <h1 id="sig-hero-title">
      <span class="sig-hero__title-line">{title}</span>
      <span class="sig-hero__title-line">
        {punchBefore}
        {punchHasBrand ? <span class="sig-hero__brand">Gadget Hub</span> : null}
        {punchAfter}
      </span>
    </h1>
    <p class="sig-hero__lede">{lede}</p>
    <div class="sig-hero__actions">
      <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="btn btn--secondary" href={secondaryHref}>{secondaryLabel}</a>
      {
        useTertiary ? (
          <a class="btn btn--secondary" href={tertiaryHref}>{tertiaryLabel}</a>
        ) : (
          <a class="btn btn--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        )
      }
    </div>
  </div>

  {
    reel.length > 0 && (
      <div class="sig-hero__reel" data-sig-reel data-reel={JSON.stringify(reel)} data-shop-links={JSON.stringify(shopLinks)} hidden>
        <div class="sig-hero__reel-stage" data-sig-reel-stage />
        <div class="sig-hero__reel-sting" data-sig-reel-sting aria-hidden="true">
          <img src="/images/logo-mark.png" alt="" width="512" height="512" loading="lazy" />
          <span>Gadget Hub</span>
        </div>
        <img class="sig-hero__reel-mark" src="/images/logo-mark.png" alt="Gadget Hub" width="512" height="512" loading="lazy" />
        <a class="sig-hero__reel-btn sig-hero__reel-btn--shop" data-sig-reel-shop href={shopLinks[0]?.href}>
          Shop {shopLinks[0]?.label} ›
        </a>
      </div>
    )
  }
</section>

<script>
  const root = document.querySelector("[data-sig-hero]");
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    /* 1s total: assemble lands, then open immediately */
    const HOLD_MS = 1000;

    if (reduce) {
      root.classList.add("is-settled");
    } else {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => root.classList.add("is-assembled"));
      });
      window.setTimeout(() => {
        root.classList.add("is-dispersing");
        root.classList.add("is-settled");
      }, HOLD_MS);
    }

    const stage = root.querySelector("[data-sig-stage]");
    if (stage && !reduce) {
      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            if (!root.classList.contains("is-settled")) {
              ticking = false;
              return;
            }
            const y = Math.min(window.scrollY, 240);
            (stage as HTMLElement).style.setProperty("--drift", `${y * 0.04}px`);
            ticking = false;
          });
        },
        { passive: true },
      );
    }

    if (!reduce) setupReel(root);
  }

  type ReelScene =
    | { kind: "video"; large: string; small: string; ms: number }
    | { kind: "image"; src: string; ms: number };
  type ReelGroup = { scenes: ReelScene[] };
  type ShopLink = { label: string; href: string };

  /** Rest on the copy this long, counted from the page having fully loaded. */
  const REEL_DELAY_MS = 30_000;
  /** Stay on the copy if the first scene has not loaded by then. */
  const REEL_START_LIMIT_MS = 8_000;
  const REEL_STING_MS = 1_800;
  const REEL_FADE_MS = 500;
  /** How long the Shop button shows each category. */
  const REEL_SHOP_LINK_MS = 2_500;

  function setupReel(hero: Element) {
    const box = hero.querySelector<HTMLElement>("[data-sig-reel]");
    const stage = box?.querySelector<HTMLElement>("[data-sig-reel-stage]");
    const shop = box?.querySelector<HTMLAnchorElement>("[data-sig-reel-shop]");
    if (!box || !stage || !shop) return;

    // Leave data savers and 2G visitors on the copy.
    const connection = (navigator as any).connection;
    if (connection?.saveData || /2g$/.test(connection?.effectiveType ?? "")) return;

    const groups: ReelGroup[] = JSON.parse(box.dataset.reel ?? "[]");
    const shopLinks: ShopLink[] = JSON.parse(box.dataset.shopLinks ?? "[]");
    let shopIndex = 0;
    let shopTimer = 0;
    const phone = window.matchMedia("(max-width: 47.99rem)").matches;
    let state: "resting" | "due" | "running" | "done" = "resting";
    let heroInView = true;
    let groupIndex = 0;
    let sceneIndex = 0;
    let timer = 0;

    const onScreen = () => heroInView && document.visibilityState === "visible";

    const finish = () => {
      if (state === "done") return;
      state = "done";
      window.clearTimeout(timer);
      window.clearInterval(shopTimer);
      observer.disconnect();
      document.removeEventListener("visibilitychange", sync);
      box.classList.remove("is-playing");
      window.setTimeout(() => {
        stage.replaceChildren();
        box.hidden = true;
      }, 800);
    };

    const buildScene = (scene: ReelScene): HTMLVideoElement | HTMLImageElement => {
      if (scene.kind === "image") {
        const img = new Image();
        img.alt = "";
        img.decoding = "async";
        img.src = scene.src;
        img.style.setProperty("--scene-ms", `${scene.ms + REEL_FADE_MS}ms`);
        return img;
      }
      const video = document.createElement("video");
      // No audio is ever played; muted and playsInline are what let it autoplay on phones.
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.preload = "auto";
      video.disablePictureInPicture = true;
      video.src = phone ? scene.small : scene.large;
      return video;
    };

    const whenReady = (el: HTMLVideoElement | HTMLImageElement, ready: () => void) => {
      let called = false;
      const once = () => {
        if (called) return;
        called = true;
        ready();
      };
      if (el instanceof HTMLVideoElement) el.addEventListener("canplay", once, { once: true });
      else if (el.complete && el.naturalWidth) once();
      else el.addEventListener("load", once, { once: true });
      // A scene that will not load is passed over rather than holding the reel.
      el.addEventListener("error", once, { once: true });
      return once;
    };

    const show = (el: HTMLVideoElement | HTMLImageElement) => {
      const previous = [...stage.children];
      stage.append(el);
      requestAnimationFrame(() => el.classList.add("is-on"));
      window.setTimeout(() => previous.forEach((node) => node.remove()), REEL_FADE_MS + 100);
    };

    const playScene = () => {
      if (state === "done") return;
      const group = groups[groupIndex];
      const scene = group.scenes[sceneIndex];
      const el = buildScene(scene);
      whenReady(el, () => {
        if (state === "done") return;
        if (state === "due") {
          state = "running";
          box.classList.add("is-playing");
        }
        show(el);
        let advanced = false;
        const advance = () => {
          if (advanced) return;
          advanced = true;
          window.clearTimeout(timer);
          next();
        };
        if (el instanceof HTMLVideoElement) {
          el.addEventListener("ended", advance, { once: true });
          void el.play().catch(advance);
          // A stalled network must not freeze the reel.
          timer = window.setTimeout(advance, scene.ms + 3000);
        } else {
          timer = window.setTimeout(advance, scene.ms);
        }
      });
      const upcoming = nextScene();
      if (upcoming) preload(upcoming);
    };

    const nextScene = (): ReelScene | null => {
      const group = groups[groupIndex];
      return group.scenes[sceneIndex + 1] ?? groups[groupIndex + 1]?.scenes[0] ?? null;
    };

    const preload = (scene: ReelScene) => {
      if (scene.kind === "image") new Image().src = scene.src;
    };

    const next = () => {
      sceneIndex += 1;
      if (sceneIndex < groups[groupIndex].scenes.length) return playScene();
      sceneIndex = 0;
      groupIndex += 1;
      // The logo closes every group, so the reel also ends on it.
      box.classList.add("is-sting");
      timer = window.setTimeout(() => {
        box.classList.remove("is-sting");
        if (groupIndex >= groups.length) finish();
        else playScene();
      }, REEL_STING_MS);
    };

    const nextShopLink = () => {
      if (!shopLinks.length) return;
      shopIndex = (shopIndex + 1) % shopLinks.length;
      const link = shopLinks[shopIndex];
      shop.href = link.href;
      shop.textContent = `Shop ${link.label} ›`;
    };

    const start = () => {
      state = "due";
      box.hidden = false;
      shopTimer = window.setInterval(nextShopLink, REEL_SHOP_LINK_MS);
      timer = window.setTimeout(() => {
        if (state === "due") finish();
      }, REEL_START_LIMIT_MS);
      playScene();
    };

    // The reel only plays while it can be seen, so nobody pays for video they cannot see.
    const sync = () => {
      if (state === "due" && !box.hidden) return;
      if (state === "due" && onScreen()) start();
      if (state === "running" && !onScreen()) finish();
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        heroInView = entry.isIntersecting;
        sync();
      },
      { threshold: 0.5 },
    );
    observer.observe(hero);
    document.addEventListener("visibilitychange", sync);

    const rest = () => {
      window.setTimeout(() => {
        if (state !== "resting") return;
        state = "due";
        sync();
      }, REEL_DELAY_MS);
    };
    if (document.readyState === "complete") rest();
    else window.addEventListener("load", rest, { once: true });
  }
</script>

<style>
  .sig-hero {
    --sig-disperse: 1.05s;
    --sig-settle-w: min(36vw, 17.5rem);
    --sig-settle-h: calc(var(--sig-settle-w) * 0.72);
    position: relative;
    isolation: isolate;
    /* The hero starts under the header, so a full screen would push the lower tiles past the fold */
    min-height: calc(100dvh - var(--header-height));
    min-height: calc(100svh - var(--header-height));
    display: grid;
    place-items: center;
    padding-block: var(--space-12);
    background: #ffffff;
    overflow: clip;
  }

  .sig-hero__stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --drift: 0px;
  }

  /* Equal rectangular tiles - shared size/shape always */
  .sig-hero__tile {
    position: absolute;
    display: block;
    overflow: hidden;
    background: #f6f5f8;
    pointer-events: auto;
    transition:
      left var(--sig-disperse) var(--ease-out),
      right var(--sig-disperse) var(--ease-out),
      top var(--sig-disperse) var(--ease-out),
      bottom var(--sig-disperse) var(--ease-out),
      width var(--sig-disperse) var(--ease-out),
      height var(--sig-disperse) var(--ease-out),
      border-radius var(--sig-disperse) var(--ease-out),
      transform var(--sig-disperse) var(--ease-out),
      box-shadow var(--sig-disperse) var(--ease-out),
      opacity 0.6s var(--ease-out);
    will-change: left, top, width, height, transform;
  }

  .sig-hero__tile img {
    width: 100%;
    height: 100%;
    /* Whole product, centred, at every tile shape (the images share this background) */
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /*
   * Phase 1 - full-screen rectangle: 2×2 equal tiles, no gap,
   * flush to hero edges so together they are one solid rectangle.
   */
  .sig-hero__tile--1,
  .sig-hero__tile--2,
  .sig-hero__tile--3,
  .sig-hero__tile--4 {
    width: 50%;
    height: 50%;
    border-radius: 0;
    box-shadow: none;
    opacity: 1;
    transform: none;
  }

  .sig-hero__tile--1 {
    left: 0;
    top: 0;
  }

  .sig-hero__tile--2 {
    left: 50%;
    top: 0;
  }

  .sig-hero__tile--3 {
    left: 0;
    top: 50%;
  }

  .sig-hero__tile--4 {
    left: 50%;
    top: 50%;
  }

  /* Soft entrance: tiles scale in from slightly larger */
  .sig-hero:not(.is-assembled):not(.is-settled) .sig-hero__tile {
    opacity: 0.85;
    transform: scale(1.04);
  }

  .sig-hero.is-assembled:not(.is-settled) .sig-hero__tile {
    transition-duration: 0.55s;
    transform: none;
    opacity: 1;
  }

  /* Phase 2 - float on white: soft elevation + crisp edge so tiles pop */
  .sig-hero.is-settled .sig-hero__tile {
    width: var(--sig-settle-w);
    height: var(--sig-settle-h);
    border-radius: 0.65rem;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.06),
      0 10px 24px rgba(0, 0, 0, 0.08),
      0 28px 56px rgba(0, 0, 0, 0.12);
  }

  .sig-hero.is-settled .sig-hero__tile:hover {
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.08),
      0 14px 28px rgba(0, 0, 0, 0.1),
      0 36px 64px rgba(0, 0, 0, 0.14);
  }

  .sig-hero.is-settled .sig-hero__tile--1 {
    left: 3%;
    top: 6%;
    transform: translateY(var(--drift, 0px));
  }

  .sig-hero.is-settled .sig-hero__tile--2 {
    left: auto;
    right: 3%;
    top: 7%;
    transform: translateY(calc(var(--drift, 0px) * -0.55));
  }

  .sig-hero.is-settled .sig-hero__tile--3 {
    left: 4%;
    top: auto;
    bottom: 8%;
    transform: translateY(calc(var(--drift, 0px) * 0.45));
  }

  .sig-hero.is-settled .sig-hero__tile--4 {
    left: auto;
    right: 4%;
    top: auto;
    bottom: 9%;
    transform: translateY(calc(var(--drift, 0px) * -0.35));
  }

  /* Centre copy - opens as tiles split */
  .sig-hero__copy {
    position: relative;
    z-index: 2;
    max-width: min(52rem, 100%);
    width: 100%;
    text-align: center;
    margin-inline: auto;
    opacity: 0;
    transform: translateY(0.85rem) scale(0.98);
    pointer-events: none;
    color: var(--color-fg);
    transition:
      opacity 0.65s var(--ease-out) 0.05s,
      transform 0.65s var(--ease-out) 0.05s;
  }

  .sig-hero.is-settled .sig-hero__copy,
  .sig-hero.is-dispersing .sig-hero__copy {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .sig-hero__eyebrow {
    font-size: clamp(0.68rem, 1.6vw, 0.78rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-3);
    line-height: var(--leading-snug);
    max-width: 34rem;
    margin-inline: auto;
  }

  .sig-hero h1 {
    font-family: var(--font-hero);
    font-size: clamp(1.35rem, 4.2vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    color: var(--color-fg);
  }

  .sig-hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .sig-hero__brand {
    font-family: inherit;
    font-weight: inherit;
  }

  .sig-hero__lede {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-6);
    line-height: var(--leading-normal);
    max-width: 32rem;
    margin-inline: auto;
  }

  .sig-hero__actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
  }

  .sig-hero__actions :global(.btn) {
    flex: 0 1 auto;
    white-space: nowrap;
    font-size: 0.78rem;
    padding: 0.4rem 0.7rem;
    min-height: 2rem;
    line-height: 1.2;
  }

  /* Silent reel: fills the hero at every screen shape, so there are never bars */
  .sig-hero__reel {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    background: #000;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.8s var(--ease-out),
      visibility 0s linear 0.8s;
  }

  .sig-hero__reel[hidden] {
    display: none;
  }

  .sig-hero__reel.is-playing {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.8s var(--ease-out);
  }

  .sig-hero__reel-stage {
    position: absolute;
    inset: 0;
  }

  .sig-hero__reel-stage :global(video),
  .sig-hero__reel-stage :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .sig-hero__reel-stage :global(.is-on) {
    opacity: 1;
  }

  .sig-hero__reel-stage :global(img) {
    animation: sig-reel-drift var(--scene-ms, 4s) linear both;
    will-change: transform;
  }

  @keyframes sig-reel-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  @keyframes sig-reel-pan {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Wide images on a tall screen: pan across the whole product instead of cropping it */
  @media (max-aspect-ratio: 1 / 1) {
    .sig-hero__reel .sig-hero__reel-stage :global(img) {
      right: auto;
      width: 200%;
      max-width: none;
      animation-name: sig-reel-pan;
    }
  }

  .sig-hero__reel-sting {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    background: #000;
    color: #fff;
    font-family: var(--font-hero);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .sig-hero__reel-sting img {
    width: clamp(4.5rem, 10vw, 7rem);
    height: auto;
    transform: scale(0.82);
    transition: transform 1.6s var(--ease-out);
  }

  .sig-hero__reel.is-sting .sig-hero__reel-sting {
    opacity: 1;
  }

  .sig-hero__reel.is-sting .sig-hero__reel-sting img {
    transform: scale(1);
  }

  /* The logo stays on the reel. Controls sit at the top, clear of the floating buttons */
  .sig-hero__reel-mark {
    position: absolute;
    bottom: 0.85rem;
    left: 50%;
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    transform: translateX(-50%);
    border-radius: 0.5rem;
  }

  .sig-hero__reel-btn {
    position: absolute;
    top: 0.85rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .sig-hero__reel-btn:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  .sig-hero__reel-btn--shop {
    left: 0.85rem;
    background: #fff;
    color: #000;
  }

  .sig-hero__reel-btn--shop:hover {
    background: #e8e8ed;
  }

  @media (max-width: 47.99rem) {
    .sig-hero {
      /* Corner tiles: slightly larger, still leave room for centre copy */
      --sig-settle-w: min(36vw, 8.85rem);
      --sig-settle-h: calc(var(--sig-settle-w) * 0.72);
      min-height: min(100dvh, 36rem);
      padding-block: calc(var(--header-height) + 0.75rem) 1.25rem;
      place-items: center;
    }

    .sig-hero.is-settled .sig-hero__tile--1 {
      left: 3%;
      top: calc(var(--header-height) + 0.35rem);
    }

    .sig-hero.is-settled .sig-hero__tile--2 {
      right: 3%;
      top: calc(var(--header-height) + 0.5rem);
    }

    .sig-hero.is-settled .sig-hero__tile--3 {
      left: 3.5%;
      bottom: 4%;
    }

    .sig-hero.is-settled .sig-hero__tile--4 {
      right: 3.5%;
      bottom: 4.5%;
    }

    .sig-hero__copy {
      padding-inline: var(--space-3);
      max-width: min(20.5rem, 100%);
