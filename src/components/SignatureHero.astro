---
/**
 * Signature home hero - four equal rectangular tiles fill the viewport
 * as one solid rectangle, hold ~2s, then split to the corners while
 * centred copy opens. Respects prefers-reduced-motion.
 */
import { whatsappUrl } from "../lib/site";
import type { HeroPhone } from "../lib/home";
import { homeOpt } from "../lib/home-images";

interface Props {
  eyebrow?: string;
  title?: string;
  titleLine?: string;
  lede?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  /** Third CTA (replaces hero WhatsApp when set) */
  tertiaryHref?: string;
  tertiaryLabel?: string;
  phones: [HeroPhone, HeroPhone, HeroPhone, HeroPhone];
}

const {
  eyebrow = "Gadget Hub · Norwich House Nairobi · Verified Apple Reseller",
  title = "Some People Buy Phones,",
  titleLine = "Some Come At Gadget Hub",
  lede = "Your New iPhone is here, Come, Have the Feeling.",
  primaryHref = "/shop",
  primaryLabel = "Shop Apple",
  secondaryHref = "/trade-in",
  secondaryLabel = "Trade-in",
  tertiaryHref = "/lipa-mdogo-mdogo",
  tertiaryLabel = "Lipa Mdogo Mdogo",
  phones,
} = Astro.props;

const wa = whatsappUrl("Hello Gadget Hub, I'd like to shop Apple products.");
const brandIdx = titleLine.indexOf("Gadget Hub");
const punchBefore = brandIdx >= 0 ? titleLine.slice(0, brandIdx) : titleLine;
const punchAfter = brandIdx >= 0 ? titleLine.slice(brandIdx + "Gadget Hub".length) : "";
const punchHasBrand = brandIdx >= 0;
const useTertiary = Boolean(tertiaryHref && tertiaryLabel);
---

<section class="sig-hero" data-sig-hero aria-labelledby="sig-hero-title">
  <div class="sig-hero__stage" data-sig-stage aria-hidden="true">
    {
      phones.map((phone, i) => (
        <a
          class={`sig-hero__tile sig-hero__tile--${i + 1}`}
          href={phone.href}
          tabindex="-1"
          data-sig-phone
        >
          <img
            src={homeOpt(phone.src)}
            alt=""
            width="960"
            height="720"
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={i === 0 ? "high" : "auto"}
            sizes="(min-width: 64rem) 25vw, 50vw"
          />
        </a>
      ))
    }
  </div>

  <div class="sig-hero__copy container">
    <p class="sig-hero__eyebrow">{eyebrow}</p>
    <h1 id="sig-hero-title">
      <span class="sig-hero__title-line">{title}</span>
      <span class="sig-hero__title-line">
        {punchBefore}
        {punchHasBrand ? <span class="sig-hero__brand">Gadget Hub</span> : null}
        {punchAfter}
      </span>
    </h1>
    <p class="sig-hero__lede">{lede}</p>
    <div class="sig-hero__actions">
      <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="btn btn--secondary" href={secondaryHref}>{secondaryLabel}</a>
      {
        useTertiary ? (
          <a class="btn btn--secondary" href={tertiaryHref}>{tertiaryLabel}</a>
        ) : (
          <a class="btn btn--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-sig-hero]");
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    /* 1s total: assemble lands, then open immediately */
    const HOLD_MS = 1000;

    if (reduce) {
      root.classList.add("is-settled");
    } else {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => root.classList.add("is-assembled"));
      });
      window.setTimeout(() => {
        root.classList.add("is-dispersing");
        root.classList.add("is-settled");
      }, HOLD_MS);
    }

    const stage = root.querySelector("[data-sig-stage]");
    if (stage && !reduce) {
      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            if (!root.classList.contains("is-settled")) {
              ticking = false;
              return;
            }
            const y = Math.min(window.scrollY, 240);
            (stage as HTMLElement).style.setProperty("--drift", `${y * 0.04}px`);
            ticking = false;
          });
        },
        { passive: true },
      );
    }
  }
</script>

<style>
  .sig-hero {
    --sig-disperse: 1.05s;
    --sig-settle-w: min(36vw, 17.5rem);
    --sig-settle-h: calc(var(--sig-settle-w) * 0.72);
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding-block: var(--space-12);
    background: #ffffff;
    overflow: clip;
  }

  .sig-hero__stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --drift: 0px;
  }

  /* Equal rectangular tiles - shared size/shape always */
  .sig-hero__tile {
    position: absolute;
    display: block;
    overflow: hidden;
    background: #e8e8ed;
    pointer-events: auto;
    transition:
      left var(--sig-disperse) var(--ease-out),
      right var(--sig-disperse) var(--ease-out),
      top var(--sig-disperse) var(--ease-out),
      bottom var(--sig-disperse) var(--ease-out),
      width var(--sig-disperse) var(--ease-out),
      height var(--sig-disperse) var(--ease-out),
      border-radius var(--sig-disperse) var(--ease-out),
      transform var(--sig-disperse) var(--ease-out),
      box-shadow var(--sig-disperse) var(--ease-out),
      opacity 0.6s var(--ease-out);
    will-change: left, top, width, height, transform;
  }

  .sig-hero__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /*
   * Phase 1 - full-screen rectangle: 2×2 equal tiles, no gap,
   * flush to hero edges so together they are one solid rectangle.
   */
  .sig-hero__tile--1,
  .sig-hero__tile--2,
  .sig-hero__tile--3,
  .sig-hero__tile--4 {
    width: 50%;
    height: 50%;
    border-radius: 0;
    box-shadow: none;
    opacity: 1;
    transform: none;
  }

  .sig-hero__tile--1 {
    left: 0;
    top: 0;
  }

  .sig-hero__tile--2 {
    left: 50%;
    top: 0;
  }

  .sig-hero__tile--3 {
    left: 0;
    top: 50%;
  }

  .sig-hero__tile--4 {
    left: 50%;
    top: 50%;
  }

  /* Soft entrance: tiles scale in from slightly larger */
  .sig-hero:not(.is-assembled):not(.is-settled) .sig-hero__tile {
    opacity: 0.85;
    transform: scale(1.04);
  }

  .sig-hero.is-assembled:not(.is-settled) .sig-hero__tile {
    transition-duration: 0.55s;
    transform: none;
    opacity: 1;
  }

  /* Phase 2 - float on white: soft elevation + crisp edge so tiles pop */
  .sig-hero.is-settled .sig-hero__tile {
    width: var(--sig-settle-w);
    height: var(--sig-settle-h);
    border-radius: 0.65rem;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.06),
      0 10px 24px rgba(0, 0, 0, 0.08),
      0 28px 56px rgba(0, 0, 0, 0.12);
  }

  .sig-hero.is-settled .sig-hero__tile:hover {
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.08),
      0 14px 28px rgba(0, 0, 0, 0.1),
      0 36px 64px rgba(0, 0, 0, 0.14);
  }

  .sig-hero.is-settled .sig-hero__tile--1 {
    left: 3%;
    top: 6%;
    transform: translateY(var(--drift, 0px));
  }

  .sig-hero.is-settled .sig-hero__tile--2 {
    left: auto;
    right: 3%;
    top: 7%;
    transform: translateY(calc(var(--drift, 0px) * -0.55));
  }

  .sig-hero.is-settled .sig-hero__tile--3 {
    left: 4%;
    top: auto;
    bottom: 8%;
    transform: translateY(calc(var(--drift, 0px) * 0.45));
  }

  .sig-hero.is-settled .sig-hero__tile--4 {
    left: auto;
    right: 4%;
    top: auto;
    bottom: 9%;
    transform: translateY(calc(var(--drift, 0px) * -0.35));
  }

  /* Centre copy - opens as tiles split */
  .sig-hero__copy {
    position: relative;
    z-index: 2;
    max-width: min(52rem, 100%);
    width: 100%;
    text-align: center;
    margin-inline: auto;
    opacity: 0;
    transform: translateY(0.85rem) scale(0.98);
    pointer-events: none;
    color: var(--color-fg);
    transition:
      opacity 0.65s var(--ease-out) 0.05s,
      transform 0.65s var(--ease-out) 0.05s;
  }

  .sig-hero.is-settled .sig-hero__copy,
  .sig-hero.is-dispersing .sig-hero__copy {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .sig-hero__eyebrow {
    font-size: clamp(0.68rem, 1.6vw, 0.78rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-3);
    line-height: var(--leading-snug);
    max-width: 34rem;
    margin-inline: auto;
  }

  .sig-hero h1 {
    font-family: var(--font-hero);
    font-size: clamp(1.35rem, 4.2vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.08;
    margin-bottom: var(--space-4);
    color: var(--color-fg);
  }

  .sig-hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .sig-hero__brand {
    font-family: inherit;
    font-weight: inherit;
  }

  .sig-hero__lede {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-6);
    line-height: var(--leading-normal);
    max-width: 32rem;
    margin-inline: auto;
  }

  .sig-hero__actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
  }

  .sig-hero__actions :global(.btn) {
    flex: 0 1 auto;
    white-space: nowrap;
    font-size: 0.78rem;
    padding: 0.4rem 0.7rem;
    min-height: 2rem;
    line-height: 1.2;
  }

  @media (max-width: 47.99rem) {
    .sig-hero {
      /* Corner tiles: slightly larger, still leave room for centre copy */
      --sig-settle-w: min(36vw, 8.85rem);
      --sig-settle-h: calc(var(--sig-settle-w) * 0.72);
      min-height: min(100dvh, 36rem);
      padding-block: calc(var(--header-height) + 0.75rem) 1.25rem;
      place-items: center;
    }

    .sig-hero.is-settled .sig-hero__tile--1 {
      left: 3%;
      top: calc(var(--header-height) + 0.35rem);
    }

    .sig-hero.is-settled .sig-hero__tile--2 {
      right: 3%;
      top: calc(var(--header-height) + 0.5rem);
    }

    .sig-hero.is-settled .sig-hero__tile--3 {
      left: 3.5%;
      bottom: 4%;
    }

    .sig-hero.is-settled .sig-hero__tile--4 {
      right: 3.5%;
      bottom: 4.5%;
    }

    .sig-hero__copy {
      padding-inline: var(--space-3);
      max-width: min(20.5rem, 100%);
    }

    .sig-hero__eyebrow {
      font-size: 0.62rem;
      letter-spacing: 0.04em;
      margin-bottom: 0.45rem;
      max-width: 16rem;
    }

    .sig-hero h1 {
      font-size: clamp(1.05rem, 5.2vw, 1.45rem);
      line-height: 1.12;
      margin-bottom: 0.55rem;
    }

    .sig-hero__title-line {
      white-space: normal;
    }

    .sig-hero__lede {
      font-size: 0.82rem;
      line-height: 1.35;
      margin-bottom: 0.85rem;
      max-width: 17.5rem;
    }

    .sig-hero__actions {
      gap: 0.28rem;
      max-width: 100%;
    }

    .sig-hero__actions :global(.btn) {
      flex: 1 1 0;
      font-size: 0.62rem;
      padding: 0.32rem 0.35rem;
      min-height: 1.75rem;
      letter-spacing: -0.01em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sig-hero__tile,
    .sig-hero__copy {
      transition: none;
    }

    .sig-hero:not(.is-assembled):not(.is-settled) .sig-hero__tile {
      opacity: 1;
      transform: none;
    }
  }
</style>
