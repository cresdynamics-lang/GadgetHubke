---
/**
 * "Price in Kenya" table + structured data for an accessory group page
 * (Apple Pencil, Cases, Magic Keyboard, ...). Prices are live admin prices.
 * The FAQ schema mirrors the FAQ already shown on the page, as Google requires.
 */
import { livePricedCatalog } from "../../lib/pricing/live";
import { offerExtras } from "../../lib/seo/offer-schema";
import { formatKes } from "../../lib/seo/product-seo";
import { site } from "../../lib/site";

interface Props {
  /** "Apple Pencil" */
  name: string;
  /** Site-relative page path, e.g. /accessories/apple-pencil */
  path: string;
  productIds: string[];
  faq: { q: string; a: string }[];
}

const { name, path, productIds, faq } = Astro.props;
const byId = new Map((await livePricedCatalog()).map((p) => [p.id, p]));
const rows = productIds.map((id) => byId.get(id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const url = new URL(path, site.url).href;
const extras = offerExtras();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      name: `${name} price in Kenya`,
      url,
      numberOfItems: rows.length,
      itemListElement: rows.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "Product",
          name: p.name,
          url: new URL(p.href, site.url).href,
          brand: { "@type": "Brand", name: "Apple" },
          offers: {
            "@type": "Offer",
            price: p.priceKes,
            priceCurrency: "KES",
            itemCondition: "https://schema.org/NewCondition",
            availability: p.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
            url: new URL(p.href, site.url).href,
            ...extras,
          },
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.url },
        { "@type": "ListItem", position: 2, name: "Accessories", item: `${site.url}/accessories` },
        { "@type": "ListItem", position: 3, name, item: url },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<section class="xgroup-prices container" aria-labelledby="xgroup-prices-title">
  <h2 id="xgroup-prices-title">{name} price in Kenya</h2>
  <p class="xgroup-prices__lede">
    Genuine Apple {name.toLowerCase().startsWith("apple") ? name.slice(6) : name} at Gadget Hub, Norwich Union House, Nairobi CBD. Live prices, including VAT where it applies.
  </p>
  <div class="xgroup-prices__wrap">
    <table class="xgroup-prices__table">
      <thead>
        <tr><th scope="col">Model</th><th scope="col">Price (KES)</th><th scope="col">Availability</th></tr>
      </thead>
      <tbody>
        {
          rows.map((p) => (
            <tr>
              <th scope="row"><a href={p.href}>{p.name}</a></th>
              <td>{formatKes(p.priceKes)}</td>
              <td>{p.inStock ? "In stock" : "Ask on WhatsApp"}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .xgroup-prices { margin: 2.5rem auto; max-width: 860px; }
  .xgroup-prices h2 { font-size: clamp(1.3rem, 2.6vw, 1.75rem); letter-spacing: -0.02em; margin: 0 0 0.5rem; }
  .xgroup-prices__lede { color: #3a3a3c; line-height: 1.6; margin: 0 0 1rem; }
  .xgroup-prices__wrap { overflow-x: auto; }
  .xgroup-prices__table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .xgroup-prices__table th, .xgroup-prices__table td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid #e5e5ea; }
  .xgroup-prices__table thead th { color: #6e6e73; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .xgroup-prices__table td:nth-child(2) { font-weight: 600; white-space: nowrap; }
  .xgroup-prices__table a { color: #0066cc; }
</style>
