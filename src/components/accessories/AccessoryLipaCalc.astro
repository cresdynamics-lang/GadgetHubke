---
import { accessoriesConfig, formatKes, lipaBreakdown, accessories } from "../../lib/accessories";
import { lipaCalcOptions } from "../../lib/listing-offers";
import { livePricedCatalog } from "../../lib/pricing/live";

interface Props {
  productId?: string;
}

const { productId } = Astro.props;
// Only products on the live list, at their listed prices.
const products = lipaCalcOptions(accessories.filter((a) => a.stocked !== false), await livePricedCatalog())
  .map((o) => ({ id: o.id, name: o.name, kes: o.base || o.exUk }));
const initial = products.find((p) => p.id === productId) || products[0];
const lipa = accessoriesConfig.lipa;
---

{initial ? (
<section class="xlipa" id="lipa" data-xlipa>
  <div class="container">
    <h2>Lipa Mdogo Mdogo</h2>
    <p class="xlipa__note">{lipa.note}</p>
    <label>
      Product
      <select data-lipa-product>
        {
          products.map((p) => (
            <option value={p.id} data-kes={p.kes} selected={p.id === initial.id}>
              {p.name} - {formatKes(p.kes)}
            </option>
          ))
        }
      </select>
    </label>
    <label>
      Deposit <span data-lipa-deposit-label>{lipa.depositDefaultPct}%</span>
      <input
        type="range"
        data-lipa-deposit
        min={lipa.depositMinPct}
        max={lipa.depositMaxPct}
        step={lipa.depositStepPct}
        value={lipa.depositDefaultPct}
      />
      <span class="xlipa__hint">Minimum deposit is {lipa.depositMinPct}%. Range {lipa.depositMinPct}-{lipa.depositMaxPct}%.</span>
    </label>
    <label>
      Months
      <select data-lipa-months>
        {lipa.monthOptions.map((m) => (
          <option value={m} selected={m === lipa.monthsDefault}>{m} {m === 1 ? "month" : "months"}</option>
        ))}
      </select>
    </label>
    <div class="xlipa__out" data-lipa-out aria-live="polite"></div>
  </div>
</section>
) : null}

<script>
  import { lipaPlan } from "../../lib/pricing/lipa";

  const root = document.querySelector("[data-xlipa]");
  const product = root?.querySelector("[data-lipa-product]");
  const deposit = root?.querySelector("[data-lipa-deposit]");
  const depositLabel = root?.querySelector("[data-lipa-deposit-label]");
  const months = root?.querySelector("[data-lipa-months]");
  const out = root?.querySelector("[data-lipa-out]");

  function kes(n) {
    return `KES ${n.toLocaleString("en-KE")}`;
  }

  function render() {
    const opt = product?.selectedOptions?.[0];
    const price = Number(opt?.dataset.kes || 0);
    const depPct = Number(deposit?.value || 40);
    const mo = Number(months?.value || 6);
    const { depositKes, monthlyKes: monthly, totalKes } = lipaPlan(price, depPct, mo);
    if (depositLabel) depositLabel.textContent = `${depPct}%`;
    if (out) {
      out.innerHTML = `
        <p><strong>Deposit</strong> ${kes(depositKes)}</p>
        <p><strong>Monthly</strong> ${kes(monthly)} × ${mo}</p>
        <p><strong>Total</strong> ${kes(totalKes)}</p>`;
    }
  }
  product?.addEventListener("change", render);
  deposit?.addEventListener("input", render);
  months?.addEventListener("change", render);
  render();
</script>

<style>
  .xlipa {
    padding: 3rem 0;
    border-top: 1px solid #d2d2d7;
  }
  .xlipa label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0.85rem 0;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .xlipa select,
  .xlipa input[type="range"] {
    max-width: 28rem;
  }
  .xlipa__note,
  .xlipa__fine {
    color: #6e6e73;
    font-size: 0.85rem;
  }
  .xlipa__out p {
    margin: 0.35rem 0;
  }
  .xlipa__hint {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #6e6e73;
  }
</style>
