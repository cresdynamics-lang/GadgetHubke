---
import AccessoryStage from "./AccessoryStage.astro";
import {
  type Accessory,
  getAccessoryImage,
  formatKes,
  lipaMonthly,
} from "../../lib/accessories";

interface Props {
  product: Accessory;
  compare?: boolean;
  fitsLine?: string;
}

const { product, compare = true, fitsLine } = Astro.props;
const img = getAccessoryImage(product.id, "hero");
const lipa = lipaMonthly(product.basePriceKes);
const isPencil = product.group === "pencil";
---

<article class="xcard" data-accessory-card data-id={product.id}>
  <a class="xcard__media" href={`/accessories/${product.id}`}>
    <AccessoryStage
      src={img.src}
      srcWebp={img.srcWebp}
      alt={img.alt}
      width={img.width}
      height={img.width}
      ratio={isPencil ? "square" : "wide"}
      designOnly={img.designOnly || product.overviewOnly}
    />
  </a>
  <div class="xcard__body">
    <h3><a href={`/accessories/${product.id}`}>{product.name}</a></h3>
    <p class="xcard__sub">{product.tagline}</p>
    {fitsLine ? <p class="xcard__fits">{fitsLine}</p> : <p class="xcard__fits">{product.notes}</p>}
    <p class="xcard__colour">Colour: {product.defaultColour}</p>
    <p class="xcard__price">
      From {formatKes(product.basePriceKes)}
      <small>or {formatKes(lipa.monthlyKes)} / mo</small>
    </p>
    <p class="xcard__fine">Sample price until stock is entered in the admin.</p>
    <div class="xcard__actions">
      <a class="btn btn--primary btn--sm" href={`/accessories/${product.id}`}>View</a>
      <button
        type="button"
        class="btn btn--secondary btn--sm"
        data-accessory-bag
        data-id={product.id}
        data-name={product.name}
        data-colour={product.defaultColour}
        data-kes={product.basePriceKes}
        data-image={img.src}
        data-group={product.group}
      >
        Add to bag
      </button>
      {
        compare ? (
          <label class="xcard__compare">
            <input type="checkbox" data-accessory-compare value={product.id} data-group={product.group} />
            Compare
          </label>
        ) : null
      }
    </div>
  </div>
</article>

<script>
  document.querySelectorAll("[data-accessory-bag]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const el = btn as HTMLElement;
      window.dispatchEvent(
        new CustomEvent("gh:bag-add", {
          detail: {
            id: el.dataset.id,
            name: el.dataset.name,
            colour: el.dataset.colour,
            kes: Number(el.dataset.kes),
            image: el.dataset.image,
            group: el.dataset.group,
            kind: "accessory",
            deviceFor: el.dataset.deviceFor || null,
          },
        }),
      );
    });
  });
</script>

<style>
  .xcard {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: transform 200ms ease;
  }
  .xcard:hover {
    transform: translateY(-6px);
  }
  @media (prefers-reduced-motion: reduce) {
    .xcard {
      transition: none;
    }
    .xcard:hover {
      transform: none;
    }
  }
  .xcard__body h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .xcard__body h3 a {
    color: inherit;
    text-decoration: none;
  }
  .xcard__sub,
  .xcard__fits,
  .xcard__colour,
  .xcard__fine {
    margin: 0.25rem 0 0;
    color: #6e6e73;
    font-size: 0.875rem;
  }
  .xcard__fits {
    color: #1d1d1f;
  }
  .xcard__price {
    margin: 0.5rem 0 0;
    font-weight: 700;
  }
  .xcard__price small {
    display: block;
    font-weight: 400;
    color: #6e6e73;
  }
  .xcard__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.65rem;
  }
  .xcard__compare {
    font-size: 0.8rem;
    color: #6e6e73;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
</style>
