---
import AccessoryStage from "./AccessoryStage.astro";
import {
  type Accessory,
  getAccessoryImage,
} from "../../lib/accessories";
import { whatsappUrl } from "../../lib/site";

interface Props {
  product: Accessory;
  compare?: boolean;
  fitsLine?: string;
}

const { product, compare = true, fitsLine } = Astro.props;
const img = getAccessoryImage(product.id, "hero");
const hoverCandidates = ["angle:0", "angle:1", "angle:2"].map((k) =>
  getAccessoryImage(product.id, k),
);
const hoverImg = hoverCandidates.find((h) => !h.fallback && h.src !== img.src);
const hoverSrc = hoverImg?.src || "";
const wa = whatsappUrl(`Hello Gadget Hub, I'm interested in the ${product.name}.`);
const isPencil = product.group === "pencil";
---

<article class="xcard" data-accessory-card data-id={product.id}>
  <a class:list={["xcard__media", { "xcard__media--swap": Boolean(hoverSrc) }]} href={`/accessories/${product.id}`}>
    <AccessoryStage
      src={img.src}
      srcWebp={img.srcWebp}
      alt={img.alt}
      width={img.width}
      height={img.width}
      ratio={isPencil ? "square" : "wide"}
      designOnly={img.designOnly || product.overviewOnly}
    />
    {
      hoverSrc ? (
        <img
          class="xcard__img-alt"
          src={hoverSrc}
          alt=""
          width={img.width}
          height={img.width}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      ) : null
    }
  </a>
  <div class="xcard__body">
    <h3><a href={`/accessories/${product.id}`}>{product.name}</a></h3>
    <p class="xcard__sub">{product.tagline}</p>
    {fitsLine ? <p class="xcard__fits">{fitsLine}</p> : <p class="xcard__fits">{product.notes}</p>}
    <p class="xcard__colour">Colour: {product.defaultColour}</p>
    <div class="xcard__row xcard__row--price">
      <p class="xcard__price">
        <span data-live-price={product.id} data-live-prefix="">{`KSh ${Math.round(product.basePriceKes).toLocaleString("en-KE")}`}</span>
      </p>
    </div>
    <div class="xcard__row xcard__row--links">
      <a class="btn btn--primary btn--xs" href={`/accessories/${product.id}`}>Details</a>
      <a class="btn btn--whatsapp btn--xs" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
    {
      compare ? (
        <label class="xcard__compare">
          <input type="checkbox" data-accessory-compare value={product.id} data-group={product.group} />
          Compare
        </label>
      ) : null
    }
  </div>
</article>

<script>
  document.querySelectorAll("[data-accessory-bag]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const el = btn as HTMLElement;
      window.dispatchEvent(
        new CustomEvent("gh:bag-add", {
          detail: {
            id: el.dataset.id,
            name: el.dataset.name,
            colour: el.dataset.colour,
            kes: Number(el.dataset.kes),
            image: el.dataset.image,
            group: el.dataset.group,
            kind: "accessory",
            deviceFor: el.dataset.deviceFor || null,
          },
        }),
      );
    });
  });
</script>

<style>
  .xcard {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: transform 200ms ease;
  }
  .xcard:hover {
    transform: translateY(-6px);
  }
  .xcard__media {
    position: relative;
    display: block;
    text-decoration: none;
  }
  .xcard__media :global(.xstage img) {
    transition: opacity 0.35s ease;
  }
  .xcard__img-alt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    mix-blend-mode: multiply;
  }
  .xcard__media--swap:hover :global(.xstage img) {
    opacity: 0;
  }
  .xcard__media--swap:hover .xcard__img-alt {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .xcard {
      transition: none;
    }
    .xcard:hover {
      transform: none;
    }
    .xcard__media :global(.xstage img),
    .xcard__img-alt {
      transition: none;
    }
    .xcard__media--swap:hover :global(.xstage img) {
      opacity: 1;
    }
    .xcard__media--swap:hover .xcard__img-alt {
      opacity: 0;
    }
  }
  .xcard__body h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .xcard__body h3 a {
    color: inherit;
    text-decoration: none;
  }
  .xcard__sub,
  .xcard__fits,
  .xcard__colour,
  .xcard__fine {
    margin: 0.25rem 0 0;
    color: #6e6e73;
    font-size: 0.875rem;
  }
  .xcard__fits {
    color: #1d1d1f;
  }
  .xcard__row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.65rem;
  }
  .xcard__row--links {
    margin-top: 0.4rem;
  }
  .xcard__price {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .xcard__row .btn {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    white-space: nowrap;
  }
  .xcard__row--price .btn {
    flex: 0 0 auto;
  }
  .xcard__compare {
    margin-top: 0.45rem;
    font-size: 0.8rem;
    color: #6e6e73;
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  /* Price and Add to cart never touch: smaller type on narrow cards, and the
     button drops under the price when the card is too narrow for both. */
  .xcard__row--price {
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 0.5rem;
    row-gap: 0.4rem;
  }
  .xcard__row--price .xcard__price,
  .xcard__row--price .xcard__price * {
    font-size: clamp(0.74rem, 2.9vw, 0.85rem);
  }
  .xcard__row--price :global(.btn) {
    flex: 0 0 auto;
    font-size: clamp(0.66rem, 2.6vw, 0.75rem);
    padding: 0.28rem 0.55rem;
    min-height: 1.75rem;
  }
</style>
