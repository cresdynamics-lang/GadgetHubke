---
/**
 * Compact Accessories nav flyout - category links + shop all.
 */
import {
  getAccessory,
  getAccessoryImage,
  formatKes,
  type Accessory,
} from "../../lib/accessories";

function previewFor(a: Accessory) {
  const img = getAccessoryImage(a.id, "hero");
  return {
    id: a.id,
    name: a.name,
    href: `/accessories/${a.id}`,
    priceLabel: formatKes(a.basePriceKes),
    src: img.src,
    alt: img.alt,
  };
}

const featuredIds = [
  "pencil-pro",
  "keyboard-ipad-pro-13",
  "mouse-usbc-black",
  "power-adapter-70w",
  "case-iphone-17-pro-silicone",
] as const;

const picks = featuredIds
  .map((id) => getAccessory(id))
  .filter(Boolean)
  .map((a) => previewFor(a as Accessory));

const defaultPreview = picks[0] || previewFor(getAccessory("pencil-pro")!);
const previews = Object.fromEntries(picks.map((p) => [p.id, p]));

const groups = [
  { label: "Apple Pencil", href: "/accessories/apple-pencil" },
  { label: "Magic Keyboard", href: "/accessories/magic-keyboard" },
  { label: "Magic Mouse", href: "/accessories/magic-mouse" },
  { label: "Power", href: "/accessories/power" },
  { label: "Cases", href: "/accessories/cases" },
];
---

<div class="xmega" data-xmega>
  <div class="xmega__cols">
    <div class="xmega__col">
      <p class="xmega__heading">Shop by type</p>
      <ul>
        {
          groups.map((g) => (
            <li>
              <a class="xmega__link" href={g.href}>{g.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="xmega__all" href="/accessories">Shop all Accessories</a>
    </div>

    <div class="xmega__col">
      <p class="xmega__heading">Featured</p>
      <ul>
        {
          picks.map((p) => (
            <li>
              <a class="xmega__link" href={p.href} data-mega-preview={p.id}>
                <span>{p.name}</span>
                <em>from {p.priceLabel}</em>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="xmega__preview" data-mega-card>
      <div class="xmega__stage">
        <img
          data-mega-img
          src={defaultPreview.src}
          alt={defaultPreview.alt}
          width="240"
          height="240"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p data-mega-name class="xmega__pname">{defaultPreview.name}</p>
      <p data-mega-price class="xmega__pprice">
        <strong>From {defaultPreview.priceLabel}</strong>
      </p>
      <a class="btn btn--primary btn--sm" data-mega-view href={defaultPreview.href}>View</a>
    </div>
  </div>
</div>

<script define:vars={{ previews, defaultPreview }}>
  const root = document.querySelector("[data-xmega]");
  if (root) {
    const img = root.querySelector("[data-mega-img]");
    const name = root.querySelector("[data-mega-name]");
    const price = root.querySelector("[data-mega-price]");
    const view = root.querySelector("[data-mega-view]");

    function show(id) {
      const p = previews[id] || defaultPreview;
      if (img instanceof HTMLImageElement) {
        img.src = p.src;
        img.alt = p.alt;
      }
      if (name) name.textContent = p.name;
      if (price) price.innerHTML = `<strong>From ${p.priceLabel}</strong>`;
      if (view instanceof HTMLAnchorElement) view.href = p.href;
    }

    root.querySelectorAll("[data-mega-preview]").forEach((el) => {
      el.addEventListener("pointerenter", () => show(el.getAttribute("data-mega-preview")));
      el.addEventListener("focus", () => show(el.getAttribute("data-mega-preview")));
    });
  }
</script>

<style>
  .xmega {
    padding: 0.25rem 0 0.5rem;
  }
  .xmega__cols {
    display: grid;
    grid-template-columns: 0.9fr 1.2fr 0.85fr;
    gap: 1.5rem;
    align-items: start;
  }
  .xmega__heading {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6e6e73;
    margin: 0 0 0.5rem;
  }
  .xmega__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .xmega__link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.4rem 0;
    color: #1d1d1f;
    text-decoration: none;
    font-size: 0.875rem;
  }
  .xmega__link:hover,
  .xmega__link:focus-visible {
    text-decoration: underline;
  }
  .xmega__link em {
    font-style: normal;
    color: #6e6e73;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .xmega__all {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1d1d1f;
  }
  .xmega__preview {
    background: #f5f5f7;
    border-radius: 1rem;
    padding: 0.85rem;
  }
  .xmega__stage {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin-bottom: 0.5rem;
  }
  .xmega__stage img {
    width: 78%;
    height: auto;
    object-fit: contain;
  }
  .xmega__pname {
    margin: 0;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .xmega__pprice {
    margin: 0.25rem 0 0.65rem;
    font-size: 0.875rem;
  }
  @media (max-width: 1019px) {
    .xmega {
      display: none;
    }
  }
</style>
