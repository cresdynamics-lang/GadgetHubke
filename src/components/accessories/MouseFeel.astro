---
import {
  getAccessoryImage,
  accessoriesConfig,
  mice,
} from "../../lib/accessories";

const white = getAccessoryImage("mouse-usbc-white", "hero");
const black = getAccessoryImage("mouse-usbc-black", "hero");
const angle0 = getAccessoryImage("mouse-usbc-white", "angle:0");
const angle2 = getAccessoryImage("mouse-usbc-white", "angle:2");
const angleBlack = getAccessoryImage("mouse-usbc-black", "angle:0");
const inUse = getAccessoryImage("mouse-usbc-black", "in-use");

const gestures = [
  {
    id: "scroll",
    label: "Scroll",
    how: "Slide one finger up or down on the surface to scroll.",
    blurb: "No scroll wheel - the Multi-Touch surface handles it.",
  },
  {
    id: "secondary_click",
    label: "Secondary click",
    how: "Click on the right side of the surface, or tap with two fingers.",
    blurb: "Opens contextual menus the same way a right-click would.",
  },
  {
    id: "smart_zoom",
    label: "Smart zoom",
    how: "Double-tap with one finger to zoom in or out on a webpage or PDF.",
    blurb: "Quick zoom without pinching.",
  },
  {
    id: "swipe_between_pages",
    label: "Swipe between pages",
    how: "Swipe left or right with one finger to move between pages.",
    blurb: "Useful in browsers and document viewers.",
  },
  {
    id: "swipe_apps",
    label: "Swipe between apps",
    how: "Swipe left or right with two fingers to move between full-screen apps.",
    blurb: "Fullest on Mac; limited on iPad - check.",
  },
  {
    id: "mission_control",
    label: "Mission Control",
    how: "Swipe up with two fingers to open Mission Control.",
    blurb: "See all open windows at once on Mac.",
  },
] as const;

function gestureKind(id: string) {
  return `gesture:${id.replace(/_/g, "-")}`;
}

const firstGesture = gestures[0];
const firstGestureImg = getAccessoryImage("mouse-usbc-white", gestureKind(firstGesture.id));

const mouseList = mice();
---

<div class="xfeel-mouse" data-mouse-feel>
  <section class="xfeel-mouse__hero">
    <div class="container">
      <h2>White or black. Same swipe.</h2>
      <p>Scroll - colour cross-fades and the angle shifts.</p>
      <div class="xfeel-mouse__colour" role="group" aria-label="Hero colour">
        <button type="button" class="is-active" data-mouse-colour="white">White</button>
        <button type="button" data-mouse-colour="black">Black</button>
      </div>
    </div>
    <div class="xfeel-mouse__stage" data-mouse-hero-stage>
      <img data-mouse-a src={white.src} alt={white.alt} width="1400" height="1050" fetchpriority="high" />
      <img data-mouse-b src={angle0.src} alt="Magic Mouse angle" width="1400" height="1050" />
    </div>
  </section>

  <section class="xfeel-mouse__swipe">
    <div class="container">
      <h2>Swipe on the shell</h2>
      <p>Illustration only - try the buttons if you prefer keyboard or switch control.</p>
      <div class="xfeel-mouse__swipe-demo" data-swipe-demo tabindex="0" aria-label="Swipe demo">
        <img src={black.src} alt="Magic Mouse black" width="900" height="675" loading="lazy" />
        <span class="xfeel-mouse__trail" data-swipe-trail aria-hidden="true"></span>
      </div>
      <div class="xfeel-mouse__swipe-btns">
        <button type="button" data-swipe="left">Swipe left</button>
        <button type="button" data-swipe="right">Swipe right</button>
        <button type="button" data-swipe="up">Scroll up</button>
        <button type="button" data-swipe="down">Scroll down</button>
      </div>
    </div>
  </section>

  <section class="xfeel-mouse__gestures" data-mouse-gesture-explorer>
    <div class="container">
      <h2>Swipe it</h2>
      <p class="xfeel-mouse__lede">A demo; the real surface senses your fingers. Works fullest on Mac.</p>
      <div class="xfeel-mouse__explorer">
        <div class="xfeel-mouse__grid" role="listbox" aria-label="Magic Mouse gestures">
          {
            gestures.map((g, i) => {
              const img = getAccessoryImage("mouse-usbc-white", gestureKind(g.id));
              return (
                <button
                  type="button"
                  class:list={{ "xfeel-mouse__tile": true, "is-active": i === 0 }}
                  role="option"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-mouse-gesture={g.id}
                  data-how={g.how}
                  data-blurb={g.blurb}
                  data-src={img.src}
                  data-label={g.label}
                >
                  <img src={img.src} alt={`${g.label} gesture`} width="400" height="400" loading="lazy" />
                  <span>{g.label}</span>
                </button>
              );
            })
          }
        </div>
        <div class="xfeel-mouse__detail" aria-live="polite">
          <img data-mouse-g-img src={firstGestureImg.src} alt={`${firstGesture.label} gesture`} width="640" height="480" loading="lazy" />
          <h3 data-mouse-g-title>{firstGesture.label}</h3>
          <p data-mouse-g-blurb>{firstGesture.blurb}</p>
          <p class="xfeel-mouse__how"><strong>How:</strong> <span data-mouse-g-how>{firstGesture.how}</span></p>
          <p class="xfeel-mouse__badges"><span class="badge">Works on Mac</span> <span class="badge badge--muted">Limited on iPad</span></p>
        </div>
      </div>
      <p class="xfeel-mouse__flag">Gestures need macOS or supported iPadOS - check Apple's list.</p>
    </div>
  </section>

  <section class="xfeel-mouse__scale">
    <div class="container">
      <h2>Compact on the desk</h2>
      <p>Low profile - compare angles in the strip.</p>
      <div class="xfeel-mouse__strip" data-scale-strip>
        <figure><img src={white.src} alt="Magic Mouse white" width="320" height="240" loading="lazy" /><figcaption>White</figcaption></figure>
        <figure><img src={angle2.src} alt="Side angle" width="320" height="240" loading="lazy" /><figcaption>Profile</figcaption></figure>
        <figure><img src={black.src} alt="Magic Mouse black" width="320" height="240" loading="lazy" /><figcaption>Black</figcaption></figure>
        <figure><img src={inUse.src} alt="Magic Mouse in use" width="320" height="240" loading="lazy" /><figcaption>In use</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="xfeel-mouse__charge">
    <div class="container">
      <h2>Charging honesty</h2>
      <p>{accessoriesConfig.mouseChargeNote}</p>
      <ul>
        {mouseList.filter((m) => m.connector === "usb-c").map((m) => (
          <li>{m.name}: {m.charging} <span class="flag">check</span></li>
        ))}
      </ul>
    </div>
  </section>
</div>

<script define:vars={{ whiteSrc: white.src, blackSrc: black.src, angleWhite: angle0.src, angleBlack: angleBlack.src }}>
  const root = document.querySelector("[data-mouse-feel]");
  if (!root) throw new Error("mouse feel");

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let colour = "white";
  const stage = root.querySelector("[data-mouse-hero-stage]");
  const a = root.querySelector("[data-mouse-a]");
  const b = root.querySelector("[data-mouse-b]");

  function heroSrcs() {
    return colour === "black"
      ? { hero: blackSrc, angle: angleBlack }
      : { hero: whiteSrc, angle: angleWhite };
  }

  if (!reduce && stage && a instanceof HTMLImageElement && b instanceof HTMLImageElement) {
    b.style.opacity = "0";
    const onScroll = () => {
      const rect = stage.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const p = Math.min(1, Math.max(0, 1 - rect.top / vh));
      a.style.opacity = String(1 - p);
      b.style.opacity = String(p);
      b.style.transform = `rotateY(${p * 18}deg)`;
    };
    window.addEventListener("scroll", () => requestAnimationFrame(onScroll), { passive: true });
    onScroll();
  } else if (b instanceof HTMLElement) {
    b.style.opacity = "1";
    if (a instanceof HTMLElement) a.style.opacity = "0";
  }

  root.querySelectorAll("[data-mouse-colour]").forEach((btn) => {
    btn.addEventListener("click", () => {
      colour = btn.getAttribute("data-mouse-colour") || "white";
      root.querySelectorAll("[data-mouse-colour]").forEach((t) => t.classList.toggle("is-active", t === btn));
      const { hero, angle } = heroSrcs();
      if (a instanceof HTMLImageElement) a.src = hero;
      if (b instanceof HTMLImageElement) b.src = angle;
    });
  });

  const trail = root.querySelector("[data-swipe-trail]");
  const demo = root.querySelector("[data-swipe-demo]");
  function animateSwipe(dir) {
    if (!trail || !demo || reduce) return;
    trail.className = "xfeel-mouse__trail is-" + dir;
    demo.classList.add("is-active");
    window.setTimeout(() => {
      trail.className = "xfeel-mouse__trail";
      demo.classList.remove("is-active");
    }, 700);
  }
  root.querySelectorAll("[data-swipe]").forEach((btn) => {
    btn.addEventListener("click", () => animateSwipe(btn.getAttribute("data-swipe")));
  });
  demo?.addEventListener("keydown", (e) => {
    const map = { ArrowLeft: "left", ArrowRight: "right", ArrowUp: "up", ArrowDown: "down" };
    const dir = map[e.key];
    if (dir) {
      e.preventDefault();
      animateSwipe(dir);
    }
  });

  const gRoot = root.querySelector("[data-mouse-gesture-explorer]");
  if (gRoot) {
    const gImg = gRoot.querySelector("[data-mouse-g-img]");
    const gTitle = gRoot.querySelector("[data-mouse-g-title]");
    const gBlurb = gRoot.querySelector("[data-mouse-g-blurb]");
    const gHow = gRoot.querySelector("[data-mouse-g-how]");
    function selectGesture(btn) {
      gRoot.querySelectorAll("[data-mouse-gesture]").forEach((t) => {
        const on = t === btn;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      if (gImg instanceof HTMLImageElement) {
        gImg.src = btn.getAttribute("data-src") || gImg.src;
        gImg.alt = (btn.getAttribute("data-label") || "") + " gesture";
      }
      if (gTitle) gTitle.textContent = btn.getAttribute("data-label") || "";
      if (gBlurb) gBlurb.textContent = btn.getAttribute("data-blurb") || "";
      if (gHow) gHow.textContent = btn.getAttribute("data-how") || "";
    }
    gRoot.querySelectorAll("[data-mouse-gesture]").forEach((btn) => {
      btn.addEventListener("click", () => selectGesture(btn));
      btn.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          selectGesture(btn);
        }
      });
    });
  }
</script>

<style>
  .xfeel-mouse__hero {
    background: #000;
    color: #f5f5f7;
    padding: 3rem 0 0;
  }
  .xfeel-mouse__colour {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .xfeel-mouse__colour button {
    border: 1px solid #424245;
    background: #1d1d1f;
    color: #fff;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .xfeel-mouse__colour button.is-active {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  .xfeel-mouse__stage {
    position: relative;
    aspect-ratio: 4 / 3;
    max-width: 960px;
    margin: 1.5rem auto 0;
    perspective: 800px;
  }
  .xfeel-mouse__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    background: #f5f5f7;
  }
  .xfeel-mouse__swipe,
  .xfeel-mouse__gestures,
  .xfeel-mouse__scale,
  .xfeel-mouse__charge {
    padding: 3rem 0;
  }
  .xfeel-mouse__swipe-demo {
    position: relative;
    background: #f5f5f7;
    border-radius: 1rem;
    overflow: hidden;
    max-width: 640px;
    margin: 1rem 0;
    outline: none;
  }
  .xfeel-mouse__swipe-demo:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }
  .xfeel-mouse__swipe-demo img {
    width: 100%;
    mix-blend-mode: multiply;
    display: block;
  }
  .xfeel-mouse__trail {
    position: absolute;
    inset: 30% 20%;
    border: 2px dashed transparent;
    border-radius: 0.5rem;
    pointer-events: none;
    transition: transform 0.5s ease, opacity 0.5s ease;
  }
  .xfeel-mouse__trail.is-left {
    transform: translateX(-24px);
    border-color: rgba(0, 0, 0, 0.35);
  }
  .xfeel-mouse__trail.is-right {
    transform: translateX(24px);
    border-color: rgba(0, 0, 0, 0.35);
  }
  .xfeel-mouse__trail.is-up {
    transform: translateY(-18px);
    border-color: rgba(0, 0, 0, 0.35);
  }
  .xfeel-mouse__trail.is-down {
    transform: translateY(18px);
    border-color: rgba(0, 0, 0, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .xfeel-mouse__trail {
      transition: none;
    }
  }
  .xfeel-mouse__swipe-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .xfeel-mouse__swipe-btns button {
    border: 1px solid #d2d2d7;
    background: #fff;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
  }
  .xfeel-mouse__gestures {
    background: #000;
    color: #f5f5f7;
  }
  .xfeel-mouse__lede {
    color: #a1a1a6;
    max-width: 40rem;
  }
  .xfeel-mouse__explorer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
    align-items: start;
  }
  @media (max-width: 720px) {
    .xfeel-mouse__explorer {
      grid-template-columns: 1fr;
    }
  }
  .xfeel-mouse__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.75rem;
  }
  .xfeel-mouse__tile {
    background: #1d1d1f;
    border: 1px solid #424245;
    border-radius: 0.75rem;
    padding: 0.65rem;
    color: #f5f5f7;
    text-align: left;
    cursor: pointer;
  }
  .xfeel-mouse__tile:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .xfeel-mouse__tile.is-active {
    border-color: #fff;
  }
  .xfeel-mouse__tile img {
    width: 100%;
    mix-blend-mode: multiply;
    background: #f5f5f7;
    border-radius: 0.35rem;
  }
  .xfeel-mouse__tile span {
    display: block;
    font-size: 0.8rem;
    margin-top: 0.35rem;
  }
  .xfeel-mouse__detail {
    background: #1d1d1f;
    border-radius: 1rem;
    padding: 1rem;
  }
  .xfeel-mouse__detail img {
    width: 100%;
    mix-blend-mode: multiply;
    background: #f5f5f7;
    border-radius: 0.75rem;
  }
  .xfeel-mouse__detail h3 {
    margin: 0.75rem 0 0.35rem;
  }
  .xfeel-mouse__how {
    font-size: 0.9rem;
    color: #a1a1a6;
  }
  .xfeel-mouse__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .xfeel-mouse__badges .badge {
    font-size: 0.7rem;
    border: 1px solid #424245;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }
  .xfeel-mouse__badges .badge--muted {
    color: #a1a1a6;
  }
  .xfeel-mouse__gestures .xfeel-mouse__flag {
    color: #a1a1a6;
  }
  .xfeel-mouse__strip {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding: 0.5rem 0;
  }
  .xfeel-mouse__strip figure {
    flex: 0 0 160px;
    margin: 0;
    background: #f5f5f7;
    border-radius: 0.75rem;
    padding: 0.5rem;
    text-align: center;
  }
  .xfeel-mouse__strip img {
    width: 100%;
    mix-blend-mode: multiply;
  }
  .xfeel-mouse__strip figcaption {
    font-size: 0.75rem;
    color: #6e6e73;
    margin-top: 0.35rem;
  }
  .xfeel-mouse__flag,
  .flag {
    font-size: 0.8rem;
    color: #6e6e73;
  }
</style>
