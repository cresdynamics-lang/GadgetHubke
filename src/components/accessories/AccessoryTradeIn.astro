---
import { accessoriesConfig } from "../../lib/accessories";
---

<section class="xtrade">
  <div class="container">
    <h2>Trade-in</h2>
    <p>{accessoriesConfig.tradeIn.note}</p>
    <a class="btn btn--secondary" href="/trade-in">Open trade-in estimator</a>
  </div>
</section>

<style>
  .xtrade {
    padding: 2.5rem 0;
    background: #f5f5f7;
  }
  .xtrade p {
    color: #6e6e73;
    max-width: 36rem;
  }
</style>
