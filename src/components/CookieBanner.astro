---
/**
 * Cookie banner - single Accept control for analytics + marketing opt-in.
 */
---

<div class="cookie-banner" data-cookie-banner hidden>
  <div class="cookie-banner__inner container">
    <div class="cookie-banner__copy">
      <p class="cookie-banner__title">Cookies</p>
      <p class="cookie-banner__text">
        We use essential cookies to run the shop. With your OK we also use analytics
        and marketing cookies. Read the{" "}
        <a href="/cookies">Cookie Policy</a>.
      </p>
    </div>

    <div class="cookie-banner__panel">
      <button type="button" class="btn btn--primary cookie-banner__btn" data-cookie-accept>
        Accept
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 4.5rem;
    z-index: 80;
    padding: 0.55rem;
    padding-bottom: calc(0.55rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__inner {
    pointer-events: auto;
    display: grid;
    gap: 0.55rem;
    padding: 0.7rem 0.8rem;
    background: var(--color-white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 -4px 18px rgba(10, 10, 10, 0.1);
    max-width: 28rem;
    margin-inline: auto;
  }

  @media (min-width: 48rem) {
    .cookie-banner {
      bottom: 5rem;
      padding: 0.75rem;
      padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
    }

    .cookie-banner__inner {
      max-width: min(100% - 2rem, 40rem);
      gap: 0.75rem;
      padding: 0.85rem 1rem;
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .cookie-banner__title {
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    margin-bottom: 0.15rem;
    letter-spacing: 0.02em;
  }

  .cookie-banner__text {
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    line-height: 1.35;
  }

  .cookie-banner__text a {
    color: var(--color-fg);
  }

  .cookie-banner__panel {
    display: flex;
    justify-content: flex-end;
  }

  .cookie-banner__btn {
    min-height: 1.85rem;
    padding: 0.28rem 0.85rem;
    font-size: 0.68rem;
    line-height: 1.2;
  }

  @media (max-width: 47.99rem) {
    .cookie-banner {
      bottom: 4.25rem;
      padding: 0.4rem;
      padding-bottom: calc(0.4rem + env(safe-area-inset-bottom, 0px));
    }

    .cookie-banner__inner {
      max-width: 100%;
      gap: 0.45rem;
      padding: 0.55rem 0.65rem;
      border-radius: 0.65rem;
    }

    .cookie-banner__title {
      font-size: 0.65rem;
      margin-bottom: 0.1rem;
    }

    .cookie-banner__text {
      font-size: 0.62rem;
      line-height: 1.3;
    }

    .cookie-banner__btn {
      min-height: 1.7rem;
      padding: 0.22rem 0.75rem;
      font-size: 0.62rem;
    }
  }
</style>

<script>
  const STORAGE_KEY = "gh-cookie-consent";

  type Consent = {
    essential: true;
    analytics: boolean;
    marketing: boolean;
    updatedAt: string;
  };

  function readConsent(): Consent | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Consent;
      if (parsed?.essential !== true) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function writeConsent(consent: Consent) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
    document.documentElement.dataset.analytics = consent.analytics ? "1" : "0";
    document.documentElement.dataset.marketing = consent.marketing ? "1" : "0";
    window.dispatchEvent(new CustomEvent("gh:consent", { detail: consent }));
  }

  function boot() {
    const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");
    if (!banner) return;

    const existing = readConsent();
    if (existing) {
      writeConsent(existing);
      banner.hidden = true;
      return;
    }

    banner.hidden = false;

    banner.querySelector("[data-cookie-accept]")?.addEventListener("click", () => {
      writeConsent({
        essential: true,
        analytics: true,
        marketing: true,
        updatedAt: new Date().toISOString(),
      });
      banner.hidden = true;
    });
  }

  void boot();
</script>
