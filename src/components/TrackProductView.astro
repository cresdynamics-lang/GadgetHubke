---
/**
 * Marks the current page as a product view for RecentlyViewed (localStorage).
 */
interface Props {
  id: string;
  name: string;
  href: string;
  image?: string;
  priceKes?: number;
}

const { id, name, href, image = "", priceKes = 0 } = Astro.props;
---

<span
  hidden
  data-rv-track
  data-id={id}
  data-name={name}
  data-href={href}
  data-image={image}
  data-price={String(priceKes)}
></span>
