---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import CookieBanner from "../components/CookieBanner.astro";
import Analytics from "../components/Analytics.astro";
import SiteSearch from "../components/SiteSearch.astro";
import BagDrawer from "../components/iphone/BagDrawer.astro";
import CatalogOverlay from "../components/CatalogOverlay.astro";
import RecentlyViewed from "../components/RecentlyViewed.astro";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { site } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  /** Share / preview image (site-relative or absolute). Defaults to the logo. */
  image?: string;
  /** Site-relative canonical path when this page duplicates another. */
  canonicalPath?: string;
  /** Keep this page out of Google (still crawlable for links). */
  noindex?: boolean;
}

const {
  title = `${site.name} - Apple devices in Nairobi`,
  description = "Gadget Hub sells Apple products in Nairobi. iPhone, Mac, iPad, Watch, AirPods, and accessories. Trade-in and Lipa Mdogo Mdogo available.",
  hideFooter = false,
  image,
  canonicalPath,
  noindex = false,
} = Astro.props;
const ogImage = new URL(image || "/images/logo.png", site.url).href;
// Store details on every page so Google can tie products and articles to the Nairobi shop.
const storeJsonLd = {
  "@context": "https://schema.org",
  "@type": "ElectronicsStore",
  "@id": `${site.url}/#store`,
  name: site.legalName,
  alternateName: ["Gadget Hub", "GadgetHub Kenya", "Gadget Hub Nairobi"],
  url: site.url,
  logo: new URL("/images/logo.png", site.url).href,
  image: new URL("/images/logo.png", site.url).href,
  telephone: site.phoneE164,
  hasMap: "https://www.google.com/maps/search/?api=1&query=Norwich+Union+House+Nairobi",
  email: site.email,
  priceRange: "KES 3,000 - KES 600,000",
  currenciesAccepted: "KES",
  paymentAccepted: "M-Pesa, Lipa Mdogo Mdogo",
  address: {
    "@type": "PostalAddress",
    streetAddress: `${site.address}, ${site.landmark}`,
    addressLocality: "Nairobi",
    addressRegion: "Nairobi County",
    addressCountry: "KE",
  },
  areaServed: { "@type": "Country", name: "Kenya" },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], opens: "08:00", closes: "20:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Sunday", opens: "10:00", closes: "20:00" },
  ],
  sameAs: [site.social.facebook, site.social.instagram, site.social.tiktok],
};

// One address per page: never a trailing slash (matches the sitemap), never a query string.
const canonical = new URL((canonicalPath || Astro.url.pathname).replace(/(.)\/+$/, "$1"), site.url).href;
const pageTitle = title;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const hideFloatWhatsApp = path === "/contact";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Gadget Hub Kenya" />
    <meta property="og:locale" content="en_KE" />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="KE-110" />
    <meta name="geo.placename" content="Nairobi" />
    <script type="application/ld+json" set:html={JSON.stringify(storeJsonLd)} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {hideFooter ? null : <RecentlyViewed />}
    {hideFooter ? null : <Footer />}
    <SiteSearch />
    <BagDrawer />
    <FloatingActions hideWhatsApp={hideFloatWhatsApp} />
    <CookieBanner />
    <Analytics />
    <CatalogOverlay />
  </body>
</html>
