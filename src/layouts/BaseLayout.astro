---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import CookieBanner from "../components/CookieBanner.astro";
import BlackNovemberDeal from "../components/BlackNovemberDeal.astro";
import Analytics from "../components/Analytics.astro";
import PresenceBeacon from "../components/PresenceBeacon.astro";
import SiteSearch from "../components/SiteSearch.astro";
import BagDrawer from "../components/iphone/BagDrawer.astro";
import CatalogOverlay from "../components/CatalogOverlay.astro";
import RecentlyViewed from "../components/RecentlyViewed.astro";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { site } from "../lib/site";
import { STOREFRONT_PAYMENTS } from "../lib/commerce";

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  /** Share / preview image (site-relative or absolute). Defaults to the logo. */
  image?: string;
  /** Site-relative canonical path when this page duplicates another. */
  canonicalPath?: string;
  /** Keep this page out of Google (still crawlable for links). */
  noindex?: boolean;
}

const {
  title = `${site.name} - Apple devices in Nairobi`,
  description = "Gadget Hub sells Apple products in Nairobi. iPhone, Mac, iPad, Watch, AirPods, and accessories. Trade-in and Lipa Mdogo Mdogo available.",
  hideFooter = false,
  image,
  canonicalPath,
  noindex = false,
} = Astro.props;
const ogImage = new URL(image || "/images/logo.png", site.url).href;
const BRAND_NAMES = ["Gadget Hub", "Gadget Hub Kenya", "GadgetHub", "GadgetHub Kenya", "GadgetHub KE", "Gadget Hub KE", "Gadgets Hub", "Gadgets Hub KE", "Gadgets Hub Kenya", "Gadget Hub Nairobi", "gadgethubke"];

// Site name Google shows in results, with the brand spellings people search.
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.url}/#website`,
  name: "Gadget Hub Kenya",
  alternateName: BRAND_NAMES,
  url: `${site.url}/`,
  publisher: { "@id": `${site.url}/#store` },
  inLanguage: "en-KE",
};

// Store details on every page so Google can tie products and articles to the Nairobi shop.
const storeJsonLd = {
  "@context": "https://schema.org",
  "@type": "ElectronicsStore",
  "@id": `${site.url}/#store`,
  name: site.legalName,
  // Every way people type the brand ("gadget hub kenya", "gadgethub ke", "gadgets hub").
  alternateName: BRAND_NAMES,
  url: site.url,
  logo: new URL("/images/logo.png", site.url).href,
  image: new URL("/images/logo.png", site.url).href,
  telephone: site.phoneE164,
  hasMap: "https://www.google.com/maps/search/?api=1&query=Norwich+Union+House+Nairobi",
  email: site.email,
  priceRange: "KES 3,000 - KES 600,000",
  currenciesAccepted: "KES",
  paymentAccepted: STOREFRONT_PAYMENTS ? "M-Pesa, Lipa Mdogo Mdogo" : "WhatsApp order, M-Pesa in store",
  address: {
    "@type": "PostalAddress",
    streetAddress: `${site.address}, ${site.landmark}`,
    addressLocality: "Nairobi",
    addressRegion: "Nairobi County",
    addressCountry: "KE",
  },
  areaServed: { "@type": "Country", name: "Kenya" },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], opens: "08:00", closes: "20:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Sunday", opens: "10:00", closes: "20:00" },
  ],
  sameAs: [site.social.facebook, site.social.instagram, site.social.tiktok],
};

// One address per page: never a trailing slash (matches the sitemap), never a query string.
const canonical = new URL((canonicalPath || Astro.url.pathname).replace(/(.)\/+$/, "$1"), site.url).href;
const pageTitle = title;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const hideFloatWhatsApp = path === "/contact";
---

<!doctype html>
<html lang="en" class:list={{ "storefront-wa-only": !STOREFRONT_PAYMENTS }}>
  <head>
    <meta charset="utf-8" />
    {/* Google Tag Manager — GTM-WRVDMKR4. Kept high in <head> as Google asks; the gtm.start push lets page-view triggers fire. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      /**
       * Every site event goes to Tag Manager as { event, ...params } (GA4 recommended names).
       * Ecommerce events carry an `ecommerce` object, cleared first as Google asks.
       */
      window.ghTrack = function (event, params) {
        params = params || {};
        if (params.ecommerce) dataLayer.push({ ecommerce: null });
        dataLayer.push(Object.assign({ event: event }, params));
      };
      /** Contact taps anywhere on the site: WhatsApp, phone, email. */
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var method = /wa\.me|whatsapp\.com/i.test(href) ? 'whatsapp' : /^tel:/i.test(href) ? 'phone' : /^mailto:/i.test(href) ? 'email' : '';
        if (!method) return;
        // Google tag events (GA4 via the Tag Manager Google tag; Google Ads imports them as conversions).
        if (method === 'whatsapp') gtag('event', 'whatsapp_click', { link_url: href, page_path: location.pathname });
        if (method === 'phone') gtag('event', 'call_click', { phone_link: href, page_path: location.pathname });
        window.ghTrack(method === 'whatsapp' ? 'whatsapp_click' : method + '_click', {
          contact_method: method,
          link_text: (a.textContent || '').trim().slice(0, 100),
          page_path: location.pathname,
        });
        window.ghTrack('generate_lead', { lead_source: method, page_path: location.pathname });
      }, true);
    </script>
    <script is:inline>
      // Tag Manager loads once the page has loaded, so it never competes with the first view.
      // Events pushed before then wait in dataLayer and are sent when it arrives.
      (function () {
        function loadGtm() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-WRVDMKR4';
          document.head.appendChild(s);
        }
        if (document.readyState === 'complete') loadGtm();
        else window.addEventListener('load', loadGtm, { once: true });
      })();
    </script>
    {/* End Google Tag Manager */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#ffffff" />
    {/* Bing Webmaster Tools ownership. Keep it after verification, or the site is unverified. */}
    <meta name="msvalidate.01" content="7E9E2511C9B5474798DC314A53217CFF" />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Gadget Hub Kenya" />
    <meta property="og:locale" content="en_KE" />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="geo.region" content="KE-110" />
    <meta name="geo.placename" content="Nairobi" />
    <script type="application/ld+json" set:html={JSON.stringify(storeJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WRVDMKR4" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {hideFooter ? null : <RecentlyViewed />}
    {hideFooter ? null : <Footer />}
    <SiteSearch />
    <BagDrawer />
    <FloatingActions hideWhatsApp={hideFloatWhatsApp} />
    <CookieBanner />
    <BlackNovemberDeal />
    <Analytics />
    <PresenceBeacon />
    <CatalogOverlay />
  </body>
</html>
