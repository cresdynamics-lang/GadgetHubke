---
/**
 * Minimal chrome for /admin (no storefront header/bag).
 */
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title?: string;
  authed?: boolean;
}

const { title = "Admin - GadgetHub", authed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title}</title>
  </head>
  <body class="admin-body">
    <header class="admin-top">
      <a class="admin-brand" href="/admin">GadgetHub Admin</a>
      {
        authed ? (
          <nav class="admin-nav">
            <a href="/admin">Dashboard</a>
            <a href="/admin/catalog">Prices & stock</a>
            <a href="/admin/reviews">Reviews</a>
            <a href="/admin/search-misses">Search misses</a>
            <a href="/" target="_blank" rel="noopener">View site</a>
            <button type="button" data-admin-logout>Log out</button>
          </nav>
        ) : null
      }
    </header>
    <main class="admin-main">
      <slot />
    </main>
    {
      authed ? (
        <script>
          document.querySelector("[data-admin-logout]")?.addEventListener("click", async () => {
            await fetch("/api/admin/logout", { method: "POST" });
            location.href = "/admin";
          });
        </script>
      ) : null
    }
  </body>
</html>

<style is:global>
  .admin-body {
    margin: 0;
    min-height: 100vh;
    background: #f5f5f7;
    color: #1d1d1f;
    font-family: Inter, system-ui, sans-serif;
  }
  .admin-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.85rem 1.25rem;
    background: #1d1d1f;
    color: #f5f5f7;
  }
  .admin-brand {
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: center;
    font-size: 0.9rem;
  }
  .admin-nav a {
    color: #d2d2d7;
    text-decoration: none;
  }
  .admin-nav a:hover {
    color: #fff;
  }
  .admin-nav button {
    font: inherit;
    border: 0;
    background: #424245;
    color: #fff;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }
  .admin-main {
    padding: 1.5rem 1.25rem 3rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .admin-card {
    background: #fff;
    border-radius: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 1.15rem 1.25rem;
  }
  .admin-card h1,
  .admin-card h2 {
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .admin-muted {
    color: #6e6e73;
    font-size: 0.9rem;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .admin-table th,
  .admin-table td {
    text-align: left;
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    vertical-align: middle;
  }
  .admin-table input[type="number"] {
    width: 7.5rem;
    font: inherit;
    padding: 0.35rem 0.45rem;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 0.45rem;
  }
  .admin-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .admin-btn {
    font: inherit;
    border: 0;
    border-radius: 0.5rem;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    background: #1d1d1f;
    color: #fff;
  }
  .admin-btn--ghost {
    background: #e8e8ed;
    color: #1d1d1f;
  }
  .admin-btn--danger {
    background: #b42318;
  }
  .admin-grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .admin-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .admin-stat {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0.35rem 0 0;
  }
  .admin-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 1rem;
  }
  .admin-filter input,
  .admin-filter select {
    font: inherit;
    padding: 0.45rem 0.6rem;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 0.5rem;
  }
  .admin-error {
    color: #b42318;
    font-size: 0.9rem;
  }
  .admin-ok {
    color: #0e9f6e;
    font-size: 0.9rem;
  }
</style>
