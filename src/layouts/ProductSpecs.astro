---
import BaseLayout from "./BaseLayout.astro";
import StickyBuyBar from "../components/StickyBuyBar.astro";
import type { Product } from "../lib/products";
import { site } from "../lib/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<BaseLayout
  title={`${product.name} Tech Specs - GadgetHub`}
  description={`Full specifications for ${product.name}. Warranty via ${site.legalName}.`}
>
  <article class="specs container">
    <header class="specs__intro">
      <p class="specs__eyebrow">
        <a href={product.overviewHref}>{product.name}</a>
        <span aria-hidden="true"> / </span>
        Tech Specs
      </p>
      <h1>{product.name} - Tech Specs</h1>
      <p class="specs__lede">
        <a href={product.overviewHref}>← Back to Overview</a>
        <span aria-hidden="true"> · </span>
        <a href={`${product.overviewHref}#buy`}>Buy on GadgetHub</a>
      </p>
    </header>

    <div class="specs__groups">
      {
        product.specs.map((group, i) => (
          <details class="specs__group" open={i === 0}>
            <summary>{group.title}</summary>
            <dl>
              {group.rows.map((row) => (
                <>
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </>
              ))}
            </dl>
          </details>
        ))
      }
    </div>

    <p class="specs__note">
      New sealed devices only. Warranty is the manufacturer’s standard coverage -
      see <a href="/warranty-repairs">Warranty &amp; Repairs</a> and{" "}
      <a href="/returns">Returns</a>.
    </p>

    <section class="specs__buy">
      <h2>Ready to buy?</h2>
      <p>Configure storage and finish on the overview - then Add to Cart or Buy on WhatsApp.</p>
      <p class="specs__buy-actions">
        <a class="btn btn--primary" href={`${product.overviewHref}#buy`} data-pdp-buy>Buy on GadgetHub</a>
        <a class="btn btn--secondary" href={product.overviewHref}>Back to Overview</a>
      </p>
    </section>
  </article>

  <StickyBuyBar
    productName={product.name}
    imageSrc={product.image.src}
    imageAlt={product.image.alt}
    description={product.tagline}
  />
</BaseLayout>

<style>
  .specs {
    padding-block: var(--space-6) calc(var(--space-8) + var(--fab-clearance));
    max-width: 42rem;
  }

  .specs__intro {
    margin-bottom: var(--space-5);
  }

  .specs__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-2);
  }

  .specs__eyebrow a {
    color: inherit;
  }

  .specs h1 {
    font-size: clamp(1.35rem, 3.5vw, 1.85rem);
    margin: 0 0 var(--space-2);
    letter-spacing: -0.02em;
  }

  .specs__lede {
    font-size: var(--text-sm);
    margin: 0;
  }

  .specs__groups {
    display: grid;
    gap: 0.35rem;
  }

  .specs__group {
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    padding: 0.35rem 0.75rem;
  }

  .specs__group summary {
    cursor: pointer;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.02em;
    padding: 0.45rem 0;
  }

  .specs__group summary::-webkit-details-marker {
    display: none;
  }

  .specs__group summary::after {
    content: "+";
    float: right;
    font-weight: 500;
    color: var(--color-fg-subtle);
  }

  .specs__group[open] summary::after {
    content: "–";
  }

  .specs__group dl {
    margin: 0 0 0.45rem;
    display: grid;
    grid-template-columns: minmax(6.5rem, 9rem) minmax(0, 1fr);
    gap: 0.35rem var(--space-3);
  }

  .specs__group dt {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .specs__group dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }

  .specs__note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .specs__buy {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .specs__buy h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .specs__buy p {
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-3);
    max-width: 36rem;
    font-size: var(--text-sm);
  }

  .specs__buy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
