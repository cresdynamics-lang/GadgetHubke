---
import BaseLayout from "./BaseLayout.astro";
import type { Product } from "../lib/products";
import { site } from "../lib/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<BaseLayout
  title={`${product.name} Tech Specs - GadgetHub`}
  description={`Full specifications for ${product.name}. Warranty via ${site.legalName}.`}
>
  <article class="specs container">
    <header class="specs__intro">
      <p class="specs__eyebrow">
        <a href={product.overviewHref}>{product.name}</a>
        <span aria-hidden="true"> / </span>
        Tech Specs
      </p>
      <h1>{product.name} - Tech Specs</h1>
      <p class="specs__lede">
        <a href={product.overviewHref}>← Back to Overview</a>
        <span aria-hidden="true"> · </span>
        <a href={`${product.overviewHref}#buy`}>Buy on GadgetHub</a>
      </p>
    </header>

    {
      product.specs.map((group) => (
        <section class="specs__group">
          <h2>{group.title}</h2>
          <dl>
            {group.rows.map((row) => (
              <>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </>
            ))}
          </dl>
        </section>
      ))
    }

    <p class="specs__note">
      New sealed devices only. Warranty is the manufacturer’s standard coverage - 
      see <a href="/warranty-repairs">Warranty &amp; Repairs</a> and{" "}
      <a href="/returns">Returns</a>.
    </p>

    <section class="specs__buy">
      <h2>Ready to buy?</h2>
      <p>Configure storage and finish on the overview - then Add to Cart or Buy on WhatsApp.</p>
      <p class="specs__buy-actions">
        <a class="btn btn--primary" href={`${product.overviewHref}#buy`}>Buy on GadgetHub</a>
        <a class="btn btn--secondary" href={product.overviewHref}>Back to Overview</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .specs {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
    max-width: 42rem;
  }

  .specs__intro {
    margin-bottom: var(--space-10);
  }

  .specs__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .specs__eyebrow a {
    color: inherit;
  }

  .specs h1 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin-bottom: var(--space-3);
  }

  .specs__lede {
    font-size: var(--text-sm);
  }

  .specs__group {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .specs__group h2 {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-4);
  }

  .specs__group dl {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
  }

  .specs__group dt {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .specs__group dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }

  .specs__note {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .specs__buy {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .specs__buy h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .specs__buy p {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-4);
    max-width: 36rem;
  }

  .specs__buy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
