---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Cart - GadgetHub" description="Your GadgetHub cart. Review items and order on WhatsApp.">
  <section class="cart container">
    <header class="cart__intro">
      <h1>Cart</h1>
      <p class="cart__lede">Items stay on this device until you order on WhatsApp.</p>
    </header>
    <p class="cart__actions">
      <button type="button" class="btn btn--whatsapp" data-bag-open>Order on WhatsApp</button>
      <a class="btn btn--secondary" href="/accessories">Shop accessories</a>
    </p>
  </section>
</BaseLayout>

<style>
  .cart {
    padding-block: var(--space-10) calc(var(--space-12) + var(--fab-clearance));
    max-width: 36rem;
  }

  .cart h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin: 0 0 var(--space-3);
  }

  .cart__lede {
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-6);
  }

  .cart__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
