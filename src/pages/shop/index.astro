---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homeCategories } from "../../lib/home";
import { productNav } from "../../lib/catalog";
---

<BaseLayout
  title="Shop - GadgetHub"
  description="Browse new Apple devices at GadgetHub Kenya - iPhone, Mac, iPad, Watch, AirPods, and accessories."
>
  <section class="shop container">
    <header class="shop__intro">
      <p class="shop__eyebrow">Shop</p>
      <h1>New devices only</h1>
      <p class="shop__lede">
        Sealed stock across every category. No refurbished listings.
      </p>
    </header>

    <ul class="shop__grid">
      {
        homeCategories.map((cat) => (
          <li>
            <a class="shop__card" href={cat.href}>
              <h2>{cat.label}</h2>
              <span>Browse →</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="shop__lineups">
      {
        productNav
          .filter((c) => c.children?.length)
          .map((cat) => (
            <section class="shop__lineup">
              <header class="shop__lineup-head">
                <h2>
                  <a href={cat.href}>{cat.label}</a>
                </h2>
                <a href={cat.href}>See all</a>
              </header>
              <ul>
                {cat.children!.map((child) => (
                  <li>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .shop {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
  }

  .shop__intro {
    max-width: 40rem;
    margin-bottom: var(--space-8);
  }

  .shop__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .shop h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .shop__lede {
    color: var(--color-fg-muted);
  }

  .shop__grid {
    list-style: none;
    margin: 0 0 var(--space-12);
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 48rem) {
    .shop__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .shop__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    text-decoration: none;
    color: inherit;
    min-height: 6.5rem;
  }

  .shop__card h2 {
    font-size: var(--text-base);
    margin: 0;
  }

  .shop__card span {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin-top: auto;
  }

  .shop__lineups {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 48rem) {
    .shop__lineups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }

  .shop__lineup-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .shop__lineup-head h2 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .shop__lineup-head a {
    font-size: var(--text-sm);
  }

  .shop__lineup ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .shop__lineup li a {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .shop__lineup li a:hover {
    color: var(--color-fg);
  }
</style>
