---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, whatsappUrl } from "../../lib/site";
import { livePricedCatalog } from "../../lib/pricing/live";
import {
  getPublishedJournalPost,
  listPublishedJournalPosts,
  parseJournalParagraph,
} from "../../lib/journal";

const { slug } = Astro.params;
// Renamed posts keep their old links working.
const movedSlugs: Record<string, string> = { "why-we-only-sell-new": "new-and-ex-uk-apple-devices" };
if (slug && movedSlugs[slug]) return Astro.redirect(`/journal/${movedSlugs[slug]}`, 301);
const post = slug ? await getPublishedJournalPost(slug) : undefined;
if (!post) {
  return Astro.redirect("/journal");
}

const all = await listPublishedJournalPosts();
const related = [
  ...all.filter((p) => p.slug !== post.slug && p.category === post.category),
  ...all.filter((p) => p.slug !== post.slug && p.category !== post.category),
].slice(0, 3);
const description = post.seoDescription || post.excerpt;
const liveById = new Map((await livePricedCatalog()).map((p) => [p.id, p]));
const fromKes = (id: string) => `KES ${(liveById.get(id)?.priceKes ?? 0).toLocaleString("en-KE")}`;
const pageTitle = post.seoTitle || `${post.title} - GadgetHub Journal`;
const canonical = new URL(`/journal/${post.slug}`, site.url).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: post.title,
      description,
      datePublished: post.date || undefined,
      dateModified: post.updatedAt?.slice(0, 10) || post.date || undefined,
      author: { "@type": "Organization", name: site.legalName, url: site.url },
      publisher: {
        "@type": "Organization",
        name: site.legalName,
        url: site.url,
        logo: { "@type": "ImageObject", url: new URL("/images/logo.png", site.url).href },
      },
      mainEntityOfPage: canonical,
      image: post.coverUrl ? new URL(post.coverUrl, site.url).href : new URL("/images/logo.png", site.url).href,
      about: { "@id": `${site.url}/#store` },
      articleSection: post.category,
      keywords: post.tags.join(", "),
    },
    ...(post.faq?.length
      ? [
          {
            "@type": "FAQPage",
            mainEntity: post.faq.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") },
            })),
          },
        ]
      : []),
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.url },
        { "@type": "ListItem", position: 2, name: "Journal", item: new URL("/journal", site.url).href },
        { "@type": "ListItem", position: 3, name: post.title, item: canonical },
      ],
    },
  ],
};
---

<BaseLayout title={pageTitle} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <article class="post container">
    <header class="post__header">
      <p class="post__eyebrow">
        <a href="/journal">Journal</a>
        <span aria-hidden="true"> / </span>
        {post.category || post.tags[0]}
      </p>
      <h1>{post.title}</h1>
      <p class="post__meta">
        <time datetime={post.date}>{post.dateLabel}</time>
        {post.author ? <span> · {post.author}</span> : null}
      </p>
    </header>

    <div class="post__body">
      {
        post.paragraphs.map((paragraph) =>
          paragraph.startsWith("## ") ? (
            <h2>{paragraph.slice(3)}</h2>
          ) : (
            <p>
              {parseJournalParagraph(paragraph).map((part) =>
                part.type === "link" ? <a href={part.href}>{part.label}</a> : part.value,
              )}
            </p>
          ),
        )
      }
    </div>

    {
      post.faq?.length ? (
        <section class="post__faq" aria-labelledby="post-faq-title">
          <h2 id="post-faq-title">Questions Kenyans ask</h2>
          {post.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>
                {parseJournalParagraph(f.a).map((part) =>
                  part.type === "link" ? <a href={part.href}>{part.label}</a> : part.value,
                )}
              </p>
            </details>
          ))}
        </section>
      ) : null
    }

    <section class="post__visit" aria-labelledby="post-visit-title">
      <h2 id="post-visit-title">Get served at Gadget Hub, Norwich Union House</h2>
      <p>
        <strong>{site.legalName}</strong> — Apple Authorised Reseller<br />
        {site.addressLines.join(", ")}
      </p>
      <p>{site.hours.weekday} · {site.hours.sunday}</p>
      <p>
        <a href={`tel:${site.phoneE164}`}>Call {site.phoneDisplay}</a>
        ·
        <a href={whatsappUrl(`Hi Gadget Hub, I read "${post.title.slice(0, 80)}" and I'd like to buy.`)} target="_blank" rel="noopener noreferrer">WhatsApp us</a>
        ·
        <a href="https://www.google.com/maps/search/?api=1&query=Norwich+Union+House+Nairobi" target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
        ·
        <a href="/locations">Directions</a>
      </p>
    </section>

    <p class="post__shop">
      Ready to buy sealed in Nairobi?
      <a href="/iphone">Shop iPhones</a>
      ·
      <a href="/iphone/iphone-16">iPhone 16 from {fromKes("iphone-16")}</a>
      ·
      <a href="/iphone/iphone-17">iPhone 17 from {fromKes("iphone-17")}</a>
      ·
      <a href="/lipa-mdogo-mdogo">Lipa Mdogo Mdogo</a>
    </p>

    {
      related.length > 0 ? (
        <aside class="post__related">
          <h2>More from the desk</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/journal/${r.slug}`}>{r.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      ) : null
    }
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
    max-width: 42rem;
  }

  .post__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .post__eyebrow a {
    color: inherit;
  }

  .post h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
    line-height: var(--leading-tight);
  }

  .post__meta {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin-bottom: var(--space-8);
  }

  .post__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .post__body p {
    margin: 0;
    color: var(--color-fg);
    line-height: var(--leading-normal);
    font-size: var(--text-base);
  }

  .post__body a {
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .post__body h2 {
    margin: var(--space-4) 0 0;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .post__faq {
    margin-top: var(--space-8);
  }

  .post__faq h2 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
  }

  .post__faq details {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  .post__faq summary {
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
  }

  .post__faq p {
    margin: var(--space-2) 0 0;
    line-height: var(--leading-normal);
  }

  .post__faq a {
    text-decoration: underline;
  }

  .post__visit {
    margin-top: var(--space-8);
    padding: var(--space-5);
    border-radius: 0.75rem;
    background: #f5f5f7;
    line-height: var(--leading-normal);
  }

  .post__visit h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .post__visit p {
    margin: var(--space-2) 0 0;
  }

  .post__visit a {
    text-decoration: underline;
  }

  .post__shop {
    margin-top: var(--space-8);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .post__shop a {
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .post__related {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .post__related h2 {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-4);
  }

  .post__related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post__related a {
    font-weight: var(--font-weight-medium);
  }
</style>
