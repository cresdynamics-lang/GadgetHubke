---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedJournalPost, listPublishedJournalPosts } from "../../lib/journal";

const { slug } = Astro.params;
const post = slug ? await getPublishedJournalPost(slug) : undefined;
if (!post) {
  return Astro.redirect("/journal");
}

const all = await listPublishedJournalPosts();
const related = all.filter((p) => p.slug !== post.slug).slice(0, 2);
const description = post.seoDescription || post.excerpt;
const pageTitle = post.seoTitle || `${post.title} - GadgetHub Journal`;
---

<BaseLayout title={pageTitle} description={description}>
  <article class="post container">
    <header class="post__header">
      <p class="post__eyebrow">
        <a href="/journal">Journal</a>
        <span aria-hidden="true"> / </span>
        {post.category || post.tags[0]}
      </p>
      <h1>{post.title}</h1>
      <p class="post__meta">
        <time datetime={post.date}>{post.dateLabel}</time>
        {post.author ? <span> · {post.author}</span> : null}
      </p>
    </header>

    <div class="post__body">
      {post.paragraphs.map((p) => <p>{p}</p>)}
    </div>

    {
      related.length > 0 ? (
        <aside class="post__related">
          <h2>More from the desk</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/journal/${r.slug}`}>{r.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      ) : null
    }
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
    max-width: 42rem;
  }

  .post__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .post__eyebrow a {
    color: inherit;
  }

  .post h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
    line-height: var(--leading-tight);
  }

  .post__meta {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin-bottom: var(--space-8);
  }

  .post__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .post__body p {
    margin: 0;
    color: var(--color-fg);
    line-height: var(--leading-normal);
    font-size: var(--text-base);
  }

  .post__related {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .post__related h2 {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-4);
  }

  .post__related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post__related a {
    font-weight: var(--font-weight-medium);
  }
</style>
