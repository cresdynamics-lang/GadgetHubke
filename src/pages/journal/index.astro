---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { listPublishedJournalPosts } from "../../lib/journal";

const posts = await listPublishedJournalPosts();
---

<BaseLayout
  title="Journal - GadgetHub"
  description="Guides and updates for Nairobi buyers - trade-in, Lipa Mdogo Mdogo, and buying new devices."
>
  <section class="journal container">
    <header class="journal__intro">
      <p class="journal__eyebrow">Journal</p>
      <h1>From the desk</h1>
      <p class="journal__lede">Guides and updates for Nairobi buyers.</p>
    </header>

    <ul class="journal__list">
      {
        posts.map((post) => (
          <li>
            <a class="journal__card" href={`/journal/${post.slug}`}>
              <span class="journal__meta">
                <time datetime={post.date}>{post.dateLabel}</time>
                {post.category ? <span>· {post.category}</span> : null}
              </span>
              <h2>{post.title}</h2>
              <p>{post.excerpt}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .journal {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
  }

  .journal__intro {
    max-width: 40rem;
    margin-bottom: var(--space-10);
  }

  .journal__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .journal h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .journal__lede {
    color: var(--color-fg-muted);
  }

  .journal__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
    max-width: 42rem;
  }

  .journal__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .journal__card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .journal__meta {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .journal__card h2 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .journal__card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }
</style>
