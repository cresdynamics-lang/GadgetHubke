---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../lib/blog";

const posts = [...blogPosts].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Blog - GadgetHub"
  description="Guides and updates for Nairobi buyers - trade-in, Lipa Mdogo Mdogo, and buying new devices."
>
  <section class="blog container">
    <header class="blog__intro">
      <p class="blog__eyebrow">Blog</p>
      <h1>From the desk</h1>
      <p class="blog__lede">Guides and updates for Nairobi buyers.</p>
    </header>

    <ul class="blog__list">
      {
        posts.map((post) => (
          <li>
            <a class="blog__card" href={`/blog/${post.slug}`}>
              <span class="blog__meta">
                <time datetime={post.date}>{post.dateLabel}</time>
                {post.tags[0] ? <span>· {post.tags[0]}</span> : null}
              </span>
              <h2>{post.title}</h2>
              <p>{post.excerpt}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .blog {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
  }

  .blog__intro {
    max-width: 40rem;
    margin-bottom: var(--space-10);
  }

  .blog__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .blog h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .blog__lede {
    color: var(--color-fg-muted);
  }

  .blog__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
    max-width: 42rem;
  }

  .blog__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .blog__card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .blog__meta {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .blog__card h2 {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .blog__card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }
</style>
