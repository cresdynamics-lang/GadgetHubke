---
export const prerender = false;

import ManagementLayout from "../../../layouts/ManagementLayout.astro";
import { isAdminAuthed } from "../../../lib/admin";
import { sampleLipa, sampleStaff } from "../../../lib/management/sample";

const authed = await isAdminAuthed(Astro.cookies);
if (!authed) return Astro.redirect("/management");

const plan = sampleLipa.find((p) => p.id === Astro.params.id) || sampleLipa[0];
---

<ManagementLayout title={`Plan ${plan.id} - Management`} authed active="lipa" staffName={sampleStaff.name} staffRole={sampleStaff.role}>
  <p class="mgmt-banner">Sample plan detail - record payment + reminders in Phase H.</p>
  <p class="mgmt-muted" style="margin-bottom:0.5rem;">
    <a class="mgmt-link" href="/management/lipa">‹ Back to Lipa</a>
  </p>
  <h1 class="mgmt-page-title">Plan {plan.id}</h1>
  <p class="mgmt-muted" style="margin-bottom:1rem;">{plan.customer} · {plan.device}</p>

  <div class="mgmt-grid mgmt-grid--2">
    <div class="mgmt-card">
      <h2 style="font-size:1.05rem;">Schedule</h2>
      <p style="margin-top:0.75rem;">Next due: <strong>{plan.nextDue}</strong></p>
      <p class="mgmt-muted">Remaining: {plan.remaining}</p>
      <p class="mgmt-muted">Status: {plan.status}</p>
    </div>
    <div class="mgmt-card">
      <h2 style="font-size:1.05rem;">Actions</h2>
      <div class="mgmt-actions" style="margin-top:0.75rem;">
        <button class="mgmt-btn" type="button" disabled>Record payment</button>
        <button class="mgmt-btn mgmt-btn--ghost" type="button" disabled>Send reminder</button>
      </div>
    </div>
  </div>
</ManagementLayout>
