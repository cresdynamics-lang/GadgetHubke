---
export const prerender = false;

import ManagementLayout from "../../../layouts/ManagementLayout.astro";
import { isAdminAuthed, listCatalogMerged } from "../../../lib/admin";
import { sampleStaff } from "../../../lib/management/sample";

const authed = await isAdminAuthed(Astro.cookies);
if (!authed) return Astro.redirect("/management");

const items = await listCatalogMerged();
const groups = [...new Set(items.map((i) => i.group))];
const kes = (n?: number) => (typeof n === "number" ? n : "");
---

<ManagementLayout title="Prices & stock - Management" authed active="catalog" staffName={sampleStaff.name} staffRole={sampleStaff.role}>
  <section class="mgmt-card">
    <h1 class="mgmt-page-title">Prices & stock</h1>
    <p class="mgmt-muted">
      Every price on the site comes from here: product pages, cards, cart, checkout and the Google / Meta feeds.
      Edit a product's options and press Save; the shop updates within a few seconds.
    </p>
    <div class="mgmt-filter">
      <input class="mgmt-input" type="search" placeholder="Filter by name or id" data-filter-q style="max-width:16rem;" />
      <select class="mgmt-select" data-filter-group style="max-width:12rem;">
        <option value="">All groups</option>
        {groups.map((g) => <option value={g}>{g}</option>)}
      </select>
      <span class="mgmt-ok" data-save-ok hidden>Saved</span>
      <span class="mgmt-error" data-save-err hidden></span>
    </div>
    <div style="overflow:auto;">
      <table class="mgmt-table" data-catalog-table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Group</th>
            <th>Option</th>
            <th>New (KES)</th>
            <th>Ex-UK (KES)</th>
            <th>In stock</th>
            <th></th>
          </tr>
        </thead>
        {
          items.map((item) => {
            const options = item.variants.length
              ? item.variants
              : [{ key: "", label: "Single price", priceKes: item.priceKes, exUkKes: item.exUkKes, inStock: item.inStock }];
            return (
              <tbody
                data-row
                data-id={item.id}
                data-group={item.group}
                data-name={`${item.name} ${item.id}`.toLowerCase()}
                data-has-variants={item.variants.length ? "1" : "0"}
                class="cat-product"
              >
                {options.map((v, i) => (
                  <tr data-variant={v.key}>
                    {i === 0 ? (
                      <>
                        <td rowspan={options.length}>
                          <strong>{item.name}</strong>
                          <div class="mgmt-muted">{item.id}</div>
                          {item.sample ? <div class="mgmt-muted">Repo default</div> : <div class="mgmt-muted">Saved in admin</div>}
                        </td>
                        <td rowspan={options.length}>{item.group}</td>
                      </>
                    ) : null}
                    <td>{v.label}</td>
                    <td><input type="number" min="0" step="500" value={kes(v.priceKes)} data-price style="width:7.5rem;" /></td>
                    <td><input type="number" min="0" step="500" value={kes(v.exUkKes)} data-exuk style="width:7.5rem;" /></td>
                    <td><input type="checkbox" checked={v.inStock} data-stock /></td>
                    {i === 0 ? (
                      <td rowspan={options.length} class="mgmt-actions">
                        <button type="button" class="mgmt-btn mgmt-btn--sm" data-save>Save</button>
                        <a class="mgmt-btn mgmt-btn--ghost mgmt-btn--sm" href={item.href} target="_blank" rel="noopener">Open</a>
                      </td>
                    ) : null}
                  </tr>
                ))}
              </tbody>
            );
          })
        }
      </table>
    </div>
  </section>
</ManagementLayout>

<style>
  .cat-product + .cat-product tr:first-child td { border-top: 2px solid rgba(0, 0, 0, 0.12); }
</style>

<script>
  const ok = document.querySelector("[data-save-ok]");
  const err = document.querySelector("[data-save-err]");
  const qEl = document.querySelector<HTMLInputElement>("[data-filter-q]");
  const gEl = document.querySelector<HTMLSelectElement>("[data-filter-group]");

  function filter() {
    const q = (qEl?.value || "").trim().toLowerCase();
    const g = gEl?.value || "";
    document.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
      const name = row.dataset.name || "";
      const group = row.dataset.group || "";
      row.hidden = Boolean((q && !name.includes(q)) || (g && group !== g));
    });
  }
  qEl?.addEventListener("input", filter);
  gEl?.addEventListener("change", filter);

  function num(input: HTMLInputElement | null): number | null {
    const raw = (input?.value || "").trim();
    if (!raw) return null;
    const n = Number(raw);
    return Number.isFinite(n) && n >= 0 ? n : null;
  }

  document.querySelectorAll("[data-save]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const row = (btn as HTMLElement).closest<HTMLElement>("[data-row]");
      if (!row) return;
      ok?.setAttribute("hidden", "");
      err?.setAttribute("hidden", "");
      const body: Record<string, unknown> = { id: row.dataset.id };
      const lines = [...row.querySelectorAll<HTMLTableRowElement>("[data-variant]")];
      if (row.dataset.hasVariants === "1") {
        const storages: Record<string, unknown> = {};
        for (const tr of lines) {
          storages[tr.dataset.variant || ""] = {
            priceKes: num(tr.querySelector("[data-price]")),
            exUkKes: num(tr.querySelector("[data-exuk]")),
            inStock: Boolean(tr.querySelector<HTMLInputElement>("[data-stock]")?.checked),
          };
        }
        body.storages = storages;
        body.inStock = lines.some((tr) => tr.querySelector<HTMLInputElement>("[data-stock]")?.checked);
      } else {
        const tr = lines[0];
        body.priceKes = num(tr.querySelector("[data-price]"));
        body.exUkKes = num(tr.querySelector("[data-exuk]"));
        body.inStock = Boolean(tr.querySelector<HTMLInputElement>("[data-stock]")?.checked);
      }
      (btn as HTMLButtonElement).disabled = true;
      try {
        const res = await fetch("/api/admin/catalog", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Save failed");
        if (ok) {
          ok.textContent = `Saved ${row.dataset.id}`;
          ok.removeAttribute("hidden");
        }
      } catch (e) {
        if (err) {
          err.textContent = e instanceof Error ? e.message : "Save failed";
          err.removeAttribute("hidden");
        }
      } finally {
        (btn as HTMLButtonElement).disabled = false;
      }
    });
  });
</script>
