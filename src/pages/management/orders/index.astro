---
export const prerender = false;

import ManagementLayout from "../../../layouts/ManagementLayout.astro";
import { isAdminAuthed } from "../../../lib/admin";
import { listOrders } from "../../../lib/checkout/orders";
import { sampleStaff } from "../../../lib/management/sample";
import { countByTab, filterByTab, toMgmtRow, withinLastDays } from "../../../lib/management/orders-view";

const authed = await isAdminAuthed(Astro.cookies);
if (!authed) return Astro.redirect("/management");

const status = (Astro.url.searchParams.get("status") || "all").toLowerCase();
const all = (await listOrders())
  .map(toMgmtRow)
  .sort((a, b) => b.placedAt.localeCompare(a.placedAt));
const orders = filterByTab(all, status);
const counts = countByTab(all);
const deliveredThisWeek = all.filter((o) => o.status === "Delivered" && withinLastDays(o.raw.updatedAt, 7)).length;
---

<ManagementLayout title="Orders - Management" authed active="orders" staffName={sampleStaff.name} staffRole={sampleStaff.role}>
  <header style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:0.75rem;align-items:end;margin-bottom:1rem;">
    <div>
      <h1 class="mgmt-page-title">Orders</h1>
      <p class="mgmt-muted">Every website checkout, newest first. Open an order to confirm, dispatch or mark delivered.</p>
    </div>
  </header>

  <div class="mgmt-grid mgmt-grid--4" style="margin-bottom:1rem;">
    <div class="mgmt-card"><p class="mgmt-muted">New</p><p class="mgmt-stat">{counts.new}</p><p class="mgmt-muted">awaiting payment or new</p></div>
    <div class="mgmt-card"><p class="mgmt-muted">Confirmed</p><p class="mgmt-stat">{counts.confirmed}</p><p class="mgmt-muted">paid, to dispatch</p></div>
    <div class="mgmt-card"><p class="mgmt-muted">Out for delivery</p><p class="mgmt-stat">{counts.dispatched}</p></div>
    <div class="mgmt-card"><p class="mgmt-muted">Delivered this week</p><p class="mgmt-stat">{deliveredThisWeek}</p></div>
  </div>

  <div class="mgmt-card">
    <div class="mgmt-tabs">
      <a class:list={["mgmt-tab", { "is-active": status === "all" }]} href="/management/orders">All {all.length}</a>
      <a class:list={["mgmt-tab", { "is-active": status === "new" }]} href="/management/orders?status=new">New {counts.new}</a>
      <a class:list={["mgmt-tab", { "is-active": status === "confirmed" }]} href="/management/orders?status=confirmed">Confirmed {counts.confirmed}</a>
      <a class:list={["mgmt-tab", { "is-active": status === "dispatched" }]} href="/management/orders?status=dispatched">Dispatched {counts.dispatched}</a>
      <a class:list={["mgmt-tab", { "is-active": status === "delivered" }]} href="/management/orders?status=delivered">Delivered {counts.delivered}</a>
      <a class:list={["mgmt-tab", { "is-active": status === "cancelled" }]} href="/management/orders?status=cancelled">Cancelled {counts.cancelled}</a>
    </div>
    <div style="overflow:auto;">
      <table class="mgmt-table">
        <thead>
          <tr>
            <th>Order</th>
            <th>Customer</th>
            <th>Item</th>
            <th>Total</th>
            <th>Payment</th>
            <th>Pickup / delivery</th>
            <th>Status</th>
            <th>Placed</th>
          </tr>
        </thead>
        <tbody>
          {
            orders.length ? (
              orders.map((o) => (
                <tr>
                  <td>
                    <a class="mgmt-link" href={`/management/orders/${encodeURIComponent(o.id)}`}>{o.id}</a>
                  </td>
                  <td>
                    {o.customer}
                    <div class="mgmt-muted">{o.phone}</div>
                  </td>
                  <td>{o.item}</td>
                  <td>{o.total}</td>
                  <td>{o.payment}</td>
                  <td>{o.raw.customer.fulfillment === "delivery" ? "Delivery" : "Pickup"}</td>
                  <td>
                    <span class:list={["mgmt-tag", { "mgmt-tag--new": o.status === "New" || o.status === "Awaiting payment" }]}>{o.status}</span>
                  </td>
                  <td class="mgmt-muted">{o.placed}</td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="8" class="mgmt-muted">No orders in this view yet.</td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</ManagementLayout>
