---
export const prerender = false;

import ManagementLayout from "../../layouts/ManagementLayout.astro";
import { isAdminAuthed } from "../../lib/admin";
import { formatKes } from "../../lib/checkout/bag";
import { listLipaPlans } from "../../lib/management/lipa";
import { sampleStaff } from "../../lib/management/sample";
import { site } from "../../lib/site";

const authed = await isAdminAuthed(Astro.cookies);
if (!authed) return Astro.redirect("/management");

const filter = Astro.url.searchParams.get("filter") || "all";
const all = await listLipaPlans();
const plans = all.filter((p) => {
  if (filter === "missed") return p.status === "Missed";
  if (filter === "due") return p.status === "Due today";
  if (filter === "deposit") return p.status === "Awaiting deposit";
  return true;
});

function waHref(row: (typeof plans)[number]) {
  const phone = (row.phone || "").replace(/\D/g, "");
  const to = phone.length >= 9 ? phone.replace(/^0/, "254") : site.whatsapp;
  const text = `Hi ${row.customer} — following up on Lipa Mdogo Mdogo ${row.id} (${row.device}).`;
  return `https://wa.me/${to}?text=${encodeURIComponent(text)}`;
}
---

<ManagementLayout title="Lipa Mdogo Mdogo - Management" authed active="lipa" staffName={sampleStaff.name} staffRole={sampleStaff.role}>
  <header style="margin-bottom:1rem;">
    <h1 class="mgmt-page-title">Lipa Mdogo Mdogo</h1>
    <p class="mgmt-muted">Applications and checkout deposits. Remaining is after the deposit, not the amount due today.</p>
  </header>

  <div class="mgmt-tabs">
    <a class:list={["mgmt-tab", { "is-active": filter === "all" }]} href="/management/lipa">All</a>
    <a class:list={["mgmt-tab", { "is-active": filter === "deposit" }]} href="/management/lipa?filter=deposit">Awaiting deposit</a>
    <a class:list={["mgmt-tab", { "is-active": filter === "due" }]} href="/management/lipa?filter=due">Due today</a>
    <a class:list={["mgmt-tab", { "is-active": filter === "missed" }]} href="/management/lipa?filter=missed">Missed</a>
  </div>

  <div class="mgmt-card">
    <table class="mgmt-table">
      <thead>
        <tr>
          <th>Plan</th>
          <th>Customer</th>
          <th>Device</th>
          <th>Status</th>
          <th>Next due</th>
          <th>Remaining</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          plans.length ? (
            plans.map((p) => (
              <tr>
                <td>
                  <a class="mgmt-link" href={`/management/lipa/${p.id}`}>
                    {p.id}
                  </a>
                </td>
                <td>
                  {p.customer}
                  <div class="mgmt-muted">{p.phone || "—"}{p.email ? ` · ${p.email}` : ""}</div>
                </td>
                <td>{p.device}</td>
                <td>
                  <span
                    class:list={[
                      "mgmt-tag",
                      { "mgmt-tag--danger": p.status === "Missed", "mgmt-tag--new": p.status === "Due today" || p.status === "Awaiting deposit" },
                    ]}
                  >
                    {p.status}
                  </span>
                </td>
                <td>{p.nextDue}</td>
                <td>{formatKes(p.remainingKes)}</td>
                <td>
                  <a class="mgmt-link" href={waHref(p)} target="_blank" rel="noopener noreferrer">WhatsApp</a>
                </td>
              </tr>
            ))
          ) : (
            <tr>
              <td colspan="7" class="mgmt-muted">No Lipa plans in this view yet.</td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</ManagementLayout>
