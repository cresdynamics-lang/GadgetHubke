---
export const prerender = false;

import ManagementLayout from "../../layouts/ManagementLayout.astro";
import { isAdminAuthed } from "../../lib/admin";
import { formatKes } from "../../lib/checkout/bag";
import { sampleStaff } from "../../lib/management/sample";
import { listTradeIns } from "../../lib/management/trade-ins";
import { site } from "../../lib/site";

const authed = await isAdminAuthed(Astro.cookies);
if (!authed) return Astro.redirect("/management");

const rows = await listTradeIns();

function when(iso: string) {
  return new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "Africa/Nairobi",
  }).format(new Date(iso));
}

function waHref(row: (typeof rows)[number]) {
  const phone = (row.phone || "").replace(/\D/g, "");
  const to = phone.length >= 9 ? phone.replace(/^0/, "254") : site.whatsapp;
  const text = `Hi ${row.customer} — following up on trade-in ${row.id} (${row.device}${row.wantDevice ? `, toward ${row.wantDevice}` : ""}).`;
  return `https://wa.me/${to}?text=${encodeURIComponent(text)}`;
}
---

<ManagementLayout title="Trade-ins - Management" authed active="trade-ins" staffName={sampleStaff.name} staffRole={sampleStaff.role}>
  <header style="margin-bottom:1rem;">
    <h1 class="mgmt-page-title">Trade-ins</h1>
    <p class="mgmt-muted">Each request names the phone they are trading in and the device they want. Enter a quote to email it back. Nothing is charged until the phone is inspected.</p>
  </header>
  <div class="mgmt-card">
    <table class="mgmt-table">
      <thead>
        <tr>
          <th>Request</th>
          <th>Customer</th>
          <th>Device</th>
          <th>Status</th>
          <th>Quote</th>
          <th>Submitted</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          rows.length ? (
            rows.map((t) => (
              <tr>
                <td>{t.id}</td>
                <td>
                  {t.customer}
                  <div class="mgmt-muted">{t.phone || "—"}{t.email ? ` · ${t.email}` : ""}</div>
                </td>
                <td>
                  {t.device}
                  {t.wantDevice ? <div class="mgmt-muted">Wants: {t.wantDevice}{t.wantKes ? ` (${formatKes(t.wantKes)})` : ""}</div> : null}
                  {t.answers?.length ? (
                    <details class="mgmt-muted">
                      <summary>Condition answers</summary>
                      {t.answers.map((a) => <div>{a.question}: {a.answer}</div>)}
                    </details>
                  ) : null}
                  {t.notes ? <div class="mgmt-muted">{t.notes}</div> : null}
                </td>
                <td>
                  <span class:list={["mgmt-tag", { "mgmt-tag--new": t.status.includes("Waiting") }]}>{t.status}</span>
                </td>
                <td>
                  {t.quoteKes ? formatKes(t.quoteKes) : "-"}
                  <form class="mgmt-quote" data-quote-form style="margin-top:0.4rem;display:flex;gap:0.35rem;align-items:center;">
                    <input type="hidden" name="id" value={t.id} />
                    <input name="quoteKes" type="number" min="1" step="1" required placeholder="KES" aria-label={`Quote for ${t.id}`} style="width:7rem;padding:0.3rem 0.4rem;" />
                    <button type="submit" class="mgmt-link" style="background:none;border:0;padding:0;cursor:pointer;">Email quote</button>
                  </form>
                  <p class="mgmt-muted" data-quote-status hidden></p>
                </td>
                <td class="mgmt-muted">{when(t.submittedAt)}</td>
                <td>
                  <a class="mgmt-link" href={waHref(t)} target="_blank" rel="noopener noreferrer">WhatsApp</a>
                </td>
              </tr>
            ))
          ) : (
            <tr>
              <td colspan="7" class="mgmt-muted">No trade-in requests yet.</td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</ManagementLayout>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-quote-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const status = form.parentElement?.querySelector<HTMLElement>("[data-quote-status]");
      const button = form.querySelector<HTMLButtonElement>("button");
      const data = new FormData(form);
      if (button) button.disabled = true;
      if (status) {
        status.hidden = false;
        status.textContent = "Sending…";
      }
      try {
        const response = await fetch("/api/management/trade-in-quote", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: data.get("id"), quoteKes: Number(data.get("quoteKes")) }),
        });
        const body = await response.json();
        if (!response.ok) throw new Error(body.error || "Could not send the quote.");
        if (status) {
          status.textContent = body.emailed
            ? `Quote emailed to ${body.email}.`
            : "Quote saved. This request has no email, so reply on WhatsApp.";
        }
      } catch (error) {
        if (status) status.textContent = error instanceof Error ? error.message : "Could not send the quote.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
