---
export const prerender = false;

import ManagementLayout from "../../layouts/ManagementLayout.astro";
import { adminSecretConfigured, isAdminAuthed } from "../../lib/admin";
import { sampleStaff } from "../../lib/management/sample";
import { buildDashboard } from "../../lib/management/dashboard";
import { liveSnapshot } from "../../lib/analytics/presence";

const authed = await isAdminAuthed(Astro.cookies);
const d = authed ? await buildDashboard() : null;
const live = liveSnapshot();

const now = new Date();
const greetingHour = Number(
  new Intl.DateTimeFormat("en-GB", { hour: "numeric", hour12: false, timeZone: "Africa/Nairobi" }).format(now),
);
const greeting =
  greetingHour < 12 ? "Good morning" : greetingHour < 17 ? "Good afternoon" : "Good evening";
const dayLabel = new Intl.DateTimeFormat("en-GB", {
  weekday: "long",
  timeZone: "Africa/Nairobi",
}).format(now);
---

<ManagementLayout
  title={authed ? "Dashboard - Management" : "Sign in - Gadget Hub Admin"}
  authed={authed}
  active="dashboard"
  staffName={sampleStaff.name}
  staffRole={sampleStaff.role}
>
  {
    !authed ? (
      <section class="mgmt-card" style="max-width:26rem;margin:3rem auto;">
        <p class="mgmt-eyebrow">Gadget Hub Admin · Sign in</p>
        <h1 class="mgmt-page-title">Sign in to Gadget Hub Admin</h1>
        <p class="mgmt-muted">Staff only. Ask the owner if you need access.</p>
        {!adminSecretConfigured() ? (
          <p class="mgmt-error" style="margin-top:0.75rem;">Set ADMIN_SECRET in the server env first.</p>
        ) : null}

        <form data-mgmt-login style="display:grid;gap:0.85rem;margin-top:1.25rem;">
          <div data-login-step="password">
            <label style="display:grid;gap:0.3rem;">
              <span class="mgmt-muted">Email</span>
              <input class="mgmt-input" type="email" name="email" required autocomplete="username" placeholder="you@gadgethubke.com" />
            </label>
            <label style="display:grid;gap:0.3rem;margin-top:0.75rem;">
              <span class="mgmt-muted">Password</span>
              <input class="mgmt-input" type="password" name="password" required autocomplete="current-password" />
            </label>
          </div>

          <p class="mgmt-error" data-login-error hidden></p>
          <button class="mgmt-btn" type="submit" data-login-submit>Sign in</button>
          <p class="mgmt-muted" style="margin:0;font-size:0.82rem;">
            Forgot password · Locked after 5 wrong tries
          </p>
        </form>

        {import.meta.env.DEV ? (
          <p class="mgmt-muted" style="margin-top:1rem;">
            Dev password: <code>gadgethub-dev-admin</code> (or ADMIN_SECRET).
          </p>
        ) : null}
      </section>
    ) : (
      <section>
        <header style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:0.75rem;align-items:end;margin-bottom:1.25rem;">
          <div>
            <h1 class="mgmt-page-title">
              {greeting}, {sampleStaff.name.split(" ")[0]}
            </h1>
            <p class="mgmt-muted">{dayLabel} · all times East Africa Time</p>
          </div>
          <span class="mgmt-tag">Today</span>
        </header>

        <div class="mgmt-grid mgmt-grid--4" style="margin-bottom:1rem;">
          <a class="mgmt-card mgmt-stat-card" href="/management/live">
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span class="mgmt-muted">Visitors on the website now</span>
              <span class="mgmt-tag mgmt-tag--live">live</span>
            </div>
            <p class="mgmt-stat" data-live="now">{live.now}</p>
            <p class="mgmt-muted">
              <span data-live="last5Min">{live.last5Min}</span> active in the last 5 minutes
              <br />
              <span data-live="phones">{live.devices.Phone}</span> phones · <span data-live="computers">{live.devices.Computer}</span> computers · <span data-live="tablets">{live.devices.Tablet}</span> tablets
              <br />
              <span data-live="todayVisitors">{live.today.visitors}</span> different visitors today
            </p>
          </a>
          <div class="mgmt-card">
            <p class="mgmt-muted">Orders today</p>
            <p class="mgmt-stat">{d!.ordersToday}</p>
            <p class="mgmt-muted">{d!.ordersDelta >= 0 ? "▲" : "▼"} {Math.abs(d!.ordersDelta)} vs yesterday</p>
          </div>
          <div class="mgmt-card">
            <p class="mgmt-muted">Sales today</p>
            <p class="mgmt-stat">KES {d!.salesTodayKes.toLocaleString("en-KE")}</p>
            <p class="mgmt-muted">paid website orders today</p>
          </div>
          <div class="mgmt-card">
            <p class="mgmt-muted">WhatsApp clicks</p>
            <p class="mgmt-stat" data-live="whatsapp">{live.today.whatsapp}</p>
            <p class="mgmt-muted">today, from any page</p>
          </div>
        </div>

        <div class="mgmt-grid mgmt-grid--2" style="margin-bottom:1rem;">
          <div class="mgmt-card">
            <p class="mgmt-muted">Trade-in requests</p>
            <p class="mgmt-stat">{d!.tradeInRequests}</p>
            <p class="mgmt-muted">{d!.tradeInsWaitingQuote} waiting for a quote</p>
          </div>
          <div class="mgmt-card">
            <h2 style="font-size:1.05rem;">Needs your attention</h2>
            <ul class="mgmt-attention">
              {!d!.attention.length ? <li class="mgmt-muted">Nothing waiting right now.</li> : null}
              {d!.attention.map((item) => (
                <li>
                  <span>
                    <span class="mgmt-attention__count">{item.count}</span> {item.label}
                    {item.badge ? <span class="mgmt-tag mgmt-tag--new" style="margin-left:0.4rem;">{item.badge}</span> : null}
                  </span>
                  <a class="mgmt-link" href={item.href}>
                    Open ›
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mgmt-grid mgmt-grid--2">
          <div class="mgmt-card">
            <h2 style="font-size:1.05rem;">Pages people are viewing now</h2>
            <table class="mgmt-table">
              <tbody data-live="pages">
                {live.pages.length ? live.pages.map((p) => (
                  <tr>
                    <td>{p.label}</td>
                    <td style="text-align:right;font-weight:600;">{p.count}</td>
                  </tr>
                )) : <tr><td class="mgmt-muted">Nobody on the site right now.</td></tr>}
              </tbody>
            </table>
          </div>
          <div class="mgmt-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
              <h2 style="font-size:1.05rem;margin:0;">Latest orders</h2>
              <a class="mgmt-link" href="/management/orders">
                View all ›
              </a>
            </div>
            <table class="mgmt-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Customer</th>
                  <th>Item</th>
                  <th>Total</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {!d!.latestOrders.length ? <tr><td colspan="5" class="mgmt-muted">No website orders yet.</td></tr> : null}
                {d!.latestOrders.map((o) => (
                  <tr>
                    <td><a class="mgmt-link" href={`/management/orders/${encodeURIComponent(o.id)}`}>{o.id}</a></td>
                    <td>{o.customer}</td>
                    <td>{o.item}</td>
                    <td>{o.total}</td>
                    <td>
                      <span class:list={["mgmt-tag", { "mgmt-tag--new": o.status === "New" || o.status === "Awaiting payment" }]}>{o.status}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }
</ManagementLayout>

{
  authed ? (
    <script>
      // Refresh the visitor figures every 10 seconds.
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string);
      async function refreshLive() {
        try {
          const res = await fetch("/api/management/live", { cache: "no-store" });
          if (!res.ok) return;
          const s = await res.json();
          const set = (k: string, v: number) => {
            const el = document.querySelector(`[data-live="${k}"]`);
            if (el) el.textContent = String(v);
          };
          set("now", s.now);
          set("last5Min", s.last5Min);
          set("phones", s.devices.Phone);
          set("computers", s.devices.Computer);
          set("tablets", s.devices.Tablet);
          set("todayVisitors", s.today.visitors);
          set("whatsapp", s.today.whatsapp);
          const pages = document.querySelector('[data-live="pages"]');
          if (pages)
            pages.innerHTML = s.pages.length
              ? s.pages.map((p: { label: string; count: number }) => `<tr><td>${esc(p.label)}</td><td style="text-align:right;font-weight:600;">${p.count}</td></tr>`).join("")
              : `<tr><td class="mgmt-muted">Nobody on the site right now.</td></tr>`;
        } catch {}
      }
      setInterval(refreshLive, 10_000);
    </script>
  ) : null
}

{
  !authed ? (
    <script>
      const form = document.querySelector("[data-mgmt-login]") as HTMLFormElement | null;
      const err = document.querySelector("[data-login-error]");
      const submitBtn = document.querySelector("[data-login-submit]") as HTMLButtonElement | null;

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        err?.setAttribute("hidden", "");
        if (submitBtn) submitBtn.disabled = true;
        const fd = new FormData(form);
        const res = await fetch("/api/management/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: String(fd.get("email") || ""), password: String(fd.get("password") || "") }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          if (submitBtn) submitBtn.disabled = false;
          if (err) {
            err.textContent = data.error || "Login failed.";
            err.removeAttribute("hidden");
          }
          return;
        }
        location.reload();
      });
    </script>
  ) : null
}
