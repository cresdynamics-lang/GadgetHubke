---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  aboutChannels,
  aboutClosing,
  aboutHero,
  aboutHeroProducts,
  aboutCategoryRail,
  aboutSteps,
  aboutStory,
  aboutWhy,
} from "../lib/about-contact";
import { site } from "../lib/site";
import "../styles/launch-pages.css";

const headlineWords = aboutHero.headline.split(" ");
---

<BaseLayout
  title="About - GadgetHub"
  description={aboutHero.intro}
>
  <div class="lp about-lp" data-about-page>
    <!-- Hero -->
    <section class="lp-section lp-section--screen about-hero" aria-label="About hero">
      <div class="about-hero__stage" aria-hidden="true">
        {
          aboutHeroProducts.map((p, i) => (
            <img
              class={`about-hero__float about-hero__float--${i + 1}`}
              src={p.src}
              alt=""
              width="480"
              height="480"
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              data-parallax={String((i + 1) * 0.08)}
            />
          ))
        }
      </div>
      <div class="container about-hero__copy">
        <h1 class="lp-h1" data-word-reveal>
          {
            headlineWords.map((w) => (
              <span class="lp-word">{w}&nbsp;</span>
            ))
          }
        </h1>
        <p class="lp-lede about-hero__intro lp-fade">{aboutHero.intro}</p>
      </div>
      <p class="about-hero__scroll" aria-hidden="true">Scroll</p>
    </section>

    <!-- Story -->
    <section class="lp-section about-story">
      <div class="container about-story__grid">
        <p class="about-story__sticky lp-fade">{aboutStory.sticky}</p>
        <div class="about-story__copy">
          {
            aboutStory.paragraphs.map((p) => (
              <p class="about-story__p" data-brighten>
                {p}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <hr class="lp-hairline container" />

    <!-- New | EX-UK -->
    <section class="lp-section about-channel" data-channel-section>
      <div class="container">
        <p class="lp-eyebrow lp-fade">What we sell</p>
        <h2 class="lp-h2 lp-fade">New or EX-UK</h2>
        <p class="lp-lede lp-fade">
          Two kinds of stock, shown clearly. Toggle to see the difference.
        </p>

        <div class="about-channel__panel lp-fade">
          <div class="about-channel__toggle" role="tablist" aria-label="Stock type">
            <button
              type="button"
              class="about-channel__tab is-active"
              role="tab"
              aria-selected="true"
              data-channel="new"
            >
              New
            </button>
            <button
              type="button"
              class="about-channel__tab"
              role="tab"
              aria-selected="false"
              data-channel="ex-uk"
            >
              EX-UK
            </button>
          </div>

          <div class="about-channel__body">
            <div class="about-channel__media">
              <img
                data-channel-img
                src={aboutChannels.new.image}
                alt={aboutChannels.new.imageAlt}
                width="560"
                height="560"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="about-channel__text">
              <h3 data-channel-title>{aboutChannels.new.title}</h3>
              <p data-channel-body>{aboutChannels.new.body}</p>
              <p class="about-channel__note" data-channel-note>
                {aboutChannels.new.note}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="lp-hairline container" />

    <!-- Why -->
    <section class="lp-section about-why">
      <div class="container">
        <p class="lp-eyebrow lp-fade">Why buy from Gadget Hub</p>
        <h2 class="lp-h2 lp-fade">What we stand on</h2>
        <ol class="about-why__list">
          {
            aboutWhy.map((item) => (
              <li class="about-why__row lp-fade">
                <span class="about-why__n">{item.n}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Category rail -->
    <section class="lp-section about-rail" aria-label="Apple product families">
      <div class="container">
        <p class="lp-eyebrow lp-fade">The whole Apple world</p>
        <h2 class="lp-h2 lp-fade">Not just iPhones</h2>
      </div>
      <div class="about-rail__track" data-rail>
        {
          aboutCategoryRail.map((cat) => (
            <a class="about-rail__card" href={cat.href}>
              <img
                src={cat.image}
                alt=""
                width="320"
                height="320"
                loading="lazy"
                decoding="async"
              />
              <span>{cat.label}</span>
            </a>
          ))
        }
      </div>
    </section>

    <hr class="lp-hairline container" />

    <!-- How it works -->
    <section class="lp-section about-steps">
      <div class="container">
        <p class="lp-eyebrow lp-fade">How it works</p>
        <h2 class="lp-h2 lp-fade">Three steps</h2>
        <div class="about-steps__line" data-steps-line aria-hidden="true"></div>
        <ol class="about-steps__list">
          {
            aboutSteps.map((step, i) => (
              <li class={`about-steps__item lp-fade about-steps__item--${i + 1}`}>
                <span class="about-steps__n">{step.n}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                {i === 1 ? (
                  <div class="about-steps__bubble" aria-hidden="true">
                    <span>WhatsApp</span>
                    <p>Hi - is this in stock?</p>
                  </div>
                ) : null}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="lp-section lp-section--screen about-close">
      <div class="container about-close__inner lp-fade">
        <h2 class="lp-h1 about-close__h">{aboutClosing.headline}</h2>
        <a
          class="lp-wa lp-wa--lg"
          href={aboutClosing.waHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="lp-wa__shine" aria-hidden="true"></span>
          {aboutClosing.waLabel}
        </a>
        <p class="about-close__meta">{site.phoneDisplay}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ channels: aboutChannels }}>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Word reveal
  const words = document.querySelectorAll("[data-word-reveal] .lp-word");
  if (reduce) {
    words.forEach((w) => w.classList.add("is-on"));
  } else {
    words.forEach((w, i) => {
      window.setTimeout(() => w.classList.add("is-on"), 120 + i * 160);
    });
  }

  // Fade-up observer
  const fades = document.querySelectorAll(".lp-fade");
  if (reduce) {
    fades.forEach((el) => el.classList.add("is-in"));
  } else if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
    );
    fades.forEach((el) => io.observe(el));
  } else {
    fades.forEach((el) => el.classList.add("is-in"));
  }

  // Story brighten
  const bright = document.querySelectorAll("[data-brighten]");
  if (!reduce && "IntersectionObserver" in window) {
    const bio = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          e.target.classList.toggle("is-bright", e.isIntersecting);
        }
      },
      { threshold: 0.55 },
    );
    bright.forEach((el) => bio.observe(el));
  } else {
    bright.forEach((el) => el.classList.add("is-bright"));
  }

  // Hero parallax
  const floats = document.querySelectorAll("[data-parallax]");
  if (!reduce && floats.length) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        floats.forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const f = Number(el.dataset.parallax || 0.1);
          el.style.transform = `translate3d(0, ${y * f}px, 0)`;
        });
        ticking = false;
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  // Channel toggle
  const section = document.querySelector("[data-channel-section]");
  if (section) {
    const img = section.querySelector("[data-channel-img]");
    const title = section.querySelector("[data-channel-title]");
    const body = section.querySelector("[data-channel-body]");
    const note = section.querySelector("[data-channel-note]");
    const tabs = section.querySelectorAll("[data-channel]");

    const apply = (key) => {
      const data = channels[key];
      if (!data) return;
      tabs.forEach((tab) => {
        const on = tab.getAttribute("data-channel") === key;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-selected", on ? "true" : "false");
      });
      if (img instanceof HTMLImageElement) {
        img.classList.add("is-swap");
        window.setTimeout(() => {
          img.src = data.image;
          img.alt = data.imageAlt;
          img.classList.remove("is-swap");
        }, reduce ? 0 : 180);
      }
      if (title) title.textContent = data.title;
      if (body) body.textContent = data.body;
      if (note) note.textContent = data.note;
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        apply(tab.getAttribute("data-channel") || "new");
      });
    });
  }

  // Steps line progress
  const line = document.querySelector("[data-steps-line]");
  if (line instanceof HTMLElement && !reduce) {
    const update = () => {
      const rect = line.parentElement?.getBoundingClientRect();
      if (!rect) return;
      const view = window.innerHeight;
      const start = view * 0.75;
      const end = view * 0.25;
      const t = Math.min(1, Math.max(0, (start - rect.top) / (start - end + rect.height * 0.4)));
      line.style.setProperty("--draw", String(t));
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  } else if (line instanceof HTMLElement) {
    line.style.setProperty("--draw", "1");
  }
</script>

<style>
  .about-lp {
    padding-bottom: calc(var(--fab-clearance, 5rem) + 1rem);
  }

  .about-hero {
    position: relative;
    isolation: isolate;
    text-align: center;
    padding-top: clamp(5rem, 14vw, 8rem);
  }

  .about-hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .about-hero__float {
    position: absolute;
    width: min(38vw, 16rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 28px 40px rgb(0 0 0 / 0.55));
    opacity: 0.55;
    will-change: transform;
  }

  .about-hero__float--1 {
    left: 4%;
    top: 18%;
  }
  .about-hero__float--2 {
    right: 6%;
    top: 12%;
  }
  .about-hero__float--3 {
    left: 18%;
    bottom: 12%;
  }
  .about-hero__float--4 {
    right: 14%;
    bottom: 16%;
  }

  @media (max-width: 47.99rem) {
    .about-hero__float--2,
    .about-hero__float--3,
    .about-hero__float--4 {
      display: none;
    }
    .about-hero__float--1 {
      left: 50%;
      top: 12%;
      width: min(70vw, 14rem);
      transform: translateX(-50%);
      opacity: 0.4;
    }
  }

  .about-hero__copy {
    position: relative;
    z-index: 1;
    max-width: 52rem;
    margin-inline: auto;
  }

  .about-hero__intro {
    margin-inline: auto;
  }

  .about-hero__scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lp-muted);
  }

  .about-hero__scroll::after {
    content: "";
    display: block;
    width: 1px;
    height: 2.25rem;
    margin: 0.5rem auto 0;
    background: linear-gradient(to bottom, #fff, transparent);
  }

  .about-story__grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 64rem) {
    .about-story__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .about-story__sticky {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    font-weight: 650;
  }

  @media (min-width: 64rem) {
    .about-story__sticky {
      position: sticky;
      top: 6rem;
    }
  }

  .about-story__p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--lp-dim);
    transition: color 0.5s ease;
    margin: 0 0 1.5rem;
  }

  .about-story__p.is-bright {
    color: var(--lp-ink);
  }

  .about-channel__panel {
    margin-top: 2.5rem;
    border: 1px solid var(--lp-line);
    border-radius: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: rgb(255 255 255 / 0.03);
  }

  .about-channel__toggle {
    display: inline-flex;
    padding: 0.25rem;
    border-radius: 999px;
    border: 1px solid var(--lp-line);
    background: #0a0a0a;
    margin-bottom: 1.75rem;
  }

  .about-channel__tab {
    min-height: 2.75rem;
    min-width: 5.5rem;
    padding: 0.55rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--lp-muted);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .about-channel__tab.is-active {
    background: #fff;
    color: #000;
  }

  .about-channel__body {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .about-channel__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .about-channel__media {
    display: grid;
    place-items: center;
    min-height: 14rem;
  }

  .about-channel__media img {
    width: min(100%, 18rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 24px 36px rgb(0 0 0 / 0.5));
    transition:
      opacity 0.2s ease,
      transform 0.35s ease;
  }

  .about-channel__media img.is-swap {
    opacity: 0;
    transform: scale(0.96);
  }

  .about-channel__text h3 {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }

  .about-channel__text p {
    margin: 0 0 1rem;
    color: var(--lp-muted);
    line-height: 1.55;
  }

  .about-channel__note {
    font-size: 0.95rem;
    color: var(--lp-ink) !important;
    border-top: 1px solid var(--lp-line);
    padding-top: 1rem;
  }

  .about-why__list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .about-why__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--lp-line);
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .about-why__row:last-child {
    border-bottom: 1px solid var(--lp-line);
  }

  .about-why__row:hover,
  .about-why__row:focus-within {
    background: rgb(255 255 255 / 0.04);
    transform: translateX(4px);
  }

  .about-why__n {
    font-size: 0.85rem;
    color: var(--lp-muted);
    letter-spacing: 0.08em;
    padding-top: 0.35rem;
  }

  .about-why__row h3 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    letter-spacing: -0.02em;
  }

  .about-why__row p {
    margin: 0;
    color: var(--lp-muted);
    line-height: 1.55;
    max-width: 40rem;
  }

  .about-rail__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2rem max(1.25rem, calc((100vw - 72rem) / 2)) 1rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .about-rail__card {
    flex: 0 0 min(70vw, 14rem);
    scroll-snap-align: start;
    text-decoration: none;
    color: #fff;
    display: grid;
    gap: 0.85rem;
    justify-items: center;
    padding: 1.25rem 1rem 1.5rem;
    border: 1px solid var(--lp-line);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.03);
    min-height: 48px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .about-rail__card:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
    background: rgb(255 255 255 / 0.06);
  }

  .about-rail__card img {
    width: 8.5rem;
    height: 8.5rem;
    object-fit: contain;
    filter: drop-shadow(0 16px 24px rgb(0 0 0 / 0.45));
  }

  .about-rail__card span {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .about-steps {
    position: relative;
  }

  .about-steps__line {
    display: none;
  }

  @media (min-width: 64rem) {
    .about-steps__line {
      display: block;
      position: absolute;
      left: max(1.25rem, calc((100vw - 72rem) / 2 + 1.1rem));
      top: 10rem;
      bottom: 4rem;
      width: 2px;
      background: var(--lp-line);
    }

    .about-steps__line::after {
      content: "";
      position: absolute;
      inset: 0;
      background: #fff;
      transform: scaleY(var(--draw, 0));
      transform-origin: top;
    }
  }

  .about-steps__list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .about-steps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
      padding-left: 2.5rem;
    }
  }

  .about-steps__n {
    display: block;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--lp-muted);
    margin-bottom: 0.75rem;
  }

  .about-steps__item h3 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .about-steps__item p {
    margin: 0;
    color: var(--lp-muted);
    line-height: 1.55;
  }

  .about-steps__bubble {
    margin-top: 1.25rem;
    max-width: 16rem;
    padding: 0.85rem 1rem;
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: #111;
    border: 1px solid var(--lp-line);
  }

  .about-steps__bubble span {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lp-muted);
    margin-bottom: 0.35rem;
  }

  .about-steps__bubble p {
    margin: 0;
    color: var(--lp-ink);
    font-size: 0.95rem;
  }

  .about-close {
    text-align: center;
  }

  .about-close__inner {
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }

  .about-close__h {
    font-size: clamp(2rem, 6vw, 3.75rem);
    line-height: 1.05;
  }

  .about-close__meta {
    margin: 0;
    color: var(--lp-muted);
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-why__row:hover {
      transform: none;
    }
  }
</style>
