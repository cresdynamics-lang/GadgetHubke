---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AirPodsStage from "../../components/airpods/AirPodsStage.astro";
import AirpodsTrademark from "../../components/airpods/AirpodsTrademark.astro";
import {
  airpodsModels,
  getAirpodsModel,
  getAirpodsImage,
  formatKes,
  hasAnc,
  hasHearing,
} from "../../lib/airpods";

const idsParam = Astro.url.searchParams.get("ids") || "";
const ids = idsParam.split(",").map((s) => s.trim()).filter(Boolean).slice(0, 3);
const models = ids.map((id) => getAirpodsModel(id)).filter(Boolean);
const chosen = models.length ? models : airpodsModels.filter((m) => m.isNew).slice(0, 3);

function honestDiff(list: typeof chosen): string {
  if (list.length < 2) return "Pick two or three models to see what actually changes.";
  const bits: string[] = [];
  const families = new Set(list.map((m) => m!.family));
  if (families.size > 1) bits.push(`Lineups differ: ${[...families].join(" vs ")}.`);
  const types = [...new Set(list.map((m) => m!.type))];
  if (types.length > 1) bits.push(`In-ear vs over-ear changes fit and case.`);
  const anc = list.map((m) => hasAnc(m!));
  if (anc.some(Boolean) && anc.some((v) => !v)) bits.push("Full ANC is only on some of these.");
  const hear = list.map((m) => hasHearing(m!));
  if (hear.some(Boolean) && hear.some((v) => !v)) bits.push("Hearing features differ - confirm Kenya availability.");
  return bits.slice(0, 3).join(" ") || "These models are close - check case, chip and sample price.";
}

const rows: { label: string; values: (string | number | boolean | null)[] }[] = [
  { label: "Family", values: chosen.map((m) => m!.family) },
  { label: "Type", values: chosen.map((m) => m!.type) },
  { label: "Chip", values: chosen.map((m) => m!.chip) },
  { label: "ANC", values: chosen.map((m) => hasAnc(m!)) },
  { label: "Spatial Audio", values: chosen.map((m) => m!.spatialAudio) },
  { label: "Hearing features", values: chosen.map((m) => hasHearing(m)) },
  { label: "Heart rate", values: chosen.map((m) => m!.heartRate) },
  { label: "Water / IP", values: chosen.map((m) => m!.waterRating) },
  { label: "Battery (single h)", values: chosen.map((m) => m!.batterySingleHours) },
  { label: "Battery + case (h)", values: chosen.map((m) => m!.batteryWithCaseHours) },
  { label: "Weight (g)", values: chosen.map((m) => m!.weightG) },
  { label: "From (KES sample)", values: chosen.map((m) => m!.basePriceKes) },
];

function cell(v: string | number | boolean | null): string {
  if (v == null) return "-";
  if (typeof v === "boolean") return v ? "Yes" : "No";
  if (typeof v === "number") return v.toLocaleString("en-KE");
  return v;
}
---

<BaseLayout title="Compare AirPods - GadgetHub" description="Compare AirPods side by side.">
  <section class="container acmp">
    <header>
      <h1>Compare AirPods</h1>
      <p class="acmp__honest">{honestDiff(chosen)}</p>
      <label class="acmp__toggle">
        <input type="checkbox" checked data-diff-only /> Show only differences
      </label>
    </header>

    <div class="acmp__table-wrap">
      <table class="acmp__table" data-compare-table>
        <thead>
          <tr>
            <th scope="col">Spec</th>
            {chosen.map((m) => {
              const compareKey =
                m!.family === "Pro"
                  ? "compare:airpods-pro-compare"
                  : m!.family === "Max"
                    ? "compare:airpods-max-compare"
                    : m!.id.includes("5")
                      ? "compare:airpods-5-up-compare"
                      : "earbuds";
              const img = getAirpodsImage(m!.id, compareKey, m!.name);
              const fallback = getAirpodsImage(m!.id, "earbuds", m!.name);
              const use = img.fallback ? fallback : img;
              return (
                <th scope="col">
                  <AirPodsStage src={use.src} srcWebp={use.srcWebp} alt={use.alt} width={320} height={320} />
                  <a href={`/airpods/${m!.id}`}>{m!.name}</a>
                  <em>From {formatKes(m!.basePriceKes)}</em>
                </th>
              );
            })}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => {
            const same = row.values.every((v) => String(v) === String(row.values[0]));
            return (
              <tr data-diff-row data-same={same ? "1" : "0"}>
                <th scope="row">{row.label}</th>
                {row.values.map((v) => <td>{cell(v)}</td>)}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="acmp__pick">
      Or pick models:
      <select data-pick-a>
        {airpodsModels.map((m) => <option value={m.id}>{m.name}</option>)}
      </select>
      <select data-pick-b>
        {airpodsModels.map((m) => <option value={m.id} selected={m.id === "airpods-pro-3"}>{m.name}</option>)}
      </select>
      <button type="button" class="btn btn--primary btn--sm" data-pick-go>Compare</button>
    </p>
    <AirpodsTrademark />
  </section>
</BaseLayout>

<script>
  const box = document.querySelector("[data-diff-only]");
  function apply() {
    const only = box instanceof HTMLInputElement && box.checked;
    document.querySelectorAll("[data-diff-row]").forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      row.hidden = only && row.getAttribute("data-same") === "1";
    });
  }
  box?.addEventListener("change", apply);
  apply();

  document.querySelector("[data-pick-go]")?.addEventListener("click", () => {
    const a = document.querySelector("[data-pick-a]");
    const b = document.querySelector("[data-pick-b]");
    if (a instanceof HTMLSelectElement && b instanceof HTMLSelectElement) {
      window.location.href = `/airpods/compare?ids=${encodeURIComponent(`${a.value},${b.value}`)}`;
    }
  });
</script>

<style>
  .acmp { padding-block: 2rem 4rem; overflow-x: hidden; }
  .acmp h1 { margin: 0 0 0.5rem; letter-spacing: -0.03em; }
  .acmp__honest { color: #6e6e73; max-width: 40rem; }
  .acmp__toggle { display: inline-flex; gap: 0.4rem; align-items: center; margin: 1rem 0; font-size: var(--text-sm); }
  .acmp__table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .acmp__table { width: 100%; border-collapse: collapse; min-width: 36rem; }
  .acmp__table th, .acmp__table td {
    border-bottom: 1px solid #d2d2d7; padding: 0.75rem; text-align: left; vertical-align: top;
    font-size: var(--text-sm);
  }
  .acmp__table thead th { min-width: 10rem; }
  .acmp__table thead a { display: block; margin-top: 0.5rem; color: inherit; font-weight: 600; text-decoration: none; }
  .acmp__table thead em { display: block; font-style: normal; color: #6e6e73; }
  .acmp__pick { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
</style>
