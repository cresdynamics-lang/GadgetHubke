---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found - GadgetHub"
  description="That page isn’t on GadgetHub. Browse the shop or WhatsApp us."
>
  <section class="notfound container">
    <p class="notfound__eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="notfound__lede">
      The link may be old or mistyped. New devices are still this way.
    </p>
    <div class="notfound__actions">
      <a class="btn btn--primary" href="/shop">Shop</a>
      <a class="btn btn--secondary" href="/">Home</a>
      <a class="btn btn--secondary" href="/contact">Contact</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-16) calc(var(--space-20) + var(--fab-clearance));
    max-width: 32rem;
  }

  .notfound__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .notfound h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .notfound__lede {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-8);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
