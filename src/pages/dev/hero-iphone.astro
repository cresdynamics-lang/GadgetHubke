---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryHero from "../../components/hero/CategoryHero.astro";
import { getHeroCategory } from "../../lib/hero";

const cat = getHeroCategory("iphone");
---

<BaseLayout
  title="DEV · CategoryHero · iPhone"
  description="Isolated CategoryHero test for iPhone scenes. Not linked from the store nav."
>
  <CategoryHero category="iphone" />

  <section class="dev-notes container">
    <h2>iPhone pack references</h2>
    <ol>
      {
        cat.scenes.map((s) => (
          <li>
            <strong>{s.id}</strong> · {s.motion} · <code>{s.src}</code>
          </li>
        ))
      }
    </ol>
    <p>
      Preview only. Approve before wiring into <code>/iphone</code>.
      All categories: <a href="/dev/hero">/dev/hero</a>
    </p>
  </section>
</BaseLayout>

<style>
  .dev-notes {
    padding: 2rem 0 4rem;
    color: #1d1d1f;
  }
  .dev-notes h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }
  .dev-notes ol {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .dev-notes code {
    font-size: 0.78rem;
    word-break: break-all;
  }
</style>
