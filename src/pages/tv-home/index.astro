---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TvHomeStage from "../../components/tv-home/TvHomeStage.astro";
import TvHomeCard from "../../components/tv-home/TvHomeCard.astro";
import TvHomeQuiz from "../../components/tv-home/TvHomeQuiz.astro";
import TvHomeLipaCalc from "../../components/tv-home/TvHomeLipaCalc.astro";
import TvHomeTradeIn from "../../components/tv-home/TvHomeTradeIn.astro";
import TvHomeTrademark from "../../components/tv-home/TvHomeTrademark.astro";
import {
  tvHomeModels,
  tvHomeModelsByFamily,
  getTvHomeImage,
  formatKes,
  lowestTvHomePrice,
  tvHomeConfig,
  homeTvHomeAccessories,
  tvHomeBundles,
  tvHomeConfigurePrice,
} from "../../lib/tv-home";
import { whatsappUrl } from "../../lib/site";

const atv = tvHomeModelsByFamily("Apple TV");
const hp = tvHomeModelsByFamily("HomePod");
const mini = tvHomeModelsByFamily("HomePod mini");
const hero = getTvHomeImage("apple-tv-4k-3", "landing");
const heroAlt = getTvHomeImage("homepod-2", "hero");
const accessories = homeTvHomeAccessories();
const newest = [...tvHomeModels].sort((a, b) => b.year - a.year || b.basePriceKes - a.basePriceKes);
const wa = whatsappUrl("Hi Gadget Hub, I want to visit and try TV & Home.");
const corp = whatsappUrl("Corporate TV & Home order");

const choose = [
  {
    title: "Apple TV 4K",
    body: "4K HDR apps on the TV you already own.",
    href: "/tv-home/shop?family=Apple%20TV",
    price: lowestTvHomePrice("Apple TV"),
    model: atv.find((m) => m.id === "apple-tv-4k-3") || atv[0],
    square: false,
  },
  {
    title: "HomePod",
    body: "Full-size sound and smart home hub.",
    href: "/tv-home/shop?family=HomePod",
    price: lowestTvHomePrice("HomePod"),
    model: hp.find((m) => m.id === "homepod-2") || hp[0],
    square: true,
  },
  {
    title: "HomePod mini",
    body: "Compact Siri in every room — stereo pair ready.",
    href: "/tv-home/shop?family=HomePod%20mini",
    price: lowestTvHomePrice("HomePod mini"),
    model: mini[0],
    square: true,
  },
];

const needChips = [
  ["movies", "Movies"],
  ["music", "Music"],
  ["hub", "Smart home"],
  ["compact", "Compact"],
  ["stereo", "Stereo pair"],
  ["budget", "Budget"],
] as const;

const bundlePayload = tvHomeBundles.map((b) => ({
  ...b,
  kes: b.modelIds.reduce((n, id) => {
    const m = tvHomeModels.find((x) => x.id === id);
    if (!m) return n;
    const p = tvHomeConfigurePrice(m, { stereoPair: b.stereoPair });
    return n + p.kes;
  }, 0),
}));
---

<BaseLayout
  title="TV & Home - GadgetHub"
  description="Apple TV 4K, HomePod and HomePod mini. Sealed stock in Nairobi. Sample prices until admin is live."
>
  <section class="tvhome-hero" data-tvhome-hero>
    <div class="tvhome-hero__copy container">
      <h1>Make home feel bigger.</h1>
      <p class="tvhome-hero__lede">{tvHomeConfig.announce}</p>
      <div class="tvhome-hero__cta" data-hero-cta>
        <a class="btn btn--primary" href="/tv-home/apple-tv-4k-3">Shop Apple TV 4K</a>
        <a class="btn btn--secondary" href="/tv-home/homepod-2">Shop HomePod</a>
      </div>
    </div>
    <div class="tvhome-hero__stage" aria-hidden="true">
      <img
        class="tvhome-hero__frame tvhome-hero__frame--start"
        data-hero-start
        src={hero.src}
        alt=""
        width={hero.width}
        height={hero.width}
        fetchpriority="high"
      />
      <img
        class="tvhome-hero__frame tvhome-hero__frame--end"
        data-hero-end
        src={heroAlt.fallback ? hero.src : heroAlt.src}
        alt=""
        width={heroAlt.width}
        height={heroAlt.width}
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="container tvhome-choose">
    <h2>Choose your corner of home</h2>
    <ul class="tvhome-choose__grid">
      {
        choose.map((c) => {
          const img = getTvHomeImage(c.model.id, "hero", c.model.name);
          return (
            <li>
              <a class="tvhome-choose__card" href={c.href}>
                <TvHomeStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={760} height={760} square={c.square} />
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                <em>From {formatKes(c.price)}</em>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="container"><TvHomeQuiz /></section>

  <section class="container tvhome-needs">
    <h2>Shop by need</h2>
    <div class="tvhome-chips" role="group" aria-label="Need">
      {needChips.map(([id, label]) => (
        <a href={`/tv-home/shop?need=${id}`}>{label}</a>
      ))}
    </div>
  </section>

  <section class="container tvhome-grid-sec">
    <div class="tvhome-grid-sec__head">
      <h2>Shop TV &amp; Home</h2>
      <a href="/tv-home/shop">Open full filters</a>
    </div>
    <ul class="tvhome-grid">
      {newest.slice(0, 8).map((m) => (
        <li><TvHomeCard model={m} /></li>
      ))}
    </ul>
  </section>

  <section class="container tvhome-bundles" data-tvhome-bundles>
    <h2>Home bundles</h2>
    <p>Add every item in a bundle to your bag in one tap.</p>
    <ul>
      {
        bundlePayload.map((b) => (
          <li>
            <div>
              <strong>{b.name}</strong>
              <p>{b.blurb}</p>
              <em>{formatKes(b.kes)} sample</em>
            </div>
            <button
              type="button"
              class="btn btn--primary btn--sm"
              data-bundle-add
              data-ids={b.modelIds.join(",")}
              data-stereo={b.stereoPair ? "1" : "0"}
              data-kes={b.kes}
              data-name={b.name}
            >
              Add all to bag
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container tvhome-plan">
    <h2>Plan the purchase</h2>
    <div class="tvhome-plan__grid">
      <TvHomeLipaCalc modelId="apple-tv-4k-3" />
      <TvHomeTradeIn modelId="homepod-2" />
    </div>
  </section>

  <section class="container tvhome-corp">
    <h2>Gifting a team or office?</h2>
    <a class="btn btn--primary" href={corp} target="_blank" rel="noopener noreferrer">Corporate TV &amp; Home order</a>
  </section>

  <section class="container tvhome-acc">
    <h2>Accessories</h2>
    <ul>
      {accessories.map((a) => (
        <li>
          <a href={a.href}>
            <strong>{a.name}</strong>
            <span>{a.priceKes > 0 ? `${formatKes(a.priceKes)} sample` : "Ask"}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container tvhome-visit">
    <h2>Visit the shop</h2>
    <p>{tvHomeConfig.address.line}, {tvHomeConfig.address.city}. Hours: {tvHomeConfig.address.hours}.</p>
    <a class="btn btn--primary" href={wa} target="_blank" rel="noopener noreferrer">Ask on WhatsApp</a>
  </section>

  <section class="container"><TvHomeTrademark /></section>
</BaseLayout>

<script define:vars={{ modelsJson: JSON.stringify(tvHomeModels.map((m) => ({ id: m.id, name: m.name, base: m.basePriceKes }))) }}>
  const models = JSON.parse(modelsJson);
  const hero = document.querySelector("[data-tvhome-hero]");
  const end = document.querySelector("[data-hero-end]");
  const start = document.querySelector("[data-hero-start]");
  const cta = document.querySelector("[data-hero-cta]");
  const copy = document.querySelector(".tvhome-hero__copy");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const mobile = window.matchMedia("(max-width: 47.99rem)").matches;

  if (end instanceof HTMLElement) {
    end.style.opacity = reduce ? "1" : "0";
    if (!reduce) end.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 1400, easing: "cubic-bezier(.16,1,.3,1)", fill: "forwards" });
  }

  if (!reduce && !mobile && hero && end instanceof HTMLElement && start instanceof HTMLElement) {
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const rect = hero.getBoundingClientRect();
          const total = Math.max(1, hero.offsetHeight - window.innerHeight);
          const p = Math.min(1, Math.max(0, -rect.top) / total);
          end.style.opacity = String(p);
          start.style.transform = `scale(${0.94 + p * 0.06})`;
          end.style.transform = `scale(${0.94 + p * 0.06})`;
          if (copy instanceof HTMLElement) copy.style.opacity = String(Math.max(0, 1 - p * 1.4));
          if (cta instanceof HTMLElement) cta.style.opacity = String(p > 0.8 ? Math.min(1, (p - 0.8) / 0.2) : 0);
          ticking = false;
        });
      },
      { passive: true },
    );
  } else if (cta instanceof HTMLElement) cta.style.opacity = "1";

  document.querySelectorAll("[data-bundle-add]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(btn instanceof HTMLElement)) return;
      const ids = (btn.getAttribute("data-ids") || "").split(",").filter(Boolean);
      const stereo = btn.getAttribute("data-stereo") === "1";
      ids.forEach((id) => {
        const m = models.find((x) => x.id === id);
        if (!m) return;
        window.dispatchEvent(
          new CustomEvent("gh:bag-add", {
            detail: {
              id: m.id,
              name: m.name,
              colour: "",
              storage: "",
              pair: stereo ? "Stereo pair" : "",
              extras: btn.getAttribute("data-name") || "",
              kes: m.base,
              image: "",
            },
          }),
        );
      });
    });
  });
</script>

<style>
  .tvhome-hero {
    position: relative;
    min-height: 720px;
    background: #f5f5f7;
    display: grid;
    align-items: end;
    overflow: hidden;
    font-family: Inter, system-ui, sans-serif;
  }
  @media (min-width: 48rem) {
    .tvhome-hero { min-height: 160vh; }
    .tvhome-hero__stage {
      position: sticky;
      top: var(--header-height);
      height: calc(100vh - var(--header-height));
    }
  }
  .tvhome-hero__copy { position: relative; z-index: 2; padding-block: 4rem 2rem; max-width: 40rem; }
  .tvhome-hero h1 { margin: 0 0 0.75rem; font-size: clamp(2.1rem, 4.5vw, 3.4rem); letter-spacing: -0.03em; font-weight: 700; }
  .tvhome-hero__lede { color: #6e6e73; }
  .tvhome-hero__cta { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.25rem; opacity: 0; }
  .tvhome-hero__stage { position: relative; display: grid; place-items: center; }
  .tvhome-hero__frame { position: absolute; width: min(92vw, 52rem); max-height: 70vh; object-fit: contain; mix-blend-mode: multiply; }
  .tvhome-choose { padding-block: 3rem; }
  .tvhome-choose__grid { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .tvhome-choose__card { text-decoration: none; color: inherit; display: grid; gap: 0.5rem; }
  .tvhome-choose__card em { color: #6e6e73; font-style: normal; font-size: var(--text-sm); }
  .tvhome-needs { padding-bottom: 2rem; }
  .tvhome-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.75rem; }
  .tvhome-chips a {
    padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid #d2d2d7; text-decoration: none; color: inherit; font-size: var(--text-sm);
  }
  .tvhome-grid { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .tvhome-grid-sec__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .tvhome-bundles ul { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.75rem; }
  .tvhome-bundles li {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem; background: #f5f5f7; border-radius: 1rem;
  }
  .tvhome-bundles p { margin: 0.25rem 0; color: #6e6e73; font-size: var(--text-sm); }
  .tvhome-plan__grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); margin-top: 1rem; }
  .tvhome-corp, .tvhome-visit, .tvhome-acc { padding-block: 2rem; }
  .tvhome-acc ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .tvhome-acc a { display: flex; justify-content: space-between; text-decoration: none; color: inherit; padding: 0.65rem 0; border-bottom: 1px solid #eee; }
</style>
