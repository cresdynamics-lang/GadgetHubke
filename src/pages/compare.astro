---
import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappUrl } from "../lib/site";

const waHref = whatsappUrl("Hi GadgetHub — I'd like help comparing devices.");
---

<BaseLayout
  title="Compare Devices — GadgetHub"
  description="Compare new devices with help from GadgetHub. WhatsApp us with the models you have in mind."
>
  <section class="compare container">
    <p class="compare__eyebrow">Shop</p>
    <h1>Compare devices</h1>
    <p class="compare__lede">
      A full side-by-side tool is coming. For now, tell us which models you’re
      choosing between and we’ll help on WhatsApp — new sealed stock only.
    </p>
    <div class="compare__actions">
      <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener noreferrer">
        WhatsApp a comparison
      </a>
      <a class="btn btn--secondary" href="/shop">Browse shop</a>
    </div>
  </section>
</BaseLayout>

<style>
  .compare {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
    max-width: 36rem;
  }

  .compare__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .compare h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .compare__lede {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-6);
    line-height: var(--leading-normal);
  }

  .compare__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
