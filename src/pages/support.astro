---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappUrl, telUrl, policy } from "../lib/site";

const waHref = whatsappUrl("Hi GadgetHub - I need support.");

const topics = [
  {
    title: "FAQs",
    body: "Common questions on stock, delivery, Lipa, and trade-in.",
    href: "/faqs",
  },
  {
    title: "Warranty & repairs",
    body: site.warranty.note,
    href: "/warranty-repairs",
  },
  {
    title: "Returns & refunds",
    body: `${policy.returnWindowDays}-day window for faulty or not-as-described items.`,
    href: "/returns",
  },
  {
    title: "Shipping & delivery",
    body: "How orders get to you in Nairobi and beyond.",
    href: "/shipping-delivery",
  },
  {
    title: "Track an order",
    body: "Check status or ask us on WhatsApp with your order details.",
    href: "/track-order",
  },
  {
    title: "Authenticity",
    body: "How we source and stand behind new, sealed devices.",
    href: "/authenticity",
  },
] as const;
---

<BaseLayout
  title="Support - GadgetHub"
  description={`Help with warranty, returns, delivery, and orders. WhatsApp or call ${site.phoneDisplay}.`}
>
  <section class="support container">
    <header class="support__intro">
      <p class="support__eyebrow">Support</p>
      <h1>How can we help?</h1>
      <p class="support__lede">
        Start with a topic below, or message the shop directly - WhatsApp{" "}
        {site.phoneDisplay} is usually fastest.
      </p>
      <div class="support__actions">
        <a
          class="btn btn--primary"
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp {site.phoneDisplay}
        </a>
        <a class="btn btn--secondary" href={telUrl()}>Call</a>
        <a class="btn btn--secondary" href="/contact">Contact form</a>
      </div>
    </header>

    <ul class="support__topics">
      {
        topics.map((t) => (
          <li>
            <a class="support__card" href={t.href}>
              <h2>{t.title}</h2>
              <p>{t.body}</p>
              <span class="support__more">Open →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .support {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
  }

  .support__intro {
    max-width: 40rem;
    margin-bottom: var(--space-10);
  }

  .support__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .support h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .support__lede {
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
  }

  .support__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .support__topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .support__topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .support__topics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .support__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .support__card:hover {
    border-color: var(--color-border-strong);
  }

  .support__card h2 {
    font-size: var(--text-base);
    margin: 0;
  }

  .support__card p {
    margin: 0;
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }

  .support__more {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }
</style>
