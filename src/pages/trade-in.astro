---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import DevicePicker from "../components/DevicePicker.astro";
import { liveDeviceOptions } from "../lib/device-options-live";
import { site, whatsappUrl } from "../lib/site";
import { BATTERY_LABEL, TRADE_IN_SKIP_GROUPS, TRADE_IN_TYPES, tradeInQuestions } from "../lib/trade-in-questions";

const iphoneNames = [
  "iPhone 7", "iPhone 7 Plus", "iPhone 8", "iPhone 8 Plus", "iPhone X", "iPhone XR", "iPhone XS", "iPhone XS Max",
  "iPhone SE (2nd generation)", "iPhone SE (3rd generation)", "iPhone 11", "iPhone 11 Pro", "iPhone 11 Pro Max",
  "iPhone 12 mini", "iPhone 12", "iPhone 12 Pro", "iPhone 12 Pro Max", "iPhone 13 mini", "iPhone 13", "iPhone 13 Pro",
  "iPhone 13 Pro Max", "iPhone 14", "iPhone 14 Plus", "iPhone 14 Pro", "iPhone 14 Pro Max", "iPhone 15", "iPhone 15 Plus",
  "iPhone 15 Pro", "iPhone 15 Pro Max", "iPhone 16e", "iPhone 16", "iPhone 16 Plus", "iPhone 16 Pro", "iPhone 16 Pro Max",
  "iPhone 17e", "iPhone 17", "iPhone Air", "iPhone 17 Pro", "iPhone 17 Pro Max", "iPhone 18 Pro", "iPhone 18 Pro Max",
];
const options = await liveDeviceOptions(TRADE_IN_SKIP_GROUPS);
const [screenQuestion, extrasQuestion] = tradeInQuestions;
const payload = JSON.stringify(tradeInQuestions.map((q) => ({ id: q.id, label: q.label }))).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Trade-In - GadgetHub"
  description="Trade in your iPhone, Samsung, iPad or Mac for the device you want at Gadget Hub Nairobi. Tell us both devices and get your quote on WhatsApp."
>
  <section class="tradein container">
    <header class="tradein__intro">
      <p class="tradein__eyebrow">Trade-In</p>
      <h1>Trade your device for the one you want</h1>
      <p class="tradein__lede">
        Tell us the device you want and the device you have, then send it to us on
        WhatsApp. We reply with your quote. We accept <strong>iPhone</strong>,
        <strong>Samsung</strong>, <strong>iPad</strong> and <strong>Mac</strong>, and the final
        offer is confirmed after we inspect it at {site.address}.
      </p>
    </header>

    <div class="tradein__grid">
      <form class="tradein__form" data-tradein-form data-wa={whatsappUrl()}>
        <fieldset class="tradein__fieldset">
          <legend>1. The device you want</legend>
          <DevicePicker options={options} name="want" />
        </fieldset>

        <fieldset class="tradein__fieldset">
          <legend>2. The device you have</legend>

          <label class="tradein__field">
            <span>Type of device</span>
            <select name="brand" required data-tradein-brand>
              <option value="" disabled selected>Select type</option>
              {TRADE_IN_TYPES.map((b) => <option value={b}>{b}</option>)}
            </select>
          </label>

          <label class="tradein__field">
            <span>Model</span>
            <input
              type="text"
              name="model"
              required
              maxlength="80"
              placeholder="e.g. iPhone 13 Pro 256GB"
              autocomplete="off"
              data-tradein-model
            />
            <datalist id="tradein-iphones">
              {iphoneNames.map((n) => <option value={n} />)}
            </datalist>
          </label>
        </fieldset>

        <fieldset class="tradein__fieldset">
          <legend>3. Its condition</legend>
          <label class="tradein__field">
            <span>{screenQuestion.label}</span>
            <select name={`q_${screenQuestion.id}`} required>
              <option value="" disabled selected>Select an answer</option>
              {screenQuestion.options.map((o) => <option value={o}>{o}</option>)}
            </select>
          </label>
          <label class="tradein__field">
            <span>{BATTERY_LABEL} (%)</span>
            <input type="number" name="battery" min="1" max="100" step="1" inputmode="numeric" placeholder="e.g. 87" />
            <small class="tradein__hint">Find it in Settings › Battery. Leave empty if your device does not show it.</small>
          </label>
          <label class="tradein__field">
            <span>{extrasQuestion.label}</span>
            <select name={`q_${extrasQuestion.id}`} required>
              <option value="" disabled selected>Select an answer</option>
              {extrasQuestion.options.map((o) => <option value={o}>{o}</option>)}
            </select>
          </label>
        </fieldset>

        <fieldset class="tradein__fieldset">
          <legend>4. Your details</legend>
          <label class="tradein__field">
            <span>Your name</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="tradein__field">
            <span>ID or passport number</span>
            <input
              type="text"
              name="idNumber"
              required
              maxlength="20"
              pattern="[A-Za-z0-9 ]{6,20}"
              title="Letters and numbers only"
              autocomplete="off"
            />
            <small class="tradein__hint">We only use this to verify the device is yours.</small>
          </label>
          <label class="tradein__field">
            <span>Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@email.com"
            />
          </label>
          <label class="tradein__field">
            <span>Phone number</span>
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              placeholder="07…"
            />
          </label>
        </fieldset>

        <p class="tradein__note">
          We’ll email a trade-in confirmation (not a payment invoice) and open WhatsApp
          to {site.phoneDisplay} with everything filled in. Press send there and we reply
          with your quote. No commitment until we inspect the device.
        </p>
        <p class="tradein__note" data-tradein-status hidden></p>

        <button class="btn btn--primary" type="submit">Send to WhatsApp for a quote</button>
      </form>

      <aside class="tradein__aside">
        <h2>Good to know</h2>
        <ul>
          <li>iPhone, Samsung, iPad and Mac only - other brands are not accepted</li>
          <li>Credit goes toward the device you choose, New or Ex-UK</li>
          <li>Pay any balance by M-Pesa, cash or Lipa Mdogo Mdogo</li>
          <li>Devices with iCloud/Google lock or unclear ownership may be declined</li>
          <li>Visit us: {site.hours.short}</li>
        </ul>
        <a class="tradein__link" href="/returns">Trade-in rules in Returns policy →</a>
      </aside>
    </div>
  </section>
  <script type="application/json" data-tradein-questions set:html={payload} />
</BaseLayout>

<script>
  import { holdWhatsAppTab, initDevicePickers, readPicker } from "../scripts/devicePicker";

  initDevicePickers();
  const form = document.querySelector<HTMLFormElement>("[data-tradein-form]");
  const picker = form?.querySelector("[data-device-picker]");
  const brandEl = form?.querySelector<HTMLSelectElement>("[data-tradein-brand]");
  const modelEl = form?.querySelector<HTMLInputElement>("[data-tradein-model]");
  const questions: { id: string; label: string }[] = JSON.parse(
    document.querySelector("[data-tradein-questions]")?.textContent || "[]",
  );

  const modelExamples: Record<string, string> = {
    iPhone: "e.g. iPhone 13 Pro 256GB",
    Samsung: "e.g. Galaxy S23 256GB",
    iPad: "e.g. iPad Air 11-inch M2 128GB",
    Mac: "e.g. MacBook Air M2 256GB",
  };

  // Suggest iPhone names only for an iPhone, and show an example that fits the type.
  brandEl?.addEventListener("change", () => {
    if (brandEl.value === "iPhone") modelEl?.setAttribute("list", "tradein-iphones");
    else modelEl?.removeAttribute("list");
    if (modelEl) modelEl.placeholder = modelExamples[brandEl.value] ?? modelEl.placeholder;
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>("[data-tradein-status]");
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const want = picker ? readPicker(picker) : null;
    if (!want) {
      if (status) {
        status.hidden = false;
        status.textContent = "Choose the device you want, with its storage and colour.";
      }
      return;
    }
    const sendToWhatsApp = holdWhatsAppTab();
    const data = new FormData(form);
    const text = (key: string) => String(data.get(key) || "").trim();
    const answers: Record<string, string> = Object.fromEntries(questions.map((q) => [q.id, text(`q_${q.id}`)]));
    answers.battery = text("battery");
    const brand = text("brand");
    const model = text("model");
    const current = model.toLowerCase().startsWith(brand.toLowerCase()) ? model : `${brand} ${model}`;

    if (btn) btn.disabled = true;
    if (status) {
      status.hidden = false;
      status.textContent = "Saving your request…";
    }
    let savedId = "";
    try {
      const res = await fetch("/api/trade-in", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          brand,
          model,
          answers,
          name: text("name"),
          idNumber: text("idNumber"),
          phone: text("phone"),
          email: text("email"),
          want: { productId: want.productId, variantKey: want.variantKey, channel: want.channel, colour: want.colour },
        }),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || "Could not save.");
      savedId = json.id || "";
    } catch (err) {
      if (status) status.textContent = err instanceof Error ? err.message : "Could not save. Continuing on WhatsApp.";
    }

    const message = [
      "Hi Gadget Hub, please send me a trade-in quote.",
      savedId ? `Reference: ${savedId}` : "",
      "",
      "*Device I want*",
      want.summary,
      `Listed price: KES ${want.priceKes.toLocaleString("en-KE")}`,
      "",
      "*Device I have*",
      `Type: ${brand}`,
      `Model: ${current}`,
      `${questions[0].label} ${answers[questions[0].id]}`,
      `Battery health: ${answers.battery ? `${answers.battery}%` : "Not given"}`,
      `${questions[1].label} ${answers[questions[1].id]}`,
      "",
      "*My details*",
      `Name: ${text("name")}`,
      `ID or passport: ${text("idNumber")}`,
      `Email: ${text("email")}`,
      `Phone: ${text("phone")}`,
    ]
      .filter((line, i, all) => line !== "" || all[i - 1] !== "")
      .join("\n");

    sendToWhatsApp(`${form.dataset.wa}?text=${encodeURIComponent(message)}`);
    if (status) {
      status.textContent = savedId
        ? `Saved ${savedId}. Press send in WhatsApp and we'll reply with your quote — this is not a payment.`
        : "Opened WhatsApp. Press send and we'll reply with your quote.";
    }
    if (btn) btn.disabled = false;
  });
</script>

<style>
  .tradein {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
  }

  .tradein__intro {
    max-width: 40rem;
    margin-bottom: var(--space-10);
  }

  .tradein__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .tradein h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .tradein__lede {
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
  }

  .tradein__grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 64rem) {
    .tradein__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--space-12);
      align-items: start;
    }
  }

  .tradein__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .tradein__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tradein__fieldset legend {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-2);
    padding: 0;
  }

  .tradein__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .tradein__field input,
  .tradein__field select,
  .tradein__field textarea {
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-white);
    font-weight: var(--font-weight-regular);
  }

  .tradein__field input:focus-visible,
  .tradein__field select:focus-visible,
  .tradein__field textarea:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  .tradein__hint {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-regular);
    color: var(--color-fg-muted);
  }

  .tradein__note {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .tradein__aside {
    padding: var(--space-6);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .tradein__aside h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .tradein__aside ul {
    margin: 0 0 var(--space-5);
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }

  .tradein__link {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-fg);
  }
</style>
