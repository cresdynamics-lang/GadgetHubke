---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappUrl } from "../lib/site";

const brands = ["iPhone", "Samsung"] as const;
const storages = ["64GB", "128GB", "256GB", "512GB", "1TB", "2TB"] as const;
const conditions = [
  { value: "excellent", label: "Excellent - minimal wear" },
  { value: "good", label: "Good - light marks" },
  { value: "fair", label: "Fair - visible wear, works fully" },
  { value: "poor", label: "Poor - heavy wear or issues" },
] as const;

const waBase = whatsappUrl();
---

<BaseLayout
  title="Trade-In - GadgetHub"
  description="Trade in an iPhone or Samsung toward any new device at GadgetHub. Estimates online; final value after inspection."
>
  <section class="tradein container">
    <header class="tradein__intro">
      <p class="tradein__eyebrow">Trade-In</p>
      <h1>Turn your phone into credit</h1>
      <p class="tradein__lede">
        We accept <strong>iPhone</strong> and <strong>Samsung</strong> only. Credit
        applies toward <strong>any new device</strong> in our catalog. Online values
        are estimates - final offer after in-person inspection at{" "}
        {site.address}.
      </p>
    </header>

    <div class="tradein__grid">
      <form class="tradein__form" data-tradein-form>
        <fieldset class="tradein__fieldset">
          <legend>Your trade-in device</legend>

          <label class="tradein__field">
            <span>Brand</span>
            <select name="brand" required>
              <option value="" disabled selected>Select brand</option>
              {brands.map((b) => <option value={b}>{b}</option>)}
            </select>
          </label>

          <label class="tradein__field">
            <span>Model</span>
            <input
              type="text"
              name="model"
              required
              placeholder="e.g. iPhone 13 Pro, Galaxy S23"
              autocomplete="off"
            />
          </label>

          <label class="tradein__field">
            <span>Storage</span>
            <select name="storage" required>
              <option value="" disabled selected>Select storage</option>
              {storages.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>

          <label class="tradein__field">
            <span>Condition</span>
            <select name="condition" required>
              <option value="" disabled selected>Select condition</option>
              {
                conditions.map((c) => (
                  <option value={c.label}>{c.label}</option>
                ))
              }
            </select>
          </label>
        </fieldset>

        <fieldset class="tradein__fieldset">
          <legend>Contact</legend>
          <label class="tradein__field">
            <span>Your name</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="tradein__field">
            <span>Phone / WhatsApp</span>
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              placeholder="07…"
            />
          </label>
          <label class="tradein__field">
            <span>Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@email.com"
            />
          </label>
        </fieldset>

        <p class="tradein__note">
          We’ll email a trade-in confirmation (not a payment invoice) and open WhatsApp
          to {site.phoneDisplay}. No commitment until we inspect the device.
        </p>
        <p class="tradein__note" data-tradein-status hidden></p>

        <button class="btn btn--primary" type="submit">Send trade-in request</button>
      </form>

      <aside class="tradein__aside">
        <h2>Good to know</h2>
        <ul>
          <li>iPhone and Samsung only - other brands are not accepted</li>
          <li>Credit toward any new sealed device we sell</li>
          <li>Devices with iCloud/Google lock or unclear ownership may be declined</li>
          <li>Visit us: {site.hours.short}</li>
        </ul>
        <a class="tradein__link" href="/returns">Trade-in rules in Returns policy →</a>
      </aside>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ waBase }}>
  const form = document.querySelector("[data-tradein-form]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const status = document.querySelector("[data-tradein-status]");
    const btn = form.querySelector('button[type="submit"]');
    const data = new FormData(form);
    const payload = {
      brand: String(data.get("brand") || "").trim(),
      model: String(data.get("model") || "").trim(),
      storage: String(data.get("storage") || "").trim(),
      condition: String(data.get("condition") || "").trim(),
      name: String(data.get("name") || "").trim(),
      phone: String(data.get("phone") || "").trim(),
      email: String(data.get("email") || "").trim(),
    };
    if (btn instanceof HTMLButtonElement) btn.disabled = true;
    if (status instanceof HTMLElement) {
      status.hidden = false;
      status.textContent = "Saving your request…";
    }
    let savedId = "";
    try {
      const res = await fetch("/api/trade-in", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || "Could not save.");
      savedId = json.id || "";
    } catch (err) {
      if (status instanceof HTMLElement) {
        status.textContent = err instanceof Error ? err.message : "Could not save. Continuing on WhatsApp.";
      }
    }

    const message = [
      "Hi GadgetHub - Trade-In enquiry",
      savedId ? `Reference: ${savedId}` : "",
      "",
      `Name: ${payload.name}`,
      `Phone: ${payload.phone}`,
      `Email: ${payload.email}`,
      `Brand: ${payload.brand}`,
      `Model: ${payload.model}`,
      `Storage: ${payload.storage}`,
      `Condition: ${payload.condition}`,
      "",
      "I'd like an estimate / to bring it in for inspection.",
    ]
      .filter((line) => line !== "")
      .join("\n");

    const url = `${waBase}?text=${encodeURIComponent(message)}`;
    window.open(url, "_blank", "noopener,noreferrer");
    if (status instanceof HTMLElement) {
      status.textContent = savedId
        ? `Saved ${savedId}. We emailed a trade-in confirmation — this is not a payment.`
        : "Opened WhatsApp. We’ll follow up from there.";
    }
    if (btn instanceof HTMLButtonElement) btn.disabled = false;
  });
</script>

<style>
  .tradein {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
  }

  .tradein__intro {
    max-width: 40rem;
    margin-bottom: var(--space-10);
  }

  .tradein__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .tradein h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .tradein__lede {
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
  }

  .tradein__grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 64rem) {
    .tradein__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--space-12);
      align-items: start;
    }
  }

  .tradein__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .tradein__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .tradein__fieldset legend {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-2);
    padding: 0;
  }

  .tradein__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .tradein__field input,
  .tradein__field select {
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-white);
    font-weight: var(--font-weight-regular);
  }

  .tradein__field input:focus-visible,
  .tradein__field select:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 2px;
  }

  .tradein__note {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }

  .tradein__aside {
    padding: var(--space-6);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .tradein__aside h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .tradein__aside ul {
    margin: 0 0 var(--space-5);
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-snug);
  }

  .tradein__link {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-fg);
  }
</style>
