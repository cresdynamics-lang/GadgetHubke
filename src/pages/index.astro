---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignatureHero from "../components/SignatureHero.astro";
import LaunchBand from "../components/LaunchBand.astro";
import HomeProductRow from "../components/home/HomeProductRow.astro";
import CategoryStrip from "../components/home/CategoryStrip.astro";
import HomeCinemaStrip from "../components/home/HomeCinemaStrip.astro";
import TradeInBanner from "../components/home/TradeInBanner.astro";
import LipaStrip from "../components/home/LipaStrip.astro";
import TrustRow from "../components/home/TrustRow.astro";
import BlogTeaser from "../components/home/BlogTeaser.astro";
import { site } from "../lib/site";
import {
  heroPhones,
  homeCinemaShots,
  homeDuoLaunch,
  homeNewIn,
  homeCategoryRows,
} from "../lib/home";
---

<BaseLayout
  title="Gadget Hub Kenya (GadgetHub KE) | Apple Authorised Reseller in Nairobi CBD | iPhone, MacBook, iPad, Apple Watch & AirPods Prices in Kenya"
  description="Gadget Hub Kenya (GadgetHub KE) — Apple Authorised Reseller at Norwich Union House, opposite the Hilton, 4th Floor, Suite 15, Nairobi CBD. iPhone, MacBook, iPad, Apple Watch and AirPods, new and Ex-UK. M-Pesa, trade-in and Lipa Mdogo Mdogo."
>
  <SignatureHero
    phones={heroPhones}
    eyebrow="Gadget Hub · Norwich Union House Nairobi · Verified Apple Reseller"
    title="Some People Buy Phones,"
    titleLine="Some Come At Gadget Hub"
    lede="Your New iPhone is here, Come, Have the Feeling."
    primaryHref="/shop"
    primaryLabel="Shop Apple"
    secondaryHref="/trade-in"
    secondaryLabel="Trade-in"
    tertiaryHref="/lipa-mdogo-mdogo"
    tertiaryLabel="Lipa Mdogo Mdogo"
  />

  <CategoryStrip />

  <HomeCinemaStrip shots={[homeCinemaShots[0], homeCinemaShots[1]]} />

  <HomeProductRow
    title="New In"
    lede="Fresh across the store - not just phones."
    href="/shop"
    linkLabel="Shop all ›"
    items={homeNewIn}
  />

  <LaunchBand {...homeDuoLaunch} />

  {
    homeCategoryRows.map((row) => (
      <HomeProductRow
        title={row.title}
        lede={row.lede}
        href={row.href}
        items={row.items}
      />
    ))
  }

  <TradeInBanner />
  <LipaStrip />
  <TrustRow />
  <BlogTeaser />
</BaseLayout>
