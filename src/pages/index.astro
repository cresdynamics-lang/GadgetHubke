---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignatureHero from "../components/SignatureHero.astro";
import LaunchBand from "../components/LaunchBand.astro";
import HomeProductRow from "../components/home/HomeProductRow.astro";
import CategoryStrip from "../components/home/CategoryStrip.astro";
import TradeInBanner from "../components/home/TradeInBanner.astro";
import LipaStrip from "../components/home/LipaStrip.astro";
import TrustRow from "../components/home/TrustRow.astro";
import BlogTeaser from "../components/home/BlogTeaser.astro";
import { site } from "../lib/site";
import {
  heroPhones,
  homeDuoLaunch,
  homeNewIn,
  homeCategoryRows,
} from "../lib/home";
---

<BaseLayout
  title={`${site.name} - Apple products in Nairobi`}
  description="Shop iPhone, Mac, iPad, Watch, AirPods, TV & Home, and Accessories at GadgetHub Kenya. Trade-in and Lipa Mdogo Mdogo available."
>
  <SignatureHero
    phones={heroPhones}
    eyebrow="Apple · Nairobi"
    title="The full lineup."
    lede="iPhone, Mac, iPad, Watch, AirPods, TV & Home, and Accessories — genuine, sealed, ready to take home. Pay in full or Lipa Mdogo Mdogo."
    primaryHref="/shop"
    primaryLabel="Shop Apple"
    secondaryHref="/lipa-mdogo-mdogo"
    secondaryLabel="See Lipa Mdogo Mdogo"
  />

  <CategoryStrip />

  <HomeProductRow
    title="New In"
    lede="Fresh across the store — not just phones."
    href="/shop"
    linkLabel="Shop all ›"
    items={homeNewIn}
  />

  <LaunchBand {...homeDuoLaunch} />

  {
    homeCategoryRows.map((row) => (
      <HomeProductRow
        title={row.title}
        lede={row.lede}
        href={row.href}
        items={row.items}
      />
    ))
  }

  <TradeInBanner />
  <LipaStrip />
  <TrustRow />
  <BlogTeaser />
</BaseLayout>
