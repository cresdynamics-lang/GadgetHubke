---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import CategoryStrip from "../components/home/CategoryStrip.astro";
import DealsRow from "../components/home/DealsRow.astro";
import TradeInBanner from "../components/home/TradeInBanner.astro";
import LipaStrip from "../components/home/LipaStrip.astro";
import TrustRow from "../components/home/TrustRow.astro";
import BlogTeaser from "../components/home/BlogTeaser.astro";
import { site } from "../lib/site";
---

<BaseLayout
  title={`${site.name} - New devices in Nairobi`}
  description="Shop new iPhone, Mac, and iPad at GadgetHub Kenya. Trade-in and Lipa Mdogo Mdogo available."
>
  <HomeHero
    title="iPhone Duo"
    tagline="Folding Super Retina XDR. A20 Pro. New, sealed, Nairobi."
    href="/shop/iphone/iphone-duo"
    imageBase="/images/heroes/iphone"
    tone="light"
    priority
    shopLabel="Buy"
    priceKes={259999}
  />
  <HomeHero
    title="Mac"
    tagline="Thin. Powerful. Built for what you do next."
    href="/shop/mac"
    imageBase="/images/heroes/mac"
    tone="light"
    priceKes={189999}
  />
  <HomeHero
    title="iPad"
    tagline="Colour, canvas, and performance - all day."
    href="/shop/ipad"
    imageBase="/images/heroes/ipad"
    tone="light"
    priceKes={89999}
  />

  <CategoryStrip />
  <DealsRow />
  <TradeInBanner />
  <LipaStrip />
  <TrustRow />
  <BlogTeaser />
</BaseLayout>
