---
import BaseLayout from "../layouts/BaseLayout.astro";
import LogoMark from "../components/LogoMark.astro";
import {
  contactChips,
  contactConsentLine,
  contactFaq,
  contactFormTopics,
  contactHero,
  isPlaceholderSocial,
} from "../lib/about-contact";
import { aboutHeroProducts } from "../lib/about-contact";
import { site, whatsappUrl, telUrl } from "../lib/site";
import "../styles/launch-pages.css";

const waHref = whatsappUrl("Hi Gadget Hub - I'd like to talk.");
const waBase = whatsappUrl();
const mapsQuery = encodeURIComponent(site.addressLines.join(", "));
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;

const socialLinks = (
  [
    { label: "Instagram", href: site.social.instagram },
    { label: "TikTok", href: site.social.tiktok },
    { label: "Facebook", href: site.social.facebook },
  ] as const
).filter((s) => !isPlaceholderSocial(s.href));

const headlineWords = contactHero.headline.split(" ");
---

<BaseLayout
  title="Contact - GadgetHub"
  description={`${contactHero.lede} WhatsApp ${site.phoneDisplay}. ${site.address}. ${site.hours.short}.`}
>
  <div class="lp contact-lp" data-contact-page>
    <!-- Hero -->
    <section class="lp-section lp-section--screen contact-hero">
      <div class="container contact-hero__grid">
        <div class="contact-hero__copy">
          <h1 class="lp-h1" data-word-reveal>
            {
              headlineWords.map((w) => (
                <span class="lp-word">{w}&nbsp;</span>
              ))
            }
          </h1>
          <p class="lp-lede lp-fade">{contactHero.lede}</p>

          <a
            class="contact-wa-card lp-fade"
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-wa-card__mark">
              <LogoMark inverse size={40} />
            </span>
            <span class="contact-wa-card__meta">
              <span class="contact-wa-card__online">Online on WhatsApp</span>
              <span class="contact-wa-card__num">{site.phoneDisplay}</span>
            </span>
            <span class="lp-wa contact-wa-card__btn">
              <span class="lp-wa__shine" aria-hidden="true"></span>
              Start chat
            </span>
          </a>
        </div>

        <div class="contact-hero__stage" aria-hidden="true">
          {
            aboutHeroProducts.map((p, i) => (
              <img
                class={`contact-hero__float contact-hero__float--${i + 1}`}
                src={p.src}
                alt=""
                width="420"
                height="420"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                data-parallax={String((i + 1) * 0.06)}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- Quick chips -->
    <section class="lp-section contact-chips" aria-label="Quick WhatsApp starts">
      <div class="container">
        <p class="lp-eyebrow lp-fade">Quick start</p>
        <h2 class="lp-h2 lp-fade">One tap to the right chat</h2>
      </div>
      <div class="contact-chips__row" data-chips>
        {
          contactChips.map((chip) => (
            <a
              class="lp-chip"
              href={whatsappUrl(chip.msg)}
              target="_blank"
              rel="noopener noreferrer"
            >
              {chip.label}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Details grid -->
    <section class="lp-section contact-details">
      <div class="container">
        <p class="lp-eyebrow lp-fade">Details</p>
        <h2 class="lp-h2 lp-fade">Reach the shop</h2>
        <div class="contact-details__grid">
          <a class="contact-card lp-fade" href={telUrl()}>
            <span class="contact-card__label">Call</span>
            <strong>{site.phoneDisplay}</strong>
            <span class="contact-card__hint">Same number as WhatsApp</span>
          </a>

          <a class="contact-card lp-fade" href={`mailto:${site.email}`}>
            <span class="contact-card__label">Email</span>
            <strong>{site.email}</strong>
            <span class="contact-card__hint">For longer notes</span>
          </a>

          <a class="contact-card lp-fade" href="/locations">
            <span class="contact-card__label">Visit or pickup</span>
            <strong>{site.address}</strong>
            <span class="contact-card__hint">{site.location}</span>
            <span class="contact-card__map" aria-hidden="true">
              <span class="contact-card__pin"></span>
            </span>
          </a>

          <div class="contact-card lp-fade" data-hours-card>
            <span class="contact-card__label">Opening hours</span>
            <strong data-hours-status>Checking…</strong>
            <span class="contact-card__hint">
              {site.hours.weekday}<br />
              {site.hours.sunday}
            </span>
          </div>

          {
            socialLinks.length > 0 ? (
              <div class="contact-card lp-fade">
                <span class="contact-card__label">Social</span>
                <strong>Follow along</strong>
                <span class="contact-card__socials">
                  {socialLinks.map((s) => (
                    <a href={s.href} target="_blank" rel="noopener noreferrer">
                      {s.label}
                    </a>
                  ))}
                </span>
              </div>
            ) : null
          }
        </div>
        <p class="contact-details__maps lp-fade">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Open in Maps</a>
        </p>
      </div>
    </section>

    <!-- Enquiry form -->
    <section class="lp-section contact-form-sec">
      <div class="container contact-form-sec__grid">
        <div class="lp-fade">
          <p class="lp-eyebrow">Enquiry</p>
          <h2 class="lp-h2">Send a short note</h2>
          <p class="lp-lede">
            Opens WhatsApp with your details filled in. No account required.
          </p>
        </div>

        <form class="contact-form lp-fade" data-contact-form novalidate>
          <label class="contact-form__field">
            <span>Name</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>

          <label class="contact-form__field">
            <span>Phone or WhatsApp</span>
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              placeholder="07…"
            />
          </label>

          <label class="contact-form__field">
            <span>What are you looking for?</span>
            <select name="topic" required>
              <option value="" disabled selected>Select</option>
              {
                contactFormTopics.map((t) => (
                  <option value={t}>{t}</option>
                ))
              }
            </select>
          </label>

          <label class="contact-form__field">
            <span>Message</span>
            <textarea name="message" rows="4" required></textarea>
          </label>

          <label class="contact-form__consent">
            <input type="checkbox" name="consent" required />
            <span>{contactConsentLine}</span>
          </label>

          <button class="lp-wa lp-wa--lg" type="submit">
            <span class="lp-wa__shine" aria-hidden="true"></span>
            Continue on WhatsApp
          </button>

          <div class="contact-form__done" data-form-done hidden>
            <svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true">
              <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="2"></circle>
              <path
                class="contact-form__check"
                d="M14 24.5l6.5 6.5L34 17"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <p>We'll reply on WhatsApp.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- Delivery strip -->
    <section class="contact-marquee" aria-label="Delivery">
      <div class="contact-marquee__track" aria-hidden="true">
        <span>Delivery across Kenya · Ask us about Nairobi and upcountry · Collection at Norwich Union Building · Ask us about fees ·</span>
        <span>Delivery across Kenya · Ask us about Nairobi and upcountry · Collection at Norwich Union Building · Ask us about fees ·</span>
      </div>
      <p class="sr-only">
        Delivery across Kenya. Ask us about Nairobi, upcountry, fees, and collection at Norwich Union Building.
      </p>
    </section>

    <!-- FAQ -->
    <section class="lp-section contact-faq">
      <div class="container">
        <p class="lp-eyebrow lp-fade">Quick answers</p>
        <h2 class="lp-h2 lp-fade">FAQ</h2>
        <div class="contact-faq__list">
          {
            contactFaq.map((item, i) => (
              <details class="contact-faq__item lp-fade" open={i === 0}>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ waBase }}>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const words = document.querySelectorAll("[data-word-reveal] .lp-word");
  if (reduce) {
    words.forEach((w) => w.classList.add("is-on"));
  } else {
    words.forEach((w, i) => {
      window.setTimeout(() => w.classList.add("is-on"), 100 + i * 140);
    });
  }

  const fades = document.querySelectorAll(".lp-fade");
  if (reduce) {
    fades.forEach((el) => el.classList.add("is-in"));
  } else if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-in");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    fades.forEach((el) => io.observe(el));
  } else {
    fades.forEach((el) => el.classList.add("is-in"));
  }

  const floats = document.querySelectorAll("[data-parallax]");
  if (!reduce && floats.length) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        floats.forEach((el) => {
          if (!(el instanceof HTMLElement)) return;
          const f = Number(el.dataset.parallax || 0.08);
          el.style.transform = `translate3d(0, ${y * f}px, 0)`;
        });
        ticking = false;
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  // Open-now status - Nairobi time, hours from site.ts
  // Mon-Sat 8:00-20:00, Sun 10:00-20:00
  const statusEl = document.querySelector("[data-hours-status]");
  if (statusEl) {
    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Africa/Nairobi",
      weekday: "short",
      hour: "numeric",
      minute: "numeric",
      hour12: false,
    });
    const parts = fmt.formatToParts(new Date());
    const get = (type) => parts.find((p) => p.type === type)?.value || "";
    const weekday = get("weekday"); // Mon, Tue...
    const hour = Number(get("hour"));
    const minute = Number(get("minute"));
    const mins = hour * 60 + minute;
    const isSun = weekday === "Sun";
    const openAt = isSun ? 10 * 60 : 8 * 60;
    const closeAt = 20 * 60;
    const open = mins >= openAt && mins < closeAt;

    let nextOpen = "";
    if (!open) {
      if (mins < openAt) {
        nextOpen = isSun ? "10:00" : "08:00";
      } else if (weekday === "Sat") {
        nextOpen = "10:00 Sunday";
      } else if (weekday === "Sun") {
        nextOpen = "08:00 Monday";
      } else {
        nextOpen = "08:00";
      }
    }

    statusEl.innerHTML = open
      ? `<span class="contact-card__pulse" aria-hidden="true"></span> Open now`
      : `<span class="contact-card__pulse contact-card__pulse--off" aria-hidden="true"></span> Closed, back at ${nextOpen}`;
  }

  const form = document.querySelector("[data-contact-form]");
  const done = document.querySelector("[data-form-done]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    if (!data.get("consent")) {
      form.reportValidity();
      return;
    }
    const name = String(data.get("name") || "").trim();
    const phone = String(data.get("phone") || "").trim();
    const topic = String(data.get("topic") || "").trim();
    const message = String(data.get("message") || "").trim();

    const text = [
      "Hi Gadget Hub - Contact form",
      "",
      `Name: ${name}`,
      `Phone: ${phone}`,
      `Looking for: ${topic}`,
      "",
      message,
    ].join("\n");

    if (done instanceof HTMLElement) {
      done.hidden = false;
      done.classList.add("is-show");
    }

    window.open(
      `${waBase}?text=${encodeURIComponent(text)}`,
      "_blank",
      "noopener,noreferrer",
    );
  });
</script>

<style>
  .contact-lp {
    padding-bottom: 2rem;
  }

  .contact-hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .contact-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
      min-height: min(72vh, 40rem);
    }
  }

  .contact-wa-card {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 1.25rem;
    border: 1px solid var(--lp-line);
    background: rgb(255 255 255 / 0.04);
    text-decoration: none;
    color: #fff;
    max-width: 26rem;
  }

  .contact-wa-card:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 0.28);
  }

  .contact-wa-card__mark {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 0.85rem;
    background: #111;
    border: 1px solid var(--lp-line);
  }

  .contact-wa-card__online {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lp-muted);
  }

  .contact-wa-card__num {
    display: block;
    margin-top: 0.25rem;
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .contact-wa-card__btn {
    width: 100%;
  }

  .contact-hero__stage {
    position: relative;
    min-height: 16rem;
    pointer-events: none;
  }

  @media (max-width: 63.99rem) {
    .contact-hero__stage {
      display: none;
    }
  }

  .contact-hero__float {
    position: absolute;
    width: min(42%, 12rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 24px 36px rgb(0 0 0 / 0.5));
    opacity: 0.7;
    will-change: transform;
  }

  .contact-hero__float--1 {
    left: 8%;
    top: 10%;
  }
  .contact-hero__float--2 {
    right: 6%;
    top: 0;
  }
  .contact-hero__float--3 {
    left: 20%;
    bottom: 8%;
  }
  .contact-hero__float--4 {
    right: 18%;
    bottom: 0;
  }

  .contact-chips__row {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding: 1.5rem max(1.25rem, calc((100vw - 72rem) / 2)) 0.25rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .lp-chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--lp-line);
    background: rgb(255 255 255 / 0.04);
    color: #fff !important;
    text-decoration: none;
    font-weight: 550;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .lp-chip:hover {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.35);
    color: #fff !important;
  }

  .contact-details__grid {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .contact-details__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .contact-details__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-height: 9.5rem;
    padding: 1.35rem 1.35rem 1.2rem;
    border-radius: 1.1rem;
    border: 1px solid var(--lp-line);
    background: rgb(255 255 255 / 0.035);
    text-decoration: none;
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  a.contact-card:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 0.3);
  }

  .contact-card__label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lp-muted);
  }

  .contact-card strong {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    font-weight: 650;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-card__hint {
    color: var(--lp-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .contact-card__map {
    margin-top: auto;
    height: 3.5rem;
    border-radius: 0.65rem;
    background:
      linear-gradient(90deg, transparent 0 12%, rgb(255 255 255 / 0.08) 12% 12.5%, transparent 12.5%),
      linear-gradient(0deg, transparent 0 40%, rgb(255 255 255 / 0.08) 40% 40.5%, transparent 40.5%),
      linear-gradient(90deg, transparent 0 55%, rgb(255 255 255 / 0.06) 55% 55.5%, transparent 55.5%),
      #111;
    position: relative;
  }

  .contact-card__pin {
    position: absolute;
    left: 52%;
    top: 42%;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.2);
    transform: translate(-50%, -50%);
  }

  .contact-card__pulse {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 0 rgb(255 255 255 / 0.55);
    animation: contact-pulse 2.4s ease-out infinite;
  }

  .contact-card__pulse--off {
    background: var(--lp-muted);
    animation: none;
    box-shadow: none;
  }

  @keyframes contact-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0.45);
    }
    70% {
      box-shadow: 0 0 0 10px rgb(255 255 255 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card__pulse {
      animation: none;
    }
  }

  .contact-card__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .contact-card__socials a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-details__maps {
    margin: 1.25rem 0 0;
    color: var(--lp-muted);
  }

  .contact-details__maps a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-form-sec__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .contact-form-sec__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 3rem;
      align-items: start;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 1.85rem);
    border-radius: 1.25rem;
    border: 1px solid var(--lp-line);
    background: rgb(255 255 255 / 0.05);
    backdrop-filter: blur(12px);
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--lp-muted);
  }

  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--lp-line);
    border-radius: 0.75rem;
    background: #0a0a0a;
    color: #fff;
    font: inherit;
  }

  .contact-form__field textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .contact-form__field input:focus-visible,
  .contact-form__field select:focus-visible,
  .contact-form__field textarea:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .contact-form__consent {
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--lp-muted);
    cursor: pointer;
  }

  .contact-form__consent input {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    accent-color: #fff;
  }

  .contact-form button {
    border: 0;
    cursor: pointer;
    width: 100%;
  }

  .contact-form__done {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #fff;
  }

  .contact-form__done[hidden] {
    display: none !important;
  }

  .contact-form__done p {
    margin: 0;
  }

  .contact-form__check {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
  }

  .contact-form__done.is-show .contact-form__check {
    animation: contact-check 0.55s ease forwards;
  }

  @keyframes contact-check {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form__done.is-show .contact-form__check {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  .contact-marquee {
    border-block: 1px solid var(--lp-line);
    padding: 1.35rem 0;
    overflow: hidden;
    background: #050505;
  }

  .contact-marquee__track {
    display: flex;
    width: max-content;
    gap: 2rem;
    animation: contact-marquee 28s linear infinite;
    font-size: clamp(1.15rem, 3vw, 1.65rem);
    letter-spacing: -0.02em;
    font-weight: 550;
    color: var(--lp-muted);
    white-space: nowrap;
  }

  @keyframes contact-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-marquee__track {
      animation: none;
      width: auto;
      white-space: normal;
      padding-inline: 1.25rem;
      justify-content: center;
    }
    .contact-marquee__track span + span {
      display: none;
    }
  }

  .contact-faq__list {
    margin-top: 2rem;
  }

