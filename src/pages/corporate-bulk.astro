---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappUrl } from "../lib/site";

const waHref = whatsappUrl(
  "Hi GadgetHub - I'd like to discuss a corporate or bulk order.",
);
---

<BaseLayout
  title="Corporate & Bulk Orders - GadgetHub"
  description={`Offices and organisations can buy multiple new devices from ${site.legalName}. Settled by agreement.`}
>
  <section class="page container">
    <p class="page__eyebrow">For teams</p>
    <h1>Corporate &amp; Bulk Orders</h1>
    <p class="page__lede">
      Equipping an office or placing a multi-device order? {site.legalName} supplies
      new Apple devices in volume. Pricing and delivery are settled by agreement - 
      not through an external finance partner.
    </p>
    <ul class="page__points">
      <li>Genuine new stock only</li>
      <li>Quoted for your quantity, models, and timeline</li>
      <li>Payment and delivery terms agreed in writing before fulfilment</li>
    </ul>
    <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener noreferrer">
      WhatsApp corporate sales
    </a>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
    max-width: 40rem;
  }

  .page__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .page h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .page__lede {
    color: var(--color-fg-muted);
    margin-bottom: var(--space-6);
  }

  .page__points {
    margin: 0 0 var(--space-6);
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
</style>
