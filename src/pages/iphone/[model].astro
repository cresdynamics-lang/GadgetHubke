---
/**
 * iPhone 11 - 16 product page - gallery + buying panel (core).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductStage from "../../components/iphone/ProductStage.astro";
import LipaCalc from "../../components/iphone/LipaCalc.astro";
import TradeInCalc from "../../components/iphone/TradeInCalc.astro";
import {
  models,
  getModel,
  getImage,
  defaultColourForModel,
  availableColours,
  availableViews,
  textOnlyColours,
  isOverviewOnly,
  storagePrices,
  formatKes,
  lipaMonthly,
  colourHex,
  colourLabel,
  isLightColour,
  isLatestTag,
  isValueTag,
  iphoneConfig,
  buyingNotes,
  accessoriesFor,
  relatedModels,
  type IphoneView,
} from "../../lib/iphone";
import { whatsappUrl } from "../../lib/site";
import StockChannelToggle from "../../components/StockChannelToggle.astro";
import ProductReviews from "../../components/ProductReviews.astro";
import { exUkFromNew } from "../../lib/stock-channel";

export function getStaticPaths() {
  return models.map((m) => ({ params: { model: m.id } }));
}

const { model: modelId } = Astro.params;
const model = getModel(modelId!);
if (!model) {
  return Astro.redirect("/iphone");
}

const overviewOnly = isOverviewOnly(model.id);
const colours = availableColours(model.id);
const textColours = textOnlyColours(model.id);
const initialColour = defaultColourForModel(model.id, model.defaultColour ?? undefined);
const initialViews = initialColour ? availableViews(model.id, initialColour) : [];
const initialImg = getImage(model.id, initialColour, overviewOnly ? "overview" : 1, model.name);
const prices = storagePrices(model.basePriceKes, model.storage);
const firstPrice = prices[0];
const lipa = lipaMonthly(firstPrice.kes);
const tag = isLatestTag(model) ? "Latest" : isValueTag(model) ? "Value" : null;
const notes = buyingNotes(model);
const fits = accessoriesFor(model);
const related = relatedModels(model, models);

const colourData = colours.map((key) => ({
  key,
  label: colourLabel(key),
  hex: colourHex(key),
  light: isLightColour(key),
  views: availableViews(model.id, key),
  images: ([1, 2, 3] as IphoneView[])
    .filter((v) => availableViews(model.id, key).includes(v))
    .map((v) => {
      const img = getImage(model.id, key, v, model.name);
      return { view: v, src: img.src, srcWebp: img.srcWebp ?? "", alt: img.alt, width: img.width };
    }),
}));

const overviewImg = getImage(model.id, null, "overview", model.name);

const galleryPayload = {
  modelId: model.id,
  name: model.name,
  overviewOnly,
  overview: overviewImg,
  colours: colourData,
  initialColour,
  textColours: textColours.map((k) => colourLabel(k)),
};
---

<BaseLayout title={`${model.name} - GadgetHub`} description={model.tagline}>
  <article class="ipdp" data-ipdp>
    <div class="container ipdp__grid">
      <div class="ipdp__gallery" data-gallery>
        <div class="ipdp__stage-wrap">
          <span class="ipdp__chip" data-gallery-chip></span>
          <button type="button" class="ipdp__stage-btn" data-gallery-open aria-label="Open full screen viewer">
            <div class="ipdp__stage" data-gallery-stage>
              <picture>
                {initialImg.srcWebp ? (
                  <source data-gallery-webp srcset={initialImg.srcWebp} type="image/webp" />
                ) : null}
                <img
                  data-gallery-img
                  class="ipdp__img"
                  src={initialImg.src}
                  alt={initialImg.alt}
                  width={initialImg.width}
                  height={initialImg.width}
                  fetchpriority="high"
                  loading="eager"
                  decoding="async"
                />
              </picture>
            </div>
          </button>
          <p class="ipdp__hint" data-gallery-hint>Hover to zoom. Click for full screen.</p>
          {
            overviewOnly ? (
              <p class="ipdp__coming">Full angle set coming soon</p>
            ) : null
          }
        </div>
        {
          !overviewOnly ? (
            <div class="ipdp__thumbs-row">
              <div class="ipdp__thumbs" data-gallery-thumbs role="tablist" aria-label="Views"></div>
              <button type="button" class="ipdp__tour" data-gallery-tour>Auto tour</button>
            </div>
          ) : null
        }
      </div>

      <div class="ipdp__buy">
        <div class="ipdp__pills">
          {tag ? <span class="ipdp__pill">{tag}</span> : null}
          <span class="ipdp__pill ipdp__pill--muted">{model.year}</span>
        </div>
        <h1>{model.name}</h1>
        <StockChannelToggle />
        <p class="ipdp__tagline">{model.tagline}</p>

        <div class="ipdp__field">
          <p class="ipdp__label">
            Colour
            <span data-colour-name>{initialColour ? colourLabel(initialColour) : "See overview"}</span>
          </p>
          {
            overviewOnly ? (
              <p class="ipdp__text-colours">
                Colours: see overview. Angle swatches coming soon.
                {textColours.length ? ` Also listed: ${textColours.map(colourLabel).join(", ")}.` : null}
              </p>
            ) : (
              <div class="ipdp__swatches" role="listbox" aria-label="Choose colour" data-colour-list>
                {colourData.map((c, i) => (
                  <button
                    type="button"
                    role="option"
                    class:list={["ipdp__swatch", { "is-active": i === 0, "ipdp__swatch--light": c.light }]}
                    style={`--swatch: ${c.hex}`}
                    aria-label={c.label}
                    aria-selected={i === 0 ? "true" : "false"}
                    data-colour={c.key}
                  />
                ))}
              </div>
            )
          }
          {
            !overviewOnly && textColours.length ? (
              <p class="ipdp__text-colours">Also available (photo soon): {textColours.map(colourLabel).join(", ")}</p>
            ) : null
          }
        </div>

        <div class="ipdp__field">
          <p class="ipdp__label">Storage</p>
          <div class="ipdp__storage" data-storage-list>
            {
              prices.map((p, i) => (
                <button
                  type="button"
                  class:list={["ipdp__storage-btn", { "is-active": i === 0 }]}
                  data-storage={p.label}
                  data-kes={p.kes}
                  data-kes-new={p.kes}
                  data-kes-ex-uk={exUkFromNew(p.kes)}
                >
                  {p.label}
                  <span data-storage-price>{formatKes(p.kes)}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="ipdp__price-block">
          <p class="ipdp__price" data-price-display>From {formatKes(firstPrice.kes)}</p>
          <p class="ipdp__monthly" data-monthly-display>
            or {formatKes(lipa.monthlyKes)} a month for {lipa.months} months after a {formatKes(lipa.depositKes)} deposit
          </p>
          <p class="ipdp__sample">Sample price</p>
        </div>

        <p class="ipdp__stock">
          <span class="ipdp__stock-dot" aria-hidden="true"></span>
          In stock (sample) · Collect today in Nairobi
        </p>

        <div class="ipdp__cta">
          <button type="button" class="btn btn--primary" data-add-bag>Add to Cart</button>
          <a
            class="btn btn--whatsapp"
            data-wa-link
            href={whatsappUrl(`Hi Gadget Hub, I'm interested in the ${model.name}.`)}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ask on WhatsApp
          </a>
        </div>
        <p class="ipdp__fine">{iphoneConfig.samplePriceDisclaimer}</p>

        <ul class="ipdp__highlights">
          <li><strong>{model.displayInches}″</strong><span>Display</span></li>
          <li><strong>{model.chip}</strong><span>Chip</span></li>
          <li><strong>{model.batteryVideoHours} h</strong><span>Video playback</span></li>
          <li>
            <strong>
              {model.rearCameras[0]?.match(/\d+/)?.[0] ?? "-"}MP · {model.rearCameras.length}
            </strong>
            <span>Rear cameras</span>
          </li>
        </ul>
      </div>
    </div>

    <section class="container ipdp__notes">
      <h2>Buying notes for this model</h2>
      <ul class="ipdp__notes-grid">
        {
          notes.map((n) => (
            <li>
              <h3>{n.title}</h3>
              <p>{n.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      fits.length > 0 ? (
        <section class="container ipdp__fits">
          <h2>Fits this model</h2>
          <p class="ipdp__fits-lede">Sample accessory prices. Compatibility only.</p>
          <ul class="ipdp__fits-grid">
            {fits.map((a) => (
              <li>
                <h3>{a.name}</h3>
                <p>{a.blurb}</p>
                <p class="ipdp__fits-price">{formatKes(a.priceKes)} <span>sample</span></p>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    <section class="container ipdp__tools">
      <LipaCalc modelId={model.id} />
      <TradeInCalc modelId={model.id} />
    </section>

    {
      related.length > 0 ? (
        <section class="container ipdp__related">
          <h2>Compare with</h2>
          <div class="ipdp__related-scroll">
            {related.map((r) => {
              const c = defaultColourForModel(r.id, r.defaultColour ?? undefined);
              const img = getImage(r.id, c, isOverviewOnly(r.id) ? "overview" : 1, r.name);
              return (
                <a class="ipdp__related-card" href={`/iphone/${r.id}`}>
                  <ProductStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={img.width} height={img.width} />
                  <span class="ipdp__related-name">{r.name}</span>
                  <span class="ipdp__related-price">From {formatKes(r.basePriceKes)}</span>
                  <span class="ipdp__related-cta">Compare with {r.name.replace("iPhone ", "")}</span>
                </a>
              );
            })}
          </div>
        </section>
      ) : null
    }

    <section class="container ipdp__specs">
      <h2>Full specifications</h2>
      <p class="ipdp__footnote">{iphoneConfig.appleSpecsFootnote}</p>
      <details class="ipdp__acc" open>
        <summary>Display</summary>
        <table>
          <tr><th>Size</th><td>{model.displayInches}″</td></tr>
          <tr><th>Resolution</th><td>{model.resolution} ({model.ppi} ppi)</td></tr>
          <tr><th>Refresh</th><td>{model.refreshHz}Hz</td></tr>
          <tr><th>Cutout</th><td>{model.cutout}</td></tr>
          {model.displayNote ? <tr><th>Note</th><td>{model.displayNote}</td></tr> : null}
        </table>
      </details>
      <details class="ipdp__acc">
        <summary>Chip and performance</summary>
        <table>
          <tr><th>Chip</th><td>{model.chip}</td></tr>
          <tr><th>Cellular</th><td>{model.cellular}</td></tr>
          <tr><th>Apple Intelligence</th><td>{model.appleIntelligence ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="ipdp__acc">
        <summary>Camera</summary>
        <table>
          <tr><th>Rear</th><td>{model.rearCameras.join("; ")}</td></tr>
          <tr><th>Front</th><td>{model.frontCamera}</td></tr>
          <tr><th>Camera Control</th><td>{model.cameraControl ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="ipdp__acc">
        <summary>Battery and charging</summary>
        <table>
          <tr><th>Video playback</th><td>{model.batteryVideoHours} hours (Apple claim)</td></tr>
          <tr><th>Port</th><td>{model.port}</td></tr>
          <tr><th>MagSafe</th><td>{model.magsafe ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="ipdp__acc">
        <summary>Design and durability</summary>
        <table>
          <tr><th>Weight</th><td>{model.weightGrams} g</td></tr>
          <tr><th>Frame</th><td>{model.frame}</td></tr>
          <tr><th>Glass</th><td>{model.glass}</td></tr>
          <tr><th>Water resistance</th><td>{model.waterResistance}</td></tr>
          <tr><th>Action button</th><td>{model.actionButton ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="ipdp__acc">
        <summary>Connectivity</summary>
        <table>
          <tr><th>Wi-Fi</th><td>{model.wifi}</td></tr>
          <tr><th>Face ID</th><td>{model.faceId ? "Yes" : "No"}</td></tr>
          <tr><th>Crash Detection</th><td>{model.crashDetection ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="ipdp__acc">
        <summary>Storage and colours</summary>
        <table>
          <tr><th>Storage</th><td>{model.storage.join(", ")}</td></tr>
          <tr><th>Colours (imaged)</th><td>{colours.map(colourLabel).join(", ") || "Overview only"}</td></tr>
          {textColours.length ? <tr><th>Also listed</th><td>{textColours.map(colourLabel).join(", ")}</td></tr> : null}
        </table>
      </details>
    </section>

    <div class="container">
      <ProductReviews productId={model.id} productName={model.name} />
    </div>
  </article>

  <dialog class="ipdp-lb" data-lightbox aria-label="Full screen photo">
    <button type="button" class="ipdp-lb__close" data-lb-close aria-label="Close">Close</button>
    <button type="button" class="ipdp-lb__nav ipdp-lb__prev" data-lb-prev aria-label="Previous">‹</button>
    <div class="ipdp-lb__panel">
      <img data-lb-img src="" alt="" />
      <p data-lb-caption></p>
    </div>
    <button type="button" class="ipdp-lb__nav ipdp-lb__next" data-lb-next aria-label="Next">›</button>
  </dialog>
</BaseLayout>

<script define:vars={{ galleryPayload, modelName: model.name, prices, depositPct: iphoneConfig.lipa.depositDefaultPct, months: iphoneConfig.lipa.monthsDefault, waBase: `https://wa.me/${iphoneConfig.whatsapp}?text=` }}>
  const state = {
    colour: galleryPayload.initialColour,
    view: 1,
    storage: prices[0]?.label,
    kesNew: prices[0]?.kes,
    kesExUk: prices[0] ? Math.max(999, Math.round((prices[0].kes * 0.88) / 1000) * 1000 - 1) : 0,
    channel: "new",
    tour: null,
  };

  function activeKes() {
    return state.channel === "ex-uk" ? Number(state.kesExUk) || 0 : Number(state.kesNew) || 0;
  }

  function channelLabel() {
    return state.channel === "ex-uk" ? "EX-UK" : "New";
  }

  const img = document.querySelector("[data-gallery-img]");
  const webpSource = document.querySelector("[data-gallery-webp]");
  const chip = document.querySelector("[data-gallery-chip]");
  const hint = document.querySelector("[data-gallery-hint]");
  const thumbs = document.querySelector("[data-gallery-thumbs]");
  const stage = document.querySelector("[data-gallery-stage]");
  const colourName = document.querySelector("[data-colour-name]");
  const priceEl = document.querySelector("[data-price-display]");
  const monthlyEl = document.querySelector("[data-monthly-display]");
  const wa = document.querySelector("[data-wa-link]");
  const tourBtn = document.querySelector("[data-gallery-tour]");
  const lb = document.querySelector("[data-lightbox]");
  const lbImg = document.querySelector("[data-lb-img]");
  const lbCap = document.querySelector("[data-lb-caption]");

  function colourEntry() {
    return galleryPayload.colours.find((c) => c.key === state.colour);
  }

  function viewLabel(v) {
    return v === 1 ? "Front and back" : v === 2 ? "Camera close-up" : "Camera and screen";
  }

  function currentImage() {
    if (galleryPayload.overviewOnly) return galleryPayload.overview;
    const entry = colourEntry();
    if (!entry || !entry.images.length) return galleryPayload.overview;
    const hit = entry.images.find((i) => i.view === state.view) || entry.images[0];
    state.view = hit.view;
    return hit;
  }

  function setImage(next, animate) {
    if (!(img instanceof HTMLImageElement)) return;
    const apply = () => {
      img.src = next.src;
      img.alt = next.alt;
      if (webpSource instanceof HTMLSourceElement) {
        if (next.srcWebp) webpSource.srcset = next.srcWebp;
        else webpSource.removeAttribute("srcset");
      }
      if (next.width) {
        img.width = next.width;
        img.height = next.width;
      }
      img.classList.toggle("is-wide", state.view !== 1 && !galleryPayload.overviewOnly);
      if (chip) {
        const c = colourEntry();
        chip.textContent = c
          ? `${c.label} · ${viewLabel(state.view)}`
          : "All colours overview";
      }
      img.style.opacity = "1";
      img.style.transform = "scale(1)";
    };
    if (animate && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      img.style.opacity = "0";
      img.style.transform = "scale(0.97)";
      const pre = new Image();
      pre.onload = () => window.setTimeout(apply, 170);
      pre.onerror = apply;
      pre.src = next.src;
    } else {
      apply();
    }
  }

  function renderThumbs() {
    if (!thumbs) return;
    const entry = colourEntry();
    if (!entry) {
      thumbs.innerHTML = "";
      return;
    }
    thumbs.innerHTML = entry.images
      .map(
        (i) => `
      <button type="button" class="ipdp__thumb ${i.view === state.view ? "is-active" : ""}" data-view="${i.view}" aria-label="${viewLabel(i.view)}">
        <img src="${i.src}" alt="" width="64" height="64" />
      </button>`,
      )
      .join("");
    thumbs.querySelectorAll("[data-view]").forEach((btn) => {
      btn.addEventListener("click", () => {
        stopTour();
        state.view = Number(btn.getAttribute("data-view"));
        setImage(currentImage(), true);
        renderThumbs();
      });
    });
  }

  function updatePrice() {
    const kes = activeKes();
    const deposit = Math.round((kes * depositPct) / 100);
    const monthly = Math.round((kes - deposit) / months);
    if (priceEl) priceEl.textContent = `From KES ${kes.toLocaleString("en-KE")}`;
    if (monthlyEl)
      monthlyEl.textContent = `or KES ${monthly.toLocaleString("en-KE")} a month for ${months} months after a KES ${deposit.toLocaleString("en-KE")} deposit`;

    document.querySelectorAll("[data-storage]").forEach((btn) => {
      const newKes = Number(btn.getAttribute("data-kes-new") || btn.getAttribute("data-kes") || 0);
      const exUkKes = Number(btn.getAttribute("data-kes-ex-uk") || newKes);
      const shown = state.channel === "ex-uk" ? exUkKes : newKes;
      const span = btn.querySelector("[data-storage-price]");
      if (span) span.textContent = `KES ${shown.toLocaleString("en-KE")}`;
    });

    if (wa instanceof HTMLAnchorElement) {
      const c = colourEntry()?.label || "overview";
      const msg = encodeURIComponent(
        `Hi Gadget Hub, I'm interested in the ${modelName} (${channelLabel()}), ${c}, ${state.storage}. Price: KES ${kes.toLocaleString("en-KE")}.`,
      );
      wa.href = `${waBase}${msg}`;
    }
  }

  document.querySelectorAll("[data-stock-channel] [data-channel]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = btn.getAttribute("data-channel") || "new";
      state.channel = next;
      document.querySelectorAll("[data-stock-channel] [data-channel]").forEach((b) => {
        const on = b === btn;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
      updatePrice();
    });
  });

  function stopTour() {
    if (state.tour) {
      clearInterval(state.tour);
      state.tour = null;
    }
    if (tourBtn) tourBtn.textContent = "Auto tour";
  }

  document.querySelectorAll("[data-colour]").forEach((btn) => {
    btn.addEventListener("click", () => {
      stopTour();
      state.colour = btn.getAttribute("data-colour");
      document.querySelectorAll("[data-colour]").forEach((b) => {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-selected", b === btn ? "true" : "false");
      });
      if (colourName) colourName.textContent = colourEntry()?.label || "";
      const views = colourEntry()?.images?.map((i) => i.view) || [];
      if (!views.includes(state.view)) state.view = views[0] || 1;
      setImage(currentImage(), true);
      renderThumbs();
      updatePrice();
    });
  });

  document.querySelectorAll("[data-storage]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-storage]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      state.storage = btn.getAttribute("data-storage");
      state.kesNew = btn.getAttribute("data-kes-new") || btn.getAttribute("data-kes");
      state.kesExUk = btn.getAttribute("data-kes-ex-uk") || state.kesNew;
      updatePrice();
    });
  });

  tourBtn?.addEventListener("click", () => {
    if (state.tour) {
      stopTour();
      return;
    }
    const entry = colourEntry();
    if (!entry?.images?.length) return;
    tourBtn.textContent = "Stop tour";
    state.tour = setInterval(() => {
      const imgs = colourEntry()?.images || [];
      if (!imgs.length) return;
      const idx = imgs.findIndex((i) => i.view === state.view);
      const next = imgs[(idx + 1) % imgs.length];
      state.view = next.view;
      setImage(next, true);
      renderThumbs();
    }, 1500);
  });

  // Zoom (desktop only)
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (fine && stage && img instanceof HTMLImageElement) {
    stage.addEventListener("mousemove", (e) => {
      const rect = stage.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      img.style.transformOrigin = `${x}% ${y}%`;
      img.style.transform = "scale(2.1)";
      if (hint) hint.style.opacity = "0";
    });
    stage.addEventListener("mouseleave", () => {
      img.style.transform = "scale(1)";
      if (hint) hint.style.opacity = "1";
    });
  } else if (hint) {
    hint.textContent = "Tap for full screen. Swipe to change view.";
  }

  // Lightbox
  function openLb() {
    if (!(lb instanceof HTMLDialogElement)) return;
    const cur = currentImage();
    if (lbImg instanceof HTMLImageElement) {
      lbImg.src = cur.src;
      lbImg.alt = cur.alt;
    }
    if (lbCap) {
      const c = colourEntry()?.label || "Overview";
      const entry = colourEntry();
      const n = entry?.images?.length || 1;
      const i = entry?.images?.findIndex((x) => x.view === state.view) ?? 0;
      lbCap.textContent = `${modelName} · ${c} · ${viewLabel(state.view)} (${i + 1}/${n})`;
    }
    const multi = (colourEntry()?.images?.length || 0) > 1;
    document.querySelector("[data-lb-prev]")?.toggleAttribute("hidden", !multi);
    document.querySelector("[data-lb-next]")?.toggleAttribute("hidden", !multi);
    lb.showModal();
  }

  document.querySelector("[data-gallery-open]")?.addEventListener("click", openLb);
  document.querySelector("[data-lb-close]")?.addEventListener("click", () => lb?.close());
  document.querySelector("[data-lb-prev]")?.addEventListener("click", () => {
    const imgs = colourEntry()?.images || [];
    if (!imgs.length) return;
    const idx = imgs.findIndex((i) => i.view === state.view);
    state.view = imgs[(idx - 1 + imgs.length) % imgs.length].view;
    setImage(currentImage(), false);
    renderThumbs();
    openLb();
  });
  document.querySelector("[data-lb-next]")?.addEventListener("click", () => {
    const imgs = colourEntry()?.images || [];
    if (!imgs.length) return;
    const idx = imgs.findIndex((i) => i.view === state.view);
    state.view = imgs[(idx + 1) % imgs.length].view;
    setImage(currentImage(), false);
    renderThumbs();
    openLb();
  });

  window.addEventListener("keydown", (e) => {
    if (!(lb instanceof HTMLDialogElement) || !lb.open) return;
    if (e.key === "Escape") lb.close();
    if (e.key === "ArrowLeft") document.querySelector("[data-lb-prev]")?.dispatchEvent(new Event("click"));
    if (e.key === "ArrowRight") document.querySelector("[data-lb-next]")?.dispatchEvent(new Event("click"));
  });

  // Swipe
  let touchX = null;
  stage?.addEventListener("touchstart", (e) => {
    touchX = e.changedTouches[0]?.clientX ?? null;
  }, { passive: true });
  stage?.addEventListener("touchend", (e) => {
    if (touchX == null) return;
    const dx = (e.changedTouches[0]?.clientX ?? 0) - touchX;
    touchX = null;
    if (Math.abs(dx) < 40) return;
    stopTour();
    const imgs = colourEntry()?.images || [];
    if (imgs.length < 2) return;
    const idx = imgs.findIndex((i) => i.view === state.view);
    const next = dx < 0 ? imgs[(idx + 1) % imgs.length] : imgs[(idx - 1 + imgs.length) % imgs.length];
    state.view = next.view;
    setImage(next, true);
    renderThumbs();
  }, { passive: true });

  setImage(currentImage(), false);
  renderThumbs();
  updatePrice();

  document.querySelector("[data-add-bag]")?.addEventListener("click", () => {
    const cur = currentImage();
    const c = colourEntry();
    window.dispatchEvent(
      new CustomEvent("gh:bag-add", {
        detail: {
          id: `${galleryPayload.modelId}-${state.channel}`,
          name: modelName,
          colour: c?.label || "Overview",
          storage: `${state.storage} · ${channelLabel()}`,
          kes: activeKes(),
          image: cur.src,
          channel: channelLabel(),
        },
      }),
    );
  });
</script>

