---
/**
 * iPad shop - Family / Size / Gen / Need + Pencil Pro & Apple Intelligence toggles.
 */
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import IpadCard from "../../components/ipad/IpadCard.astro";
import { filterVisibleById, livePricedCatalog, websiteVisibleIdSet } from "../../lib/pricing/live";
import { listingRows } from "../../lib/listing-offers";
import {
  ipadModels,
  ipadConfig,
  type IpadFamily,
  type IpadChipGen,
} from "../../lib/ipad";

const params = Astro.url.searchParams;
const family = params.get("family") as IpadFamily | null;
const chip = params.get("chip") as IpadChipGen | null;
const size = params.get("size");
const need = params.get("need");
const pencilPro = params.get("pencil") === "pro" || params.get("pencilPro") === "1";
const aiOnly = params.get("ai") === "1";
const sort = params.get("sort") || "newest";

let list = filterVisibleById([...ipadModels], await websiteVisibleIdSet());
if (family === "Pro" || family === "Air" || family === "mini" || family === "iPad") {
  list = list.filter((m) => m.family === family);
}
if (chip) list = list.filter((m) => m.chipGen === chip);
if (size) {
  const s = Number(size);
  if (!Number.isNaN(s)) list = list.filter((m) => Math.abs(m.screenInches - s) < 0.2 || (s === 13 && m.screenInches === 12.9));
}
if (pencilPro) list = list.filter((m) => m.pencils.includes("pro"));
if (aiOnly) list = list.filter((m) => m.appleIntelligence);

if (need === "drawing") list = list.filter((m) => m.family === "Pro" || (m.family === "Air" && m.pencils.includes("pro")));
else if (need === "school") list = list.filter((m) => m.family === "Air" || m.family === "iPad" || m.family === "mini");
else if (need === "kids") list = list.filter((m) => m.family === "iPad");
else if (need === "work") list = list.filter((m) => m.family === "Pro" || m.family === "Air" || m.family === "mini");
else if (need === "lightest") list = [...list].sort((a, b) => a.weightG - b.weightG).slice(0, 8);
else if (need === "screen") list = list.filter((m) => m.display.promotion || m.family === "Pro");
else if (need === "price") list = [...list].sort((a, b) => a.basePriceKes - b.basePriceKes).slice(0, 8);

if (need !== "lightest" && need !== "price") {
  if (sort === "price") list.sort((a, b) => a.basePriceKes - b.basePriceKes);
  else if (sort === "weight") list.sort((a, b) => a.weightG - b.weightG);
  else list.sort((a, b) => b.year - a.year || b.basePriceKes - a.basePriceKes);
}

const qs = (extra: Record<string, string | null>) => {
  const p = new URLSearchParams(params);
  for (const [k, v] of Object.entries(extra)) {
    if (v === null || v === "") p.delete(k);
    else p.set(k, v);
  }
  const s = p.toString();
  return s ? `/ipad/shop?${s}` : "/ipad/shop";
};

const ipadShopRows = listingRows(list, await livePricedCatalog(), {
  href: (model) => `/ipad/${model.id}`,
  fallbackPrice: (model) => model.basePriceKes,
});
---

<BaseLayout title="Shop iPad - GadgetHub" description="Filter iPad Pro, Air, mini and iPad by size, chip and need.">
  <section class="container ipad-shop">
    <nav class="ipad-shop__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/ipad">iPad</a> / Shop
    </nav>
    <h1>Shop iPad</h1>
    <p class="ipad-shop__intro">{ipadConfig.samplePriceDisclaimer}</p>

    <div class="ipad-shop__filters" role="group" aria-label="Family">
      <a class:list={["ipad-chip", { "is-active": !family }]} href={qs({ family: null })}>All</a>
      {(["Pro", "Air", "mini", "iPad"] as const).map((f) => (
        <a class:list={["ipad-chip", { "is-active": family === f }]} href={qs({ family: f })}>
          {f === "iPad" ? "iPad" : `iPad ${f}`}
        </a>
      ))}
    </div>
    <div class="ipad-shop__filters" role="group" aria-label="Size">
      {["8.3", "10.9", "11", "12.9", "13"].map((s) => (
        <a class:list={["ipad-chip", { "is-active": size === s }]} href={qs({ size: size === s ? null : s })}>
          {s}″
        </a>
      ))}
    </div>
    <div class="ipad-shop__filters" role="group" aria-label="Generation">
      {(["M5", "M4", "M3", "M2", "M1"] as const).map((g) => (
        <a class:list={["ipad-chip", { "is-active": chip === g }]} href={qs({ chip: chip === g ? null : g })}>
          {g}
        </a>
      ))}
    </div>
    <div class="ipad-shop__filters" role="group" aria-label="Need">
      <a class:list={["ipad-chip", { "is-active": need === "drawing" }]} href={qs({ need: "drawing" })}>Drawing</a>
      <a class:list={["ipad-chip", { "is-active": need === "school" }]} href={qs({ need: "school" })}>School</a>
      <a class:list={["ipad-chip", { "is-active": need === "kids" }]} href={qs({ need: "kids" })}>Kids</a>
      <a class:list={["ipad-chip", { "is-active": need === "work" }]} href={qs({ need: "work" })}>Work & travel</a>
      <a class:list={["ipad-chip", { "is-active": need === "lightest" }]} href={qs({ need: "lightest" })}>Lightest</a>
      <a class:list={["ipad-chip", { "is-active": need === "screen" }]} href={qs({ need: "screen" })}>Best screen</a>
      <a class:list={["ipad-chip", { "is-active": need === "price" }]} href={qs({ need: "price" })}>Lowest price</a>
    </div>
    <div class="ipad-shop__toggles">
      <a class:list={["ipad-chip", { "is-active": pencilPro }]} href={qs({ pencilPro: pencilPro ? null : "1", pencil: null })}>
        Works with Apple Pencil Pro
      </a>
      <a class:list={["ipad-chip", { "is-active": aiOnly }]} href={qs({ ai: aiOnly ? null : "1" })}>
        Supports Apple Intelligence
      </a>
      <label class="ipad-shop__sort">
        Sort
        <select onchange="location.href=this.value">
          <option value={qs({ sort: "newest" })} selected={sort === "newest"}>Newest</option>
          <option value={qs({ sort: "price" })} selected={sort === "price"}>Price</option>
          <option value={qs({ sort: "weight" })} selected={sort === "weight"}>Weight</option>
        </select>
      </label>
    </div>

    <p class="ipad-shop__count">{list.length} models</p>
    <ul class="ipad-shop__grid" data-ipad-shop-grid>
      {ipadShopRows.map(({ item: m, offer }) => (
        <li>
          <IpadCard model={m} compare={false} channel={offer.channel} priceKes={offer.priceKes || m.basePriceKes} coloursInStock={offer.colours} href={offer.href} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  import { bindLandingViewState } from "../../scripts/landingViewState";
  import { repairProductImages } from "../../scripts/safeSwapImage";

  bindLandingViewState({
    storageKey: "gh-shop-ipad",
    gridSelector: "[data-ipad-shop-grid]",
    withGenFilter: false,
  });
  repairProductImages();
  window.addEventListener("pageshow", () => repairProductImages());
</script>

<style>
  .ipad-shop {
    padding-block: var(--space-10) var(--ipad-section-gap);
  }
  .ipad-shop__crumb {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin-bottom: 0.75rem;
  }
  .ipad-shop h1 {
    margin: 0 0 0.5rem;
    font-size: var(--ipad-headline);
    letter-spacing: -0.03em;
  }
  .ipad-shop__intro {
    color: var(--color-fg-muted);
    max-width: 40rem;
  }
  .ipad-shop__filters,
  .ipad-shop__toggles {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.4rem;
    margin: 0.85rem 0;
    align-items: center;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.15rem;
  }
  .ipad-shop__filters::-webkit-scrollbar,
  .ipad-shop__toggles::-webkit-scrollbar {
    display: none;
  }
  .ipad-chip {
    flex: 0 0 auto;
    white-space: nowrap;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    text-decoration: none;
    color: inherit;
    font-size: 0.78rem;
  }
  .ipad-chip.is-active,
  .ipad-chip:hover {
    background: #000;
    color: #fff;
    border-color: #000;
  }
  .ipad-shop__sort {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
  }
  .ipad-shop__count {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
  .ipad-shop__grid {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
</style>
