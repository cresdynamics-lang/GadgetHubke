---
/**
 * iPad landing - hero light-up, choose cards, gen chips, grid, plan purchase, visit.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import IpadStage from "../../components/ipad/IpadStage.astro";
import IpadCard from "../../components/ipad/IpadCard.astro";
import IpadQuiz from "../../components/ipad/IpadQuiz.astro";
import IpadLipaCalc from "../../components/ipad/IpadLipaCalc.astro";
import IpadTradeIn from "../../components/ipad/IpadTradeIn.astro";
import {
  ipadModels,
  ipadModelsByFamily,
  getIpadImage,
  defaultIpadColour,
  formatKes,
  lowestIpadPrice,
  ipadConfig,
  homeIpadAccessories,
  lipaMonthly,
} from "../../lib/ipad";
import { whatsappUrl } from "../../lib/site";
import CategoryHero from "../../components/hero/CategoryHero.astro";

const pro = ipadModelsByFamily("Pro");
const air = ipadModelsByFamily("Air");
const mini = ipadModelsByFamily("mini");
const std = ipadModelsByFamily("iPad");
const accessories = homeIpadAccessories();
const newest = [...ipadModels].sort((a, b) => b.year - a.year || b.basePriceKes - a.basePriceKes);

const choose = [
  {
    family: "Pro" as const,
    title: "iPad Pro",
    body: "Tandem OLED, M-series power, Pencil Pro. For people who push the screen hard.",
    href: "/ipad/shop?family=Pro",
    price: lowestIpadPrice("Pro"),
    model: pro.find((m) => m.id === "ipad-pro-11-m4") || pro[0],
  },
  {
    family: "Air" as const,
    title: "iPad Air",
    body: "The sweet spot - light, colourful, Pencil Pro, enough for school and creative work.",
    href: "/ipad/shop?family=Air",
    price: lowestIpadPrice("Air"),
    model: air.find((m) => m.id === "ipad-air-11-m2") || air[0],
  },
  {
    family: "mini" as const,
    title: "iPad mini",
    body: "One-hand reading, notes and travel. A17 Pro brings Apple Intelligence.",
    href: "/ipad/shop?family=mini",
    price: lowestIpadPrice("mini"),
    model: mini.find((m) => m.id === "ipad-mini-a17-pro") || mini[0],
  },
  {
    family: "iPad" as const,
    title: "iPad",
    body: "Colourful, approachable, family-ready. USB-C on 10th gen and A16.",
    href: "/ipad/shop?family=iPad",
    price: lowestIpadPrice("iPad"),
    model: std.find((m) => m.id === "ipad-10") || std[0],
  },
];

const genChips = ["M5", "M4", "M3", "M2", "M1", "A-series"] as const;
const wa = whatsappUrl("Hi Gadget Hub, I want to visit and try an iPad / Apple Pencil.");
---

<BaseLayout
  title="iPad - GadgetHub"
  description="iPad Pro, Air, mini and iPad. Sealed stock in Nairobi. Sample prices until admin is live."
>
  <CategoryHero category="ipad" />

  <section class="container ipad-choose">
    <h2>Choose your iPad</h2>
    <p>Four families. One honest fit for how you draw, study, travel or share with family.</p>
    <ul class="ipad-choose__grid">
      {
        choose.map((c) => {
          const colour = defaultIpadColour(c.model);
          const img = getIpadImage(c.model.id, colour, "product", c.model.name);
          return (
            <li>
              <a class="ipad-choose__card" href={c.href}>
                <IpadStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={760} height={760} />
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                <em>From {formatKes(c.price)}</em>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="container">
    <IpadQuiz />
  </section>

  <section class="container ipad-os">
    <h2>What you can do on iPadOS</h2>
    <p>Everyday jobs people actually open on an iPad - not a feature dump.</p>
    <ul class="ipad-os__grid">
      {
        [
          { t: "Split View notes", d: "Textbook on one side, notes on the other." },
          { t: "Stage Manager", d: "Windowed apps on M-series iPads with an external display." },
          { t: "Apple Pencil markup", d: "Sign PDFs, sketch wireframes, annotate slides." },
          { t: "Continuity Camera", d: "Use your iPad as a secondary Mac display or webcam." },
          { t: "Files and USB", d: "Plug in a drive, move folders, keep projects tidy." },
          { t: "Focus modes", d: "School, work, or wind-down - mute the noise." },
        ].map((item) => (
          <li>
            <h3>{item.t}</h3>
            <p>{item.d}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container ipad-org">
    <h2>Schools and teams</h2>
    <p>Bulk quotes, setup help, and classroom Pencil kits - ask on WhatsApp.</p>
    <div class="ipad-org__grid">
      <a class="ipad-org__card" href={whatsappUrl("Hi Gadget Hub - school / college iPad quote request.")}>
        <h3>Schools and colleges</h3>
        <p>Volume pricing, MDM-friendly setup notes, and Pencil bundles for labs.</p>
      </a>
      <a class="ipad-org__card" href={whatsappUrl("Hi Gadget Hub - corporate iPad / fleet quote.")}>
        <h3>Corporate and field teams</h3>
        <p>Shared devices, cases, and cellular options for staff on the road.</p>
      </a>
    </div>
  </section>

  <section class="container ipad-grid-sec" data-ipad-landing-grid>
    <div class="ipad-grid-sec__head">
      <h2>Shop iPads</h2>
      <div class="ipad-chips" role="group" aria-label="Generation">
        <button type="button" class="is-active" data-gen="all">All</button>
        {
          genChips.map((g) => (
            <button type="button" data-gen={g}>
              {g}
            </button>
          ))
        }
      </div>
      <a href="/ipad/shop">Open full filters</a>
    </div>
    <ul class="ipad-grid">
      {
        newest.slice(0, 12).map((m) => (
          <li data-chip-gen={["M1", "M2", "M3", "M4", "M5"].includes(m.chipGen) ? m.chipGen : "A-series"}>
            <IpadCard model={m} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container ipad-bundles">
    <h2>Pencil and keyboard bundles</h2>
    <p>Compatible sets only - sample combined prices.</p>
    <ul class="ipad-bundles__grid">
      {
        [
          { id: "ipad-air-11-m2", pencil: 18000, kb: 35000, label: "Air 11″ M2 + Pencil Pro + Magic Keyboard" },
          { id: "ipad-pro-11-m4", pencil: 18000, kb: 45000, label: "Pro 11″ M4 + Pencil Pro + Magic Keyboard" },
          { id: "ipad-10", pencil: 11000, kb: 28000, label: "iPad 10th gen + Pencil (USB-C) + Folio" },
        ].map((b) => {
          const m = ipadModels.find((x) => x.id === b.id)!;
          const total = m.basePriceKes + b.pencil + b.kb;
          const lipa = lipaMonthly(total);
          return (
            <li>
              <h3>{b.label}</h3>
              <p>{formatKes(total)} sample · or {formatKes(lipa.monthlyKes)} / mo</p>
              <button
                type="button"
                class="btn btn--primary btn--sm"
                data-bundle
                data-id={m.id}
                data-name={m.name}
                data-kes={total}
                data-extras={`${b.label}`}
              >
                Add bundle to bag
              </button>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="container ipad-plan">
    <h2>Plan the purchase</h2>
    <p>{ipadConfig.lipa.note}</p>
    <div class="ipad-plan__grid">
      <IpadLipaCalc modelId="ipad-air-11-m2" />
      <IpadTradeIn modelId="ipad-10" />
    </div>
  </section>

  <section class="container ipad-acc">
    <h2>Accessories for your iPad</h2>
    <ul>
      {
        accessories.map((a) => (
          <li>
            <a href={a.href}>
              <strong>{a.name}</strong>
              <span>{a.priceKes > 0 ? `${formatKes(a.priceKes)} sample` : "See category"}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container ipad-visit">
    <h2>Visit the shop</h2>
    <p>
      {ipadConfig.address.line}, {ipadConfig.address.city}. Hours: {ipadConfig.address.hours}.
    </p>
    <p>Come in and try the Pencil.</p>
    <a class="btn btn--primary" href={wa} target="_blank" rel="noopener noreferrer">Ask on WhatsApp</a>
  </section>
</BaseLayout>

<script>
  // Gen chips
  document.querySelectorAll("[data-gen]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-gen]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      const gen = btn.getAttribute("data-gen");
      document.querySelectorAll("[data-ipad-landing-grid] [data-chip-gen]").forEach((li) => {
        if (!(li instanceof HTMLElement)) return;
        li.hidden = gen !== "all" && li.getAttribute("data-chip-gen") !== gen;
      });
    });
  });

  document.querySelectorAll("[data-bundle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(btn instanceof HTMLElement)) return;
      window.dispatchEvent(
        new CustomEvent("gh:bag-add", {
          detail: {
            id: btn.getAttribute("data-id"),
            name: btn.getAttribute("data-name"),
            kes: Number(btn.getAttribute("data-kes") || 0),
            extras: btn.getAttribute("data-extras"),
          },
        }),
      );
    });
  });
</script>

<style>
  .ipad-choose,
  .ipad-grid-sec,
  .ipad-bundles,
  .ipad-plan,
  .ipad-acc,
  .ipad-visit,
  .ipad-os,
  .ipad-org {
    padding-block: var(--ipad-section-gap);
  }
  .ipad-choose h2,
  .ipad-grid-sec h2,
  .ipad-bundles h2,
  .ipad-plan h2,
  .ipad-acc h2,
  .ipad-visit h2,
  .ipad-os h2,
  .ipad-org h2 {
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .ipad-os__grid,
  .ipad-org__grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .ipad-os__grid { grid-template-columns: 1fr 1fr 1fr; }
    .ipad-org__grid { grid-template-columns: 1fr 1fr; }
  }
  .ipad-os__grid li,
  .ipad-org__card {
    border: 1px solid var(--color-border);
    border-radius: var(--ipad-radius);
    padding: 1rem;
  }
  .ipad-os__grid h3,
  .ipad-org__card h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .ipad-os__grid p,
  .ipad-org__card p { margin: 0; color: var(--color-fg-muted); font-size: var(--text-sm); }
  .ipad-org__card { display: block; text-decoration: none; color: inherit; }
  .ipad-plan__grid { display: grid; gap: 1rem; }
  @media (min-width: 40rem) {
    .ipad-plan__grid { grid-template-columns: 1fr 1fr; }
  }
  .ipad-choose__grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .ipad-choose__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .ipad-choose__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ipad-choose__card {
    display: grid;
    gap: 0.45rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--ipad-radius);
    padding: 0.85rem;
    transition: transform 180ms var(--ease-out);
  }
  .ipad-choose__card:hover {
    transform: translateY(-6px);
  }
  .ipad-choose__card :global(.istage__img) {
    transition: transform 220ms var(--ease-out);
  }
  .ipad-choose__card:hover :global(.istage__img) {
    transform: scale(1.05);
  }
  .ipad-choose__card h3 {
    margin: 0.35rem 0 0;
  }
  .ipad-choose__card p,
  .ipad-choose__card em {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    font-style: normal;
  }
  .ipad-grid-sec__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .ipad-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .ipad-chips button {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .ipad-chips button.is-active {
    background: #000;
    color: #fff;
  }
  .ipad-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 64rem) {
    .ipad-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ipad-bundles__grid,
  .ipad-acc ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 48rem) {
    .ipad-bundles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ipad-acc ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ipad-bundles__grid li,
  .ipad-plan__card,
  .ipad-acc a {
    border: 1px solid var(--color-border);
    border-radius: var(--ipad-radius);
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: 0.35rem;
  }
  .ipad-bundles__grid h3,
  .ipad-plan__card h3 {
    margin: 0;
    font-size: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .ipad-choose__card,
    .ipad-choose__card :global(.istage__img) {
      transition: none;
    }
    .ipad-choose__card:hover {
      transform: none;
    }
  }
</style>
