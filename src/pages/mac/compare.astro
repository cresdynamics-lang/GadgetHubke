---
/**
 * MacBook compare page — photos, grouped specs, differences toggle, honest summary.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  macModels,
  macConfig,
  macCompareCard,
  macCompareRows,
  honestMacDifference,
  rowIsDifferent,
} from "../../lib/mac";

const raw = Astro.url.searchParams.get("ids") || "";
const ids = raw
  .split(",")
  .map((s) => s.trim())
  .filter(Boolean)
  .slice(0, 3);

let models = ids
  .map((id) => macModels.find((m) => m.id === id))
  .filter((m): m is (typeof macModels)[number] => Boolean(m));

if (models.length < 2) {
  // Sensible defaults so the page is never empty
  models = [
    macModels.find((m) => m.id === "macbook-air-13-m4")!,
    macModels.find((m) => m.id === "macbook-pro-14-m4")!,
  ].filter(Boolean);
}

const cards = models.map(macCompareCard);
const rows = macCompareRows(cards);
const honest = honestMacDifference(models);
const pickList = macModels.filter((m) => m.year >= 2023 || m.isNew);
---

<BaseLayout title="Compare MacBooks - GadgetHub" description="Side-by-side MacBook Air and Pro comparison.">
  <section class="container mac-cmp" data-mac-cmp>
    <nav class="mac-cmp__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/mac">Mac</a> / Compare
    </nav>
    <h1>Compare MacBooks</h1>
    <p class="mac-cmp__intro">{macConfig.samplePriceDisclaimer}</p>

    <form class="mac-cmp__pick" method="get" action="/mac/compare">
      <p>Choose up to 3 models</p>
      <div class="mac-cmp__selects">
        {[0, 1, 2].map((i) => (
          <label>
            <span class="sr-only">Model {i + 1}</span>
            <select name={`id${i}`}>
              <option value="">—</option>
              {pickList.map((m) => (
                <option value={m.id} selected={models[i]?.id === m.id}>
                  {m.name}
                </option>
              ))}
            </select>
          </label>
        ))}
      </div>
      <button type="submit" class="btn btn--primary btn--sm" data-mac-cmp-submit>
        Update compare
      </button>
    </form>

    <p class="mac-cmp__honest"><strong>The honest difference.</strong> {honest}</p>

    <label class="mac-cmp__toggle">
      <input type="checkbox" data-mac-cmp-diff checked />
      Show only differences
    </label>

    <div class="mac-cmp__scroll">
      <table data-mac-cmp-table>
        <thead>
          <tr>
            <th></th>
            {
              cards.map((c) => (
                <th>
                  <a href={c.href}>
                    <img src={c.imageSrc} alt={c.imageAlt} width="220" height="138" loading="lazy" />
                    <span>{c.name}</span>
                  </a>
                  <small>From {c.priceLabel}</small>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            (() => {
              let last = "";
              return rows.flatMap((r) => {
                const diff = rowIsDifferent(r);
                const out = [];
                if (r.group !== last) {
                  out.push(
                    <tr class="mac-cmp__group" data-group={r.group}>
                      <th colspan={cards.length + 1}>{r.group}</th>
                    </tr>,
                  );
                  last = r.group;
                }
                out.push(
                  <tr data-diff={diff ? "1" : "0"}>
                    <th>{r.label}</th>
                    {r.values.map((v) => (
                      <td>{v}</td>
                    ))}
                  </tr>,
                );
                return out;
              });
            })()
          }
        </tbody>
      </table>
    </div>

    <p class="mac-cmp__back"><a href="/mac/shop">Back to shop</a></p>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector(".mac-cmp__pick");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const selects = [...form.querySelectorAll("select")];
    const ids = selects
      .map((s) => (s instanceof HTMLSelectElement ? s.value : ""))
      .filter(Boolean)
      .slice(0, 3);
    const uniq = [...new Set(ids)];
    location.href = uniq.length ? `/mac/compare?ids=${encodeURIComponent(uniq.join(","))}` : "/mac/compare";
  });

  const toggle = document.querySelector("[data-mac-cmp-diff]");
  const table = document.querySelector("[data-mac-cmp-table]");
  function applyDiff() {
    const only = toggle instanceof HTMLInputElement ? toggle.checked : true;
    table?.querySelectorAll("tbody tr[data-diff]").forEach((tr) => {
      if (!(tr instanceof HTMLElement)) return;
      tr.hidden = only && tr.getAttribute("data-diff") === "0";
    });
    // Hide group headers with no visible rows
    table?.querySelectorAll("tbody tr.mac-cmp__group").forEach((g) => {
      if (!(g instanceof HTMLElement)) return;
      let next = g.nextElementSibling;
      let any = false;
      while (next && !next.classList.contains("mac-cmp__group")) {
        if (next instanceof HTMLElement && !next.hidden) any = true;
        next = next.nextElementSibling;
      }
      g.hidden = only && !any;
    });
  }
  toggle?.addEventListener("change", applyDiff);
  applyDiff();
</script>

<style>
  .mac-cmp {
    padding-block: var(--space-10) var(--mac-section-gap);
  }
  .mac-cmp__crumb {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    margin-bottom: 0.75rem;
  }
  .mac-cmp__crumb a {
    color: inherit;
  }
  .mac-cmp h1 {
    margin: 0 0 0.5rem;
    font-size: var(--mac-headline);
    letter-spacing: -0.03em;
  }
  .mac-cmp__intro {
    color: var(--color-fg-muted);
    max-width: 40rem;
  }
  .mac-cmp__pick {
    margin: 1.25rem 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
  }
  .mac-cmp__pick p {
    margin: 0 0 0.65rem;
    font-weight: 600;
  }
  .mac-cmp__selects {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 48rem) {
    .mac-cmp__selects {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .mac-cmp__selects select {
    width: 100%;
    font: inherit;
    padding: 0.55rem 0.65rem;
    border-radius: 0.65rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .mac-cmp__honest {
    margin: 1rem 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-fg-muted);
  }
  .mac-cmp__honest strong {
    color: var(--color-fg);
  }
  .mac-cmp__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    margin-bottom: 0.85rem;
  }
  .mac-cmp__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .mac-cmp table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .mac-cmp th,
  .mac-cmp td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .mac-cmp thead th a {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
  }
  .mac-cmp thead img {
    width: 100%;
    max-width: 14rem;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: #f5f5f7;
    border-radius: 0.85rem;
    mix-blend-mode: multiply;
  }
  .mac-cmp thead small {
    display: block;
    color: var(--color-fg-muted);
    font-weight: 400;
  }
  .mac-cmp__group th {
    background: var(--color-bg-subtle);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .mac-cmp__back {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }
</style>
