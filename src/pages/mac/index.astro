---
/**
 * Mac landing — Air/Pro choose, quiz, grid, plan purchase, Windows, accessories, visit.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import MacStage from "../../components/mac/MacStage.astro";
import MacCard from "../../components/mac/MacCard.astro";
import MacQuiz from "../../components/mac/MacQuiz.astro";
import MacLipaCalc from "../../components/mac/MacLipaCalc.astro";
import MacTradeIn from "../../components/mac/MacTradeIn.astro";
import {
  macModels,
  macModelsByFamily,
  getMacImage,
  defaultMacColour,
  formatKes,
  lowestMacPrice,
  macConfig,
  homeMacAccessories,
} from "../../lib/mac";

const air = macModelsByFamily("Air");
const pro = macModelsByFamily("Pro");
const heroStart = getMacImage("macbook-air-13-m4", "sky-blue", "hero_startframe");
const heroEnd = getMacImage("macbook-air-13-m4", "sky-blue", "hero_endframe");
const accessories = homeMacAccessories();
---

<BaseLayout
  title="MacBook - GadgetHub"
  description="MacBook Air and MacBook Pro, M1 to M5. Sealed stock in Nairobi. Sample prices until admin is live."
>
  <section class="mac-hero" data-mac-hero>
    <div class="mac-hero__copy container">
      <h1>The MacBook, felt before you buy it.</h1>
      <p class="mac-hero__lede">
        Sealed. Serial number on the invoice. Set up for you before you collect.
      </p>
      <div class="mac-hero__cta">
        <a class="btn btn--primary" href="/mac/shop?family=Air">Shop MacBook Air</a>
        <a class="btn btn--secondary" href="/mac/shop?family=Pro">Shop MacBook Pro</a>
      </div>
    </div>
    <div class="mac-hero__stage" aria-hidden="true">
      <img
        class="mac-hero__frame mac-hero__frame--start"
        data-hero-start
        src={heroStart.src}
        alt=""
        width={heroStart.width}
        height={Math.round(heroStart.width * 0.625)}
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="mac-hero__frame mac-hero__frame--end"
        data-hero-end
        src={heroEnd.src}
        alt=""
        width={heroEnd.width}
        height={Math.round(heroEnd.width * 0.625)}
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="mac-choose container">
    <h2>Choose your MacBook</h2>
    <div class="mac-choose__grid">
      <a class="mac-choose__card" href="/mac/shop?family=Air">
        {
          (() => {
            const m = air.find((x) => x.id === "macbook-air-13-m4") || air[0];
            const img = getMacImage(m.id, defaultMacColour(m), "product", m.name);
            return (
              <>
                <MacStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={img.width} height={Math.round(img.width * 0.625)} />
                <h3>MacBook Air</h3>
                <p>Thin, silent, all-day battery. From students to everyday work.</p>
                <span class="mac-choose__price">From {formatKes(lowestMacPrice("Air"))}</span>
              </>
            );
          })()
        }
      </a>
      <a class="mac-choose__card" href="/mac/shop?family=Pro">
        {
          (() => {
            const m = pro.find((x) => x.id === "macbook-pro-14-m4") || pro[0];
            const img = getMacImage(m.id, defaultMacColour(m), "product", m.name);
            return (
              <>
                <MacStage src={img.src} srcWebp={img.srcWebp} alt={img.alt} width={img.width} height={Math.round(img.width * 0.625)} />
                <h3>MacBook Pro</h3>
                <p>XDR screens, active cooling, ports for real work.</p>
                <span class="mac-choose__price">From {formatKes(lowestMacPrice("Pro"))}</span>
              </>
            );
          })()
        }
      </a>
    </div>
  </section>

  <div class="container">
    <MacQuiz />
  </div>

  <section class="mac-grid-wrap container" id="mac-shop-preview">
    <header class="mac-grid-wrap__head">
      <h2>Shop by generation</h2>
      <p>All sample prices. {macConfig.samplePriceDisclaimer}</p>
    </header>
    <div class="mac-chips" role="group" aria-label="Filter by chip">
      {(["M5", "M4", "M3", "M2", "M1"] as const).map((g) => (
        <a class="mac-chip" href={`/mac/shop?chip=${g}`}>{g}</a>
      ))}
      <a class="mac-chip mac-chip--all" href="/mac/shop">All</a>
    </div>
    <ul class="mac-grid">
      {macModels.slice(0, 8).map((m) => (
        <li>
          <MacCard model={m} />
        </li>
      ))}
    </ul>
    <p class="mac-grid-wrap__more">
      <a href="/mac/shop">See all {macModels.length} MacBooks ›</a>
    </p>
  </section>

  <section class="mac-plan container">
    <h2>Plan the purchase</h2>
    <p class="mac-plan__lede">Sample calculators. Final terms are confirmed in the shop.</p>
    <div class="mac-plan__grid">
      <MacLipaCalc modelId="macbook-air-13-m4" />
      <MacTradeIn modelId="macbook-air-13-m2" />
    </div>
  </section>

  <section class="mac-windows container">
    <h2>Switching from Windows</h2>
    <p>
      Excel and Word work. Most apps have a Mac version. A few Windows-only programs will not run —
      ask us before you buy. We can help move your files across when you collect.
    </p>
    <a
      class="btn btn--secondary"
      href={`https://wa.me/${macConfig.whatsapp}?text=${encodeURIComponent("Hi Gadget Hub — I'm switching from Windows to Mac. Can you help?")}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Ask about switching
    </a>
  </section>

  <section class="mac-acc container">
    <h2>Accessories for Mac</h2>
    <p class="mac-acc__lede">Sample prices. Fit rules filter on each product page.</p>
    <ul class="mac-acc__grid">
      {
        accessories.map((a) => (
          <li>
            <a href={a.href}>
              <strong>{a.name}</strong>
              <span>{a.blurb}</span>
              {a.priceKes > 0 ? <b>{formatKes(a.priceKes)} sample</b> : <b>See category</b>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mac-corp container">
    <h2>Equipping a team?</h2>
    <p>We invoice companies and can prepare machines in bulk.</p>
    <a
      class="btn btn--primary"
      href={`https://wa.me/${macConfig.whatsapp}?text=${encodeURIComponent("Corporate Mac order")}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      WhatsApp corporate order
    </a>
  </section>

  <section class="mac-visit container">
    <h2>Visit the shop</h2>
    <p>
      {macConfig.address.line}, {macConfig.address.city}. Hours: {macConfig.address.hours}.
      Come in and type on one.
    </p>
    <a
      class="btn btn--primary"
      href={`https://wa.me/${macConfig.whatsapp}?text=${encodeURIComponent("Hi Gadget Hub — I want to see a MacBook.")}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      WhatsApp {macConfig.whatsappDisplay}
    </a>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector("[data-mac-hero]");
  const end = document.querySelector("[data-hero-end]");
  if (root && end instanceof HTMLElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mobile = window.matchMedia("(max-width: 47.99rem)").matches;
    if (reduce) {
      end.style.opacity = "1";
    } else {
      end.style.opacity = "0";
      end.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 1400,
        easing: "cubic-bezier(0.16, 1, 0.3, 1)",
        fill: "forwards",
      });
      if (!mobile) {
        const onScroll = () => {
          const rect = root.getBoundingClientRect();
          const total = root.offsetHeight - window.innerHeight;
          const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
          end.style.opacity = String(progress);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }
    }
  }
</script>

<style>
  .mac-hero {
    position: relative;
    min-height: 720px;
    background: #f5f5f7;
    color: #1d1d1f;
    display: grid;
    align-items: end;
    padding-block: var(--space-16) var(--space-12);
  }
  @media (min-width: 64rem) {
    .mac-hero {
      min-height: 160vh;
      align-items: start;
      padding-top: 12vh;
    }
  }
  .mac-hero__copy {
    position: relative;
    z-index: 2;
    max-width: 36rem;
  }
  .mac-hero h1 {
    margin: 0 0 0.75rem;
    font-size: var(--mac-headline);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .mac-hero__lede {
    margin: 0 0 1.5rem;
    color: #6e6e73;
    font-size: var(--text-lg);
  }
  .mac-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .mac-hero__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .mac-hero__frame {
    grid-area: 1 / 1;
    width: min(92%, 1100px);
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .mac-hero__frame--end {
    opacity: 0;
  }
  .mac-choose,
  .mac-grid-wrap,
  .mac-plan,
  .mac-windows,
  .mac-acc,
  .mac-corp,
  .mac-visit {
    padding-block: var(--mac-section-gap);
  }
  .mac-choose h2,
  .mac-grid-wrap h2,
  .mac-plan h2,
  .mac-windows h2,
  .mac-acc h2,
  .mac-corp h2,
  .mac-visit h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
  }
  .mac-choose__grid {
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 48rem) {
    .mac-choose__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .mac-choose__card {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1rem;
    border-radius: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition:
      transform var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease);
  }
  .mac-choose__card:hover {
    transform: translateY(-6px);
    border-color: var(--color-fg);
    color: inherit;
  }
  .mac-choose__card :global(.mstage__img) {
    transition: transform var(--duration) var(--ease-out);
  }
  .mac-choose__card:hover :global(.mstage__img) {
    transform: scale(1.05);
  }
  .mac-choose__card h3 {
    margin: 1rem 0 0.35rem;
    letter-spacing: -0.02em;
  }
  .mac-choose__card p {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }
  .mac-choose__price {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
  }
  .mac-grid-wrap__head p,
  .mac-plan__lede,
  .mac-acc__lede,
  .mac-windows p,
  .mac-corp p,
  .mac-visit p {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 40rem;
  }
  .mac-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 1.5rem;
  }
  .mac-chip {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    text-decoration: none;
    color: inherit;
    font-size: var(--text-sm);
  }
  .mac-chip:hover,
  .mac-chip--all {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .mac-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .mac-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .mac-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .mac-grid-wrap__more {
    margin: 1.5rem 0 0;
  }
  .mac-plan__grid {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .mac-plan__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .mac-windows .btn,
  .mac-corp .btn,
  .mac-visit .btn {
    margin-top: 1rem;
  }
  .mac-acc__grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .mac-acc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .mac-acc__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .mac-acc__grid a {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1rem;
    height: 100%;
  }
  .mac-acc__grid span {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
  .mac-acc__grid b {
    font-size: var(--text-sm);
  }
  .mac-visit,
  .mac-corp {
    border-top: 1px solid var(--color-border);
  }
  @media (prefers-reduced-motion: reduce) {
    .mac-choose__card:hover,
    .mac-choose__card:hover :global(.mstage__img) {
      transform: none;
    }
  }
</style>
