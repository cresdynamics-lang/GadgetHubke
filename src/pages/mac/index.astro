---
/**
 * Mac landing - Air/Pro choose, quiz, grid, plan purchase, Windows, accessories, visit.
 */
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { filterVisibleById, livePricedCatalog, websiteVisibleIdSet } from "../../lib/pricing/live";
import { buildCategorySeo, formatKes as formatKesSeoHub } from "../../lib/seo/product-seo";
import MacStage from "../../components/mac/MacStage.astro";
import MacCard from "../../components/mac/MacCard.astro";
import MacQuiz from "../../components/mac/MacQuiz.astro";
import MacLipaCalc from "../../components/mac/MacLipaCalc.astro";
import MacTradeIn from "../../components/mac/MacTradeIn.astro";
import {
  macModels,
  getMacImage,
  defaultMacColour,
  formatKes,
  macConfig,
  homeMacAccessories,
} from "../../lib/mac";
import { cardImageSrc } from "../../lib/card-images";
import CategoryHero from "../../components/hero/CategoryHero.astro";
import { listingRows } from "../../lib/listing-offers";

const visibleIds = await websiteVisibleIdSet();
const listedMacModels = filterVisibleById(macModels, visibleIds);
const air = listedMacModels.filter((m) => m.family === "Air");
const pro = listedMacModels.filter((m) => m.family === "Pro");
const accessories = homeMacAccessories();
const chooseAir =
  air.find((x) => x.id === "macbook-air-13-m5") ||
  air.find((x) => x.id === "macbook-neo-13") ||
  air[0] ||
  macModels.find((x) => x.family === "Air") ||
  macModels[0];
const choosePro =
  pro.find((x) => x.id === "macbook-pro-14-m5") ||
  pro[0] ||
  macModels.find((x) => x.family === "Pro") ||
  macModels[0];
const chooseAirImg = (() => {
  const img = getMacImage(chooseAir.id, defaultMacColour(chooseAir), "product", chooseAir.name);
  const src = cardImageSrc(chooseAir.id, img.src);
  return { ...img, src, srcWebp: src.endsWith(".webp") ? src : img.srcWebp };
})();
const chooseProImg = (() => {
  const img = getMacImage(choosePro.id, defaultMacColour(choosePro), "product", choosePro.name);
  const src = cardImageSrc(choosePro.id, img.src);
  return { ...img, src, srcWebp: src.endsWith(".webp") ? src : img.srcWebp };
})();
const preloadMacCards = [
  chooseAirImg.src,
  chooseProImg.src,
  ...listedMacModels.slice(0, 6).map((m) => {
    const img = getMacImage(m.id, defaultMacColour(m), "product", m.name);
    return cardImageSrc(m.id, img.src);
  }),
].filter((src, i, arr) => src && arr.indexOf(src) === i);
const liveCatalog = await livePricedCatalog();
const macCardRows = listingRows(listedMacModels.slice(0, 8), liveCatalog, {
  href: (model) => `/mac/${model.id}`,
  fallbackPrice: (model) => model.basePriceKes,
});
const hubProducts = liveCatalog.filter((p) => p.group === "Mac" && p.showOnWebsite !== false);
const hubSeo = buildCategorySeo({ label: "Mac", path: "/mac", products: hubProducts });
const hubFrom = formatKesSeoHub(hubSeo.fromKes);
---

<BaseLayout
  title="MacBook Price in Kenya | MacBook Air & Pro M5 | Gadget Hub"
  description={`MacBook prices in Nairobi from ${hubFrom}: MacBook Air and MacBook Pro, M1 to M5. New (1-year warranty) or Ex-UK. Pay by M-Pesa or Lipa Mdogo Mdogo at Gadget Hub.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(hubSeo.jsonLd)} />
  </Fragment>
  <Fragment slot="head">
    {
      preloadMacCards.map((href, i) =>
        i < 2 ? (
          <link rel="preload" as="image" href={href} type="image/webp" fetchpriority="high" />
        ) : (
          <link rel="preload" as="image" href={href} type="image/webp" />
        ),
      )
    }
  </Fragment>
  <CategoryHero category="macbook" heading="MacBook prices in Kenya" />

  <section class="mac-choose container">
    <h2>Choose your MacBook</h2>
    <div class="mac-choose__grid">
      <a class="mac-choose__card" href="/mac/shop?family=Air">
        <MacStage
          src={chooseAirImg.src}
          srcWebp={chooseAirImg.srcWebp}
          alt={chooseAirImg.alt}
          width={chooseAirImg.width}
          height={Math.round(chooseAirImg.width * 0.625)}
          eager
          highPriority
        />
        <h3>MacBook Air</h3>
        <p>Thin, silent, all-day battery. From students to everyday work.</p>
        <span class="mac-choose__price">{formatKes(air.length ? Math.min(...air.map((m) => m.basePriceKes)) : 0)}</span>
      </a>
      <a class="mac-choose__card" href="/mac/shop?family=Pro">
        <MacStage
          src={chooseProImg.src}
          srcWebp={chooseProImg.srcWebp}
          alt={chooseProImg.alt}
          width={chooseProImg.width}
          height={Math.round(chooseProImg.width * 0.625)}
          eager
          highPriority
        />
        <h3>MacBook Pro</h3>
        <p>XDR screens, active cooling, ports for real work.</p>
        <span class="mac-choose__price">{formatKes(pro.length ? Math.min(...pro.map((m) => m.basePriceKes)) : 0)}</span>
      </a>
    </div>
  </section>

  <div class="container">
    <MacQuiz />
  </div>

  <section class="mac-grid-wrap container" id="mac-shop-preview">
    <header class="mac-grid-wrap__head">
      <h2>Shop by generation</h2>
      <p>{macConfig.samplePriceDisclaimer}</p>
    </header>
    <div class="mac-chips" role="group" aria-label="Filter by chip">
      {(["M5", "M4", "M3", "M2", "M1"] as const).map((g) => (
        <a class="mac-chip" href={`/mac/shop?chip=${g}`}>{g}</a>
      ))}
      <a class="mac-chip mac-chip--all" href="/mac/shop">All</a>
    </div>
    <ul class="mac-grid">
      {macCardRows.map(({ item: m, offer }, i) => (
        <li>
          <MacCard model={m} eager={i < 8} channel={offer.channel} priceKes={offer.priceKes || m.basePriceKes} coloursInStock={offer.colours} href={offer.href} />
        </li>
      ))}
    </ul>
    <p class="mac-grid-wrap__more">
      <a href="/mac/shop">See all {listedMacModels.length} MacBooks ›</a>
    </p>
  </section>

  <section class="mac-plan container">
    <h2>Plan the purchase</h2>
    <p class="mac-plan__lede">Sample calculators. Final terms are confirmed in the shop.</p>
    <div class="mac-plan__grid">
      <MacLipaCalc modelId="macbook-air-13-m4" />
      <MacTradeIn modelId="macbook-air-13-m2" />
    </div>
  </section>

  <section class="mac-windows container">
    <h2>Switching from Windows</h2>
    <p>
      Excel and Word work. Most apps have a Mac version. A few Windows-only programs will not run -
      ask us before you buy. We can help move your files across when you collect.
    </p>
    <a
      class="btn btn--secondary"
      href={`https://wa.me/${macConfig.whatsapp}?text=${encodeURIComponent("Hi Gadget Hub - I'm switching from Windows to Mac. Can you help?")}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Ask about switching
    </a>
  </section>

  <section class="mac-acc container">
    <h2>Accessories for Mac</h2>
    <p class="mac-acc__lede">Fit rules filter on each product page.</p>
    <ul class="mac-acc__grid">
      {
        accessories.map((a) => (
          <li>
            <a href={a.href}>
              <strong>{a.name}</strong>
              <span>{a.blurb}</span>
              {a.priceKes > 0 ? <b>{formatKes(a.priceKes)}</b> : <b>See category</b>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mac-corp container">
    <h2>Equipping a team?</h2>
    <p>We invoice companies and can prepare machines in bulk.</p>
    <a
      class="btn btn--primary"
      href={`https://wa.me/${macConfig.whatsapp}?text=${encodeURIComponent("Corporate Mac order")}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      WhatsApp corporate order
    </a>
  </section>

  <section class="mac-visit container">
    <h2>Visit the shop</h2>
    <p>
      {macConfig.address.line}, {macConfig.address.city}. Hours: {macConfig.address.hours}.
      Come in and type on one.
    </p>
    <a
      class="btn btn--primary"
      href={`https://wa.me/${macConfig.whatsapp}?text=${encodeURIComponent("Hi Gadget Hub - I want to see a MacBook.")}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      WhatsApp {macConfig.whatsappDisplay}
    </a>
  </section>
</BaseLayout>

<style>
  .mac-choose,
  .mac-grid-wrap,
  .mac-plan,
  .mac-windows,
  .mac-acc,
  .mac-corp,
  .mac-visit {
    padding-block: var(--mac-section-gap);
  }
  .mac-choose h2,
  .mac-grid-wrap h2,
  .mac-plan h2,
  .mac-windows h2,
  .mac-acc h2,
  .mac-corp h2,
  .mac-visit h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
  }
  .mac-choose__grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .mac-choose__card {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.75rem;
    border-radius: 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    min-width: 0;
    transition:
      transform var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease);
  }
  @media (min-width: 48rem) {
    .mac-choose__grid {
      gap: 1.25rem;
    }
    .mac-choose__card {
      padding: 1rem;
      border-radius: 1.5rem;
    }
  }
  .mac-choose__card:hover {
    transform: translateY(-6px);
    border-color: var(--color-fg);
    color: inherit;
  }
  .mac-choose__card :global(.mstage__img) {
    transition: transform var(--duration) var(--ease-out);
  }
  .mac-choose__card:hover :global(.mstage__img) {
    transform: scale(1.05);
  }
  .mac-choose__card h3 {
    margin: 0.65rem 0 0.25rem;
    letter-spacing: -0.02em;
    font-size: clamp(0.95rem, 2.8vw, 1.35rem);
  }
  .mac-choose__card p {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: clamp(0.68rem, 2vw, 0.875rem);
    line-height: 1.35;
  }
  .mac-choose__price {
    display: inline-block;
    margin-top: 0.55rem;
    font-weight: 600;
    font-size: clamp(0.75rem, 2.2vw, 1rem);
  }
  .mac-grid-wrap__head p,
  .mac-plan__lede,
  .mac-acc__lede,
  .mac-windows p,
  .mac-corp p,
  .mac-visit p {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 40rem;
  }
  .mac-chips {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.4rem;
    margin: 1.25rem 0 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.15rem;
  }
  .mac-chips::-webkit-scrollbar {
    display: none;
  }
  .mac-chip {
    flex: 0 0 auto;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    text-decoration: none;
    color: inherit;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .mac-chip:hover,
  .mac-chip--all {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .mac-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 64rem) {
    .mac-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .mac-grid-wrap__more {
    margin: 1.5rem 0 0;
  }
  .mac-plan__grid {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .mac-plan__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .mac-windows .btn,
  .mac-corp .btn,
  .mac-visit .btn {
    margin-top: 1rem;
  }
  .mac-acc__grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .mac-acc__grid a {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1rem;
    height: 100%;
  }
  .mac-acc__grid span {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
  .mac-acc__grid b {
    font-size: var(--text-sm);
  }
  .mac-visit,
  .mac-corp {
    border-top: 1px solid var(--color-border);
  }
  @media (prefers-reduced-motion: reduce) {
    .mac-choose__card:hover,
    .mac-choose__card:hover :global(.mstage__img) {
      transform: none;
    }
  }
</style>
