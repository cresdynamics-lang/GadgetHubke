---
/**
 * Watch PDP - sticky 4:3 viewer + buy panel + feel + specs/FAQ.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import WatchStage from "../../components/watch/WatchStage.astro";
import WatchFeel from "../../components/watch/WatchFeel.astro";
import WatchLipaCalc from "../../components/watch/WatchLipaCalc.astro";
import WatchTradeIn from "../../components/watch/WatchTradeIn.astro";
import {
  watchModels,
  getWatchModel,
  getWatchImage,
  watchViewerTabs,
  relatedWatchModels,
  formatKes,
  watchConfigurePrice,
  lipaMonthly,
  watchConfig,
  colourHex,
  colourLabel,
  colourMaterial,
  bandsForWatch,
  accessoriesForWatch,
  watchBuyingNotes,
  watchFaq,
} from "../../lib/watch";

export function getStaticPaths() {
  return watchModels.map((m) => ({ params: { model: m.id } }));
}

const model = getWatchModel(Astro.params.model!);
if (!model) return Astro.redirect("/watch");

const tabs = watchViewerTabs(model);
const img = tabs[0] || getWatchImage(model.id, "main", model.name);
const price = watchConfigurePrice(model);
const lipa = lipaMonthly(price.kes);
const notes = watchBuyingNotes(model);
const faq = watchFaq();
const bands = bandsForWatch(model);
const fits = accessoriesForWatch(model).filter((a) => a.category !== "cross");
const related = relatedWatchModels(model, watchModels);
const materials = model.materials;

const heroStart = getWatchImage(model.id, "hero_startframe", model.name);
const heroEnd = getWatchImage(model.id, "hero_endframe", model.name);
const showModelHero = model.isNew && !heroStart.fallback && !heroEnd.fallback;
---

<BaseLayout title={`${model.name} - GadgetHub`} description={model.tagline}>
  <article class="wpdp">
    {showModelHero ? (
      <section class="wpdp-hero" data-model-hero>
        <img data-mh-start src={heroStart.src} alt="" width={heroStart.width} height={Math.round(heroStart.width * 0.75)} fetchpriority="high" />
        <img data-mh-end src={heroEnd.src} alt="" width={heroEnd.width} height={Math.round(heroEnd.width * 0.75)} fetchpriority="high" />
      </section>
    ) : null}

    <div class="container wpdp__top">
      <div class="wpdp__viewer" data-viewer>
        <div class="wpdp__stage" data-stage>
          <img data-viewer-img src={img.src} alt={img.alt} width="1200" height="900" />
        </div>
        <div class="wpdp__tabs" role="tablist">
          {tabs.map((t, i) => (
            <button type="button" role="tab" class:list={{ "is-active": i === 0 }} data-tab={t.id} data-src={t.src} data-alt={t.alt}>
              {t.label}
            </button>
          ))}
        </div>
        <p class="wpdp__fine">Hover to zoom on desktop. Click for lightbox.</p>

        <div class="wpdp__scale" aria-hidden="true">
          <svg viewBox="0 0 320 80" width="320" height="80">
            <rect x="20" y="20" width={model.defaultCaseMm * 2.2} height={model.defaultCaseMm * 1.1} rx="12" fill="none" stroke="#1d1d1f" stroke-width="2" />
            <circle cx="260" cy="40" r="14" fill="none" stroke="#6e6e73" stroke-width="2" />
            <text x="20" y="72" font-size="11" fill="#6e6e73">{model.defaultCaseMm} mm case vs coin</text>
          </svg>
        </div>

        <div class="wpdp__wrist">
          <label>
            Wrist circumference (cm)
            <input type="number" min="13" max="24" step="0.5" value="17" data-wrist />
          </label>
          <p data-wrist-result>About 17 cm - suggest {model.defaultCaseMm < 44 ? "smaller" : "larger"} case family. Check Apple's size guide.</p>
        </div>
      </div>

      <div class="wpdp__buy" data-buy>
        <p class="wpdp__pills">
          <span>{model.year}</span>
          {model.isNew ? <span>New</span> : <span>Also in stock</span>}
          {model.specialBandIncluded ? <span>Special band included</span> : null}
          {model.checkFinalSpecs ? <span>Check final specs</span> : null}
        </p>
        <h1>{model.name}</h1>
        <p class="wpdp__tagline">{model.tagline}</p>
        <p class="wpdp__who">{model.whoItSuits}</p>

        <fieldset>
          <legend>Case size</legend>
          <div class="wpdp__opts" data-size>
            {model.caseSizesMm.map((s) => (
              <button type="button" class="is-active" data-size-val={s}>{s} mm</button>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend>Material</legend>
          <div class="wpdp__opts" data-material>
            {materials.map((m, i) => (
              <button type="button" class:list={{ "is-active": i === 0 }} data-material-val={m} data-step={watchConfig.materialStepKes[m]}>
                {m}{watchConfig.materialStepKes[m] ? ` (+${formatKes(watchConfig.materialStepKes[m]).replace("KES ", "")})` : ""}
              </button>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend>Colour</legend>
          <div class="wpdp__swatches">
            {model.colours.map((c, i) => (
              <button
                type="button"
                class:list={{ "is-active": i === 0 }}
                data-watch-swatch
                data-colour={c}
                data-label={colourLabel(c)}
                style={`--swatch:${colourHex(c)}`}
                aria-label={colourLabel(c)}
              >
                <span />
                <em>{colourLabel(c)}</em>
              </button>
            ))}
          </div>
        </fieldset>

        {model.cellularAvailable ? (
          <fieldset>
            <legend>Connectivity</legend>
            <div class="wpdp__opts" data-conn>
              <button type="button" class="is-active" data-cellular="0">GPS</button>
              <button type="button" data-cellular="1">GPS + Cellular (+{formatKes(watchConfig.cellularStepKes)})</button>
            </div>
            <p class="wpdp__fine">{watchConfig.cellularKenyaNote}</p>
          </fieldset>
        ) : null}

        <fieldset>
          <legend>Band</legend>
          <div class="wpdp__bands">
            <button type="button" class="is-active" data-pdp-band="" data-band-kes="0">Band in the pack</button>
            {bands.map((b) => (
              <button type="button" data-pdp-band={b.id} data-band-kes={b.priceKes} data-band-name={b.name}>
                {b.name} · {formatKes(b.priceKes)}
              </button>
            ))}
          </div>
        </fieldset>

        <div class="wpdp__price">
          <p><span data-price>{formatKes(price.kes)}</span></p>
          <p data-lipa>or {formatKes(lipa.monthlyKes)} / mo</p>
          <p class="wpdp__fine">{watchConfig.samplePriceDisclaimer}</p>
        </div>

        <p class="wpdp__stock"><span class="wpdp__dot" /> In stock (sample) · Collect today in Nairobi</p>

        <div class="wpdp__cta">
          <button
            type="button"
            class="btn btn--primary"
            data-watch-bag
            data-id={model.id}
            data-name={model.name}
            data-size={`${model.defaultCaseMm}mm`}
            data-material={materials[0]}
            data-colour={colourLabel(model.defaultColour)}
            data-connectivity="GPS"
            data-band="Band in the pack"
            data-kes={price.kes}
            data-image={img.src}
          >
            Add to bag
          </button>
          <a class="btn btn--whatsapp" data-wa href={`https://wa.me/${watchConfig.whatsapp}`} target="_blank" rel="noopener noreferrer">
            Ask on WhatsApp
          </a>
        </div>

        <ul class="wpdp__highlights">
          <li><strong>{model.displayType.split(" ").slice(0, 2).join(" ")}</strong><span>Display</span></li>
          <li><strong>{model.chip || "Check"}</strong><span>Chip</span></li>
          <li><strong>{model.batteryHours ?? "Check"}{model.batteryHours ? " h" : ""}</strong><span>Battery</span></li>
          <li><strong>{model.weightG ?? "-"}{model.weightG ? " g" : ""}</strong><span>Weight</span></li>
        </ul>

        <div class="wpdp__why">
          <h2>Why people choose this one</h2>
          <ul>{model.whyChoose.map((line) => <li>{line}</li>)}</ul>
        </div>
      </div>
    </div>

    <section class="container wpdp__block">
      <h2>Design and materials</h2>
      <p>
        {model.dimensionsMm
          ? `About ${model.dimensionsMm.w} × ${model.dimensionsMm.h} × ${model.dimensionsMm.d} mm.`
          : "Dimensions - check final specs."}
        {model.weightG ? ` About ${model.weightG} g.` : ""}
      </p>
      {(() => {
        const d = getWatchImage(model.id, "design", model.name);
        return !d.fallback ? <WatchStage src={d.src} srcWebp={d.srcWebp} alt={d.alt} width={1100} height={825} /> : null;
      })()}
    </section>

    <WatchFeel model={model} />

    <section class="container wpdp__block">
      <h2>Buying notes for this model</h2>
      <ul class="wpdp__notes">
        {notes.map((n) => (
          <li><h3>{n.title}</h3><p>{n.body}</p></li>
        ))}
      </ul>
    </section>

    <section class="container wpdp__block">
      <h2>Full specifications</h2>
      <p class="wpdp__fine">{watchConfig.appleSpecsFootnote}</p>
      <details class="wpdp__acc" open>
        <summary>Display {model.checkFinalSpecs ? "· check" : ""}</summary>
        <table>
          <tr><th>Type</th><td>{model.displayType}</td></tr>
          <tr><th>Always-On</th><td>{model.alwaysOn == null ? "Check final specs" : model.alwaysOn ? "Yes" : "No"}</td></tr>
          <tr><th>Brightness</th><td>{model.brightnessNits != null ? `${model.brightnessNits} nits` : "Check final specs"}</td></tr>
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Chip and performance</summary>
        <table>
          <tr><th>Chip</th><td>{model.chip || "Check final specs"}</td></tr>
          <tr><th>Double tap</th><td>{model.doubleTap == null ? "Check" : model.doubleTap ? "Yes" : "No"}</td></tr>
          <tr><th>Wrist flick</th><td>{model.wristFlick == null ? "Check" : model.wristFlick ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Health sensors</summary>
        <table>
          {Object.entries(model.health).map(([k, v]) => (
            <tr><th>{k}</th><td>{v == null ? "-" : v ? "Yes" : "No"}</td></tr>
          ))}
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Safety</summary>
        <table>
          {Object.entries(model.safety).map(([k, v]) => (
            <tr><th>{k}</th><td>{v == null ? "-" : v ? "Yes" : "No"}</td></tr>
          ))}
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Water resistance</summary>
        <table>
          <tr><th>Rating</th><td>{model.waterM} m</td></tr>
          <tr><th>Depth gauge</th><td>{model.depthGaugeM != null ? `${model.depthGaugeM} m` : "No"}</td></tr>
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Connectivity</summary>
        <table>
          <tr><th>Cellular</th><td>{model.cellularAvailable ? "Available" : "No"}</td></tr>
          <tr><th>5G</th><td>{model.fiveG == null ? "Check" : model.fiveG ? "Yes" : "No"}</td></tr>
          <tr><th>Dual-frequency GPS</th><td>{model.dualFrequencyGps == null ? "Check" : model.dualFrequencyGps ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Battery and charging</summary>
        <table>
          <tr><th>Claim</th><td>{model.batteryHours != null ? `${model.batteryHours} h` : "Check final specs"}</td></tr>
          <tr><th>Low Power</th><td>{model.lowPowerHours != null ? `${model.lowPowerHours} h` : "Check"}</td></tr>
          <tr><th>Fast charging</th><td>{model.fastCharging == null ? "Check" : model.fastCharging ? "Yes" : "No"}</td></tr>
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Case and weight</summary>
        <table>
          <tr><th>Size</th><td>{model.defaultCaseMm} mm</td></tr>
          <tr><th>Materials</th><td>{model.materials.join(", ")}</td></tr>
          <tr><th>Weight</th><td>{model.weightG != null ? `${model.weightG} g` : "Check"}</td></tr>
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Colours and materials</summary>
        <table>
          <tr><th>Colours</th><td>{model.colours.map(colourLabel).join(", ")}</td></tr>
        </table>
      </details>
      <details class="wpdp__acc">
        <summary>Software</summary>
        <table>
          <tr><th>Compatibility</th><td>Requires iPhone - check Apple's list for watchOS and iPhone requirements.</td></tr>
        </table>
      </details>
    </section>

    {related.length ? (
      <section class="container wpdp__block">
        <h2>Compare with</h2>
        <div class="wpdp__related">
          {related.map((r) => {
            const rimg = getWatchImage(r.id, "main", r.name);
            return (
              <a href={`/watch/compare?ids=${encodeURIComponent(`${model.id},${r.id}`)}`}>
                <WatchStage src={rimg.src} srcWebp={rimg.srcWebp} alt={rimg.alt} width={560} height={420} />
                <span>{r.name}</span>
                <em>From {formatKes(r.basePriceKes)}</em>
              </a>
            );
          })}
        </div>
      </section>
    ) : null}

    {fits.length || bands.length ? (
      <section class="container wpdp__block">
        <h2>Fits this watch</h2>
        <ul class="wpdp__fits">
          {bands.slice(0, 6).map((b) => (
            <li><h3>{b.name}</h3><p>{b.blurb}</p><p>{formatKes(b.priceKes)} sample</p></li>
          ))}
          {fits.map((a) => (
            <li><h3>{a.name}</h3><p>{a.blurb}</p><p>{a.priceKes > 0 ? `${formatKes(a.priceKes)} sample` : "See category"}</p><a href={a.href}>View</a></li>
          ))}
        </ul>
      </section>
    ) : null}

    <section class="container wpdp__block">
      <h2>Questions people ask</h2>
      {faq.map((item) => (
        <details class="wpdp__acc"><summary>{item.q}</summary><p>{item.a}</p></details>
      ))}
    </section>

    <section class="container wpdp__tools">
      <WatchLipaCalc modelId={model.id} />
      <WatchTradeIn modelId={model.id} />
    </section>
  </article>

  <dialog class="wpdp-lb" data-lightbox aria-label="Full screen photo">
    <button type="button" data-lb-close aria-label="Close">Close</button>
    <img data-lb-img src={img.src} alt={img.alt} />
  </dialog>
</BaseLayout>

<script define:vars={{
  base: model.basePriceKes,
  cellStep: watchConfig.cellularStepKes,
  depositPct: watchConfig.lipa.depositDefaultPct,
  months: watchConfig.lipa.monthsDefault,
  waBase: `https://wa.me/${watchConfig.whatsapp}?text=`,
  modelName: model.name,
}}>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const state = { materialStep: 0, cellular: 0, bandKes: 0, colour: "", size: "", material: "", band: "Band in the pack", connectivity: "GPS" };
  const priceEl = document.querySelector("[data-price]");
  const lipaEl = document.querySelector("[data-lipa]");
  const bag = document.querySelector("[data-watch-bag]");
  const wa = document.querySelector("[data-wa]");
  const viewerImg = document.querySelector("[data-viewer-img]");
  const stage = document.querySelector("[data-stage]");

  function total() {
    return base + state.materialStep + (state.cellular ? cellStep : 0) + state.bandKes;
  }
  function refresh() {
    const kes = total();
    const monthly = Math.round((kes * (1 - depositPct / 100)) / months);
    if (priceEl) priceEl.textContent = `KES ${kes.toLocaleString("en-KE")}`;
    if (lipaEl) lipaEl.textContent = `or KES ${monthly.toLocaleString("en-KE")} / mo`;
    if (bag instanceof HTMLElement) {
      bag.setAttribute("data-kes", String(kes));
      bag.setAttribute("data-colour", state.colour || bag.getAttribute("data-colour") || "");
      bag.setAttribute("data-material", state.material || bag.getAttribute("data-material") || "");
      bag.setAttribute("data-size", state.size || bag.getAttribute("data-size") || "");
      bag.setAttribute("data-connectivity", state.connectivity);
      bag.setAttribute("data-band", state.band);
    }
    if (wa instanceof HTMLAnchorElement) {
      const msg = `Hi Gadget Hub - interested in ${modelName}, ${state.size || ""}, ${state.material || ""}, ${state.colour || ""}, ${state.connectivity}, band: ${state.band}. Sample KES ${kes.toLocaleString("en-KE")}.`;
      wa.href = waBase + encodeURIComponent(msg);
    }
  }

  document.querySelectorAll("[data-tab]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-tab]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      if (viewerImg instanceof HTMLImageElement) {
        viewerImg.src = btn.getAttribute("data-src") || viewerImg.src;
        viewerImg.alt = btn.getAttribute("data-alt") || viewerImg.alt;
      }
    });
  });

  document.querySelectorAll("[data-material-val]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-material-val]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      state.materialStep = Number(btn.getAttribute("data-step") || 0);
      state.material = btn.getAttribute("data-material-val") || "";
      refresh();
    });
  });

  document.querySelectorAll("[data-watch-swatch]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-watch-swatch]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      state.colour = btn.getAttribute("data-label") || "";
      if (viewerImg instanceof HTMLImageElement && !reduce) {
        viewerImg.animate([{ opacity: 1, transform: "scale(1)" }, { opacity: 0, transform: "scale(0.97)" }], { duration: 170, fill: "forwards" });
        window.setTimeout(() => {
          viewerImg.animate([{ opacity: 0, transform: "scale(0.97)" }, { opacity: 1, transform: "scale(1)" }], { duration: 170, fill: "forwards" });
        }, 180);
      }
      refresh();
    });
  });

  document.querySelectorAll("[data-cellular]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-cellular]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      state.cellular = Number(btn.getAttribute("data-cellular") || 0);
      state.connectivity = state.cellular ? "GPS + Cellular" : "GPS";
      refresh();
    });
  });

  document.querySelectorAll("[data-pdp-band]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-pdp-band]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      state.bandKes = Number(btn.getAttribute("data-band-kes") || 0);
      state.band = btn.getAttribute("data-band-name") || "Band in the pack";
      refresh();
    });
  });

  document.querySelectorAll("[data-size-val]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("[data-size-val]").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      state.size = `${btn.getAttribute("data-size-val")}mm`;
      refresh();
    });
  });

  bag?.addEventListener("click", () => {
    if (!(bag instanceof HTMLElement)) return;
    window.dispatchEvent(new CustomEvent("gh:bag-add", {
      detail: {
        id: bag.getAttribute("data-id"),
        name: bag.getAttribute("data-name"),
        size: bag.getAttribute("data-size"),
        material: bag.getAttribute("data-material"),
        colour: bag.getAttribute("data-colour"),
        connectivity: bag.getAttribute("data-connectivity"),
        band: bag.getAttribute("data-band"),
        kes: Number(bag.getAttribute("data-kes") || 0),
        image: bag.getAttribute("data-image"),
      },
    }));
  });

  // Zoom
  if (stage instanceof HTMLElement && viewerImg instanceof HTMLImageElement) {
    stage.addEventListener("mousemove", (e) => {
      if (window.matchMedia("(max-width: 63.99rem)").matches || reduce) return;
      const rect = stage.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      viewerImg.style.transformOrigin = `${x}% ${y}%`;
      viewerImg.style.transform = "scale(2)";
    });
    stage.addEventListener("mouseleave", () => { viewerImg.style.transform = "scale(1)"; });
    stage.addEventListener("click", () => {
      const lb = document.querySelector("[data-lightbox]");
      const lbImg = document.querySelector("[data-lb-img]");
      if (lb instanceof HTMLDialogElement && lbImg instanceof HTMLImageElement) {
        lbImg.src = viewerImg.src;
        lbImg.alt = viewerImg.alt;
        lb.showModal();
      }
    });
  }
  document.querySelector("[data-lb-close]")?.addEventListener("click", () => {
    const lb = document.querySelector("[data-lightbox]");
    if (lb instanceof HTMLDialogElement) lb.close();
  });

  const wrist = document.querySelector("[data-wrist]");
  const wristResult = document.querySelector("[data-wrist-result]");
  wrist?.addEventListener("input", () => {
    const cm = wrist instanceof HTMLInputElement ? Number(wrist.value) : 17;
    if (wristResult) {
      wristResult.textContent =
        cm < 16
          ? `About ${cm} cm - smaller case (40 - 42 mm) often feels better. Check Apple's size guide.`
          : cm > 18.5
            ? `About ${cm} cm - larger case (44 - 46 mm or Ultra 49 mm) often reads easier. Check Apple's size guide.`
            : `About ${cm} cm - either size family can work. Check Apple's size guide.`;
    }
  });

  // Model hero intro
  const mhEnd = document.querySelector("[data-mh-end]");
  if (mhEnd instanceof HTMLElement) {
    mhEnd.style.opacity = reduce ? "1" : "0";
    if (!reduce) mhEnd.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 1400, fill: "forwards" });
  }

  // Init material/size from active
  const matBtn = document.querySelector("[data-material-val].is-active");
  if (matBtn) {
    state.materialStep = Number(matBtn.getAttribute("data-step") || 0);
    state.material = matBtn.getAttribute("data-material-val") || "";
  }
  const sizeBtn = document.querySelector("[data-size-val].is-active");
  if (sizeBtn) state.size = `${sizeBtn.getAttribute("data-size-val")}mm`;
  const colBtn = document.querySelector("[data-watch-swatch].is-active");
  if (colBtn) state.colour = colBtn.getAttribute("data-label") || "";
  refresh();
</script>

<style>
  .wpdp-hero {
    position: relative; min-height: 50vh; background: #f5f5f7;
    display: grid; place-items: center; overflow: hidden;
  }
  .wpdp-hero img {
    grid-area: 1 / 1; width: min(70vw, 40rem); height: auto; mix-blend-mode: multiply;
  }
  .wpdp__top {
    display: grid; gap: 2rem; padding-block: 2rem;
  }
  @media (min-width: 64rem) {
    .wpdp__top { grid-template-columns: 1.1fr 0.9fr; align-items: start; }
    .wpdp__viewer { position: sticky; top: calc(var(--header-height) + 1rem); }
  }
  .wpdp__stage {
    aspect-ratio: 4 / 3; background: #f5f5f7; border-radius: 1.5rem;
    display: grid; place-items: center; overflow: hidden; cursor: zoom-in;
  }
  .wpdp__stage img {
    width: 88%; height: auto; mix-blend-mode: multiply; transition: transform 120ms ease;
  }
