---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { whatsappUrl } from "../../lib/site";

const orderId = Astro.url.searchParams.get("order") || "";
const wa = whatsappUrl(
  orderId
    ? `Hi Gadget Hub - checkout for ${orderId} didn't complete. Please help.`
    : "Hi Gadget Hub - my checkout didn't complete.",
);
---

<BaseLayout
  title="Checkout cancelled - GadgetHub"
  description="Payment was cancelled or didn’t finish. You can try again."
>
  <section class="cancel container">
    <p class="cancel__eyebrow">Checkout</p>
    <h1>Payment not completed</h1>
    <p class="cancel__lede">
      No charge was kept for this attempt{orderId ? ` (${orderId})` : ""}. You can return to checkout and pay with M-Pesa or card.
    </p>
    <div class="cancel__actions">
      <a class="btn btn--primary" href="/checkout">Back to checkout</a>
      <a class="btn btn--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp help</a>
      <a class="btn btn--secondary" href="/shop">Continue shopping</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cancel {
    padding-block: var(--space-10) calc(var(--space-12) + var(--fab-clearance));
    max-width: 32rem;
  }

  .cancel__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .cancel h1 {
    margin: 0 0 var(--space-2);
    letter-spacing: -0.03em;
  }

  .cancel__lede {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  .cancel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: var(--space-6);
  }
</style>
