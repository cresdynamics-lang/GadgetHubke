---
/**
 * Successful payment page — only after order status is `paid`.
 * Google Tag purchase URL: https://gadgethubke.com/checkout/success
 * Customers are sent here only after M-Pesa payment succeeds; this page
 * also re-checks the order and redirects away if payment is not confirmed.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { whatsappUrl } from "../../lib/site";
import { finishSplitModelIds } from "../../lib/ads/catalog-feed";
import identifiers from "../../lib/ads/product-identifiers.json";

/** Google Merchant Center account for Google Customer Reviews. */
const GCR_MERCHANT_ID = 5876471550;
// Only barcodes that have been filled in; the survey's product list is optional.
const gtins = Object.fromEntries(
  Object.entries(identifiers as Record<string, { gtin?: string }>)
    .map(([id, row]) => [id, (row.gtin || "").replace(/\s+/g, "")])
    .filter(([, gtin]) => /^\d{8,14}$/.test(gtin)),
);


const orderId = Astro.url.searchParams.get("order") || "";
const wa = whatsappUrl(
  orderId
    ? `Hi Gadget Hub - I paid for order ${orderId}. Please confirm.`
    : "Hi Gadget Hub - I just checked out and need help.",
);
---

<BaseLayout
  title="Payment successful - GadgetHub"
  description="Your payment was received. We’ll confirm your order shortly."
>
  <section
    class="ok container"
    data-success
    data-order-id={orderId}
    data-paid="0"
    data-finish-split={JSON.stringify(finishSplitModelIds())}
    data-gtins={JSON.stringify(gtins)}
    data-gcr-merchant={GCR_MERCHANT_ID}
    hidden
  >
    <p class="ok__eyebrow">Payment successful</p>
    <h1 data-success-title>Thank you — payment received</h1>
    <p class="ok__lede" data-success-lede>
      Your order is confirmed. We’ll follow up on WhatsApp or email for pickup / delivery.
    </p>
    <p class="ok__meta" data-success-meta></p>
    <div class="ok__actions">
      <a class="btn btn--primary" data-receipt-download hidden href="#">Download receipt PDF</a>
      <a class="btn btn--whatsapp" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp help</a>
      <a class="btn btn--secondary" href="/account">Account</a>
      <a class="btn btn--secondary" href="/accessories">Continue shopping</a>
    </div>
  </section>

  <section class="ok container" data-success-wait>
    <p class="ok__eyebrow">Checkout</p>
    <h1>Confirming your payment…</h1>
    <p class="ok__lede">
      Please wait a moment while we verify the payment with the bank.
    </p>
    <p class="ok__meta" data-wait-meta>Checking order…</p>
  </section>
</BaseLayout>

<script>
  import { formatKes } from "../../lib/checkout/bag";
  import { RECENT_ORDER_KEY } from "../../lib/checkout/types";
  import { feedItemId } from "../../lib/ads/feed-item-id";

  const root = document.querySelector("[data-success]");
  const wait = document.querySelector("[data-success-wait]");
  const meta = document.querySelector("[data-success-meta]");
  const waitMeta = document.querySelector("[data-wait-meta]");

  const params = new URLSearchParams(location.search);
  const orderId =
    root?.getAttribute("data-order-id") ||
    params.get("order") ||
    localStorage.getItem(RECENT_ORDER_KEY) ||
    "";

  function goCancel(reason) {
    const q = new URLSearchParams();
    if (orderId) q.set("order", orderId);
    if (reason) q.set("reason", reason);
    location.replace(`/checkout/cancel?${q.toString()}`);
  }

  function showPaid(order) {
    if (wait) wait.hidden = true;
    if (root instanceof HTMLElement) {
      root.hidden = false;
      root.dataset.paid = "1";
    }
    // Canonical success URL for ads tags (paid confirmed)
    const next = new URL(location.href);
    next.searchParams.set("order", order.id);
    next.searchParams.set("paid", "1");
    history.replaceState({}, "", next.pathname + next.search);

    const lipa = order.intent === "lipa";
    const titleEl = document.querySelector("[data-success-title]");
    const ledeEl = document.querySelector("[data-success-lede]");
    if (titleEl) titleEl.textContent = lipa ? "Lipa deposit received" : "Thank you — payment received";
    if (ledeEl) {
      ledeEl.textContent = lipa
        ? `We received your Lipa Mdogo Mdogo deposit of ${formatKes(order.subtotalKes)}. Remaining ${formatKes(order.lipa?.remainingKes || 0)} over ${order.lipa?.months || 6} months after we confirm the schedule.`
        : "Your purchase is confirmed. We’ll follow up on WhatsApp or email for pickup / delivery.";
    }
    if (meta) {
      meta.textContent = [
        `Order ${order.id}`,
        lipa ? "Deposit paid" : "Paid",
        formatKes(order.subtotalKes),
        order.paymentMethod === "card" ? "Card" : order.paymentMethod === "mpesa" ? "M-Pesa" : "",
        order.customer?.fulfillment === "delivery" ? "Delivery" : "Pickup",
        order.mock ? "Sandbox" : "",
      ]
        .filter(Boolean)
        .join(" · ");
    }
    const receiptA = document.querySelector("[data-receipt-download]");
    if (receiptA instanceof HTMLAnchorElement && order.receiptUrl) {
      receiptA.href = order.receiptUrl;
      receiptA.hidden = false;
    }
    trackPurchase(order);
  }

  const finishSplit = JSON.parse(root?.getAttribute("data-finish-split") || "[]");
  const gtins = JSON.parse(root?.getAttribute("data-gtins") || "{}");
  /** Google feed id (Mac/iPad split by finish); Meta's catalogue splits iPhones only. */
  const googleId = (i) => feedItemId(i, finishSplit);
  const metaId = (i) => feedItemId(i);

  /** Date in Nairobi, n days from today, as YYYY-MM-DD. */
  function nairobiDate(days) {
    const d = new Date(Date.now() + days * 86400000);
    return new Intl.DateTimeFormat("en-CA", { timeZone: "Africa/Nairobi" }).format(d);
  }

  /** Google Customer Reviews opt-in: full purchases with an email only, once per order. */
  function renderReviewOptIn(order) {
    const email = String(order.customer?.email || "").trim();
    if (!email || order.intent === "lipa" || order.mock) return;
    const key = `gh-gcr-${order.id}`;
    if (sessionStorage.getItem(key)) return;
    sessionStorage.setItem(key, "1");
    const products = (Array.isArray(order.items) ? order.items : [])
      .map((i) => gtins[googleId(i)])
      .filter(Boolean)
      .map((gtin) => ({ gtin }));
    window.renderOptIn = function () {
      window.gapi.load("surveyoptin", function () {
        window.gapi.surveyoptin.render({
          merchant_id: Number(root?.getAttribute("data-gcr-merchant")),
          order_id: String(order.id),
          email,
          delivery_country: "KE",
          // Pickup is same day in Nairobi; delivery is priced by location, so allow three days.
          estimated_delivery_date: nairobiDate(order.customer?.fulfillment === "delivery" ? 3 : 0),
          ...(products.length ? { products } : {}),
        });
      });
    };
    const s = document.createElement("script");
    s.src = "https://apis.google.com/js/platform.js?onload=renderOptIn";
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  }

  function trackPurchase(order) {
    if (!order || order.status !== "paid") return;
    renderReviewOptIn(order);
    // Sandbox (mock) payments are not sales: keep them out of Meta, Google Ads and GA4.
    if (order.mock) return;
    const key = `gh-purchase-${order.id}`;
    if (sessionStorage.getItem(key)) return;
    const items = Array.isArray(order.items) ? order.items : [];
    const value = Number(order.subtotalKes) || 0;
    const contentIds = items.map(metaId).filter(Boolean);

    if (typeof window.fbq === "function" && contentIds.length) {
      window.fbq("track", "Purchase", {
        content_ids: contentIds,
        content_type: "product",
        value,
        currency: "KES",
        contents: items.map((i) => ({
          id: metaId(i),
          quantity: Number(i.qty) || 1,
          item_price: Number(i.kes) || 0,
        })),
        num_items: items.reduce((n, i) => n + (Number(i.qty) || 1), 0),
      });
    }

    if (typeof window.ghTrack === "function") {
      window.ghTrack("purchase", {
        ecommerce: {
          transaction_id: String(order.id),
          value,
          currency: "KES",
          payment_type: order.paymentMethod === "card" ? "card" : order.paymentMethod === "mpesa" ? "mpesa" : String(order.paymentMethod || ""),
          items: items.map((i) => ({
            item_id: googleId(i),
            item_name: String(i.name || ""),
            item_variant: [i.storage, i.colour, i.channel].filter(Boolean).join(" / "),
            price: Number(i.kes) || 0,
            quantity: Number(i.qty) || 1,
          })),
        },
      });
    }

    if (typeof window.gtag === "function") {
      window.gtag("event", "purchase", {
        transaction_id: String(order.id),
        value,
        currency: "KES",
        items: items.map((i) => ({
          item_id: googleId(i),
          item_name: String(i.name || ""),
          price: Number(i.kes) || 0,
          quantity: Number(i.qty) || 1,
        })),
      });
    }

    sessionStorage.setItem(key, "1");
  }

  async function fetchOrder() {
    const res = await fetch(`/api/checkout/order?id=${encodeURIComponent(orderId)}`);
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Order not found");
    return data.order;
  }

  async function confirmPaid() {
    if (!orderId) {
      goCancel("missing_order");
      return;
    }
    localStorage.setItem(RECENT_ORDER_KEY, orderId);

    const maxAttempts = 40; // ~60s at 1.5s
    for (let i = 0; i < maxAttempts; i++) {
      try {
        const order = await fetchOrder();
        if (order.status === "paid") {
          showPaid(order);
          return;
        }
        if (order.status === "failed" || order.status === "cancelled") {
          goCancel(order.status);
          return;
        }
        if (waitMeta) {
          waitMeta.textContent = `Waiting for payment confirmation… (${order.status || "pending"})`;
        }
      } catch {
        if (waitMeta) waitMeta.textContent = "Looking up your order…";
      }
      await new Promise((r) => setTimeout(r, 1500));
    }
    goCancel("timeout");
  }

  confirmPaid();
</script>

<style>
  .ok {
    padding-block: var(--space-10) calc(var(--space-12) + var(--fab-clearance));
    max-width: 32rem;
  }

  .ok[hidden] {
    display: none !important;
  }

  .ok__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }

  .ok h1 {
    margin: 0 0 var(--space-2);
    letter-spacing: -0.03em;
  }

  .ok__lede,
  .ok__meta {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  .ok__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: var(--space-6);
  }
</style>
