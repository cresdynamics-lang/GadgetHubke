---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { iphoneConfig } from "../../lib/iphone/config";
import { STOREFRONT_PAYMENTS } from "../../lib/commerce";
import { site } from "../../lib/site";

const waNumber = site.whatsapp;
const lipa = iphoneConfig.lipa;
---

<BaseLayout
  title="Checkout - GadgetHub"
  description={STOREFRONT_PAYMENTS ? `Complete your order with M-Pesa. ${site.address}.` : `Leave your details, then finish the order on WhatsApp. ${site.address}.`}
  hideFooter
>
  <section
    class="checkout container"
    data-checkout
    data-wa={waNumber}
    data-lipa-pct={lipa.depositDefaultPct}
    data-lipa-months={lipa.monthsDefault}
    data-payments={STOREFRONT_PAYMENTS ? "1" : "0"}
  >
    <header class="checkout__intro">
      <button type="button" class="checkout__back" data-checkout-back>← Back</button>
      <p class="checkout__eyebrow">Checkout</p>
      <h1 data-checkout-title>Review cart</h1>
      <p class="checkout__lede" data-checkout-lede>
        {STOREFRONT_PAYMENTS ? "Confirm your items, then pay with M-Pesa." : "Confirm your items, leave your contact details, then finish on WhatsApp."}
      </p>
    </header>

    <ol class="checkout__steps" aria-label="Checkout steps">
      <li data-step-dot="review" class="is-active">1. Review</li>
      <li data-step-dot="details">2. Details</li>
      {STOREFRONT_PAYMENTS ? <li data-step-dot="pay">3. Pay</li> : <li data-step-dot="pay">3. WhatsApp</li>}
    </ol>

    <div class="checkout__empty" data-checkout-empty hidden>
      <p>Your cart is empty.</p>
      <a class="btn btn--secondary btn--sm" href="/accessories">Shop accessories</a>
    </div>

    <div data-checkout-flow>
      <!-- Review -->
      <div class="checkout__panel" data-panel="review">
        <ul class="checkout__lines" data-checkout-lines></ul>
        <p class="checkout__total">Total <strong data-checkout-total></strong></p>
        <div class="checkout__actions">
          <a class="btn btn--secondary" href="/accessories">Shop accessories</a>
        </div>
      </div>

      <!-- Details -->
      <form class="checkout__panel" data-panel="details" hidden>
        <label class="checkout__field">
          <span>Full name</span>
          <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
        </label>
        <label class="checkout__field">
          <span>Phone</span>
          <input type="tel" name="phone" required autocomplete="tel" placeholder="07XX XXX XXX" />
        </label>
        <label class="checkout__field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@email.com" />
        </label>
        {STOREFRONT_PAYMENTS ? (
        <fieldset class="checkout__fulfill">
          <legend>How you’ll pay</legend>
          <label>
            <input type="radio" name="intent" value="purchase" checked />
            Pay in full today
          </label>
          <label>
            <input type="radio" name="intent" value="lipa" />
            Lipa Mdogo Mdogo — {lipa.depositDefaultPct}% deposit today, rest over {lipa.monthsDefault} months
          </label>
        </fieldset>
        ) : <input type="hidden" name="intent" value="purchase" />}
        {STOREFRONT_PAYMENTS ? (
        <div class="checkout__lipa" data-lipa-fields hidden>
          <label class="checkout__field">
            <span>Deposit</span>
            <select name="depositPct">
              {
                Array.from(
                  { length: Math.floor((lipa.depositMaxPct - lipa.depositMinPct) / lipa.depositStepPct) + 1 },
                  (_, i) => lipa.depositMinPct + i * lipa.depositStepPct,
                ).map((pct) => (
                  <option value={pct} selected={pct === lipa.depositDefaultPct}>
                    {pct}%
                  </option>
                ))
              }
            </select>
          </label>
          <label class="checkout__field">
            <span>Months</span>
            <select name="months">
              {
                lipa.monthOptions.map((m) => (
                  <option value={m} selected={m === lipa.monthsDefault}>
                    {m} months
                  </option>
                ))
              }
            </select>
          </label>
        </div>
        ) : null}
        <p class="checkout__hint" data-intent-hint></p>
        <fieldset class="checkout__fulfill">
          <legend>Fulfillment</legend>
          <label>
            <input type="radio" name="fulfillment" value="pickup" checked />
            Pickup · {site.address}
          </label>
          <label>
            <input type="radio" name="fulfillment" value="delivery" />
            Delivery · Nairobi (fee confirmed on WhatsApp)
          </label>
        </fieldset>
        <label class="checkout__field" data-delivery-field hidden>
          <span>Delivery address</span>
          <textarea
            name="deliveryAddress"
            rows="2"
            maxlength="300"
            placeholder="Area / estate, building or street, and a landmark — e.g. Kilimani, Argwings Kodhek Rd, Elgon Court B4, opposite Yaya Centre"
          ></textarea>
        </label>
        <label class="checkout__field">
          <span>Notes (optional)</span>
          <textarea name="notes" rows="2" placeholder="Landmark, preferred pickup time…"></textarea>
        </label>
        <p class="checkout__error" data-details-error hidden></p>
        <div class="checkout__actions">
          <button type="submit" class="btn btn--primary">{STOREFRONT_PAYMENTS ? "Continue to invoice" : "Continue on WhatsApp"}</button>
        </div>
      </form>

      <!-- Pay (hidden while storefront is WhatsApp-only) -->
      {STOREFRONT_PAYMENTS ? (
      <div class="checkout__panel" data-panel="pay" hidden>
        <p class="checkout__pay-total"><span data-pay-kind>Pay</span> <strong data-pay-total></strong></p>
        <p class="checkout__hint">Order <span data-order-id></span> · <span data-pay-mail-kind>invoice</span> emailed to <span data-order-email></span></p>
        <div class="checkout__actions">
          <a class="btn btn--secondary btn--sm" data-invoice-download href="#" hidden>Download invoice PDF</a>
          <a class="btn btn--secondary btn--sm" data-pay-link href="#" hidden>Open pay link</a>
        </div>

        <div class="checkout__methods" role="radiogroup" aria-label="Payment method">
          <label class="checkout__method is-active">
            <input type="radio" name="method" value="mpesa" checked />
            <span>
              <strong>M-Pesa</strong>
              <em>We prompt, you enter PIN</em>
            </span>
          </label>
        </div>
        <p class="checkout__hint">Card is not available yet. Pay with M-Pesa STK Push into Gadget Hub’s Stanbic account.</p>

        <div data-pay-mpesa>
          <label class="checkout__field">
            <span>M-Pesa number</span>
            <input type="tel" name="mpesaPhone" data-mpesa-phone placeholder="07XX XXX XXX" />
          </label>
          <button type="button" class="btn btn--primary checkout__pay-btn" data-pay-mpesa-btn>
            Pay with M-Pesa
          </button>
          <p class="checkout__wait" data-mpesa-wait hidden>Check your phone for the M-Pesa prompt…</p>
        </div>

        <p class="checkout__error" data-pay-error hidden></p>
        <p class="checkout__hint">Need help? <button type="button" class="checkout__text-btn" data-order-wa>WhatsApp this order</button></p>
      </div>
      ) : null}
    </div>
  </section>
</BaseLayout>

<script>
  import {
    bagMetaLine,
    bagTotal,
    clearExpressItems,
    formatKes,
    readBagFromStorage,
    readExpressItems,
    whatsappOrderMessage,
    writeBagToStorage,
  } from "../../lib/checkout/bag";
  import { RECENT_ORDER_KEY } from "../../lib/checkout/types";

  const root = document.querySelector("[data-checkout]");
  if (!root) throw new Error("checkout missing");
  const waNumber = root.getAttribute("data-wa") || "254729585471";

  function openOrderWhatsApp() {
    const msg = whatsappOrderMessage(items, bagTotal(items), customer, orderId || undefined);
    const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
    window.location.assign(url);
  }

  const params = new URLSearchParams(location.search);
  const resumeOrder = params.get("order") || "";
  const resumeToken = params.get("t") || params.get("pay") || "";
  const paymentsOn = root.getAttribute("data-payments") !== "0";
  if (paymentsOn && resumeOrder && resumeToken) {
    location.replace(`/checkout/pay?order=${encodeURIComponent(resumeOrder)}&t=${encodeURIComponent(resumeToken)}`);
  }
  const expressMode = params.get("mode") === "buy-now";

  let items = expressMode ? readExpressItems() : readBagFromStorage();
  if (expressMode && !items.length) items = readBagFromStorage();

  let orderId = "";
  let customer = {
    name: "",
    phone: "",
    email: "",
    fulfillment: "pickup",
    notes: "",
  };

  try {
    const acc = JSON.parse(localStorage.getItem("gh-account") || "null");
    if (acc?.email) {
      customer.name = acc.name || "";
      customer.email = acc.email || "";
      customer.phone = acc.phone || "";
    }
  } catch {
    /* ignore */
  }

  const linesEl = root.querySelector("[data-checkout-lines]");
  const totalEl = root.querySelector("[data-checkout-total]");
  const payTotalEl = root.querySelector("[data-pay-total]");
  const emptyEl = root.querySelector("[data-checkout-empty]");
  const flowEl = root.querySelector("[data-checkout-flow]");
  const titleEl = root.querySelector("[data-checkout-title]");
  const ledeEl = root.querySelector("[data-checkout-lede]");

  const titles = {
    review: "Review cart",
    details: "Your details",
    pay: "Pay securely",
  };
  const ledes = paymentsOn
    ? {
        review: "Confirm your items, then pay with M-Pesa.",
        details: "We'll use these for pickup, delivery updates, and your receipt. Choose pay-in-full or Lipa Mdogo Mdogo.",
        pay: "Download the invoice, then pay with M-Pesa STK Push. Funds settle to Gadget Hub’s Stanbic account.",
      }
    : {
        review: "Confirm your items, leave your contact details, then finish on WhatsApp.",
        details: "We’ll save these for follow-up, then open WhatsApp with your order.",
        pay: "Finish this order on WhatsApp.",
      };

  function visitorId() {
    try {
      let id = localStorage.getItem("gh-visitor");
      if (!id) {
        id = (crypto.randomUUID && crypto.randomUUID()) || `v-${Date.now().toString(36)}`;
        localStorage.setItem("gh-visitor", id);
      }
      return id;
    } catch {
      return "";
    }
  }

  function pingLead(source, extra = {}) {
    try {
      const acc = JSON.parse(localStorage.getItem("gh-account") || "null");
      fetch("/api/leads/cart", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        keepalive: true,
        body: JSON.stringify({
          visitorId: visitorId(),
          source,
          href: location.pathname,
          items: items.map((i) => ({
            id: i.id,
            name: i.name,
            kes: i.kes,
            qty: i.qty,
            href: i.href,
          })),
          name: extra.name || customer.name || acc?.name || "",
          email: extra.email || customer.email || acc?.email || "",
          phone: extra.phone || customer.phone || acc?.phone || "",
        }),
      }).catch(() => {});
    } catch {
      /* ignore */
    }
  }

  function detailsForm() {
    return root.querySelector('[data-panel="details"]');
  }

  function selectedIntent() {
    const form = detailsForm();
    if (!(form instanceof HTMLFormElement)) return "purchase";
    const checked = form.querySelector('input[name="intent"]:checked');
    return checked instanceof HTMLInputElement && checked.value === "lipa" ? "lipa" : "purchase";
  }

  function lipaInputs() {
    const form = detailsForm();
    if (!(form instanceof HTMLFormElement)) return { pct: 40, months: 6 };
    const pctEl = form.querySelector('[name="depositPct"]');
    const monthsEl = form.querySelector('[name="months"]');
    const pct =
      pctEl instanceof HTMLSelectElement || pctEl instanceof HTMLInputElement ? Number(pctEl.value) : 40;
    const months =
      monthsEl instanceof HTMLSelectElement || monthsEl instanceof HTMLInputElement
        ? Number(monthsEl.value)
        : 6;
    return { pct: Number.isFinite(pct) ? pct : 40, months: Number.isFinite(months) ? months : 6 };
  }

  function dueKes() {
    const total = bagTotal(items);
    if (selectedIntent() !== "lipa") return total;
    const { pct } = lipaInputs();
    return Math.round(total * (pct / 100));
  }

  function syncIntentUi() {
    const lipa = selectedIntent() === "lipa";
    root.querySelectorAll("[data-lipa-fields]").forEach((el) => {
      el.toggleAttribute("hidden", !lipa);
    });
    const hint = root.querySelector("[data-intent-hint]");
    const total = bagTotal(items);
    if (hint) {
      hint.textContent = lipa
        ? `Deposit due today ${formatKes(dueKes())}. Remaining ${formatKes(total - dueKes())} after we confirm your plan.`
        : `Full amount due today ${formatKes(total)}.`;
    }
  }

  let currentPanel = "review";

  function showPanel(id) {
    currentPanel = id;
    root.querySelectorAll("[data-panel]").forEach((p) => {
      p.toggleAttribute("hidden", p.getAttribute("data-panel") !== id);
    });
    root.querySelectorAll("[data-step-dot]").forEach((d) => {
      d.classList.toggle("is-active", d.getAttribute("data-step-dot") === id);
    });
    if (titleEl) titleEl.textContent = titles[id] || titles.review;
    if (ledeEl) ledeEl.textContent = ledes[id] || ledes.review;
  }

  root.querySelector("[data-checkout-back]")?.addEventListener("click", () => {
    if (currentPanel === "pay") {
      showPanel("details");
      return;
    }
    if (currentPanel === "details") {
      showPanel("review");
      return;
    }
    if (history.length > 1) history.back();
    else location.href = "/";
  });

  function renderLines() {
    if (!items.length) {
      emptyEl?.removeAttribute("hidden");
      flowEl?.setAttribute("hidden", "");
      return;
    }
    emptyEl?.setAttribute("hidden", "");
    flowEl?.removeAttribute("hidden");
    if (linesEl) {
      linesEl.innerHTML = items
        .map(
          (i) => `
        <li class="checkout__line">
          ${i.image ? `<img src="${i.image}" alt="" width="56" height="56" />` : `<span class="checkout__ph"></span>`}
          <div>
            <strong>${i.name}</strong>
            <p>${bagMetaLine(i) || "Configured item"}</p>
            <p>×${i.qty}</p>
          </div>
          <span>${formatKes(i.kes * i.qty)}</span>
        </li>`,
        )
        .join("");
    }
    const total = formatKes(bagTotal(items));
    if (totalEl) totalEl.textContent = total;
    if (payTotalEl) payTotalEl.textContent = formatKes(dueKes());
    syncIntentUi();
  }

  function fillDetailsForm() {
    const form = root.querySelector('[data-panel="details"]');
    if (!(form instanceof HTMLFormElement)) return;
    form.name.value = customer.name;
    form.phone.value = customer.phone;
    form.email.value = customer.email;
    form.notes.value = customer.notes || "";
    const radio = form.querySelector(`input[name="fulfillment"][value="${customer.fulfillment}"]`);
    if (radio instanceof HTMLInputElement) radio.checked = true;
  }

  root.querySelectorAll("[data-next]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = btn.getAttribute("data-next") || "review";
      if (next === "details") fillDetailsForm();
      showPanel(next);
    });
  });

  // Delivery address shows (and is required) only when Delivery is chosen.
  const deliveryField = root.querySelector("[data-delivery-field]");
  const syncDelivery = () => {
    const on = root.querySelector('input[name="fulfillment"][value="delivery"]')?.checked;
    if (deliveryField instanceof HTMLElement) deliveryField.hidden = !on;
    const ta = deliveryField?.querySelector("textarea");
    if (ta) ta.required = Boolean(on);
  };
  root.querySelectorAll('input[name="fulfillment"]').forEach((r) => r.addEventListener("change", syncDelivery));
  syncDelivery();

  root.querySelector('[data-panel="details"]')?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;
    const err = root.querySelector("[data-details-error]");
    const fd = new FormData(form);
    customer = {
      name: String(fd.get("name") || "").trim(),
      phone: String(fd.get("phone") || "").trim(),
      email: String(fd.get("email") || "").trim(),
      fulfillment: String(fd.get("fulfillment") || "pickup") === "delivery" ? "delivery" : "pickup",
      deliveryAddress: String(fd.get("deliveryAddress") || "").trim(),
      notes: String(fd.get("notes") || "").trim(),
    };
    const intent = String(fd.get("intent") || "purchase") === "lipa" ? "lipa" : "purchase";
    const depositPct = Number(fd.get("depositPct") || 40);
    const months = Number(fd.get("months") || 6);

    pingLead("checkout", customer);

    if (err) err.hidden = true;
    try {
      const res = await fetch("/api/checkout/order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          items,
          customer,
          intent,
          depositPct,
          months,
          visitorId: visitorId(),
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Could not create order.");
      orderId = data.order.id;
      const oid = root.querySelector("[data-order-id]");
      if (oid) oid.textContent = orderId;
      const emailEl = root.querySelector("[data-order-email]");
      if (emailEl) emailEl.textContent = customer.email;
      const invoiceA = root.querySelector("[data-invoice-download]");
      if (invoiceA instanceof HTMLAnchorElement && data.order.invoiceUrl) {
        invoiceA.href = data.order.invoiceUrl;
        invoiceA.hidden = false;
      }
      const payA = root.querySelector("[data-pay-link]");
      if (payA instanceof HTMLAnchorElement && data.order.payUrl) {
        payA.href = data.order.payUrl;
        payA.hidden = false;
      }
      const mpesa = root.querySelector("[data-mpesa-phone]");
      if (mpesa instanceof HTMLInputElement) mpesa.value = customer.phone;
      const lipaOrder = data.order.intent === "lipa";
      const due = formatKes(Number(data.order.subtotalKes) || dueKes());
      if (payTotalEl) payTotalEl.textContent = due;
      const kindEl = root.querySelector("[data-pay-kind]");
      if (kindEl) kindEl.textContent = lipaOrder ? "Deposit due today" : "Pay";
      const mailKind = root.querySelector("[data-pay-mail-kind]");
      if (mailKind) mailKind.textContent = lipaOrder ? "deposit invoice" : "invoice";
      const payBtn = root.querySelector("[data-pay-mpesa-btn]");
      if (payBtn) payBtn.textContent = lipaOrder ? `Pay deposit ${due} with M-Pesa` : "Pay with M-Pesa";
      if (ledeEl) {
        ledeEl.textContent = lipaOrder
          ? "This invoice is the Lipa Mdogo Mdogo deposit, not the full device price. Pay with M-Pesa STK Push."
          : ledes.pay;
      }
      localStorage.setItem(RECENT_ORDER_KEY, orderId);
      if (!paymentsOn) {
        openOrderWhatsApp();
        return;
      }
      showPanel("pay");
      if (typeof window.fbq === "function") {
        const contentIds = items
          .map((i) => String(i.catalogId || i.sheetId || i.id || "").trim())
          .filter(Boolean);
        window.fbq("track", "InitiateCheckout", {
          content_ids: contentIds,
          content_type: "product",
          value: items.reduce((n, i) => n + (Number(i.kes) || 0) * (Number(i.qty) || 1), 0),
          currency: "KES",
          num_items: items.reduce((n, i) => n + (Number(i.qty) || 1), 0),
          contents: items.map((i) => ({
            id: String(i.catalogId || i.sheetId || i.id || ""),
            quantity: Number(i.qty) || 1,
          })),
        });
      }
    } catch (ex) {
      if (err) {
        err.textContent = ex instanceof Error ? ex.message : "Could not continue.";
        err.hidden = false;
      }
    }
  });

  function syncMethodUi() {
    root.querySelectorAll(".checkout__method").forEach((el) => {
      el.classList.add("is-active");
    });
    root.querySelector("[data-pay-mpesa]")?.removeAttribute("hidden");
  }

  let pollTimer = null;
  function stopPoll() {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  async function pollMpesa() {
    const wait = root.querySelector("[data-mpesa-wait]");
    const err = root.querySelector("[data-pay-error]");
    stopPoll();
    pollTimer = setInterval(async () => {
      try {
        const res = await fetch(`/api/checkout/mpesa/status?orderId=${encodeURIComponent(orderId)}`);
        const data = await res.json();
        if (data.status === "paid") {
          stopPoll();
          if (!expressMode) writeBagToStorage([]);
          clearExpressItems();
          location.href = `/checkout/success?order=${encodeURIComponent(orderId)}&paid=1`;

        } else if (data.status === "failed") {
          stopPoll();
          if (wait) wait.hidden = true;
          if (err) {
            err.textContent = data.order?.error || "Payment failed. Try again.";
            err.hidden = false;
          }
        }
      } catch {
        /* keep polling briefly */
      }
    }, 1500);
  }

  root.querySelector("[data-order-wa]")?.addEventListener("click", () => openOrderWhatsApp());

  root.querySelector("[data-pay-mpesa-btn]")?.addEventListener("click", async () => {
    const err = root.querySelector("[data-pay-error]");
    const wait = root.querySelector("[data-mpesa-wait]");
    const phoneEl = root.querySelector("[data-mpesa-phone]");
    const mobileNumber = phoneEl instanceof HTMLInputElement ? phoneEl.value.trim() : customer.phone;
    if (err) err.hidden = true;
    if (!orderId) {
      if (err) {
        err.textContent = "Create the order from details first.";
        err.hidden = false;
      }
      return;
    }
    try {
      const res = await fetch("/api/checkout/mpesa/stk", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ orderId, mobileNumber }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "STK failed.");
      if (wait) {
        wait.textContent = data.stk?.message || "Check your phone for the M-Pesa prompt…";
        wait.hidden = false;
      }
      await pollMpesa();
    } catch (ex) {
      if (err) {
        err.textContent = ex instanceof Error ? ex.message : "STK failed.";
        err.hidden = false;
      }
    }
  });

  detailsForm()?.addEventListener("change", () => {
    syncIntentUi();
    if (payTotalEl && currentPanel !== "pay") payTotalEl.textContent = formatKes(dueKes());
  });

  let leadTimer = 0;
  detailsForm()?.addEventListener("input", () => {
    window.clearTimeout(leadTimer);
    leadTimer = window.setTimeout(() => {
      const form = detailsForm();
      if (!(form instanceof HTMLFormElement)) return;
      pingLead("checkout", {
        name: String(form.name?.value || "").trim(),
        email: String(form.email?.value || "").trim(),
        phone: String(form.phone?.value || "").trim(),
      });
    }, 800);
  });

  renderLines();
  if (items.length) {
    fillDetailsForm();
    showPanel("details");
    pingLead("checkout");
  } else {
    showPanel("review");
  }
  syncMethodUi();
  syncIntentUi();
</script>

<style>
  .checkout {
    padding-block: var(--space-8) calc(var(--space-12) + var(--fab-clearance));
    max-width: 36rem;
  }

  .checkout__back {
    display: inline-flex;
    align-items: center;
    margin: 0 0 var(--space-3);
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg-muted);
    cursor: pointer;
  }

  .checkout__back:hover {
    color: var(--color-fg);
  }

  .checkout__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
