---
import BaseLayout from "../layouts/BaseLayout.astro";
import Price from "../components/Price.astro";
import { homeDeals } from "../lib/home";
---

<BaseLayout
  title="Deals — GadgetHub"
  description="Current promos and bestsellers on new Apple devices at GadgetHub Kenya."
>
  <section class="deals-page container">
    <header class="deals-page__head">
      <h1>Deals</h1>
      <p>New stock only — prices in KES.</p>
    </header>
    <ul class="deals-page__grid">
      {
        homeDeals.map((deal) => (
          <li>
            <a class="deals-page__card" href={deal.href}>
              <span class="deals-page__media">
                {deal.badge && <span class="badge">{deal.badge}</span>}
                {deal.image && (
                  <picture>
                    {deal.image.srcWebp && (
                      <source srcset={deal.image.srcWebp} type="image/webp" />
                    )}
                    <img
                      src={deal.image.src}
                      alt={deal.image.alt}
                      width="400"
                      height="300"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                )}
              </span>
              <span class="deals-page__name">{deal.name}</span>
              <Price kes={deal.priceKes} prefix="From" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .deals-page {
    padding-block: var(--space-12) calc(var(--space-16) + var(--fab-clearance));
  }

  .deals-page__head {
    margin-bottom: var(--space-8);
    max-width: 36rem;
  }

  .deals-page__head h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .deals-page__head p {
    color: var(--color-fg-muted);
  }

  .deals-page__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 48rem) {
    .deals-page__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .deals-page__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .deals-page__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }

  .deals-page__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-muted);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .deals-page__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .deals-page__media .badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
  }

  .deals-page__name {
    font-weight: var(--font-weight-medium);
  }
</style>
