# Optional - copy to .env for local / set in host dashboard for production
PUBLIC_PLAUSIBLE_DOMAIN=

# Ads pixels
# Meta Pixel ID from Events Manager (default on site: 971017782717953)
PUBLIC_META_PIXEL_ID=971017782717953
# Google tag (gtag.js) — default GT-TWQKGRD3
PUBLIC_GOOGLE_TAG_ID=GT-TWQKGRD3
# Optional extra Google Ads (AW-…) and/or GA4 (G-…) configs on the same gtag
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GA_MEASUREMENT_ID=


# Product catalog feeds (live shop prices):
#   Meta CSV:    https://gadgethubke.com/feeds/meta-catalog.csv
#   Google XML:  https://gadgethubke.com/feeds/google-merchant.xml


# Product reviews + admin overlays (required on Vercel for persistence)
# Free Redis: https://upstash.com → create DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login password for /admin (required in production)
ADMIN_SECRET=

# Force local .data/*.json even when VERCEL=1 (rarely needed)
# REVIEWS_LOCAL_FILE=1

# The shop and operations app are standalone. Leave these unset.
# OPS_CATALOG_URL=https://app.gadgethubke.com
# WEBSITE_SYNC_SECRET=

# Storefront checkout is WhatsApp-only. Stanbic / M-Pesa STK is not shown.
# Leave these unset unless you turn STOREFRONT_PAYMENTS back on in src/lib/commerce.ts.
# PAYMENTS_MODE=mock | sandbox | live
# STANBIC_CLIENT_ID=
# STANBIC_CLIENT_SECRET=
# STANBIC_BILL_ACCOUNT_REF=0100013199528
# STANBIC_API_BASE=
# STANBIC_TOKEN_URL=
# STANBIC_STK_PATH=
# STANBIC_WEBHOOK_SECRET=

# --- Email (Namecheap Private Email SMTP) ---
# App password from the mailbox, not the webmail login.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@gadgethubke.com
SMTP_PASS=
MAIL_FROM=Gadget Hub <info@gadgethubke.com>
MAIL_REPLY_TO=info@gadgethubke.com
# Optional dedicated HMAC secret for invoice pay links / password reset
# GH_SIGNING_SECRET=


