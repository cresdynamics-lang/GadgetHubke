# Optional - copy to .env for local / set in host dashboard for production
PUBLIC_PLAUSIBLE_DOMAIN=

# Product reviews + admin overlays (required on Vercel for persistence)
# Free Redis: https://upstash.com → create DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login password for /admin (required in production)
ADMIN_SECRET=

# Force local .data/*.json even when VERCEL=1 (rarely needed)
# REVIEWS_LOCAL_FILE=1

# --- Stanbic Bank payments (checkout) ---
# Without these, checkout runs in mock mode (STK auto-confirms; card skips to success).
# Portal: https://sandbox.stanbicbank.co.ke/
# PAYMENTS_MODE=mock | sandbox | live
PAYMENTS_MODE=mock
STANBIC_CLIENT_ID=
STANBIC_CLIENT_SECRET=
STANBIC_BILL_ACCOUNT_REF=
STANBIC_API_BASE=https://sandbox.stanbicbank.co.ke
# Optional overrides once Stanbic confirms exact paths for your merchant product:
# STANBIC_STK_PATH=
# STANBIC_CARD_PATH=
# STANBIC_WEBHOOK_SECRET=
