# Optional - copy to .env for local / set in host dashboard for production
PUBLIC_PLAUSIBLE_DOMAIN=

# Product reviews (required on Vercel so customer posts persist for everyone)
# Free Redis: https://upstash.com → create DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Force local .data/reviews.json even when VERCEL=1 (rarely needed)
# REVIEWS_LOCAL_FILE=1
