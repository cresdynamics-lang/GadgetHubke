# Optional - copy to .env for local / set in host dashboard for production
PUBLIC_PLAUSIBLE_DOMAIN=

# Product reviews + admin overlays (required on Vercel for persistence)
# Free Redis: https://upstash.com → create DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login password for /admin (required in production)
ADMIN_SECRET=

# Force local .data/*.json even when VERCEL=1 (rarely needed)
# REVIEWS_LOCAL_FILE=1
